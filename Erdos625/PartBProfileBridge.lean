    PaperPartBTerminalContributionEntropyFloorExactForbiddenUpperWorstMFeasibleUpperWitnessRealSlackTarget ε := by
  rcases hbelow with ⟨n₀, hbelow⟩
  refine ⟨n₀, fun n hn hmain => ?_⟩
  let t := partBThresholdLevel n
  let kt := kThresholdAlphaMinusOne n
  have hkt_ge_one :
      (1 : ℝ) ≤ expectedTBoundedColorings n kt t := by
    simpa [kt, t, kThresholdAlphaMinusOne] using
      firstMomentThreshold_ge_one n (partBThresholdLevel n) (partBThresholdLevel_pos n)
  have hnot_lt : ¬((kt : ℝ) < (n : ℝ) / (t : ℝ) + 2) := by
    intro hlt
    have hlt_one : expectedTBoundedColorings n kt t < 1 := by
      simpa [kt, t] using hbelow n hn hmain kt (by simpa [t] using hlt)
    exact not_lt_of_ge hkt_ge_one hlt_one
  exact not_lt.mp hnot_lt

