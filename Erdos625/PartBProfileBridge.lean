  refine ⟨max n₁ n₂, fun n hn hmain => ?_⟩
  have hn₁ : n₁ ≤ n := (Nat.le_max_left n₁ n₂).trans hn
  have hn₂ : n₂ ≤ n := (Nat.le_max_right n₁ n₂).trans hn
  rcases havg n hn₁ hmain with ⟨_hD5_pos, hD5_le⟩
  have hth_ge9 : (9 : ℝ) ≤ threshold n := hge9 n hn₂ hmain
  have hlog_pos : 0 < Real.log 2 := Real.log_pos (by norm_num)
