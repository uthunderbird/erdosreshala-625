def PaperPartBLogFactorialUpperWithLinearCorrectionTarget : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → 0 < n →
    Real.log (Nat.factorial n) ≤ (n : ℝ) * Real.log n - (n : ℝ) + Real.log n

/-- Standard eventual multiplicative upper form of Stirling with an unspecified constant.

This is separated from `PaperPartBLogFactorialUpperWithLinearCorrectionTarget` so the terminal
route can use a conventional asymptotic Stirling upper and a small log-absorption lemma rather than
asking for the exact logarithmic correction in one opaque target. -/
def PaperPartBLogFactorialUpperWithStirlingConstantTarget (C : ℝ) : Prop :=
  0 < C ∧ ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → 0 < n →
    (Nat.factorial n : ℝ) ≤ C * Real.sqrt (n : ℝ) * ((n : ℝ) / Real.exp 1) ^ n

/-- Eventual absorption of the fixed Stirling constant into the spare `log n / 2` margin. -/
def PaperPartBLogAbsorbsStirlingConstantTarget (C : ℝ) : Prop :=
  0 < C ∧ ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → 0 < n →
    Real.log C + Real.log n / 2 ≤ Real.log n

theorem paperPartBLogAbsorbsStirlingConstantTarget_of_pos
    {C : ℝ} (hC_pos : 0 < C) :
    PaperPartBLogAbsorbsStirlingConstantTarget C := by
  have hlog_nat :
      Filter.Tendsto (fun n : ℕ => Real.log (n : ℝ)) Filter.atTop Filter.atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hhalf_log_nat :
      Filter.Tendsto (fun n : ℕ => Real.log (n : ℝ) / 2) Filter.atTop Filter.atTop :=
    Filter.Tendsto.atTop_div_const (by norm_num : (0 : ℝ) < 2) hlog_nat
  rcases (hhalf_log_nat.eventually_ge_atTop (Real.log C)).exists_forall_of_atTop with
    ⟨n₀, hn₀⟩
  refine ⟨hC_pos, n₀, fun n hn _hn_pos => ?_⟩
  have hle : Real.log C ≤ Real.log (n : ℝ) / 2 := hn₀ n hn
  linarith

theorem paperPartBLogFactorialUpperWithStirlingConstantTarget_of_stirling :
    PaperPartBLogFactorialUpperWithStirlingConstantTarget (2 * Real.sqrt (2 * Real.pi)) := by
  obtain ⟨φ, hφ, hEq⟩ :=
    Asymptotics.IsEquivalent.exists_eq_mul Stirling.factorial_isEquivalent_stirling
  have hφ_le_two : ∀ᶠ n : ℕ in Filter.atTop, φ n ≤ (2 : ℝ) :=
    hφ.eventually_le_const (by norm_num : (1 : ℝ) < 2)
  rcases (hφ_le_two.and hEq).exists_forall_of_atTop with ⟨n₀, hn₀⟩
  refine ⟨by positivity, n₀, fun n hn hn_pos => ?_⟩
  rcases hn₀ n hn with ⟨hφn_le_two, hEqn⟩
  have hv_nonneg :
      0 ≤ Real.sqrt (2 * (n : ℝ) * Real.pi) * ((n : ℝ) / Real.exp 1) ^ n := by
    positivity
  have hsqrt_arg :
      2 * (n : ℝ) * Real.pi = (2 * Real.pi) * (n : ℝ) := by
    ring
  calc
    (Nat.factorial n : ℝ)
        = φ n * (Real.sqrt (2 * (n : ℝ) * Real.pi) *
            ((n : ℝ) / Real.exp 1) ^ n) := by
          simpa using hEqn
    _ ≤ 2 * (Real.sqrt (2 * (n : ℝ) * Real.pi) *
            ((n : ℝ) / Real.exp 1) ^ n) :=
          mul_le_mul_of_nonneg_right hφn_le_two hv_nonneg
    _ = 2 * Real.sqrt (2 * Real.pi) * Real.sqrt (n : ℝ) *
            ((n : ℝ) / Real.exp 1) ^ n := by
          rw [hsqrt_arg, Real.sqrt_mul (by positivity : 0 ≤ 2 * Real.pi)]
          ring

theorem paperPartBLogFactorialUpperWithLinearCorrectionTarget_of_stirlingConstant
    {C : ℝ}
    (hupper : PaperPartBLogFactorialUpperWithStirlingConstantTarget C)
    (habsorb : PaperPartBLogAbsorbsStirlingConstantTarget C) :
    PaperPartBLogFactorialUpperWithLinearCorrectionTarget := by
  rcases hupper with ⟨hC_pos, n₁, hupper⟩
  rcases habsorb with ⟨_hC_pos_absorb, n₂, habsorb⟩
  refine ⟨max n₁ n₂, fun n hn hn_pos => ?_⟩
  have hn₁ : n₁ ≤ n := le_trans (Nat.le_max_left n₁ n₂) hn
  have hn₂ : n₂ ≤ n := le_trans (Nat.le_max_right n₁ n₂) hn
  have hn_real_pos : 0 < (n : ℝ) := by exact_mod_cast hn_pos
  have hfac_pos : 0 < (Nat.factorial n : ℝ) := by positivity
  have hstirling_upper := hupper n hn₁ hn_pos
  have hlog_le := Real.log_le_log hfac_pos hstirling_upper
  have hlog_stirling :
      Real.log (C * Real.sqrt (n : ℝ) * ((n : ℝ) / Real.exp 1) ^ n) =
        Real.log C + Real.log n / 2 + ((n : ℝ) * Real.log n - (n : ℝ)) := by
    rw [Real.log_mul (by positivity) (by positivity),
      Real.log_mul (by positivity) (by positivity),
      Real.log_sqrt (by positivity), Real.log_pow,
      Real.log_div (by positivity) (by positivity), Real.log_exp]
    ring
  have habs := habsorb n hn₂ hn_pos
  calc
    Real.log (Nat.factorial n)
        ≤ Real.log (C * Real.sqrt (n : ℝ) * ((n : ℝ) / Real.exp 1) ^ n) := hlog_le
    _ = Real.log C + Real.log n / 2 + ((n : ℝ) * Real.log n - (n : ℝ)) :=
        hlog_stirling
    _ ≤ (n : ℝ) * Real.log n - (n : ℝ) + Real.log n := by
        linarith

theorem paperPartBLogFactorialUpperWithLinearCorrectionTarget_of_stirling :
    PaperPartBLogFactorialUpperWithLinearCorrectionTarget :=
  paperPartBLogFactorialUpperWithLinearCorrectionTarget_of_stirlingConstant
    paperPartBLogFactorialUpperWithStirlingConstantTarget_of_stirling
    (paperPartBLogAbsorbsStirlingConstantTarget_of_pos (by positivity))

lemma log_factorial_upper_pow_self
    {n : ℕ} (_hn : 0 < n) :
    Real.log (Nat.factorial n) ≤ (n : ℝ) * Real.log n := by
  have hfac_pos : 0 < (Nat.factorial n : ℝ) := by positivity
  have hle_nat : Nat.factorial n ≤ n ^ n := Nat.factorial_le_pow n
  have hle : (Nat.factorial n : ℝ) ≤ (n ^ n : ℕ) := by
    exact_mod_cast hle_nat
  have hlog_le := Real.log_le_log hfac_pos hle
  rw [Nat.cast_pow, Real.log_pow] at hlog_le
  simpa using hlog_le

lemma log_factorial_upper_pow_self_all (n : ℕ) :
    Real.log (Nat.factorial n) ≤ (n : ℝ) * Real.log n := by
  cases n with
  | zero => norm_num
  | succ n => exact log_factorial_upper_pow_self (Nat.succ_pos n)

lemma log_factorial_nonneg (n : ℕ) :
    0 ≤ Real.log (Nat.factorial n) := by
  have hge_one : (1 : ℝ) ≤ (Nat.factorial n : ℝ) := by
    exact_mod_cast Nat.succ_le_of_lt (Nat.factorial_pos n)
  exact Real.log_nonneg hge_one

lemma partBTerminalContributionRealQuotientExpandedLogInnerBudgetLhs_le_stirlingUpper
    {δ : ℝ} {n m : ℕ} (hfeas : PartBTerminalProfileFeasible n m) :
    partBTerminalContributionRealQuotientExpandedLogInnerBudgetLhs δ n m ≤
      partBTerminalContributionRealQuotientStirlingUpperLogInnerBudgetLhs δ n m := by
  rcases hfeas with ⟨_hlower, _hupper, _hmn, ht_one, htn⟩
  have hn_pos : 0 < n := by omega
  have ht_pos : 0 < partBThresholdLevel n := by omega
  have ht_minus_pos : 0 < partBThresholdLevel n - 1 := by omega
  have hn_fact_upper :
      Real.log (Nat.factorial n) ≤ (n : ℝ) * Real.log n :=
    log_factorial_upper_pow_self hn_pos
  have ht_fact_lower :
      (partBThresholdLevel n : ℝ) * Real.log (partBThresholdLevel n) -
          (partBThresholdLevel n : ℝ) +
          Real.log (partBThresholdLevel n) / 2 + Real.log (2 * Real.pi) / 2 ≤
        Real.log (Nat.factorial (partBThresholdLevel n)) :=
    log_factorial_lower_coarse ht_pos
  have ht_minus_fact_lower :
      (((partBThresholdLevel n - 1 : ℕ) : ℝ) *
          Real.log ((partBThresholdLevel n - 1 : ℕ) : ℝ) -
          ((partBThresholdLevel n - 1 : ℕ) : ℝ) +
          Real.log ((partBThresholdLevel n - 1 : ℕ) : ℝ) / 2 +
          Real.log (2 * Real.pi) / 2) ≤
        Real.log (Nat.factorial (partBThresholdLevel n - 1)) :=
    log_factorial_lower_coarse ht_minus_pos
  have htop_mul :
      (partBTerminalTopCount n m : ℝ) *
          ((partBThresholdLevel n : ℝ) * Real.log (partBThresholdLevel n) -
            (partBThresholdLevel n : ℝ) +
            Real.log (partBThresholdLevel n) / 2 + Real.log (2 * Real.pi) / 2) ≤
        (partBTerminalTopCount n m : ℝ) *
          Real.log (Nat.factorial (partBThresholdLevel n)) :=
    mul_le_mul_of_nonneg_left ht_fact_lower (by positivity)
  have hlow_mul :
      (partBTerminalLowCount n m : ℝ) *
          (((partBThresholdLevel n - 1 : ℕ) : ℝ) *
            Real.log ((partBThresholdLevel n - 1 : ℕ) : ℝ) -
            ((partBThresholdLevel n - 1 : ℕ) : ℝ) +
            Real.log ((partBThresholdLevel n - 1 : ℕ) : ℝ) / 2 +
            Real.log (2 * Real.pi) / 2) ≤
        (partBTerminalLowCount n m : ℝ) *
          Real.log (Nat.factorial (partBThresholdLevel n - 1)) :=
    mul_le_mul_of_nonneg_left ht_minus_fact_lower (by positivity)
  have htop_symm_nonneg :
      0 ≤ Real.log (Nat.factorial (partBTerminalTopCount n m)) :=
    log_factorial_nonneg _
  have hlow_symm_nonneg :
      0 ≤ Real.log (Nat.factorial (partBTerminalLowCount n m)) :=
    log_factorial_nonneg _
  dsimp [partBTerminalContributionRealQuotientExpandedLogInnerBudgetLhs,
    partBTerminalContributionRealQuotientStirlingUpperLogInnerBudgetLhs]
  linarith

lemma partBTerminalContributionRealQuotientExpandedLogInnerBudgetLhs_le_sharpStirlingUpper
    {δ : ℝ} {n m : ℕ} (hfeas : PartBTerminalProfileFeasible n m)
