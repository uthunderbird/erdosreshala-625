lemma partBEndpointClosedVectorTailMomentQBoundedVectorFinset_card_le_product
    (n q : ℕ) :
    (partBEndpointClosedVectorTailMomentQBoundedVectorFinset n q).card ≤
      (n + 1) ^ 2 * (q + 1) ^ (partBThresholdLevel n + 1) := by
  classical
  let oneIdx : Fin (partBThresholdLevel n + 1) :=
    ⟨1, by
      have ht_pos : 0 < partBThresholdLevel n := partBThresholdLevel_pos n
      omega⟩
  let code :
      (Fin (partBThresholdLevel n + 1) → Fin (n + 1)) →
        (Fin 2 → Fin (n + 1)) ×
          (Fin (partBThresholdLevel n + 1) → Fin (q + 1)) :=
    fun e =>
      (fun a : Fin 2 =>
          if a.val = 0 then e 0 else e oneIdx,
        fun j : Fin (partBThresholdLevel n + 1) =>
          if 2 ≤ j.val then
            ⟨min (e j).val q, Nat.lt_succ_of_le (Nat.min_le_right _ _)⟩
          else 0)
  have hmap :
      ∀ e ∈ partBEndpointClosedVectorTailMomentQBoundedVectorFinset n q,
        code e ∈
          (Finset.univ :
            Finset ((Fin 2 → Fin (n + 1)) ×
              (Fin (partBThresholdLevel n + 1) → Fin (q + 1)))) := by
    intro e _he
    exact Finset.mem_univ _
  have hinj :
      Set.InjOn code
        ↑(partBEndpointClosedVectorTailMomentQBoundedVectorFinset n q) := by
    intro e he e' he' hcode
    funext j
    have he_tail :
        ∀ j : Fin (partBThresholdLevel n + 1), 2 ≤ j.val → (e j).val ≤ q :=
      (Finset.mem_filter.mp he).2
    have he'_tail :
        ∀ j : Fin (partBThresholdLevel n + 1), 2 ≤ j.val → (e' j).val ≤ q :=
      (Finset.mem_filter.mp he').2
    by_cases hj0 : j.val = 0
    · have hj_eq : j = 0 := by
        ext
        simpa using hj0
      subst j
      have hfirst := congrFun (congrArg Prod.fst hcode) (0 : Fin 2)
      simpa [code] using hfirst
    · by_cases hj1 : j.val = 1
      · have hj_eq : j = oneIdx := by
          ext
          simpa [oneIdx] using hj1
        subst j
        have hfirst := congrFun (congrArg Prod.fst hcode) (1 : Fin 2)
        simpa [code, oneIdx] using hfirst
      · have hj_tail : 2 ≤ j.val := by omega
        have hsecond := congrFun (congrArg Prod.snd hcode) j
        have he_min : min (e j).val q = (e j).val :=
          Nat.min_eq_left (he_tail j hj_tail)
        have he'_min : min (e' j).val q = (e' j).val :=
          Nat.min_eq_left (he'_tail j hj_tail)
        exact Fin.ext (by
          simpa [code, hj_tail, he_min, he'_min] using congrArg Fin.val hsecond)
  have hcard := Finset.card_le_card_of_injOn code hmap hinj
  have htarget_card :
      ((Finset.univ :
        Finset ((Fin 2 → Fin (n + 1)) ×
          (Fin (partBThresholdLevel n + 1) → Fin (q + 1)))).card) =
        (n + 1) ^ 2 * (q + 1) ^ (partBThresholdLevel n + 1) := by
    simp [Fintype.card_prod, Fintype.card_fin]
  simpa [htarget_card] using hcard

