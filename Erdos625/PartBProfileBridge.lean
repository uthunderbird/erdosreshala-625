  have hleft : ((n : ℝ) / (t : ℝ) + 2) * (t : ℝ) = (n : ℝ) + 2 * (t : ℝ) := by
    field_simp [ne_of_gt ht_pos]
  have hnat_real : ((n + 2 * t : ℕ) : ℝ) ≤ ((k * t : ℕ) : ℝ) := by
    norm_num
    linarith
  exact_mod_cast hnat_real

