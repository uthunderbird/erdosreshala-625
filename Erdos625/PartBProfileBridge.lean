def PaperPartBExactNoEmptyProfilePhiRemainderBinaryBudgetProfileFDeficitAbsorptionTarget :
    Prop :=
  ∀ ε A : ℝ, 0 < ε →
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
      ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
        0 < m →
