lemma partBTerminalProfileContribution_eq_formula
    {n m : ℕ} (hfeas : PartBTerminalProfileFeasible n m) :
    profileContribution n (partBTerminalProfile n m) =
      partBTerminalContributionFormula n m := by
  simpa [partBTerminalContributionFormula] using
    paperPartBTerminalProfileContributionFormulaTarget n m hfeas

/-- Any no-empty profile contributes at most the whole fixed-`m` profile sum, since every
profile contribution is nonnegative. -/
lemma profileContribution_le_noEmptyProfileSum_of_mem
    {n m t : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n m t) :
    profileContribution n f ≤
      ∑ g ∈ noEmptyColoringProfileFinset n m t, profileContribution n g := by
  exact Finset.single_le_sum
    (s := noEmptyColoringProfileFinset n m t)
    (f := fun g => profileContribution n g)
    (fun g _hg => profileContribution_nonneg n g) hf

/-- The terminal two-size profile gives a concrete summand in the fixed-`m` no-empty profile
sum whenever its arithmetic feasibility window holds. -/
def PaperPartBTerminalProfileContributionWitnessTarget : Prop :=
  ∀ n m : ℕ, PartBTerminalProfileFeasible n m →
    profileContribution n (partBTerminalProfile n m) ≤
      ∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        profileContribution n f

theorem paperPartBTerminalProfileContributionWitnessTarget :
    PaperPartBTerminalProfileContributionWitnessTarget := by
  intro n m hfeas
  exact profileContribution_le_noEmptyProfileSum_of_mem
    (paperPartBTerminalProfileMembershipTarget n m hfeas)

lemma partBTerminalProfileContribution_le_of_noEmptyProfileSum_le
    {n m : ℕ} {B : ℝ}
    (hfeas : PartBTerminalProfileFeasible n m)
    (hsum :
      (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        profileContribution n f) ≤ B) :
    profileContribution n (partBTerminalProfile n m) ≤ B :=
  (paperPartBTerminalProfileContributionWitnessTarget n m hfeas).trans hsum

/-- Necessary terminal-profile consequence of any fixed-`m` real inner budget. This is a
diagnostic guardrail for future terminal-band estimates: the fixed-`m` budget cannot be true unless
the concrete terminal profile already satisfies the same budget. -/
def PaperPartBTerminalContributionFixedMInnerBudgetNecessaryTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      PartBTerminalProfileFeasible n m →
        profileContribution n (partBTerminalProfile n m) ≤
          δ / (((Finset.range (partBPaperObstructionColorCount n + 1)).card + 1 : ℕ) : ℝ)

/-- Bridge target for the terminal-profile necessary fixed-`m` budget. -/
def PaperPartBTerminalContributionFixedMInnerBudgetNecessaryBridgeTarget : Prop :=
  ∀ ε δ : ℝ, 0 < ε → 0 < δ →
    PaperPartBTerminalContributionFixedMInnerBudgetNecessaryTarget ε δ

theorem paperPartBTerminalContributionFixedMInnerBudgetNecessaryTarget_of_realInnerBudget
    {ε δ : ℝ}
    (hreal : PaperPartBExactNoEmptyProfileRealInnerBudgetTarget ε δ) :
    PaperPartBTerminalContributionFixedMInnerBudgetNecessaryTarget ε δ := by
  rcases hreal with ⟨n₀, hreal⟩
  refine ⟨n₀, fun n hn hmain m hm hfeas => ?_⟩
  exact partBTerminalProfileContribution_le_of_noEmptyProfileSum_le hfeas
    (hreal n hn hmain m hm)

lemma partBTerminalProfileContribution_pos
    {n m : ℕ} (hfeas : PartBTerminalProfileFeasible n m) :
    0 < profileContribution n (partBTerminalProfile n m) := by
  have hf :=
    paperPartBTerminalProfileMembershipTarget n m hfeas
  have hf_color : partBTerminalProfile n m ∈
      coloringProfileFinset n m (partBThresholdLevel n) :=
    (mem_noEmptyColoringProfileFinset_iff.mp hf).1
  have hP : 0 < profileP n (fun u => (partBTerminalProfile n m u).val) :=
    profileP_pos_of_mem_coloringProfileFinset hf_color
  exact profileContribution_pos_of_profileP_pos n (partBTerminalProfile n m) hP

