theorem paperPartBTerminalZeroBandMembershipLowerWindowBridgeTarget :
    PaperPartBTerminalZeroBandMembershipLowerWindowBridgeTarget := by
  intro ε hε_pos
  rcases paperPartBThresholdLevelTerminalShapeTarget_of_thresholdGeNine_floorLe
      (ε := ε) hε_pos (paperPartBThresholdFloorLeNTarget ε) with ⟨n₀, hshape⟩
  refine ⟨n₀, fun n hn hmain m hmem => ?_⟩
  by_cases hlower : m * (partBThresholdLevel n - 1) ≤ n
  · exact hlower
  · have hlower_gt : n < m * (partBThresholdLevel n - 1) := Nat.lt_of_not_ge hlower
    have ht_one : 1 < partBThresholdLevel n := (hshape n hn hmain).1
    have htn : partBThresholdLevel n ≤ n := (hshape n hn hmain).2
    have hf :
        partBTerminalProfile n m ∈
          noEmptyColoringProfileFinset n m (partBThresholdLevel n) := by
      have hfilter :
          partBTerminalProfile n m ∈
            (noEmptyColoringProfileFinset n m (partBThresholdLevel n)).filter
              (fun f => partBProfileTerminalL1Distance n m f ≤ 0) := by
        simpa [noEmptyProfileTerminalBandFinset] using hmem
      exact (Finset.mem_filter.mp hfilter).1
    have hf_color :
        partBTerminalProfile n m ∈
          coloringProfileFinset n m (partBThresholdLevel n) :=
      (mem_noEmptyColoringProfileFinset_iff.mp hf).1
    have hupper : n ≤ m * partBThresholdLevel n :=
      noEmptyProfile_vertexCount_le_colorCount_mul_threshold (n := n) (m := m)
        (f := partBTerminalProfile n m) hf
    have hmn : m ≤ n :=
      noEmptyProfile_colorCount_le_vertexCount_of_mem (n := n) (m := m)
        (f := partBTerminalProfile n m) hf
    have htop_zero : partBTerminalTopCount n m = 0 :=
      partBTerminalTopCount_eq_zero_of_le_lower (n := n) (m := m)
        (Nat.le_of_lt hlower_gt)
    have hlow_eq : partBTerminalLowCount n m = m := by
      have hsum := partBTerminalLowCount_add_topCount (n := n) (m := m) hupper
      omega
    let uLow : Fin (n + 1) :=
      ⟨partBThresholdLevel n - 1,
        Nat.lt_succ_of_le ((Nat.sub_le _ _).trans htn)⟩
    have hlow_ne_top : uLow.val ≠ partBThresholdLevel n := by
      dsimp [uLow]
      omega
    have hlow_val :
        (partBTerminalProfile n m uLow).val = m := by
      have hlow_val' :=
        partBTerminalProfile_low_val (n := n) (m := m) (u := uLow)
          (by simp [uLow]) hlow_ne_top hmn
      simpa [hlow_eq] using hlow_val'
    have hsingle :
        m * (partBThresholdLevel n - 1) ≤
          profileVertexWeight n (partBTerminalProfile n m) := by
      dsimp [profileVertexWeight]
      calc
        m * (partBThresholdLevel n - 1)
            = uLow.val * (partBTerminalProfile n m uLow).val := by
              dsimp [uLow]
              rw [hlow_val]
              rw [Nat.mul_comm]
        _ ≤ ∑ u : Fin (n + 1), u.val * (partBTerminalProfile n m u).val := by
              exact Finset.single_le_sum
                (s := Finset.univ)
                (f := fun u : Fin (n + 1) =>
                  u.val * (partBTerminalProfile n m u).val)
                (fun _ _ => Nat.zero_le _) (Finset.mem_univ uLow)
    have hvertex :
        profileVertexWeight n (partBTerminalProfile n m) = n :=
      profileVertexWeight_eq_of_mem_coloringProfileFinset hf_color
    rw [hvertex] at hsingle
    exact False.elim (hlower hsingle)

