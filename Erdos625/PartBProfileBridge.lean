lemma natCast_div_le_real_div (a b : ℕ) (hb : 0 < b) :
    (((a / b : ℕ) : ℝ)) ≤ (a : ℝ) / (b : ℝ) := by
  have hbR : 0 < (b : ℝ) := by exact_mod_cast hb
  have hmul : (((a / b : ℕ) : ℝ)) * (b : ℝ) ≤ (a : ℝ) := by
    exact_mod_cast Nat.div_mul_le_self a b
  exact (le_div_iff₀ hbR).mpr hmul

noncomputable def partBTerminalContributionRealQuotientUpperFormula (n m : ℕ) : ℝ :=
  ((Nat.factorial n : ℝ) /
      (((Nat.factorial (partBThresholdLevel n)) ^ partBTerminalTopCount n m *
        (Nat.factorial (partBThresholdLevel n - 1)) ^ partBTerminalLowCount n m : ℕ) : ℝ)) *
    (1 / 2 : ℝ) ^
      (Nat.choose (partBThresholdLevel n) 2 * partBTerminalTopCount n m +
        Nat.choose (partBThresholdLevel n - 1) 2 * partBTerminalLowCount n m) /
    ((Nat.factorial (partBTerminalTopCount n m) *
      Nat.factorial (partBTerminalLowCount n m) : ℕ) : ℝ)

lemma partBTerminalContributionFormula_le_realQuotientUpper
    (n m : ℕ) :
    partBTerminalContributionFormula n m ≤
      partBTerminalContributionRealQuotientUpperFormula n m := by
  set D : ℕ :=
    (Nat.factorial (partBThresholdLevel n)) ^ partBTerminalTopCount n m *
      (Nat.factorial (partBThresholdLevel n - 1)) ^ partBTerminalLowCount n m
  set Q : ℝ :=
    (1 / 2 : ℝ) ^
      (Nat.choose (partBThresholdLevel n) 2 * partBTerminalTopCount n m +
        Nat.choose (partBThresholdLevel n - 1) 2 * partBTerminalLowCount n m)
  set S : ℝ :=
    ((Nat.factorial (partBTerminalTopCount n m) *
      Nat.factorial (partBTerminalLowCount n m) : ℕ) : ℝ)
  have hD_pos : 0 < D := by
    dsimp [D]
    positivity
  have hdiv : (((Nat.factorial n / D : ℕ) : ℝ)) ≤ (Nat.factorial n : ℝ) / (D : ℝ) :=
    natCast_div_le_real_div (Nat.factorial n) D hD_pos
  have hQ_nonneg : 0 ≤ Q := by
    dsimp [Q]
    positivity
  have hS_nonneg : 0 ≤ S := by
    dsimp [S]
    positivity
  dsimp [partBTerminalContributionFormula, partBTerminalContributionRealQuotientUpperFormula]
  change (((Nat.factorial n / D : ℕ) : ℝ)) * Q / S ≤
    ((Nat.factorial n : ℝ) / (D : ℝ)) * Q / S
  exact div_le_div_of_nonneg_right
    (mul_le_mul_of_nonneg_right hdiv hQ_nonneg) hS_nonneg

