/-- Variable-reserve version of the paper average-class denominator. This is the honest
replacement for fixed positive-buffer denominator targets after the `B = 5/2` route failed. -/
noncomputable def partBPaperAverageClassReserveDenom (R : ℕ → ℝ) (n : ℕ) : ℝ :=
  threshold n - (1 + 2 / Real.log 2) + R n

/-- Upstream variable-reserve obstruction-count target:
`m ≤ k_t - 2` is eventually controlled by `n / (threshold - 1 - 2/log 2 + R n)`. -/
def PaperPartBPaperObstructionColorCountReserveUpperTarget (R : ℕ → ℝ) : Prop :=
  ∀ ε : ℝ, 0 < ε →
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
      0 < partBPaperAverageClassReserveDenom R n ∧
        (partBPaperObstructionColorCount n : ℝ) ≤
          (n : ℝ) / partBPaperAverageClassReserveDenom R n

/-- Denominator-controlled scalar absorption target for a variable reserve. -/
def PaperPartBExactNoEmptyProfilePhiRemainderBinaryBudgetBalancedDeficitAbsorptionReserveLhsTarget
    (R : ℕ → ℝ) : Prop :=
  ∀ ε A : ℝ, 0 < ε →
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
      ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
        0 < m →
          (m : ℝ) ≤ (n : ℝ) / partBPaperAverageClassReserveDenom R n →
            partBExactNoEmptyPhiRemainderBinaryBudgetBalancedDeficitAbsorptionLhs n m ≤ A

