/-- Denominator-parametrized scalar LHS target. This isolates the remaining analytic inequality
from the upstream paper average-colour-class bound on the admissible colour count. -/
def PaperPartBExactNoEmptyExplicitCoarseCoreDenomScalarLhsTarget
    (C : ℝ) : Prop :=
  ∀ ε : ℝ, 0 < ε →
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
      0 < partBPaperAverageClassDenom C n →
        ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
          (m : ℝ) ≤ (n : ℝ) / partBPaperAverageClassDenom C n →
            partBExactNoEmptyExplicitCoarseCoreScalarLhs n m ≤ 0

/-- Denominator-parametrized scalar LHS target with the lower admissibility constraint forced by
bounded no-empty profiles. This is the live scalar target after the route audit; the unconstrained
version is retained only as a stronger diagnostic surface. -/
def PaperPartBExactNoEmptyExplicitCoarseCoreConstrainedDenomScalarLhsTarget
    (C : ℝ) : Prop :=
  ∀ ε : ℝ, 0 < ε →
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
      0 < partBPaperAverageClassDenom C n →
        ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
          n ≤ m * partBThresholdLevel n →
            (m : ℝ) ≤ (n : ℝ) / partBPaperAverageClassDenom C n →
              partBExactNoEmptyExplicitCoarseCoreScalarLhs n m ≤ 0

theorem paperPartBExactNoEmptyProfileExplicitCoarseCoreScalarLhsTarget_of_denom
    {ε C : ℝ}
    (hupper : PaperPartBPaperObstructionColorCountUpperTarget C)
    (hdenom : PaperPartBExactNoEmptyExplicitCoarseCoreDenomScalarLhsTarget C)
    (hε_pos : 0 < ε) :
    PaperPartBExactNoEmptyProfileExplicitCoarseCoreScalarLhsTarget ε := by
  rcases hupper ε hε_pos with ⟨n₀_upper, hupper⟩
  rcases hdenom ε hε_pos with ⟨n₀_denom, hdenom⟩
  refine ⟨max n₀_upper n₀_denom, fun n hn hmain m hm => ?_⟩
  have hn_upper : n₀_upper ≤ n := (le_max_left n₀_upper n₀_denom).trans hn
  have hn_denom : n₀_denom ≤ n := (le_max_right n₀_upper n₀_denom).trans hn
  rcases hupper n hn_upper hmain with ⟨hD_pos, hK_upper⟩
  have hm_leK : m ≤ partBPaperObstructionColorCount n := by
    have hm_lt : m < partBPaperObstructionColorCount n + 1 := Finset.mem_range.mp hm
    omega
  have hm_leK_real : (m : ℝ) ≤ (partBPaperObstructionColorCount n : ℝ) := by
    exact_mod_cast hm_leK
  have hm_upper :
      (m : ℝ) ≤ (n : ℝ) / partBPaperAverageClassDenom C n :=
    hm_leK_real.trans hK_upper
  exact hdenom n hn_denom hmain hD_pos m hm hm_upper

