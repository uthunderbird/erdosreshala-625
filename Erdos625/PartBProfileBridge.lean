/-- Pointwise binary-budget target for the paper's `phi + L_0` exponent.

This is the sharp replacement for the failed balanced-quadratic scalar route: future `cont2`/`L_0`
work should prove that the retained exponent, not its coarse balanced lower bound, is below the
finite-union binary profile budget. -/
def PaperPartBExactNoEmptyProfilePhiRemainderBinaryBudgetPointwiseTarget
    (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        profilePhi n f * n + profileRemainder n f ≤
          partBExactNoEmptyBinaryLogCoreBudget δ n

/-- LHS-normalized form of the retained `phi + L_0` binary-budget comparison. -/
noncomputable def partBExactNoEmptyPhiRemainderBinaryBudgetLhs
    (δ : ℝ) (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  profilePhi n f * n + profileRemainder n f -
    partBExactNoEmptyBinaryLogCoreBudget δ n

/-- Fully expanded LHS for the retained `phi + L_0` binary-budget comparison. -/
noncomputable def partBExactNoEmptyPhiRemainderBinaryBudgetExpandedLhs
    (δ : ℝ) (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  (Real.log 2 / 2) *
      ∑ u : Fin (n + 1),
        (((u.val * (f u).val : ℕ) : ℝ) *
          (threshold n - (1 + 2 / Real.log 2) - u.val)) +
    ∑ u : Fin (n + 1), (thresholdFloor n - u.val : ℤ) * (f u).val +
    (n : ℝ) * Real.log (Real.log n) / Real.log n -
    partBExactNoEmptyBinaryLogCoreBudget δ n

/-- δ-free expanded LHS for the retained `phi + L_0` exponent plus binary union denominator. -/
noncomputable def partBExactNoEmptyPhiRemainderBinaryBudgetExpandedNoDeltaLhs
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  (Real.log 2 / 2) *
      ∑ u : Fin (n + 1),
        (((u.val * (f u).val : ℕ) : ℝ) *
          (threshold n - (1 + 2 / Real.log 2) - u.val)) +
    ∑ u : Fin (n + 1), (thresholdFloor n - u.val : ℤ) * (f u).val +
    (n : ℝ) * Real.log (Real.log n) / Real.log n +
    Real.log (partBExactNoEmptyBinaryBudgetDenom n)

/-- No-δ retained-exponent LHS with the integer `L_0` term scalarized to `thresholdFloor*m - n`. -/
noncomputable def partBExactNoEmptyPhiRemainderBinaryBudgetScalarRemainderNoDeltaLhs
    (n m : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  (Real.log 2 / 2) *
      ∑ u : Fin (n + 1),
        (((u.val * (f u).val : ℕ) : ℝ) *
          (threshold n - (1 + 2 / Real.log 2) - u.val)) +
    (thresholdFloor n : ℝ) * m - n +
    (n : ℝ) * Real.log (Real.log n) / Real.log n +
    Real.log (partBExactNoEmptyBinaryBudgetDenom n)

/-- Profile-dependent weighted term in the scalar-remainder no-δ `phi + L_0` budget. -/
noncomputable def partBExactNoEmptyPhiRemainderBinaryBudgetWeightedTerm
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  (Real.log 2 / 2) *
    ∑ u : Fin (n + 1),
      (((u.val * (f u).val : ℕ) : ℝ) *
        (threshold n - (1 + 2 / Real.log 2) - u.val))

/-- Positive weighted deficit relative to the paper centre `threshold - (1 + 2/log 2)`. -/
noncomputable def partBExactNoEmptyPhiRemainderBinaryBudgetWeightedDeficitTerm
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  (Real.log 2 / 2) *
    ∑ u : Fin (n + 1),
      (((u.val * (f u).val : ℕ) : ℝ) *
        (u.val - (threshold n - (1 + 2 / Real.log 2))))

/-- Balanced second-moment lower model for the positive weighted deficit. -/
noncomputable def partBExactNoEmptyPhiRemainderBinaryBudgetBalancedDeficitLower
    (n m : ℕ) : ℝ :=
  (Real.log 2 / 2) *
    ((n : ℝ) * ((n : ℝ) / m - (threshold n - (1 + 2 / Real.log 2))))

/-- `profileF`-based lower model for the positive weighted deficit.

This keeps the profile second moment before replacing it by a purely scalar balanced lower
bound. It is the next exact interface for the `cont2`/`L_0` route after the fixed-buffer
average-class route failed. -/
noncomputable def partBExactNoEmptyPhiRemainderBinaryBudgetProfileFDeficitLower
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  Real.log 2 * (profileF n (fun u => (f u).val) : ℝ) +
    (Real.log 2 / 2) *
      ((n : ℝ) * (1 - (threshold n - (1 + 2 / Real.log 2))))

lemma partBExactNoEmptyPhiRemainderBinaryBudgetWeightedTerm_eq_neg_deficit
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) :
    partBExactNoEmptyPhiRemainderBinaryBudgetWeightedTerm n f =
      -partBExactNoEmptyPhiRemainderBinaryBudgetWeightedDeficitTerm n f := by
  dsimp [partBExactNoEmptyPhiRemainderBinaryBudgetWeightedTerm,
    partBExactNoEmptyPhiRemainderBinaryBudgetWeightedDeficitTerm]
  let c : ℝ := Real.log 2 / 2
  change
    c * (∑ u : Fin (n + 1),
      (((u.val * (f u).val : ℕ) : ℝ) *
        (threshold n - (1 + 2 / Real.log 2) - u.val))) =
      -(c * (∑ u : Fin (n + 1),
        (((u.val * (f u).val : ℕ) : ℝ) *
          (u.val - (threshold n - (1 + 2 / Real.log 2))))))
  calc
    c * (∑ u : Fin (n + 1),
      (((u.val * (f u).val : ℕ) : ℝ) *
        (threshold n - (1 + 2 / Real.log 2) - u.val))) =
        c * (-(∑ u : Fin (n + 1),
          (((u.val * (f u).val : ℕ) : ℝ) *
            (u.val - (threshold n - (1 + 2 / Real.log 2)))))) := by
          congr 1
          rw [← Finset.sum_neg_distrib]
          refine Finset.sum_congr rfl ?_
          intro u _hu
          ring
    _ = -(c * (∑ u : Fin (n + 1),
        (((u.val * (f u).val : ℕ) : ℝ) *
          (u.val - (threshold n - (1 + 2 / Real.log 2)))))) := by
          ring

lemma partBExactNoEmptyPhiRemainderBinaryBudgetWeightedDeficitTerm_eq_profileFDeficitLower_of_mem
    {n m t : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ coloringProfileFinset n m t) :
    partBExactNoEmptyPhiRemainderBinaryBudgetWeightedDeficitTerm n f =
      partBExactNoEmptyPhiRemainderBinaryBudgetProfileFDeficitLower n f := by
  let C : ℝ := threshold n - (1 + 2 / Real.log 2)
  let L : ℝ := Real.log 2
  have hvertex_nat := profileVertexWeight_eq_of_mem_coloringProfileFinset hf
  have hvertex :
      ∑ u : Fin (n + 1), (((u.val * (f u).val : ℕ) : ℝ)) = (n : ℝ) := by
    exact_mod_cast hvertex_nat
  have hprofile :
      (profileF n (fun u => (f u).val) : ℝ) =
        ∑ u : Fin (n + 1), ((Nat.choose u.val 2 * (f u).val : ℕ) : ℝ) :=
    profileF_eq_sum_choose_mul n f
  have hpoint :
      ∀ u : Fin (n + 1),
        (((u.val * (f u).val : ℕ) : ℝ) * (u.val - C)) =
          2 * ((Nat.choose u.val 2 * (f u).val : ℕ) : ℝ) +
            (1 - C) * (((u.val * (f u).val : ℕ) : ℝ)) := by
    intro u
    rw [Nat.cast_mul, Nat.cast_mul, Nat.cast_choose_two]
    ring
  have hsum :
      ∑ u : Fin (n + 1),
          (((u.val * (f u).val : ℕ) : ℝ) * (u.val - C)) =
        2 * (profileF n (fun u => (f u).val) : ℝ) + (1 - C) * (n : ℝ) := by
    calc
      ∑ u : Fin (n + 1),
          (((u.val * (f u).val : ℕ) : ℝ) * (u.val - C)) =
          ∑ u : Fin (n + 1),
            (2 * ((Nat.choose u.val 2 * (f u).val : ℕ) : ℝ) +
              (1 - C) * (((u.val * (f u).val : ℕ) : ℝ))) := by
            exact Finset.sum_congr rfl (fun u _ => hpoint u)
      _ = 2 * (∑ u : Fin (n + 1),
            ((Nat.choose u.val 2 * (f u).val : ℕ) : ℝ)) +
          (1 - C) * (∑ u : Fin (n + 1), (((u.val * (f u).val : ℕ) : ℝ))) := by
            rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
      _ = 2 * (profileF n (fun u => (f u).val) : ℝ) + (1 - C) * (n : ℝ) := by
            rw [← hprofile, hvertex]
  dsimp [partBExactNoEmptyPhiRemainderBinaryBudgetWeightedDeficitTerm,
    partBExactNoEmptyPhiRemainderBinaryBudgetProfileFDeficitLower]
  change (L / 2) *
      (∑ u : Fin (n + 1), (((u.val * (f u).val : ℕ) : ℝ) * (u.val - C))) =
    L * (profileF n (fun u => (f u).val) : ℝ) +
      (L / 2) * ((n : ℝ) * (1 - C))
  rw [hsum]
  ring

/-- Profile-independent scalar term in the scalar-remainder no-δ `phi + L_0` budget. -/
noncomputable def partBExactNoEmptyPhiRemainderBinaryBudgetGlobalTerm
    (n m : ℕ) : ℝ :=
  (thresholdFloor n : ℝ) * m - n +
    (n : ℝ) * Real.log (Real.log n) / Real.log n +
    Real.log (partBExactNoEmptyBinaryBudgetDenom n)

lemma partBExactNoEmptyPhiRemainderBinaryBudgetScalarRemainderNoDeltaLhs_eq_weighted_add_global
    (n m : ℕ) (f : Fin (n + 1) → Fin (n + 1)) :
    partBExactNoEmptyPhiRemainderBinaryBudgetScalarRemainderNoDeltaLhs n m f =
      partBExactNoEmptyPhiRemainderBinaryBudgetWeightedTerm n f +
        partBExactNoEmptyPhiRemainderBinaryBudgetGlobalTerm n m := by
  dsimp [partBExactNoEmptyPhiRemainderBinaryBudgetScalarRemainderNoDeltaLhs,
    partBExactNoEmptyPhiRemainderBinaryBudgetWeightedTerm,
    partBExactNoEmptyPhiRemainderBinaryBudgetGlobalTerm]
  ring

lemma partBExactNoEmptyPhiRemainderBinaryBudgetExpandedNoDeltaLhs_eq_scalarRemainder_of_mem
    {n m t : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ coloringProfileFinset n m t) :
    partBExactNoEmptyPhiRemainderBinaryBudgetExpandedNoDeltaLhs n f =
