theorem paperPartBTerminalContributionEntropyFloorExactForbiddenUpperWorstMNoDeltaCoarseNPlusTwoTopPenaltyDenomCoeffLowerTarget_of_gapRatioLower
    {B ε : ℝ}
    (hgr :
      PaperPartBTerminalContributionEntropyFloorExactForbiddenUpperWorstMNoDeltaCoarseNPlusTwoTopPenaltyDenomCoeffGapRatioLowerTarget B ε) :
    PaperPartBTerminalContributionEntropyFloorExactForbiddenUpperWorstMNoDeltaCoarseNPlusTwoTopPenaltyDenomCoeffLowerTarget B ε := by
