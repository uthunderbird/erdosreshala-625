    · exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, by simp [hj_zero]⟩
    · exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, by simpa [hj_one] using hone_low⟩
  have hpair_prod :
