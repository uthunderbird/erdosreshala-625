theorem partB_colorCount_mul_threshold_lt_of_lt_terminalLowerEndpoint
    {n m : ℕ} (hm : m < partBTerminalLowerEndpointColorCount n) :
    m * partBThresholdLevel n < n := by
  have ht_pos_nat : 0 < partBThresholdLevel n := partBThresholdLevel_pos n
  have ht_pos_real : (0 : ℝ) < (partBThresholdLevel n : ℝ) := by
    exact_mod_cast ht_pos_nat
  have hm_lt_ceil :
      m < ⌈(n : ℝ) / (partBThresholdLevel n : ℝ)⌉₊ := by
    simpa [partBTerminalLowerEndpointColorCount] using hm
  have hm_lt_div :
      (m : ℝ) < (n : ℝ) / (partBThresholdLevel n : ℝ) :=
    Nat.lt_ceil.mp hm_lt_ceil
  have hmul_real :
      ((m * partBThresholdLevel n : ℕ) : ℝ) < (n : ℝ) := by
    have hmul :=
      mul_lt_mul_of_pos_right hm_lt_div ht_pos_real
    rw [div_mul_cancel₀] at hmul
    · simpa [Nat.cast_mul, mul_comm, mul_left_comm, mul_assoc] using hmul
    · exact ne_of_gt ht_pos_real
  exact_mod_cast hmul_real

