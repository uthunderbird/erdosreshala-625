/-- Cauchy-Schwarz for `∑ C(xᵢ, 2)`, localized here to avoid depending on the
currently experimental `SharpProfileBound.lean` module. -/
private lemma sum_choose_two_ge_k_mul_of_sum_local
    {k n : ℕ} (hk : 0 < k) (x : Fin k → ℕ) (hsum : ∑ i, x i = n) :
    k * Nat.choose (n / k) 2 ≤ ∑ i : Fin k, Nat.choose (x i) 2 := by
  suffices h : (k * Nat.choose (n / k) 2 : ℝ) ≤
      ∑ i : Fin k, (Nat.choose (x i) 2 : ℝ) by exact_mod_cast h
  set q := (n / k : ℕ)
  have hk_pos : (0 : ℝ) < k := Nat.cast_pos.mpr hk
  have hsum_r : ∑ i : Fin k, (x i : ℝ) = n := by push_cast [← hsum]; simp
  have hCS : (n : ℝ) ^ 2 ≤ k * ∑ i : Fin k, (x i : ℝ) ^ 2 := by
    rw [← hsum_r]
    have h := @sq_sum_le_card_mul_sum_sq (Fin k) ℝ _ _ _ _ Finset.univ
      (fun i => (x i : ℝ))
    simpa only [Finset.card_univ, Fintype.card_fin] using h
  have hkq_le : (k : ℝ) * q ≤ n := by exact_mod_cast Nat.mul_div_le n k
  simp_rw [Nat.cast_choose_two]
  suffices hsuff : (k : ℝ) * q * (q - 1) ≤
      ∑ i : Fin k, ((x i : ℝ) * ((x i : ℝ) - 1)) by
    calc (k : ℝ) * ((q : ℝ) * ((q : ℝ) - 1) / 2)
        = k * q * (q - 1) / 2 := by ring
      _ ≤ (∑ i : Fin k, ((x i : ℝ) * ((x i : ℝ) - 1))) / 2 :=
          div_le_div_of_nonneg_right hsuff (by norm_num)
      _ = ∑ i : Fin k, ((x i : ℝ) * ((x i : ℝ) - 1) / 2) := by
          rw [← Finset.sum_div]
  simp_rw [show ∀ i : Fin k, (x i : ℝ) * ((x i : ℝ) - 1) =
      (x i : ℝ) ^ 2 - (x i : ℝ) from fun i => by ring,
    Finset.sum_sub_distrib, hsum_r]
  set S := ∑ i : Fin k, (x i : ℝ) ^ 2
  have hSn : (n : ℝ) ≤ S := by
    calc (n : ℝ) = ∑ i : Fin k, (x i : ℝ) := hsum_r.symm
      _ ≤ S := Finset.sum_le_sum fun i _ => by
          rcases Nat.eq_zero_or_pos (x i) with h | h
          · simp [show (x i : ℝ) = 0 from by exact_mod_cast h]
          · have hxi1 : (1 : ℝ) ≤ (x i : ℝ) := by exact_mod_cast h
            nlinarith
  have hdelta : 0 ≤ (n : ℝ) - k * q := by linarith
  rcases Nat.eq_zero_or_pos (n / k) with hq0 | hq1_nat
  · have hq0r : q = (0 : ℝ) := by exact_mod_cast hq0
    simp only [hq0r, mul_zero, zero_mul]
    linarith
  · have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq1_nat
    have hn_kq_k : (0 : ℝ) ≤ n + k * q - k := by nlinarith
    have h_step1 : (k : ℝ) ^ 2 * q * (q - 1) ≤ n * (n - k) := by
      nlinarith [mul_nonneg hdelta hn_kq_k]
    have h_step2 : (n : ℝ) * (n - k) ≤ k * (S - n) := by nlinarith [hCS]
    nlinarith [le_trans h_step1 h_step2]

private lemma int_le_sq_self (z : ℤ) : z ≤ z ^ 2 := by
  rcases le_or_gt z 0 with hz | hz
  · have hz1 : z - 1 ≤ 0 := by omega
    have hnonneg : 0 ≤ z * (z - 1) := mul_nonneg_of_nonpos_of_nonpos hz hz1
    nlinarith
  · have hz1 : 1 ≤ z := by omega
    have hz0 : 0 ≤ z := by omega
    have hzsub : 0 ≤ z - 1 := by omega
    have hnonneg : 0 ≤ z * (z - 1) := mul_nonneg hz0 hzsub
    nlinarith

/-- Sharp convexity lower bound for `∑ C(xᵢ, 2)`: the minimum at fixed sum is attained
by class sizes differing by at most one. -/
private lemma sum_choose_two_ge_balanced_remainder_of_sum_local
    {k n : ℕ} (_hk : 0 < k) (x : Fin k → ℕ) (hsum : ∑ i, x i = n) :
    partBFiniteWindowBalancedRemainderProfileF n k ≤
      ∑ i : Fin k, Nat.choose (x i) 2 := by
  suffices h : (partBFiniteWindowBalancedRemainderProfileF n k : ℝ) ≤
      ∑ i : Fin k, (Nat.choose (x i) 2 : ℝ) by exact_mod_cast h
  set q := n / k
  set r := n % k
  have hsum_r : ∑ i : Fin k, (x i : ℝ) = n := by
    push_cast [← hsum]
    simp
  have hdivmod_nat : k * q + r = n := by
    simpa [q, r] using Nat.div_add_mod n k
  have hdivmod : (k : ℝ) * (q : ℝ) + (r : ℝ) = (n : ℝ) := by
    exact_mod_cast hdivmod_nat
  have hdev_sum :
      ∑ i : Fin k, ((x i : ℝ) - (q : ℝ)) = (r : ℝ) := by
    rw [Finset.sum_sub_distrib, hsum_r]
    simp
    nlinarith [hdivmod]
  have hdev_sq_ge :
      ∑ i : Fin k, ((x i : ℝ) - (q : ℝ)) ≤
        ∑ i : Fin k, ((x i : ℝ) - (q : ℝ)) ^ 2 := by
    exact Finset.sum_le_sum fun i _ => by
      have hint : ((x i : ℤ) - (q : ℤ)) ≤ ((x i : ℤ) - (q : ℤ)) ^ 2 :=
        int_le_sq_self ((x i : ℤ) - (q : ℤ))
      exact_mod_cast hint
  have hsq_lower :
      (k : ℝ) * (q : ℝ) ^ 2 + (2 * (q : ℝ) + 1) * (r : ℝ) ≤
        ∑ i : Fin k, (x i : ℝ) ^ 2 := by
    have hexpand :
        ∑ i : Fin k, ((x i : ℝ) - (q : ℝ)) ^ 2 =
          ∑ i : Fin k, (x i : ℝ) ^ 2 - 2 * (q : ℝ) * (n : ℝ) +
            (k : ℝ) * (q : ℝ) ^ 2 := by
      calc
        ∑ i : Fin k, ((x i : ℝ) - (q : ℝ)) ^ 2 =
            ∑ i : Fin k, ((x i : ℝ) ^ 2 - 2 * (q : ℝ) * (x i : ℝ) +
              (q : ℝ) ^ 2) := by
              exact Finset.sum_congr rfl (fun i _ => by ring_nf)
        _ = ∑ i : Fin k, (x i : ℝ) ^ 2 - 2 * (q : ℝ) * (n : ℝ) +
              (k : ℝ) * (q : ℝ) ^ 2 := by
              rw [Finset.sum_add_distrib, Finset.sum_sub_distrib]
              have hsum_q :
                  ∑ i : Fin k, 2 * (q : ℝ) * (x i : ℝ) = 2 * (q : ℝ) * (n : ℝ) := by
                rw [← Finset.mul_sum, hsum_r]
              rw [hsum_q]
              simp
    rw [hdev_sum, hexpand] at hdev_sq_ge
    nlinarith [hdivmod]
  have hchoose_sum :
      ∑ i : Fin k, (Nat.choose (x i) 2 : ℝ) =
        (∑ i : Fin k, (x i : ℝ) ^ 2 - (n : ℝ)) / 2 := by
    simp_rw [Nat.cast_choose_two]
    calc
      ∑ i : Fin k, (x i : ℝ) * ((x i : ℝ) - 1) / 2 =
          (∑ i : Fin k, (x i : ℝ) * ((x i : ℝ) - 1)) / 2 := by
            rw [Finset.sum_div]
      _ = (∑ i : Fin k, ((x i : ℝ) ^ 2 - (x i : ℝ))) / 2 := by
            congr 1
            exact Finset.sum_congr rfl (fun i _ => by ring)
      _ = (∑ i : Fin k, (x i : ℝ) ^ 2 - (n : ℝ)) / 2 := by
            rw [Finset.sum_sub_distrib, hsum_r]
  have hbalanced :
      (partBFiniteWindowBalancedRemainderProfileF n k : ℝ) =
        ((k : ℝ) * (q : ℝ) ^ 2 + (2 * (q : ℝ) + 1) * (r : ℝ) - (n : ℝ)) / 2 := by
    dsimp [partBFiniteWindowBalancedRemainderProfileF]
    simp [q, r, Nat.cast_choose_two]
    rw [← hdivmod]
    ring
  rw [hchoose_sum, hbalanced]
  nlinarith

/-- Histogram-to-list transfer for the sharp convexity bound on profile quadratic mass. -/
lemma profileF_ge_balanced_of_mem_coloringProfileFinset
    {n m t : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hm_pos : 0 < m)
    (hf : f ∈ coloringProfileFinset n m t) :
    ((m * Nat.choose (n / m) 2 : ℕ) : ℝ) ≤
      (profileF n (fun u => (f u).val) : ℝ) := by
  let α := Σ u : Fin (n + 1), Fin ((f u).val)
  have hcardα : Fintype.card α = m := by
    calc
      Fintype.card α = ∑ u : Fin (n + 1), (f u).val := by
        simp [α]
      _ = m := profileColorCount_eq_of_mem_coloringProfileFinset hf
  have hcardα_fin : Fintype.card α = Fintype.card (Fin m) := by
    simpa using hcardα
  let e : α ≃ Fin m := Fintype.equivOfCardEq hcardα_fin
  have hsumα :
      ∑ a : α, a.1.val = n := by
    calc
      ∑ a : α, a.1.val =
          ∑ u : Fin (n + 1), (f u).val * u.val := by
        rw [Fintype.sum_sigma]
        simp [Finset.sum_const, mul_comm]
      _ = ∑ u : Fin (n + 1), u.val * (f u).val := by
        refine Finset.sum_congr rfl ?_
        intro u _
        rw [Nat.mul_comm]
      _ = n := profileVertexWeight_eq_of_mem_coloringProfileFinset hf
  have hsum :
      ∑ i : Fin m, (e.symm i).1.val = n := by
    calc
      ∑ i : Fin m, (e.symm i).1.val =
          ∑ a : α, a.1.val := by
        exact (Fintype.sum_equiv e (fun a : α => a.1.val)
          (fun i : Fin m => (e.symm i).1.val) (by intro a; simp [e])).symm
      _ = n := hsumα
  have hchooseα :
      ∑ a : α, Nat.choose a.1.val 2 =
        ∑ u : Fin (n + 1), Nat.choose u.val 2 * (f u).val := by
    calc
      ∑ a : α, Nat.choose a.1.val 2 =
          ∑ u : Fin (n + 1), (f u).val * Nat.choose u.val 2 := by
        rw [Fintype.sum_sigma]
        simp [Finset.sum_const]
      _ = ∑ u : Fin (n + 1), Nat.choose u.val 2 * (f u).val := by
        refine Finset.sum_congr rfl ?_
        intro u _
        rw [Nat.mul_comm]
  have hchoose :
      ∑ i : Fin m, Nat.choose (e.symm i).1.val 2 =
        ∑ u : Fin (n + 1), Nat.choose u.val 2 * (f u).val := by
    calc
      ∑ i : Fin m, Nat.choose (e.symm i).1.val 2 =
          ∑ a : α, Nat.choose a.1.val 2 := by
        exact (Fintype.sum_equiv e (fun a : α => Nat.choose a.1.val 2)
          (fun i : Fin m => Nat.choose (e.symm i).1.val 2) (by intro a; simp [e])).symm
      _ = ∑ u : Fin (n + 1), Nat.choose u.val 2 * (f u).val := hchooseα
  have hsharp :
      m * Nat.choose (n / m) 2 ≤ ∑ i : Fin m, Nat.choose (e.symm i).1.val 2 :=
    sum_choose_two_ge_k_mul_of_sum_local hm_pos (fun i : Fin m => (e.symm i).1.val) hsum
  have hnat :
      m * Nat.choose (n / m) 2 ≤ profileF n (fun u => (f u).val) := by
    simpa [profileF, hchoose] using hsharp
  exact_mod_cast hnat

