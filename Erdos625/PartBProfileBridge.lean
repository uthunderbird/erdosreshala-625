theorem paperPartBExactNoEmptyProfileContributionFixedMTerminalZeroBandHalfBudgetBridgeTarget_of_terminalMemberHalfBudget
    (hterminal :
      PaperPartBExactNoEmptyProfileContributionFixedMTerminalZeroBandMemberHalfBudgetBridgeTarget) :
    PaperPartBExactNoEmptyProfileContributionFixedMTerminalZeroBandHalfBudgetBridgeTarget := by
  intro ε δ hε_pos hδ_pos
  rcases hterminal ε δ hε_pos hδ_pos with ⟨n₀, hterminal⟩
  refine ⟨n₀, fun n hn hmain m hm => ?_⟩
  by_cases hmem : partBTerminalProfile n m ∈ noEmptyProfileTerminalBandFinset n m 0
  · exact (partBExactNoEmptyTerminalZeroBandNormalizedContribution_sum_le_terminal
      hδ_pos n m).trans (hterminal n hn hmain m hm hmem)
  · have hband_empty : noEmptyProfileTerminalBandFinset n m 0 = ∅ := by
      classical
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro f hf
      have hsubset :
          noEmptyProfileTerminalBandFinset n m 0 ⊆ {partBTerminalProfile n m} := by
        intro g hg
        have hg_filter :
            g ∈ (noEmptyColoringProfileFinset n m (partBThresholdLevel n)).filter
              (fun g => partBProfileTerminalL1Distance n m g ≤ 0) := by
          simpa [noEmptyProfileTerminalBandFinset] using hg
        have hdist_le : partBProfileTerminalL1Distance n m g ≤ 0 :=
          (Finset.mem_filter.mp hg_filter).2
        have hdist_zero : partBProfileTerminalL1Distance n m g = 0 :=
          Nat.eq_zero_of_le_zero hdist_le
        simp [partBProfileTerminalL1Distance_eq_zero_iff.mp hdist_zero]
      have hf_single := hsubset hf
      have hf_eq : f = partBTerminalProfile n m := by simpa using hf_single
      subst f
      exact hmem hf
    simp [partBExactNoEmptyTerminalZeroBandRadius, partBExactNoEmptyTerminalHalfBudget,
      hband_empty]

