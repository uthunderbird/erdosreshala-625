  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        partBExactNoEmptyExplicitCoarseCoreCont2Lhs n m f ≤ 0

/-- Scalarized form of the LHS pointwise target. The profile variable has disappeared because the
linearized kernel term is determined by the two profile sums. -/
def PaperPartBExactNoEmptyProfileExplicitCoarseCoreScalarLhsTarget
    (ε : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      partBExactNoEmptyExplicitCoarseCoreScalarLhs n m ≤ 0

/-- Scalarized LHS target with the lower admissibility constraint forced by bounded no-empty
profiles: if every colour class has size at most `t`, then `n <= m*t`. -/
def PaperPartBExactNoEmptyProfileExplicitCoarseCoreConstrainedScalarLhsTarget
    (ε : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      n ≤ m * partBThresholdLevel n →
        partBExactNoEmptyExplicitCoarseCoreScalarLhs n m ≤ 0

theorem paperPartBExactNoEmptyProfileExplicitCoarseCoreCont2LhsPointwiseTarget_of_scalar
    {ε : ℝ}
    (hscalar : PaperPartBExactNoEmptyProfileExplicitCoarseCoreScalarLhsTarget ε) :
    PaperPartBExactNoEmptyProfileExplicitCoarseCoreCont2LhsPointwiseTarget ε := by
  rcases hscalar with ⟨n₀, hscalar⟩
  refine ⟨n₀, fun n hn hmain m hm f hf => ?_⟩
  rw [partBExactNoEmptyExplicitCoarseCoreCont2Lhs_eq_scalar_of_mem hf]
  exact hscalar n hn hmain m hm

theorem paperPartBExactNoEmptyProfileExplicitCoarseCoreCont2LhsPointwiseTarget_of_constrainedScalar
    {ε : ℝ}
    (hscalar :
      PaperPartBExactNoEmptyProfileExplicitCoarseCoreConstrainedScalarLhsTarget ε) :
