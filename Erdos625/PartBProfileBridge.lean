    exact mul_le_mul_of_nonneg_left hB_le (le_of_lt (by simpa [← hA_eq]))
  have hden_pos : 0 < A * B := mul_pos hA_pos hB_pos
  have hinv : 1 / (A' * B') ≤ 1 / (A * B) :=
