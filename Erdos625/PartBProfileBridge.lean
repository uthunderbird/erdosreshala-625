/-- Exact-colour replacement for the unordered obstruction event: the probability that some
surjective class-bounded `m`-coloring exists for `m ≤ k_t - 2` is small. -/
def PaperPartBExactUnorderedFailureEventTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    gnHalf n {G : SimpleGraph (Fin n) |
      ∃ m : ℕ, m ≤ partBPaperObstructionColorCount n ∧
        UnorderedSurjectiveClassBoundedColoringExists n m (partBThresholdLevel n) G} ≤
      ENNReal.ofReal δ

/-- Expectation-union target for the exact-colour repair: the sum of exact-colour quotient-count
expectations over all `m ≤ k_t - 2` is small. -/
def PaperPartBExactUnorderedCountExpectationUnionTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    (∑ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∫⁻ G : SimpleGraph (Fin n),
        (unorderedSurjectiveClassColoringCount n m (partBThresholdLevel n) G : ℝ≥0∞)
          ∂(gnHalf n)) ≤
      ENNReal.ofReal δ

/-- The exact profile comparison plus the summed no-empty profile estimate imply the exact
quotient-count expectation-union target. -/
theorem paperPartBExactUnorderedCountExpectationUnionTarget_of_noEmptyProfileUnion
    (hcompare : PaperPartBExactUnorderedExpectationComparisonTarget)
    {ε δ : ℝ} (hprofiles : PaperPartBExactNoEmptyProfileUnionTarget ε δ) :
    PaperPartBExactUnorderedCountExpectationUnionTarget ε δ := by
  obtain ⟨n₀, hprofiles⟩ := hprofiles
  refine ⟨n₀, ?_⟩
  intro n hn hnMain
  calc
    (∑ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∫⁻ G : SimpleGraph (Fin n),
        (unorderedSurjectiveClassColoringCount n m (partBThresholdLevel n) G : ℝ≥0∞)
          ∂(gnHalf n)) ≤
        ∑ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
          ENNReal.ofReal
            (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
              profileContribution n f) := by
      exact Finset.sum_le_sum (fun m _hm => hcompare n m)
    _ ≤ ENNReal.ofReal δ := hprofiles n hn hnMain

/-- A small sum of exact-colour quotient-count expectations makes the exact-colour union event
rare. -/
theorem paperPartBExactUnorderedFailureEventTarget_of_countExpectationUnion
    {ε δ : ℝ} (hcount : PaperPartBExactUnorderedCountExpectationUnionTarget ε δ) :
    PaperPartBExactUnorderedFailureEventTarget ε δ := by
  obtain ⟨n₀, hcount⟩ := hcount
  refine ⟨n₀, ?_⟩
  intro n hn hnMain
  let K := partBPaperObstructionColorCount n
  let t := partBThresholdLevel n
  let I := Finset.range (K + 1)
  let S : ℕ → Set (SimpleGraph (Fin n)) :=
    fun m => {G : SimpleGraph (Fin n) | UnorderedSurjectiveClassBoundedColoringExists n m t G}
  have hsubset :
      {G : SimpleGraph (Fin n) |
        ∃ m : ℕ, m ≤ K ∧ UnorderedSurjectiveClassBoundedColoringExists n m t G} ⊆
        ⋃ m ∈ I, S m := by
    intro G hG
    simp only [Set.mem_setOf_eq] at hG
    rcases hG with ⟨m, hm, hmG⟩
    refine Set.mem_biUnion ?_ hmG
    simp [I, hm]
  have hmarkov_sum :
      ∑ m ∈ I, gnHalf n (S m) ≤
        ∑ m ∈ I,
          ∫⁻ G : SimpleGraph (Fin n),
            (unorderedSurjectiveClassColoringCount n m t G : ℝ≥0∞) ∂(gnHalf n) := by
    refine Finset.sum_le_sum ?_
    intro m hm
    exact unorderedSurjectiveClassBoundedColoringExists_prob_le_expectedCount n m t
  calc
    gnHalf n {G : SimpleGraph (Fin n) |
        ∃ m : ℕ, m ≤ K ∧ UnorderedSurjectiveClassBoundedColoringExists n m t G} ≤
        gnHalf n (⋃ m ∈ I, S m) :=
      MeasureTheory.measure_mono hsubset
    _ ≤ ∑ m ∈ I, gnHalf n (S m) :=
      MeasureTheory.measure_biUnion_finset_le _ _
    _ ≤ ∑ m ∈ I,
          ∫⁻ G : SimpleGraph (Fin n),
            (unorderedSurjectiveClassColoringCount n m t G : ℝ≥0∞) ∂(gnHalf n) :=
      hmarkov_sum
    _ ≤ ENNReal.ofReal δ := by
      simpa [K, t, I] using hcount n hn hnMain

