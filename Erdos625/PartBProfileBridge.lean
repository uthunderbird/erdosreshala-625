/-- A non-logarithmic normalized envelope proves the normalized contribution target. -/
theorem paperPartBExactNoEmptyProfileContributionFixedMNormalizedContributionTarget_of_envelope
    {W : ℝ → ℝ → (n : ℕ) → ℕ → (Fin (n + 1) → Fin (n + 1)) → ℝ}
    {ε δ : ℝ}
    (hpoint :
      PaperPartBExactNoEmptyProfileContributionFixedMNormalizedEnvelopePointwiseTarget W ε δ)
    (hsum :
      PaperPartBExactNoEmptyProfileContributionFixedMNormalizedEnvelopeSumTarget W ε δ) :
    PaperPartBExactNoEmptyProfileContributionFixedMNormalizedContributionTarget ε δ := by
  rcases hpoint with ⟨n₁, hpoint⟩
  rcases hsum with ⟨n₂, hsum⟩
  refine ⟨max n₁ n₂, fun n hn hmain m hm => ?_⟩
  have hn₁ : n₁ ≤ n := (le_max_left n₁ n₂).trans hn
  have hn₂ : n₂ ≤ n := (le_max_right n₁ n₂).trans hn
  set S := noEmptyColoringProfileFinset n m (partBThresholdLevel n)
  calc
    (∑ f ∈ S, partBExactNoEmptyFixedMNormalizedContribution δ n f)
        ≤ ∑ f ∈ S, W ε δ n m f := by
          exact Finset.sum_le_sum (fun f hf =>
            hpoint n hn₁ hmain m hm f (by simpa [S] using hf))
    _ ≤ 1 := by
      simpa [S] using hsum n hn₂ hmain m hm

/-- Terminal-band and terminal-tail budgets prove the fixed-`m` normalized contribution target. -/
theorem paperPartBExactNoEmptyProfileContributionFixedMNormalizedContributionTarget_of_terminalBandTail
    {D : ℝ → ℝ → ℕ → ℕ → ℕ} {θ : ℝ → ℝ → ℕ → ℕ → ℝ}
    {ε δ : ℝ}
    (hband :
      PaperPartBExactNoEmptyProfileContributionFixedMTerminalBandBudgetTarget D θ ε δ)
    (htail :
      PaperPartBExactNoEmptyProfileContributionFixedMTerminalTailBudgetTarget D θ ε δ) :
    PaperPartBExactNoEmptyProfileContributionFixedMNormalizedContributionTarget ε δ := by
  classical
  rcases hband with ⟨n₁, hband⟩
  rcases htail with ⟨n₂, htail⟩
  refine ⟨max n₁ n₂, fun n hn hmain m hm => ?_⟩
  have hn₁ : n₁ ≤ n := (le_max_left n₁ n₂).trans hn
  have hn₂ : n₂ ≤ n := (le_max_right n₁ n₂).trans hn
  set S := noEmptyColoringProfileFinset n m (partBThresholdLevel n)
  have hsplit :
      (∑ f ∈ S, partBExactNoEmptyFixedMNormalizedContribution δ n f) =
        (∑ f ∈ noEmptyProfileTerminalBandFinset n m (D ε δ n m),
          partBExactNoEmptyFixedMNormalizedContribution δ n f) +
        (∑ f ∈ noEmptyProfileTerminalTailFinset n m (D ε δ n m),
          partBExactNoEmptyFixedMNormalizedContribution δ n f) := by
    have hsplit0 := Finset.sum_filter_add_sum_filter_not
      (s := S)
      (p := fun f => partBProfileTerminalL1Distance n m f ≤ D ε δ n m)
      (f := fun f => partBExactNoEmptyFixedMNormalizedContribution δ n f)
    simpa [noEmptyProfileTerminalBandFinset, noEmptyProfileTerminalTailFinset, S] using hsplit0.symm
  have hsum_le :
      (∑ f ∈ noEmptyProfileTerminalBandFinset n m (D ε δ n m),
        partBExactNoEmptyFixedMNormalizedContribution δ n f) +
      (∑ f ∈ noEmptyProfileTerminalTailFinset n m (D ε δ n m),
        partBExactNoEmptyFixedMNormalizedContribution δ n f) ≤ 1 := by
    have hb := hband n hn₁ hmain m hm
    have ht := htail n hn₂ hmain m hm
    linarith
  simpa [hsplit] using hsum_le

theorem partBExactNoEmptyTerminalZeroBandNormalizedContribution_sum_le_terminal
    {δ : ℝ} (hδ_pos : 0 < δ) (n m : ℕ) :
    (∑ f ∈ noEmptyProfileTerminalBandFinset n m 0,
      partBExactNoEmptyFixedMNormalizedContribution δ n f) ≤
        partBExactNoEmptyFixedMNormalizedContribution δ n (partBTerminalProfile n m) := by
  classical
  set S0 := noEmptyProfileTerminalBandFinset n m 0
  have hsubset : S0 ⊆ {partBTerminalProfile n m} := by
    intro f hf
    have hf_filter :
        f ∈ (noEmptyColoringProfileFinset n m (partBThresholdLevel n)).filter
          (fun f => partBProfileTerminalL1Distance n m f ≤ 0) := by
      simpa [S0, noEmptyProfileTerminalBandFinset] using hf
    have hdist_le : partBProfileTerminalL1Distance n m f ≤ 0 :=
      (Finset.mem_filter.mp hf_filter).2
    have hdist_zero : partBProfileTerminalL1Distance n m f = 0 := by
      exact Nat.eq_zero_of_le_zero hdist_le
    exact by
      simp [partBProfileTerminalL1Distance_eq_zero_iff.mp hdist_zero]
  have hterminal_nonneg :
      0 ≤ partBExactNoEmptyFixedMNormalizedContribution δ n (partBTerminalProfile n m) := by
    dsimp [partBExactNoEmptyFixedMNormalizedContribution, partBExactNoEmptyFixedMInnerBudget]
    exact div_nonneg (profileContribution_nonneg n (partBTerminalProfile n m))
      (div_pos hδ_pos (by positivity)).le
  by_cases hmem : partBTerminalProfile n m ∈ S0
  · have hS0_eq : S0 = {partBTerminalProfile n m} := by
      apply Finset.eq_singleton_iff_unique_mem.mpr
      refine ⟨hmem, ?_⟩
      intro y hy
      have hy_single := hsubset hy
      simpa using hy_single
    simp [S0, hS0_eq]
  · have hS0_empty : S0 = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro f hf
      have hf_single := hsubset hf
      have hf_eq : f = partBTerminalProfile n m := by simpa using hf_single
      subst f
      exact hmem hf
    simp [S0, hS0_empty, hterminal_nonneg]

