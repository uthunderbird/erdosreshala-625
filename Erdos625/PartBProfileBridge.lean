        partBThresholdLevel n * partBEndpointDeficitVectorNearTopPairCountSumNat n e :=
    htail_count.trans (Nat.mul_le_mul_left (partBThresholdLevel n) hcount_pair)
  have htail_pair_real :
      (partBEndpointDeficitVectorNearTopTailMomentSumNat n e : ℝ) ≤
        (partBThresholdLevel n : ℝ) *
          (partBEndpointDeficitVectorNearTopPairCountSumNat n e : ℝ) := by
    exact_mod_cast htail_pair_nat
  have hdiv :
      (partBEndpointDeficitVectorNearTopTailMomentSumNat n e : ℝ) /
          (partBThresholdLevel n : ℝ) ≤
        (partBEndpointDeficitVectorNearTopPairCountSumNat n e : ℝ) := by
    rw [div_le_iff₀ ht_pos]
    simpa [mul_comm] using htail_pair_real
  let p := partBEndpointDeficitVectorNearTopPairCountSumNat n e
  have hsub_cast : (p : ℝ) - 2 ≤ ((p - 2 : ℕ) : ℝ) := by
    by_cases hp : 2 ≤ p
    · have hcast : ((p - 2 : ℕ) : ℝ) + 2 = (p : ℝ) := by
        exact_mod_cast (Nat.sub_add_cancel hp)
      linarith
    · have hp_le : p ≤ 1 := by omega
      have hp_real : (p : ℝ) ≤ 1 := by exact_mod_cast hp_le
      have hnonneg : 0 ≤ ((p - 2 : ℕ) : ℝ) := by positivity
      linarith
  have hleft :
      ((partBEndpointDeficitVectorNearTopTailMomentSumNat n e : ℝ) /
          (partBThresholdLevel n : ℝ)) - 2 ≤
        ((partBEndpointDeficitVectorNearTopPairCountSumNat n e - 2 : ℕ) : ℝ) := by
    dsimp [p] at hsub_cast
    linarith
  have hlog2_nonneg : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
  have hmul :=
    mul_le_mul_of_nonneg_right hleft hlog2_nonneg
  exact hmul.trans (nearTopPairCount_sub_two_logTwo_le_nearTopSymm_log ht3 e)

lemma partBEndpointDeficitVectorFarCountSumNat_le_profileF
    (n : ℕ)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    partBEndpointDeficitVectorFarCountSumNat n e ≤
      partBEndpointDeficitVectorProfileF n e := by
  classical
  rw [partBEndpointDeficitVectorFarCountSumNat,
    partBEndpointDeficitVectorProfileF]
  apply Finset.sum_le_sum
  intro j _hj
  by_cases hfar : 2 ≤ j.val ∧ 2 ≤ partBThresholdLevel n - j.val
  · simp [hfar]
    have hone :
        1 ≤ Nat.choose (partBThresholdLevel n - j.val) 2 :=
      Nat.succ_le_of_lt (Nat.choose_pos hfar.2)
    exact Nat.le_mul_of_pos_left (e j).val hone
  · simp [hfar]

lemma partBEndpointDeficitTailMomentSumNat_profileOfDeficitVector
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    partBEndpointDeficitTailMomentSumNat n htn
      (partBEndpointProfileOfDeficitVector n e) =
