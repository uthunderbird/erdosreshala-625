/-- Normalized closed-vector endpoint coefficient value. Outside the terminal feasibility window
the endpoint vector carrier is not the intended paper object, so the value is set to zero. -/
noncomputable def partBEndpointClosedVectorCoefficientValue (δ : ℝ) (n : ℕ) : ℝ :=
  if hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n) then
    (∑ e ∈ partBEndpointNoEmptyDeficitVectorTerminalEraseFinset n hfeas.2.2.2.2,
      partBEndpointDeficitVectorClosedContribution n e) /
        partBExactNoEmptyFixedMInnerBudget δ n
  else 0

lemma partBEndpointClosedVectorCoefficientValue_eq_endpointDeficitCoefficientValue_of_feasible
    (δ : ℝ) {n : ℕ}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n)) :
    partBEndpointClosedVectorCoefficientValue δ n =
      partBEndpointDeficitCoefficientValue δ n := by
  rw [partBEndpointClosedVectorCoefficientValue]
  simp [hfeas]
  rw [partBEndpointDeficitCoefficientValue_eq_raw_div_fixedMInnerBudget]
  rw [partBEndpointRawDeficitCoefficientValue_eq_vectorClosedTerminalEraseSum hfeas]

def PaperPartBEndpointClosedVectorSaddleHalfBudgetTarget (ε δ : ℝ) : Prop :=
  PaperPartBEndpointDeficitSaddleHalfBudgetTarget
    partBEndpointClosedVectorCoefficientValue ε δ

