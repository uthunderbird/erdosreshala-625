theorem paperPartBExactNoEmptyDenomBinaryControlledLhsDecayTarget_of_lower
    {B : ℝ}
    (hlower : PaperPartBExactNoEmptyDenomBinaryLowerControlledLhsDecayTarget B) :
    PaperPartBExactNoEmptyDenomBinaryControlledLhsDecayTarget (-B) := by
  intro ε A hε_pos
  rcases hlower ε A hε_pos with ⟨n₀, hlower⟩
  refine ⟨n₀, fun n hn hmain m hm hm_pos hm_upper => ?_⟩
  exact hlower n hn hmain m hm hm_pos
    (by simpa [partBPaperAverageClassLowerDenom_eq_negBuffer B n] using hm_upper)

theorem paperPartBExactNoEmptyDenomBinaryBalancedQuadraticUniformDecayTarget_of_lhsDecay
    {C : ℝ}
