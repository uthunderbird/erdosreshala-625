theorem paperPartBExactNoEmptyProfileContributionFixedMTerminalZeroBandMemberHalfBudgetBridgeTarget_of_feasible_necessary
    (hfeasible : PaperPartBTerminalZeroBandMembershipFeasibleBridgeTarget)
    (hnecessary : PaperPartBTerminalContributionFixedMInnerBudgetNecessaryBridgeTarget) :
    PaperPartBExactNoEmptyProfileContributionFixedMTerminalZeroBandMemberHalfBudgetBridgeTarget := by
  intro ε δ hε_pos hδ_pos
  rcases hfeasible ε hε_pos with ⟨n₁, hfeasible⟩
  rcases hnecessary ε (δ / 2) hε_pos (half_pos hδ_pos) with ⟨n₀, hnecessary⟩
  refine ⟨max n₁ n₀, fun n hn hmain m hm hmem => ?_⟩
  have hn₁ : n₁ ≤ n := (le_max_left n₁ n₀).trans hn
  have hn₀ : n₀ ≤ n := (le_max_right n₁ n₀).trans hn
  have hA_pos :
      0 <
        (((Finset.range (partBPaperObstructionColorCount n + 1)).card + 1 : ℕ) : ℝ) := by
    positivity
  have hbudget_pos : 0 < partBExactNoEmptyFixedMInnerBudget δ n := by
    dsimp [partBExactNoEmptyFixedMInnerBudget]
    positivity
  have hcontrib_le :
      profileContribution n (partBTerminalProfile n m) ≤
        (δ / 2) /
          (((Finset.range (partBPaperObstructionColorCount n + 1)).card + 1 : ℕ) : ℝ) :=
    hnecessary n hn₀ hmain m hm (hfeasible n hn₁ hmain m hmem)
  have hhalf_budget :
      (δ / 2) /
          (((Finset.range (partBPaperObstructionColorCount n + 1)).card + 1 : ℕ) : ℝ) =
        partBExactNoEmptyFixedMInnerBudget δ n / 2 := by
    dsimp [partBExactNoEmptyFixedMInnerBudget]
    field_simp [ne_of_gt hA_pos]
  have hcontrib_half :
      profileContribution n (partBTerminalProfile n m) ≤
        partBExactNoEmptyFixedMInnerBudget δ n / 2 := by
    rw [hhalf_budget] at hcontrib_le
    exact hcontrib_le
  dsimp [partBExactNoEmptyFixedMNormalizedContribution]
  rw [div_le_iff₀ hbudget_pos]
  linarith

