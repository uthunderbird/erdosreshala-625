deficit vector directly, before taking a layer maximum. -/
def PaperPartBEndpointClosedVectorTailMomentExpandedLogClosedPointwiseUpperTarget
    (U : ℝ → ℝ → ℕ → ℕ → ℝ) (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n),
      ∀ e ∈ partBEndpointNoEmptyDeficitVectorTerminalEraseFinset n hfeas.2.2.2.2,
        partBEndpointDeficitVectorExpandedLogClosedLhs δ n e ≤
          U ε δ n (partBEndpointDeficitVectorTailMomentSumNat n e)

/-- Component upper bound assembled from a logarithmic partition-count upper term and a lower
bound for the forbidden-edge exponent. The nonnegative symmetry logarithm is intentionally omitted
because it only improves the closed lhs. -/
noncomputable def partBEndpointClosedVectorTailMomentComponentUpper
    (LP LF : ℝ → ℝ → ℕ → ℕ → ℝ) : ℝ → ℝ → ℕ → ℕ → ℝ :=
  fun ε δ n q =>
    LP ε δ n q - LF ε δ n q * Real.log 2 -
      Real.log (partBExactNoEmptyFixedMInnerBudget δ n)

/-- Component upper bound that keeps a lower bound for the symmetry denominator instead of
discarding it as merely nonnegative. -/
noncomputable def partBEndpointClosedVectorTailMomentComponentUpperWithSymm
    (LP LF LS : ℝ → ℝ → ℕ → ℕ → ℝ) : ℝ → ℝ → ℕ → ℕ → ℝ :=
  fun ε δ n q =>
    LP ε δ n q - LF ε δ n q * Real.log 2 - LS ε δ n q -
      Real.log (partBExactNoEmptyFixedMInnerBudget δ n)

def PaperPartBEndpointClosedVectorTailMomentLogPUpperTarget
    (LP : ℝ → ℝ → ℕ → ℕ → ℝ) (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n),
      ∀ e ∈ partBEndpointNoEmptyDeficitVectorTerminalEraseFinset n hfeas.2.2.2.2,
        Real.log (partBEndpointDeficitVectorProfileP n e) ≤
          LP ε δ n (partBEndpointDeficitVectorTailMomentSumNat n e)

def PaperPartBEndpointClosedVectorTailMomentLogSymmLowerTarget
    (LS : ℝ → ℝ → ℕ → ℕ → ℝ) (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n),
      ∀ e ∈ partBEndpointNoEmptyDeficitVectorTerminalEraseFinset n hfeas.2.2.2.2,
        LS ε δ n (partBEndpointDeficitVectorTailMomentSumNat n e) ≤
          Real.log (partBEndpointDeficitVectorProfileSymm n e)

noncomputable def partBEndpointClosedVectorTailMomentFactorialLogPUpper :
    ℝ → ℝ → ℕ → ℕ → ℝ :=
  fun _ε _δ n _q => Real.log (Nat.factorial n)

theorem paperPartBEndpointClosedVectorTailMomentLogPUpperTarget_factorial
    (ε δ : ℝ) :
    PaperPartBEndpointClosedVectorTailMomentLogPUpperTarget
      partBEndpointClosedVectorTailMomentFactorialLogPUpper ε δ := by
  refine ⟨0, fun n _hn _hmain _hfeas e _he => ?_⟩
  dsimp [partBEndpointClosedVectorTailMomentFactorialLogPUpper]
  exact partBEndpointDeficitVectorProfileP_log_le_factorial n e

noncomputable def partBEndpointClosedVectorTailMomentFactorialSubDenomLogPUpper
    (LD : ℝ → ℝ → ℕ → ℕ → ℝ) : ℝ → ℝ → ℕ → ℕ → ℝ :=
  fun ε δ n q => Real.log (Nat.factorial n) - LD ε δ n q

def PaperPartBEndpointClosedVectorTailMomentPDenomLogLowerTarget
    (LD : ℝ → ℝ → ℕ → ℕ → ℝ) (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n),
      ∀ e ∈ partBEndpointNoEmptyDeficitVectorTerminalEraseFinset n hfeas.2.2.2.2,
        LD ε δ n (partBEndpointDeficitVectorTailMomentSumNat n e) ≤
          Real.log (partBEndpointDeficitVectorProfilePDenom n e)

lemma partBEndpointDeficitVectorProfilePDenom_pos
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    0 < partBEndpointDeficitVectorProfilePDenom n e := by
  classical
  rw [partBEndpointDeficitVectorProfilePDenom]
  exact Finset.prod_pos (fun j _ =>
    pow_pos (Nat.factorial_pos (partBThresholdLevel n - j.val)) (e j).val)

lemma one_le_partBEndpointDeficitVectorProfilePDenom
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    1 ≤ partBEndpointDeficitVectorProfilePDenom n e :=
  Nat.succ_le_of_lt (partBEndpointDeficitVectorProfilePDenom_pos n e)

lemma partBEndpointDeficitVectorProfilePDenom_log_nonneg
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    0 ≤ Real.log (partBEndpointDeficitVectorProfilePDenom n e) := by
  exact Real.log_nonneg (by
    exact_mod_cast one_le_partBEndpointDeficitVectorProfilePDenom n e)

noncomputable def partBEndpointDeficitVectorProfilePDenomLogSum
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) : ℝ :=
  ∑ j : Fin (partBThresholdLevel n + 1),
    ((e j).val : ℝ) * Real.log (Nat.factorial (partBThresholdLevel n - j.val))

/-- Exact per-class decay coefficient contributed by forbidden edges and the factorial
denominator in endpoint deficit coordinates. -/
noncomputable def partBEndpointDeficitVectorProfilePDenomClassDecayCoeff
    (n : ℕ) (j : Fin (partBThresholdLevel n + 1)) : ℝ :=
  ((Nat.choose (partBThresholdLevel n - j.val) 2 : ℕ) : ℝ) * Real.log 2 +
    Real.log (Nat.factorial (partBThresholdLevel n - j.val))

/-- The `j = 1` endpoint deficit coordinate. This is always a valid finite index because
`partBThresholdLevel n` is positive. -/
def partBEndpointDeficitVectorOneIndex (n : ℕ) :
    Fin (partBThresholdLevel n + 1) :=
  ⟨1, Nat.succ_lt_succ (partBThresholdLevel_pos n)⟩

/-- Affine tail coefficient left after eliminating the zero- and one-deficit coordinates from
the exact profile/P-denominator class decay. -/
noncomputable def partBEndpointDeficitVectorProfilePDenomAffineTailCoeff
    (n : ℕ) (j : Fin (partBThresholdLevel n + 1)) : ℝ :=
  partBEndpointDeficitVectorProfilePDenomClassDecayCoeff n j -
    partBEndpointDeficitVectorProfilePDenomClassDecayCoeff n 0 +
      (j.val : ℝ) *
        (partBEndpointDeficitVectorProfilePDenomClassDecayCoeff n 0 -
          partBEndpointDeficitVectorProfilePDenomClassDecayCoeff n
            (partBEndpointDeficitVectorOneIndex n))

/-- Constant affine part of the profile/P-denominator decay after the endpoint equations are used.
The remaining variable part is carried by the tail moment. -/
noncomputable def partBEndpointDeficitVectorProfilePDenomAffineBase
    (n : ℕ) : ℝ :=
  partBEndpointDeficitVectorProfilePDenomClassDecayCoeff n 0 *
      (partBPaperObstructionColorCount n : ℝ) -
    (partBEndpointDeficitVectorProfilePDenomClassDecayCoeff n 0 -
        partBEndpointDeficitVectorProfilePDenomClassDecayCoeff n
          (partBEndpointDeficitVectorOneIndex n)) *
      ((partBPaperObstructionColorCount n * partBThresholdLevel n - n : ℕ) : ℝ)

/-- Finite minimum slope supplied by the exact profile/P-denominator affine tail coefficients.
This is a route surface for the small-`q` scalar branch, not yet the final scalar estimate. -/
noncomputable def partBEndpointDeficitVectorProfilePDenomAffineTailSlopeMin
    (n : ℕ) : ℝ :=
  let T : Finset (Fin (partBThresholdLevel n + 1)) :=
    Finset.univ.filter (fun j => 2 ≤ j.val)
  if hT : T.Nonempty then
    (T.image (fun j =>
      partBEndpointDeficitVectorProfilePDenomAffineTailCoeff n j / (j.val : ℝ))).min'
        (hT.image _)
  else 0

/-- Weighted affine tail contribution of an endpoint deficit vector. -/
noncomputable def partBEndpointDeficitVectorProfilePDenomAffineTailWeightedSum
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) : ℝ :=
  ∑ j : Fin (partBThresholdLevel n + 1),
    if 2 ≤ j.val then
      partBEndpointDeficitVectorProfilePDenomAffineTailCoeff n j * ((e j).val : ℝ)
    else 0

/-- Closed affine lower candidate extracted from the exact profile/P-denominator branch. Its
proof obligation is the support inequality for tail coordinates. -/
noncomputable def partBEndpointClosedVectorTailMomentProfilePDenomAffineSupportLower :
    ℝ → ℝ → ℕ → ℕ → ℝ :=
  fun _ε _δ n q =>
    partBEndpointDeficitVectorProfilePDenomAffineBase n +
      partBEndpointDeficitVectorProfilePDenomAffineTailSlopeMin n * (q : ℝ)

/-- Closed affine lower with the checked conservative `(log 2)/2` tail slope. -/
noncomputable def partBEndpointClosedVectorTailMomentProfilePDenomAffineHalfLogSupportLower :
    ℝ → ℝ → ℕ → ℕ → ℝ :=
  fun _ε _δ n q =>
    partBEndpointDeficitVectorProfilePDenomAffineBase n +
      (Real.log 2 / 2) * (q : ℝ)

lemma partBEndpointDeficitVectorProfileF_logTwo_eq_sum_classDecayCoeff_F_part
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    (partBEndpointDeficitVectorProfileF n e : ℝ) * Real.log 2 =
      ∑ j : Fin (partBThresholdLevel n + 1),
        ((e j).val : ℝ) *
          (((Nat.choose (partBThresholdLevel n - j.val) 2 : ℕ) : ℝ) *
            Real.log 2) := by
  classical
  rw [partBEndpointDeficitVectorProfileF, Nat.cast_sum, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro j _hj
  rw [Nat.cast_mul]
  ring

lemma factorial_le_pow_mul_factorial_sub (t j : ℕ) (hj : j ≤ t) :
    Nat.factorial t ≤ t ^ j * Nat.factorial (t - j) := by
  induction j generalizing t with
  | zero => simp
  | succ j ih =>
      cases t with
      | zero => omega
      | succ t =>
          have hjt : j ≤ t := by omega
          have ih_t := ih t hjt
          have hpow_mono : t ^ j ≤ (t + 1) ^ j :=
            Nat.pow_le_pow_left (Nat.le_succ t) j
          have h1 : Nat.factorial t ≤ (t + 1) ^ j * Nat.factorial (t - j) :=
            ih_t.trans (Nat.mul_le_mul_right (Nat.factorial (t - j)) hpow_mono)
          have hmul := Nat.mul_le_mul_left (t + 1) h1
          simpa [Nat.factorial_succ, pow_succ, Nat.succ_sub_succ_eq_sub,
            Nat.mul_assoc, Nat.mul_left_comm, Nat.mul_comm] using hmul

lemma log_factorial_le_mul_log_add_log_factorial_sub
    {t j : ℕ} (ht_pos : 0 < t) (hj : j ≤ t) :
    Real.log (Nat.factorial t) ≤
      (j : ℝ) * Real.log t + Real.log (Nat.factorial (t - j)) := by
  have hle_nat := factorial_le_pow_mul_factorial_sub t j hj
  have hle :
      (Nat.factorial t : ℝ) ≤
        ((t ^ j * Nat.factorial (t - j) : ℕ) : ℝ) := by
    exact_mod_cast hle_nat
  have hfac_pos : 0 < (Nat.factorial t : ℝ) := by positivity
  have hlog := Real.log_le_log hfac_pos hle
  have ht_real_pos : 0 < (t : ℝ) := by exact_mod_cast ht_pos
  have hpow_ne : ((t : ℝ) ^ j) ≠ 0 := pow_ne_zero _ ht_real_pos.ne'
  have hfac_sub_pos : 0 < (Nat.factorial (t - j) : ℝ) := by positivity
  rw [Nat.cast_mul, Nat.cast_pow,
    Real.log_mul hpow_ne hfac_sub_pos.ne', Real.log_pow] at hlog
  simpa [mul_comm] using hlog

lemma partBEndpointDeficitVectorProfilePDenomAffineTailFactorialReserve_nonneg
    {n : ℕ} (j : Fin (partBThresholdLevel n + 1)) :
    0 ≤
      Real.log (Nat.factorial (partBThresholdLevel n - j.val)) -
        Real.log (Nat.factorial (partBThresholdLevel n)) +
          (j.val : ℝ) * Real.log (partBThresholdLevel n) := by
  have hj_le : j.val ≤ partBThresholdLevel n := Nat.le_of_lt_succ j.isLt
  have hlog :=
    log_factorial_le_mul_log_add_log_factorial_sub
      (t := partBThresholdLevel n) (j := j.val)
      (partBThresholdLevel_pos n) hj_le
  linarith

lemma log_factorial_eq_log_add_log_factorial_sub_one {t : ℕ} (ht : 1 ≤ t) :
    Real.log (Nat.factorial t) =
      Real.log t + Real.log (Nat.factorial (t - 1)) := by
  cases t with
  | zero => omega
  | succ t =>
      rw [Nat.factorial_succ]
      rw [show t + 1 - 1 = t by omega]
      rw [Nat.cast_mul]
      have ht_pos : 0 < ((t + 1 : ℕ) : ℝ) := by exact_mod_cast Nat.succ_pos t
      have hfac_pos : 0 < (Nat.factorial t : ℝ) := by positivity
      exact Real.log_mul ht_pos.ne' hfac_pos.ne'

lemma choose_two_half_le (k : ℕ) (hk : 2 ≤ k) :
    (k : ℝ) / 2 ≤ (Nat.choose k 2 : ℝ) := by
  have hnat : k ≤ 2 * Nat.choose k 2 := by
    induction k with
    | zero => omega
    | succ k ih =>
        by_cases hk2 : 2 ≤ k
        · have ihk := ih hk2
          rw [Nat.choose_succ_succ, Nat.choose_one_right]
          nlinarith
        · interval_cases k
          · omega
          · norm_num
  have hreal : (k : ℝ) ≤ 2 * (Nat.choose k 2 : ℝ) := by
    exact_mod_cast hnat
  nlinarith

lemma choose_two_affine_sub_add (t k : ℕ) (hk : k ≤ t) :
    Nat.choose (t - k) 2 + k * (t - 1) =
      Nat.choose t 2 + Nat.choose k 2 := by
  induction k generalizing t with
  | zero => simp
  | succ k ih =>
      cases t with
      | zero => omega
      | succ t =>
          have hkt : k ≤ t := by omega
          have ih_t := ih t hkt
          have harith : k * (t - 1) + t + k = (k + 1) * t := by
            by_cases ht : t = 0
            · subst t
              omega
            · nlinarith [show (t - 1 : ℕ) + 1 = t by omega]
          rw [Nat.succ_sub_succ_eq_sub]
          rw [show t + 1 - 1 = t by omega]
          rw [Nat.choose_succ_succ, Nat.choose_one_right]
          rw [Nat.choose_succ_succ, Nat.choose_one_right]
          rw [show Nat.succ 1 = 2 by rfl]
          omega

lemma partBEndpointDeficitVectorProfilePDenomAffineBase_eq_closedForm
    (n : ℕ) :
    partBEndpointDeficitVectorProfilePDenomAffineBase n =
      (((Nat.choose (partBThresholdLevel n) 2 : ℕ) : ℝ) * Real.log 2 +
          Real.log (Nat.factorial (partBThresholdLevel n))) *
        (partBPaperObstructionColorCount n : ℝ) -
      ((((partBThresholdLevel n - 1 : ℕ) : ℝ) * Real.log 2 +
          Real.log (partBThresholdLevel n)) *
        ((partBPaperObstructionColorCount n * partBThresholdLevel n - n : ℕ) : ℝ)) := by
  let t := partBThresholdLevel n
  have ht_one : 1 ≤ t := Nat.succ_le_of_lt (partBThresholdLevel_pos n)
  have hchoose_one_nat := choose_two_affine_sub_add t 1 ht_one
  have hchoose_one :
      ((Nat.choose (t - 1) 2 : ℕ) : ℝ) + ((t - 1 : ℕ) : ℝ) =
        ((Nat.choose t 2 : ℕ) : ℝ) := by
    have h : Nat.choose (t - 1) 2 + 1 * (t - 1) = Nat.choose t 2 := by
      simpa using hchoose_one_nat
    norm_num at h
    exact_mod_cast h
  have hlog_one := log_factorial_eq_log_add_log_factorial_sub_one ht_one
  dsimp [partBEndpointDeficitVectorProfilePDenomAffineBase,
    partBEndpointDeficitVectorProfilePDenomClassDecayCoeff,
    partBEndpointDeficitVectorOneIndex]
  dsimp [t] at hchoose_one hlog_one
  rw [hlog_one]
  have hchoose_diff :
      ((Nat.choose (partBThresholdLevel n) 2 : ℕ) : ℝ) -
          ((Nat.choose (partBThresholdLevel n - 1) 2 : ℕ) : ℝ) =
        ((partBThresholdLevel n - 1 : ℕ) : ℝ) := by
    linarith [hchoose_one]
  have hdiff :
      (((Nat.choose (partBThresholdLevel n) 2 : ℕ) : ℝ) * Real.log 2 +
          (Real.log (partBThresholdLevel n) +
            Real.log (Nat.factorial (partBThresholdLevel n - 1)))) -
        (((Nat.choose (partBThresholdLevel n - 1) 2 : ℕ) : ℝ) * Real.log 2 +
          Real.log (Nat.factorial (partBThresholdLevel n - 1))) =
        ((partBThresholdLevel n - 1 : ℕ) : ℝ) * Real.log 2 +
          Real.log (partBThresholdLevel n) := by
    calc
      (((Nat.choose (partBThresholdLevel n) 2 : ℕ) : ℝ) * Real.log 2 +
          (Real.log (partBThresholdLevel n) +
            Real.log (Nat.factorial (partBThresholdLevel n - 1)))) -
        (((Nat.choose (partBThresholdLevel n - 1) 2 : ℕ) : ℝ) * Real.log 2 +
          Real.log (Nat.factorial (partBThresholdLevel n - 1))) =
          ((((Nat.choose (partBThresholdLevel n) 2 : ℕ) : ℝ) -
              ((Nat.choose (partBThresholdLevel n - 1) 2 : ℕ) : ℝ)) *
            Real.log 2 +
              Real.log (partBThresholdLevel n)) := by
            ring
      _ = ((partBThresholdLevel n - 1 : ℕ) : ℝ) * Real.log 2 +
          Real.log (partBThresholdLevel n) := by
            rw [hchoose_diff]
  rw [hdiff]

lemma partBEndpointDeficitVectorProfilePDenomAffineTailCoeff_ge_half_logTwo_mul_val
    {n : ℕ} {j : Fin (partBThresholdLevel n + 1)}
    (hj2 : 2 ≤ j.val) :
    (Real.log 2 / 2) * (j.val : ℝ) ≤
      partBEndpointDeficitVectorProfilePDenomAffineTailCoeff n j := by
  let t := partBThresholdLevel n
  let k := j.val
  have hk_le : k ≤ t := Nat.le_of_lt_succ j.isLt
  have ht_one : 1 ≤ t := Nat.succ_le_of_lt (partBThresholdLevel_pos n)
  have hchoose_main_nat := choose_two_affine_sub_add t k hk_le
  have hchoose_one_nat := choose_two_affine_sub_add t 1 ht_one
  have hchoose_main :
      ((Nat.choose (t - k) 2 : ℕ) : ℝ) + ((k * (t - 1) : ℕ) : ℝ) =
        ((Nat.choose t 2 : ℕ) : ℝ) + ((Nat.choose k 2 : ℕ) : ℝ) := by
    exact_mod_cast hchoose_main_nat
  have hchoose_one :
      ((Nat.choose (t - 1) 2 : ℕ) : ℝ) + ((t - 1 : ℕ) : ℝ) =
        ((Nat.choose t 2 : ℕ) : ℝ) := by
    have h : Nat.choose (t - 1) 2 + 1 * (t - 1) = Nat.choose t 2 := by
      simpa using hchoose_one_nat
    norm_num at h
    exact_mod_cast h
  have hchoose_half := choose_two_half_le k (by simpa [k] using hj2)
  have hreserve :=
    partBEndpointDeficitVectorProfilePDenomAffineTailFactorialReserve_nonneg
      (n := n) j
  have hlog_one := log_factorial_eq_log_add_log_factorial_sub_one ht_one
  dsimp [partBEndpointDeficitVectorProfilePDenomAffineTailCoeff,
    partBEndpointDeficitVectorProfilePDenomClassDecayCoeff,
    partBEndpointDeficitVectorOneIndex]
  dsimp [t, k] at hchoose_main hchoose_one hchoose_half hreserve hlog_one
  rw [Nat.cast_mul] at hchoose_main
  have hlog2_nonneg : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
  have hchoose_coeff_eq :
      ((Nat.choose (partBThresholdLevel n - j.val) 2 : ℕ) : ℝ) -
          ((Nat.choose (partBThresholdLevel n) 2 : ℕ) : ℝ) +
          (j.val : ℝ) *
            (((Nat.choose (partBThresholdLevel n) 2 : ℕ) : ℝ) -
              ((Nat.choose (partBThresholdLevel n - 1) 2 : ℕ) : ℝ)) =
        ((Nat.choose j.val 2 : ℕ) : ℝ) := by
    nlinarith
  have hchoose_log_lower :
      (Real.log 2 / 2) * (j.val : ℝ) ≤
        ((Nat.choose (partBThresholdLevel n - j.val) 2 : ℕ) : ℝ) * Real.log 2 -
            ((Nat.choose (partBThresholdLevel n) 2 : ℕ) : ℝ) * Real.log 2 +
            (j.val : ℝ) *
              (((Nat.choose (partBThresholdLevel n) 2 : ℕ) : ℝ) * Real.log 2 -
                ((Nat.choose (partBThresholdLevel n - 1) 2 : ℕ) : ℝ) * Real.log 2) := by
    have hchoose_log_eq :
        ((Nat.choose (partBThresholdLevel n - j.val) 2 : ℕ) : ℝ) * Real.log 2 -
            ((Nat.choose (partBThresholdLevel n) 2 : ℕ) : ℝ) * Real.log 2 +
            (j.val : ℝ) *
              (((Nat.choose (partBThresholdLevel n) 2 : ℕ) : ℝ) * Real.log 2 -
                ((Nat.choose (partBThresholdLevel n - 1) 2 : ℕ) : ℝ) * Real.log 2) =
          ((Nat.choose j.val 2 : ℕ) : ℝ) * Real.log 2 := by
      nlinarith
    rw [hchoose_log_eq]
    have hscaled := mul_le_mul_of_nonneg_right hchoose_half hlog2_nonneg
    nlinarith
  have hlog_part_nonneg :
      0 ≤
        Real.log (Nat.factorial (partBThresholdLevel n - j.val)) -
          Real.log (Nat.factorial (partBThresholdLevel n)) +
          (j.val : ℝ) *
            (Real.log (Nat.factorial (partBThresholdLevel n)) -
              Real.log (Nat.factorial (partBThresholdLevel n - 1))) := by
    nlinarith
  nlinarith

lemma half_logTwo_le_partBEndpointDeficitVectorProfilePDenomAffineTailCoeff_ratio
    {n : ℕ} {j : Fin (partBThresholdLevel n + 1)}
    (hj2 : 2 ≤ j.val) :
    Real.log 2 / 2 ≤
      partBEndpointDeficitVectorProfilePDenomAffineTailCoeff n j / (j.val : ℝ) := by
  have hcoeff :=
    partBEndpointDeficitVectorProfilePDenomAffineTailCoeff_ge_half_logTwo_mul_val
      (n := n) (j := j) hj2
  have hj_pos_nat : 0 < j.val := by omega
  have hj_pos : 0 < (j.val : ℝ) := by exact_mod_cast hj_pos_nat
  have hdiv :=
    div_le_div_of_nonneg_right hcoeff (le_of_lt hj_pos)
  have hcancel :
      (Real.log 2 / 2 * (j.val : ℝ)) / (j.val : ℝ) = Real.log 2 / 2 := by
    field_simp [hj_pos.ne']
  rwa [hcancel] at hdiv

lemma half_logTwo_le_partBEndpointDeficitVectorProfilePDenomAffineTailSlopeMin
    {n : ℕ} (ht_two : 1 < partBThresholdLevel n) :
    Real.log 2 / 2 ≤
      partBEndpointDeficitVectorProfilePDenomAffineTailSlopeMin n := by
  classical
  let T : Finset (Fin (partBThresholdLevel n + 1)) :=
    Finset.univ.filter (fun j => 2 ≤ j.val)
  let j2 : Fin (partBThresholdLevel n + 1) := ⟨2, by omega⟩
  have hj2T : j2 ∈ T := by
    simp [T, j2]
  have hT : T.Nonempty := ⟨j2, hj2T⟩
  have hle_all :
      ∀ y ∈ T.image (fun j =>
          partBEndpointDeficitVectorProfilePDenomAffineTailCoeff n j / (j.val : ℝ)),
        Real.log 2 / 2 ≤ y := by
    intro y hy
    rcases Finset.mem_image.mp hy with ⟨j, hjT, hy_eq⟩
    have hj2 : 2 ≤ j.val := by
      simpa [T] using (Finset.mem_filter.mp hjT).2
    simpa [hy_eq] using
      half_logTwo_le_partBEndpointDeficitVectorProfilePDenomAffineTailCoeff_ratio
        (n := n) (j := j) hj2
  have hmin :=
    Finset.le_min'
