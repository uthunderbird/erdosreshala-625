theorem paperPartBTerminalContributionEntropyFloorExactForbiddenUpperWorstMNoDeltaCoarseNPlusTwoTopPenaltyDenomGapLowerTarget_of_buffer
    {B ε : ℝ}
    (hε_pos : 0 < ε)
    (hB_gap : (2 : ℝ) / Real.log 2 < B + 1) :
    PaperPartBTerminalContributionEntropyFloorExactForbiddenUpperWorstMNoDeltaCoarseNPlusTwoTopPenaltyDenomGapLowerTarget B ε := by
  rcases paperPartBThresholdEventuallyGeNineTarget ε hε_pos with ⟨n₀, hge9⟩
  refine ⟨(B + 1 - (2 : ℝ) / Real.log 2) / 2, ?_, n₀, fun n hn hmain _hD_pos => ?_⟩
  · linarith
  · have hth_ge9 : (9 : ℝ) ≤ threshold n := hge9 n hn hmain
    have hth_nonneg : 0 ≤ threshold n := by linarith
    have hfloor_le : (thresholdFloor n : ℝ) ≤ threshold n := by
      simpa [thresholdFloor] using Nat.floor_le hth_nonneg
    have hfloor_ge9 : 9 ≤ thresholdFloor n := Nat.le_floor hth_ge9
    have hlevel_sub_le :
        partBThresholdLevel n - 1 ≤ thresholdFloor n - 2 := by
      dsimp [partBThresholdLevel]
      omega
