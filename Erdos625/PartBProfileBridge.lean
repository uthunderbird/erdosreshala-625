import Mathlib.Probability.Combinatorics.BinomialRandomGraph.Defs
import Mathlib.Analysis.Real.Pi.Bounds
import Mathlib.Analysis.SpecialFunctions.Log.Base
import Mathlib.Analysis.SpecialFunctions.Pow.Asymptotics
import Erdos625.FirstMomentThreshold

/-!
# Problem 625 — Part B Profile Bridge Targets

This module is a lightweight Lean-facing decomposition for the next honest Part B route.
It deliberately avoids importing `ChromaticConnection` or `RouteD2`, so it can be checked
component-by-component without replaying the full theorem pipeline.

The 2026-05-05 direction audit showed that the old target
`kThresholdWitness n ≤ n / threshold n` has the wrong reciprocal direction relative to the
published estimate `n/k_t = α₀ - 1 - 2/log 2 + o(1)`.

This file therefore does not encode that reciprocal route. It also does not treat the
cochromatic special-profile construction at `k^* = k_t - n^(1-ε/2)` as a proof of the live Part B
small-error axiom. The live target here is narrower and explicit: prove a log-core upper bound for
every profile in the Part B error finset, strong enough to imply the exact
`k! * expectedTBoundedColorings` small-error target.
-/

namespace Problem625

open MeasureTheory ProbabilityTheory ENNReal

open scoped Classical

noncomputable section

/-- Singleton measurability for the finite graph space. This local instance keeps the Part B
bridge component independent of `ChromaticConnection.lean`. -/
private instance instMeasurableSingletonClassSimpleGraph (n : ℕ) :
    MeasurableSingletonClass (SimpleGraph (Fin n)) := by
  constructor
  intro G
  show MeasurableSet {G}
  have heq : ({G} : Set (SimpleGraph (Fin n))) = SimpleGraph.Adj ⁻¹' {G.Adj} := by
    ext H
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    exact ⟨fun h => h ▸ rfl, SimpleGraph.ext⟩
  rw [heq]
  exact SimpleGraph.measurable_adj (MeasurableSet.singleton G.Adj)

/-- Markov bound for the event that at least one class-bounded `k`-coloring exists.

This isolates the ordered-count first-moment shell: the expectation of `classColoringCount` is
`k! * expectedTBoundedColorings n k t`. A genuinely unordered shell must remove or quotient this
factor at the counting layer rather than hiding it in the probability conversion. -/
theorem classBoundedColoringExists_prob_le_factorial_expected
    (n k t : ℕ) (ht : 0 < t) (hk : k ≤ n) :
    gnHalf n {G : SimpleGraph (Fin n) | ClassBoundedColoringExists n k t G} ≤
      ENNReal.ofReal (Nat.factorial k * expectedTBoundedColorings n k t) := by
  have hmarkov :
      gnHalf n {G : SimpleGraph (Fin n) | 1 ≤ classColoringCount n k t G} ≤
        ENNReal.ofReal (Nat.factorial k * expectedTBoundedColorings n k t) := by
    obtain ⟨hint, haeM⟩ := gnHalf_expected_tBoundedColoringCount n k t ht hk
    have hle : gnHalf n {G | 1 ≤ classColoringCount n k t G} ≤
        ∫⁻ G, (classColoringCount n k t G : ℝ≥0∞) ∂(gnHalf n) :=
      MeasureTheory.meas_le_lintegral₀
        (f := fun G => (classColoringCount n k t G : ℝ≥0∞))
        haeM
        (fun G hG => by
          simp only [Set.mem_setOf_eq] at hG
          simp only
          exact_mod_cast hG)
    rw [hint] at hle
    exact hle
  have hset_sub :
      {G : SimpleGraph (Fin n) | ClassBoundedColoringExists n k t G} ⊆
        {G : SimpleGraph (Fin n) | 1 ≤ classColoringCount n k t G} := by
    intro G hG
    simp only [Set.mem_setOf_eq]
    exact (classColoringCount_pos_iff n k t G).mp hG
  exact (MeasureTheory.measure_mono hset_sub).trans hmarkov

/-- Recolor an ordered coloring by a permutation of the color labels. -/
def recolorByPerm {n k : ℕ} (e : Equiv.Perm (Fin k)) (π : Fin n → Fin k) :
    Fin n → Fin k :=
  fun v => e (π v)

/-- Recoloring by a permutation preserves and reflects properness. -/
lemma isProperColoring_recolorByPerm_iff
    {n k : ℕ} (G : SimpleGraph (Fin n)) (e : Equiv.Perm (Fin k)) (π : Fin n → Fin k) :
    IsProperColoring G k (recolorByPerm e π) ↔ IsProperColoring G k π := by
  constructor
  · intro h u v huv heq
    exact h u v huv (by simp [recolorByPerm, heq])
  · intro h u v huv heq
    exact h u v huv (e.injective heq)

/-- A color class after permuting labels is the corresponding original color class. -/
lemma recolorByPerm_colorClass_card
    {n k : ℕ} (e : Equiv.Perm (Fin k)) (π : Fin n → Fin k) (i : Fin k) :
    (Finset.univ.filter (fun v : Fin n => recolorByPerm e π v = i)).card =
      (Finset.univ.filter (fun v : Fin n => π v = e.symm i)).card := by
  congr 1
  ext v
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · intro hv
    simpa [recolorByPerm] using congrArg e.symm hv
  · intro hv
    simp [recolorByPerm, hv]

/-- Class-bounded proper colorings are invariant under permutations of color labels. -/
lemma isClassBoundedProperColoring_recolorByPerm_iff
    {n k t : ℕ} (G : SimpleGraph (Fin n)) (e : Equiv.Perm (Fin k)) (π : Fin n → Fin k) :
    IsClassBoundedProperColoring G k t (recolorByPerm e π) ↔
      IsClassBoundedProperColoring G k t π := by
  constructor
  · intro h
    refine ⟨(isProperColoring_recolorByPerm_iff G e π).mp h.1, ?_⟩
    intro i
    have hcard := recolorByPerm_colorClass_card e π (e i)
    have hbound := h.2 (e i)
    rw [hcard] at hbound
    simpa using hbound
  · intro h
    refine ⟨(isProperColoring_recolorByPerm_iff G e π).mpr h.1, ?_⟩
    intro i
    rw [recolorByPerm_colorClass_card e π i]
    exact h.2 (e.symm i)

/-- Ordered colorings are equivalent when they differ only by a permutation of color labels. -/
def colorPermRel {n k : ℕ} (π σ : Fin n → Fin k) : Prop :=
  ∃ e : Equiv.Perm (Fin k), σ = recolorByPerm e π

lemma colorPermRel_refl {n k : ℕ} (π : Fin n → Fin k) :
    colorPermRel π π := by
  refine ⟨Equiv.refl (Fin k), ?_⟩
  ext v
  rfl

lemma colorPermRel_symm {n k : ℕ} {π σ : Fin n → Fin k} :
    colorPermRel π σ → colorPermRel σ π := by
  rintro ⟨e, rfl⟩
  refine ⟨e.symm, ?_⟩
  ext v
  simp [recolorByPerm]

lemma colorPermRel_trans {n k : ℕ} {π σ τ : Fin n → Fin k} :
    colorPermRel π σ → colorPermRel σ τ → colorPermRel π τ := by
  rintro ⟨e₁, rfl⟩ ⟨e₂, rfl⟩
  refine ⟨e₁.trans e₂, ?_⟩
  ext v
  rfl

/-- Setoid quotienting ordered colorings by permutations of color labels. -/
def colorPermSetoid (n k : ℕ) : Setoid (Fin n → Fin k) where
  r := colorPermRel
  iseqv := by
    refine ⟨?_, ?_, ?_⟩
    · intro π
      exact colorPermRel_refl π
    · intro π σ h
      exact colorPermRel_symm h
    · intro π σ τ hπσ hστ
      exact colorPermRel_trans hπσ hστ

/-- An unordered `k`-coloring, represented as an ordered coloring modulo color-label permutation. -/
def UnorderedColoring (n k : ℕ) : Type :=
  Quot (colorPermSetoid n k)

/-- The unordered coloring represented by an ordered coloring. -/
def unorderedColoringOf {n k : ℕ} (π : Fin n → Fin k) : UnorderedColoring n k :=
  Quot.mk (colorPermSetoid n k) π

lemma unorderedColoringOf_eq_iff_colorPermRel
    {n k : ℕ} {π σ : Fin n → Fin k} :
    unorderedColoringOf π = unorderedColoringOf σ ↔ colorPermRel π σ := by
  constructor
  · intro h
    exact Quotient.exact h
  · intro h
    exact Quotient.sound h

/-- `IsClassBoundedProperColoring` descends to unordered colorings. -/
def IsUnorderedClassBoundedProperColoring
    {n k : ℕ} (G : SimpleGraph (Fin n)) (t : ℕ) (q : UnorderedColoring n k) : Prop :=
  Quot.liftOn q
    (fun π : Fin n → Fin k => IsClassBoundedProperColoring G k t π)
    (fun π σ h => by
      apply propext
      rcases h with ⟨e, rfl⟩
      exact (isClassBoundedProperColoring_recolorByPerm_iff G e π).symm)

lemma isUnorderedClassBoundedProperColoring_mk_iff
    {n k t : ℕ} (G : SimpleGraph (Fin n)) (π : Fin n → Fin k) :
    IsUnorderedClassBoundedProperColoring G t (unorderedColoringOf π) ↔
      IsClassBoundedProperColoring G k t π := by
  rfl

/-- Existence of an unordered class-bounded coloring. -/
def UnorderedClassBoundedColoringExists
    (n k t : ℕ) (G : SimpleGraph (Fin n)) : Prop :=
  ∃ q : UnorderedColoring n k, IsUnorderedClassBoundedProperColoring G t q

/-- Ordered and unordered existence are equivalent; quotienting changes the count, not the event. -/
lemma unorderedClassBoundedColoringExists_iff
    (n k t : ℕ) (G : SimpleGraph (Fin n)) :
    UnorderedClassBoundedColoringExists n k t G ↔ ClassBoundedColoringExists n k t G := by
  constructor
  · rintro ⟨q, hq⟩
    refine Quot.inductionOn q ?_ hq
    intro π hπ
    exact ⟨π, hπ⟩
  · rintro ⟨π, hπ⟩
    exact ⟨unorderedColoringOf π, by simpa using hπ⟩

/-- Count of unordered class-bounded `k`-colorings. -/
noncomputable def unorderedClassColoringCount
    (n k t : ℕ) (G : SimpleGraph (Fin n)) : ℕ :=
  letI : DecidableEq (UnorderedColoring n k) := Classical.decEq _
  letI : DecidablePred (fun π : Fin n → Fin k => IsClassBoundedProperColoring G k t π) :=
    fun _ => Classical.propDecidable _
  ((Finset.univ.filter
    (fun π : Fin n → Fin k => IsClassBoundedProperColoring G k t π)).image
      (fun π => unorderedColoringOf π)).card

/-- The unordered count is positive exactly when an unordered class-bounded coloring exists. -/
lemma unorderedClassColoringCount_pos_iff
    (n k t : ℕ) (G : SimpleGraph (Fin n)) :
    UnorderedClassBoundedColoringExists n k t G ↔
      0 < unorderedClassColoringCount n k t G := by
  letI : DecidableEq (UnorderedColoring n k) := Classical.decEq _
  letI : DecidablePred (fun π : Fin n → Fin k => IsClassBoundedProperColoring G k t π) :=
    fun _ => Classical.propDecidable _
  unfold unorderedClassColoringCount
  rw [Finset.card_pos]
  constructor
  · rintro ⟨q, hq⟩
    refine Quot.inductionOn q ?_ hq
    intro π hπ
    refine ⟨unorderedColoringOf π, ?_⟩
    exact Finset.mem_image.mpr ⟨π, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hπ⟩, rfl⟩
  · rintro ⟨q, hq⟩
    rcases Finset.mem_image.mp hq with ⟨π, hπ, hq_eq⟩
    have hπ_valid : IsClassBoundedProperColoring G k t π := (Finset.mem_filter.mp hπ).2
    refine ⟨q, ?_⟩
    rw [← hq_eq]
    simpa using hπ_valid

lemma unorderedClassColoringCount_pos_iff_orderedExists
    (n k t : ℕ) (G : SimpleGraph (Fin n)) :
    ClassBoundedColoringExists n k t G ↔
      0 < unorderedClassColoringCount n k t G := by
  exact (unorderedClassBoundedColoringExists_iff n k t G).symm.trans
    (unorderedClassColoringCount_pos_iff n k t G)

/-- Exact-colour class-bounded proper coloring: all `k` colours are used. This no-empty variant
matches the profile formula without the empty-colour stabilizer issue. -/
def IsSurjectiveClassBoundedProperColoring
    {n k : ℕ} (G : SimpleGraph (Fin n)) (t : ℕ) (π : Fin n → Fin k) : Prop :=
  IsClassBoundedProperColoring G k t π ∧ Function.Surjective π

lemma surjective_recolorByPerm_iff
    {n k : ℕ} (e : Equiv.Perm (Fin k)) (π : Fin n → Fin k) :
    Function.Surjective (recolorByPerm e π) ↔ Function.Surjective π := by
  constructor
  · intro h j
    obtain ⟨v, hv⟩ := h (e j)
    refine ⟨v, ?_⟩
    exact e.injective (by simpa [recolorByPerm] using hv)
  · intro h j
    obtain ⟨v, hv⟩ := h (e.symm j)
    refine ⟨v, ?_⟩
    simp [recolorByPerm, hv]

/-- The colour-permutation action is free on surjective colourings. -/
lemma recolorByPerm_eq_self_of_surjective
    {n k : ℕ} (e : Equiv.Perm (Fin k)) (π : Fin n → Fin k)
    (hsurj : Function.Surjective π) (hfix : recolorByPerm e π = π) :
    e = 1 := by
  ext i
  rcases hsurj i with ⟨v, hv⟩
  have h_at_v := congrFun hfix v
  exact congrArg Fin.val (by simpa [recolorByPerm, hv] using h_at_v)

/-- A surjective colouring separates colour permutations. -/
lemma recolorByPerm_left_cancel_of_surjective
    {n k : ℕ} (e₁ e₂ : Equiv.Perm (Fin k)) (π : Fin n → Fin k)
    (hsurj : Function.Surjective π)
    (h : recolorByPerm e₁ π = recolorByPerm e₂ π) :
    e₁ = e₂ := by
  ext i
  rcases hsurj i with ⟨v, hv⟩
  have h_at_v := congrFun h v
  exact congrArg Fin.val (by simpa [recolorByPerm, hv] using h_at_v)

/-- The finite colour-permutation orbit of an ordered colouring. -/
noncomputable def colorPermOrbitFinset
    {n k : ℕ} (π : Fin n → Fin k) : Finset (Fin n → Fin k) :=
  Finset.univ.image (fun e : Equiv.Perm (Fin k) => recolorByPerm e π)

lemma mem_colorPermOrbitFinset_iff_unorderedColoringOf_eq
    {n k : ℕ} {π σ : Fin n → Fin k} :
    σ ∈ colorPermOrbitFinset π ↔ unorderedColoringOf π = unorderedColoringOf σ := by
  constructor
  · intro hσ
    rcases Finset.mem_image.mp hσ with ⟨e, _he, hσ_eq⟩
    rw [← hσ_eq]
    exact (unorderedColoringOf_eq_iff_colorPermRel).mpr ⟨e, rfl⟩
  · intro hq
    rcases (unorderedColoringOf_eq_iff_colorPermRel.mp hq) with ⟨e, hσ⟩
    exact Finset.mem_image.mpr ⟨e, Finset.mem_univ _, hσ.symm⟩

/-- A surjective colouring has exactly `k!` distinct colour relabellings. -/
lemma colorPermOrbitFinset_card_eq_factorial_of_surjective
    {n k : ℕ} (π : Fin n → Fin k) (hsurj : Function.Surjective π) :
    (colorPermOrbitFinset π).card = Nat.factorial k := by
  unfold colorPermOrbitFinset
  rw [Finset.card_image_of_injOn]
  · simp [Fintype.card_perm, Fintype.card_fin]
  · intro e₁ _he₁ e₂ _he₂ h
    exact recolorByPerm_left_cancel_of_surjective e₁ e₂ π hsurj h

lemma isSurjectiveClassBoundedProperColoring_recolorByPerm_iff
    {n k t : ℕ} (G : SimpleGraph (Fin n)) (e : Equiv.Perm (Fin k)) (π : Fin n → Fin k) :
    IsSurjectiveClassBoundedProperColoring G t (recolorByPerm e π) ↔
      IsSurjectiveClassBoundedProperColoring G t π := by
  simp [IsSurjectiveClassBoundedProperColoring,
    isClassBoundedProperColoring_recolorByPerm_iff G e π,
    surjective_recolorByPerm_iff e π]

/-- Surjective class-bounded properness descends to unordered colorings. -/
def IsUnorderedSurjectiveClassBoundedProperColoring
    {n k : ℕ} (G : SimpleGraph (Fin n)) (t : ℕ) (q : UnorderedColoring n k) : Prop :=
  Quot.liftOn q
    (fun π : Fin n → Fin k => IsSurjectiveClassBoundedProperColoring G t π)
    (fun π σ h => by
      apply propext
      rcases h with ⟨e, rfl⟩
      exact (isSurjectiveClassBoundedProperColoring_recolorByPerm_iff G e π).symm)

lemma isUnorderedSurjectiveClassBoundedProperColoring_mk_iff
    {n k t : ℕ} (G : SimpleGraph (Fin n)) (π : Fin n → Fin k) :
    IsUnorderedSurjectiveClassBoundedProperColoring G t (unorderedColoringOf π) ↔
      IsSurjectiveClassBoundedProperColoring G t π := by
  rfl

/-- Existence of an exact-colour unordered class-bounded coloring. -/
def UnorderedSurjectiveClassBoundedColoringExists
    (n k t : ℕ) (G : SimpleGraph (Fin n)) : Prop :=
  ∃ q : UnorderedColoring n k, IsUnorderedSurjectiveClassBoundedProperColoring G t q

/-- Ordered and unordered exact-colour existence are equivalent. -/
lemma unorderedSurjectiveClassBoundedColoringExists_iff
    (n k t : ℕ) (G : SimpleGraph (Fin n)) :
    UnorderedSurjectiveClassBoundedColoringExists n k t G ↔
      ∃ π : Fin n → Fin k, IsSurjectiveClassBoundedProperColoring G t π := by
  constructor
  · rintro ⟨q, hq⟩
    refine Quot.inductionOn q ?_ hq
    intro π hπ
    exact ⟨π, hπ⟩
  · rintro ⟨π, hπ⟩
    exact ⟨unorderedColoringOf π, by simpa using hπ⟩

/-- Count of exact-colour unordered class-bounded `k`-colorings. -/
noncomputable def unorderedSurjectiveClassColoringCount
    (n k t : ℕ) (G : SimpleGraph (Fin n)) : ℕ :=
  letI : DecidableEq (UnorderedColoring n k) := Classical.decEq _
  letI : DecidablePred
      (fun π : Fin n → Fin k => IsSurjectiveClassBoundedProperColoring G t π) :=
    fun _ => Classical.propDecidable _
  ((Finset.univ.filter
    (fun π : Fin n → Fin k => IsSurjectiveClassBoundedProperColoring G t π)).image
      (fun π => unorderedColoringOf π)).card

/-- Ordered exact-colour class-bounded colourings as a reusable finite set. -/
noncomputable def surjectiveClassColoringFinset
    (n k t : ℕ) (G : SimpleGraph (Fin n)) : Finset (Fin n → Fin k) :=
  (Finset.univ.filter
    (fun π : Fin n → Fin k => IsSurjectiveClassBoundedProperColoring G t π))

lemma mem_surjectiveClassColoringFinset_iff
    {n k t : ℕ} {G : SimpleGraph (Fin n)} {π : Fin n → Fin k} :
    π ∈ surjectiveClassColoringFinset n k t G ↔
      IsSurjectiveClassBoundedProperColoring G t π := by
  simp [surjectiveClassColoringFinset]

/-- Ordered exact-colour class-bounded colouring count. -/
noncomputable def surjectiveClassColoringCount
    (n k t : ℕ) (G : SimpleGraph (Fin n)) : ℕ :=
  (surjectiveClassColoringFinset n k t G).card

/-- The unordered exact count is bounded by the ordered exact count. -/
lemma unorderedSurjectiveClassColoringCount_le_surjectiveClassColoringCount
    (n k t : ℕ) (G : SimpleGraph (Fin n)) :
    unorderedSurjectiveClassColoringCount n k t G ≤
      surjectiveClassColoringCount n k t G := by
  letI : DecidableEq (UnorderedColoring n k) := Classical.decEq _
  letI : DecidablePred
      (fun π : Fin n → Fin k => IsSurjectiveClassBoundedProperColoring G t π) :=
    fun _ => Classical.propDecidable _
  unfold unorderedSurjectiveClassColoringCount surjectiveClassColoringCount
    surjectiveClassColoringFinset
  exact Finset.card_image_le

/-- The ordered exact count is bounded by the older possibly-empty ordered count. -/
lemma surjectiveClassColoringCount_le_classColoringCount
    (n k t : ℕ) (G : SimpleGraph (Fin n)) :
    surjectiveClassColoringCount n k t G ≤ classColoringCount n k t G := by
  unfold surjectiveClassColoringCount surjectiveClassColoringFinset classColoringCount
  refine Finset.card_le_card ?_
  intro π hπ
  exact Finset.mem_filter.mpr
    ⟨Finset.mem_univ _, (Finset.mem_filter.mp hπ).2.1⟩

/-- Coarse expectation bound for the ordered exact count, inherited from the older ordered count.

This does not yet exploit the no-empty profile restriction; it is a sanity bridge showing the new
exact count is controlled by the already checked first-moment identity. -/
theorem gnHalf_expected_surjectiveClassColoringCount_le_factorial_expected
    (n k t : ℕ) (ht : 0 < t) (hk : k ≤ n) :
    (∫⁻ G : SimpleGraph (Fin n),
      (surjectiveClassColoringCount n k t G : ℝ≥0∞) ∂(gnHalf n)) ≤
      ENNReal.ofReal (Nat.factorial k * expectedTBoundedColorings n k t) := by
  obtain ⟨hclass_expect, _hclass_meas⟩ := gnHalf_expected_tBoundedColoringCount n k t ht hk
  calc
    (∫⁻ G : SimpleGraph (Fin n),
      (surjectiveClassColoringCount n k t G : ℝ≥0∞) ∂(gnHalf n)) ≤
        ∫⁻ G : SimpleGraph (Fin n), (classColoringCount n k t G : ℝ≥0∞) ∂(gnHalf n) := by
      exact lintegral_mono (fun G => by
        exact_mod_cast surjectiveClassColoringCount_le_classColoringCount n k t G)
    _ = ENNReal.ofReal (Nat.factorial k * expectedTBoundedColorings n k t) :=
      hclass_expect

/-- The colour-permutation orbit of an exact valid colouring stays inside the exact valid set. -/
lemma colorPermOrbitFinset_subset_surjectiveClassColoringFinset
    {n k t : ℕ} {G : SimpleGraph (Fin n)} {π : Fin n → Fin k}
    (hπ : IsSurjectiveClassBoundedProperColoring G t π) :
    colorPermOrbitFinset π ⊆ surjectiveClassColoringFinset n k t G := by
  intro σ hσ
  rcases Finset.mem_image.mp hσ with ⟨e, _he, rfl⟩
  rw [mem_surjectiveClassColoringFinset_iff]
  exact (isSurjectiveClassBoundedProperColoring_recolorByPerm_iff G e π).mpr hπ

/-- The exact-valid ordered fibre over a quotient representative is exactly its colour orbit. -/
lemma surjectiveClassColoringFiber_eq_colorPermOrbitFinset
    {n k t : ℕ} {G : SimpleGraph (Fin n)} {π : Fin n → Fin k}
    (hπ : IsSurjectiveClassBoundedProperColoring G t π) :
    (surjectiveClassColoringFinset n k t G).filter
        (fun σ : Fin n → Fin k => unorderedColoringOf σ = unorderedColoringOf π) =
      colorPermOrbitFinset π := by
  ext σ
  constructor
  · intro hσ
    exact (mem_colorPermOrbitFinset_iff_unorderedColoringOf_eq).mpr
      (Finset.mem_filter.mp hσ).2.symm
  · intro hσ
    refine Finset.mem_filter.mpr ⟨?_, ?_⟩
    · exact colorPermOrbitFinset_subset_surjectiveClassColoringFinset hπ hσ
    · exact (mem_colorPermOrbitFinset_iff_unorderedColoringOf_eq.mp hσ).symm

/-- Every exact-valid quotient fibre has cardinality `k!`. -/
lemma surjectiveClassColoringFiber_card_eq_factorial
    {n k t : ℕ} {G : SimpleGraph (Fin n)} {π : Fin n → Fin k}
    (hπ : IsSurjectiveClassBoundedProperColoring G t π) :
    ((surjectiveClassColoringFinset n k t G).filter
        (fun σ : Fin n → Fin k => unorderedColoringOf σ = unorderedColoringOf π)).card =
      Nat.factorial k := by
  rw [surjectiveClassColoringFiber_eq_colorPermOrbitFinset hπ]
  exact colorPermOrbitFinset_card_eq_factorial_of_surjective π hπ.2

/-- Ordered exact colourings split into `k!` representatives per unordered exact colouring. -/
theorem surjectiveClassColoringCount_eq_factorial_mul_unordered
    (n k t : ℕ) (G : SimpleGraph (Fin n)) :
    surjectiveClassColoringCount n k t G =
      Nat.factorial k * unorderedSurjectiveClassColoringCount n k t G := by
  letI : DecidableEq (UnorderedColoring n k) := Classical.decEq _
  letI : DecidablePred
      (fun π : Fin n → Fin k => IsSurjectiveClassBoundedProperColoring G t π) :=
    fun _ => Classical.propDecidable _
  set S := surjectiveClassColoringFinset n k t G
  set qOf : (Fin n → Fin k) → UnorderedColoring n k := fun π => unorderedColoringOf π
  have hpartition :
      S.card = ∑ q ∈ S.image qOf, (S.filter (fun π => qOf π = q)).card :=
    Finset.card_eq_sum_card_image qOf S
  have hfiber :
      ∀ q ∈ S.image qOf, (S.filter (fun π => qOf π = q)).card = Nat.factorial k := by
    intro q hq
    rcases Finset.mem_image.mp hq with ⟨π, hπ_mem, rfl⟩
    have hπ : IsSurjectiveClassBoundedProperColoring G t π :=
      mem_surjectiveClassColoringFinset_iff.mp (by simpa [S] using hπ_mem)
    simpa [qOf, S] using surjectiveClassColoringFiber_card_eq_factorial hπ
  calc
    surjectiveClassColoringCount n k t G = S.card := by
      simp [surjectiveClassColoringCount, S]
    _ = ∑ q ∈ S.image qOf, (S.filter (fun π => qOf π = q)).card := hpartition
    _ = ∑ q ∈ S.image qOf, Nat.factorial k := by
      exact Finset.sum_congr rfl hfiber
    _ = (S.image qOf).card * Nat.factorial k := by
      simp
    _ = Nat.factorial k * unorderedSurjectiveClassColoringCount n k t G := by
      have hcount :
          unorderedSurjectiveClassColoringCount n k t G = (S.image qOf).card := by
        simp [unorderedSurjectiveClassColoringCount, S, qOf, surjectiveClassColoringFinset]
      rw [hcount, Nat.mul_comm]

/-- The exact-colour unordered count is positive exactly when an exact-colour unordered coloring
exists. -/
lemma unorderedSurjectiveClassColoringCount_pos_iff
    (n k t : ℕ) (G : SimpleGraph (Fin n)) :
    UnorderedSurjectiveClassBoundedColoringExists n k t G ↔
      0 < unorderedSurjectiveClassColoringCount n k t G := by
  letI : DecidableEq (UnorderedColoring n k) := Classical.decEq _
  letI : DecidablePred
      (fun π : Fin n → Fin k => IsSurjectiveClassBoundedProperColoring G t π) :=
    fun _ => Classical.propDecidable _
  unfold unorderedSurjectiveClassColoringCount
  rw [Finset.card_pos]
  constructor
  · rintro ⟨q, hq⟩
    refine Quot.inductionOn q ?_ hq
    intro π hπ
    refine ⟨unorderedColoringOf π, ?_⟩
    exact Finset.mem_image.mpr ⟨π, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hπ⟩, rfl⟩
  · rintro ⟨q, hq⟩
    rcases Finset.mem_image.mp hq with ⟨π, hπ, hq_eq⟩
    have hπ_valid : IsSurjectiveClassBoundedProperColoring G t π := (Finset.mem_filter.mp hπ).2
    refine ⟨q, ?_⟩
    rw [← hq_eq]
    simpa using hπ_valid

/-- The exact-colour quotient count is measurable on the finite random-graph sample space. -/
private lemma aemeasurable_unorderedSurjectiveClassColoringCount
    (n k t : ℕ) :
    AEMeasurable
      (fun G : SimpleGraph (Fin n) =>
        (unorderedSurjectiveClassColoringCount n k t G : ℝ≥0∞)) (gnHalf n) := by
  exact AEMeasurable.of_discrete (μ := gnHalf n)

/-- Markov bound for one exact-colour unordered obstruction event. -/
theorem unorderedSurjectiveClassBoundedColoringExists_prob_le_expectedCount
    (n k t : ℕ) :
    gnHalf n {G : SimpleGraph (Fin n) |
      UnorderedSurjectiveClassBoundedColoringExists n k t G} ≤
        ∫⁻ G : SimpleGraph (Fin n),
          (unorderedSurjectiveClassColoringCount n k t G : ℝ≥0∞) ∂(gnHalf n) := by
  have hmarkov :
      gnHalf n {G : SimpleGraph (Fin n) | 1 ≤ unorderedSurjectiveClassColoringCount n k t G} ≤
        ∫⁻ G : SimpleGraph (Fin n),
          (unorderedSurjectiveClassColoringCount n k t G : ℝ≥0∞) ∂(gnHalf n) :=
    MeasureTheory.meas_le_lintegral₀
      (f := fun G : SimpleGraph (Fin n) =>
        (unorderedSurjectiveClassColoringCount n k t G : ℝ≥0∞))
      (aemeasurable_unorderedSurjectiveClassColoringCount n k t)
      (fun G hG => by
        simp only [Set.mem_setOf_eq] at hG
        have hG' :
            ((1 : ℕ) : ℝ≥0∞) ≤
              (unorderedSurjectiveClassColoringCount n k t G : ℝ≥0∞) := by
          exact_mod_cast hG
        simpa using hG')
  have hset_sub :
      {G : SimpleGraph (Fin n) | UnorderedSurjectiveClassBoundedColoringExists n k t G} ⊆
        {G : SimpleGraph (Fin n) | 1 ≤ unorderedSurjectiveClassColoringCount n k t G} := by
    intro G hG
    simp only [Set.mem_setOf_eq]
    exact Nat.succ_le_of_lt ((unorderedSurjectiveClassColoringCount_pos_iff n k t G).mp hG)
  exact (MeasureTheory.measure_mono hset_sub).trans hmarkov

/-- The quotient count is pointwise bounded by the ordered count. -/
lemma unorderedClassColoringCount_le_classColoringCount
    (n k t : ℕ) (G : SimpleGraph (Fin n)) :
    unorderedClassColoringCount n k t G ≤ classColoringCount n k t G := by
  letI : DecidableEq (UnorderedColoring n k) := Classical.decEq _
  letI : DecidablePred (fun π : Fin n → Fin k => IsClassBoundedProperColoring G k t π) :=
    fun _ => Classical.propDecidable _
  unfold unorderedClassColoringCount classColoringCount
  exact Finset.card_image_le

/-- The quotient count is measurable on the finite random-graph sample space. -/
private lemma aemeasurable_unorderedClassColoringCount
    (n k t : ℕ) :
    AEMeasurable
      (fun G : SimpleGraph (Fin n) =>
        (unorderedClassColoringCount n k t G : ℝ≥0∞)) (gnHalf n) := by
  exact AEMeasurable.of_discrete (μ := gnHalf n)

/-- Using only the existing ordered expectation, the unordered-existence event still inherits the
factorial loss. Removing that loss requires a separate expectation theorem for the quotient count. -/
theorem unorderedClassBoundedColoringExists_prob_le_factorial_expected
    (n k t : ℕ) (ht : 0 < t) (hk : k ≤ n) :
    gnHalf n {G : SimpleGraph (Fin n) | UnorderedClassBoundedColoringExists n k t G} ≤
      ENNReal.ofReal (Nat.factorial k * expectedTBoundedColorings n k t) := by
  simpa [unorderedClassBoundedColoringExists_iff]
    using classBoundedColoringExists_prob_le_factorial_expected n k t ht hk

/-- Class-bounded colorability is monotone in the number of available colors. -/
lemma classBoundedColoringExists_mono_k
    {n : ℕ} (G : SimpleGraph (Fin n)) {k₁ k₂ t : ℕ}
    (hle : k₁ ≤ k₂) (h : ClassBoundedColoringExists n k₁ t G) :
    ClassBoundedColoringExists n k₂ t G := by
  obtain ⟨π, hproper, hbound⟩ := h
  refine ⟨fun v => Fin.castLE hle (π v), ?_, ?_⟩
  · intro u v hadj heq
    exact hproper u v hadj (Fin.castLE_injective hle heq)
  · intro i
    by_cases hi : i.val < k₁
    · have : (Finset.univ.filter (fun v : Fin n => Fin.castLE hle (π v) = i)).card =
          (Finset.univ.filter (fun v : Fin n => π v = ⟨i.val, hi⟩)).card := by
        congr 1
        ext v
        simp [Fin.ext_iff, Fin.castLE]
      rw [this]
      exact hbound ⟨i.val, hi⟩
    · push_neg at hi
      have : (Finset.univ.filter (fun v : Fin n => Fin.castLE hle (π v) = i)).card = 0 := by
        rw [Finset.card_eq_zero, Finset.eq_empty_iff_forall_notMem]
        intro v
        simp only [Finset.mem_filter, Finset.mem_univ, true_and]
        intro heq
        have := (π v).isLt
        simp [Fin.ext_iff, Fin.castLE] at heq
        omega
      linarith [Nat.zero_le t]

/-- Any possibly-empty class-bounded `k`-coloring compresses to an exact-colour class-bounded
`m`-coloring for some `m ≤ k`, by retaining only the colours that are actually used. -/
lemma classBoundedColoringExists_to_surjective
    {n k t : ℕ} {G : SimpleGraph (Fin n)}
    (h : ClassBoundedColoringExists n k t G) :
    ∃ m : ℕ, m ≤ k ∧
      ∃ π' : Fin n → Fin m, IsSurjectiveClassBoundedProperColoring G t π' := by
  obtain ⟨π, hproper, hbound⟩ := h
  let used : Finset (Fin k) := Finset.univ.image π
  let m : ℕ := used.card
  let π' : Fin n → Fin m := fun v =>
    used.equivFin ⟨π v, Finset.mem_image.mpr ⟨v, Finset.mem_univ _, rfl⟩⟩
  refine ⟨m, ?_, π', ?_⟩
  · dsimp [m, used]
    calc
      (Finset.univ.image π).card ≤ (Finset.univ (α := Fin k)).card :=
        Finset.card_le_univ _
      _ = k := Fintype.card_fin k
  refine ⟨?_, ?_⟩
  · refine ⟨?_, ?_⟩
    · intro u v huv heq
      have hsub :
          (⟨π u, Finset.mem_image.mpr ⟨u, Finset.mem_univ _, rfl⟩⟩ : used) =
            ⟨π v, Finset.mem_image.mpr ⟨v, Finset.mem_univ _, rfl⟩⟩ :=
        used.equivFin.injective heq
      exact hproper u v huv (congrArg Subtype.val hsub)
    · intro i
      let c : Fin k := (used.equivFin.symm i).val
      have hfilter :
          (Finset.univ.filter (fun v : Fin n => π' v = i)).card =
            (Finset.univ.filter (fun v : Fin n => π v = c)).card := by
        congr 1
        ext v
        simp only [Finset.mem_filter, Finset.mem_univ, true_and]
        constructor
        · intro hv
          have hsub :
              (⟨π v, Finset.mem_image.mpr ⟨v, Finset.mem_univ _, rfl⟩⟩ : used) =
                used.equivFin.symm i := by
            exact used.equivFin.injective (by simpa [π'] using hv)
          exact congrArg Subtype.val hsub
        · intro hv
          have hsub :
              (⟨π v, Finset.mem_image.mpr ⟨v, Finset.mem_univ _, rfl⟩⟩ : used) =
                used.equivFin.symm i :=
            Subtype.ext hv
          change used.equivFin
              (⟨π v, Finset.mem_image.mpr ⟨v, Finset.mem_univ _, rfl⟩⟩ : used) = i
          rw [hsub, Equiv.apply_symm_apply]
      rw [hfilter]
      exact hbound c
  · intro i
    have hi_mem : (used.equivFin.symm i).val ∈ used := (used.equivFin.symm i).property
    rcases Finset.mem_image.mp hi_mem with ⟨v, _hv_univ, hv⟩
    refine ⟨v, ?_⟩
    have hsub :
        (⟨π v, Finset.mem_image.mpr ⟨v, Finset.mem_univ _, rfl⟩⟩ : used) =
          used.equivFin.symm i :=
      Subtype.ext hv
    change used.equivFin
        (⟨π v, Finset.mem_image.mpr ⟨v, Finset.mem_univ _, rfl⟩⟩ : used) = i
    rw [hsub, Equiv.apply_symm_apply]

/-- There is always some class-bounded coloring when the class-size bound is positive. -/
lemma classBoundedColoringExists_nonempty
    {n t : ℕ} (G : SimpleGraph (Fin n)) (ht : 0 < t) :
    {k : ℕ | ClassBoundedColoringExists n k t G}.Nonempty := by
  use max n 1
  have hn_le : n ≤ max n 1 := le_max_left _ _
  refine ⟨fun v => Fin.castLE hn_le v, ?_, ?_⟩
  · intro u v hadj heq
    exact G.ne_of_adj hadj (Fin.castLE_injective hn_le heq)
  · intro i
    by_cases hi : i.val < n
    · have : (Finset.univ.filter (fun v : Fin n => Fin.castLE hn_le v = i)).card = 1 := by
        have heq : (Finset.univ.filter (fun v : Fin n => Fin.castLE hn_le v = i)) = {⟨i.val, hi⟩} := by
          ext v
          simp [Fin.ext_iff, Fin.castLE]
        rw [heq, Finset.card_singleton]
      rw [this]
      exact ht
    · push_neg at hi
      have : (Finset.univ.filter (fun v : Fin n => Fin.castLE hn_le v = i)).card = 0 := by
        rw [Finset.card_eq_zero, Finset.eq_empty_iff_forall_notMem]
        intro v
        simp only [Finset.mem_filter, Finset.mem_univ, true_and]
        intro heq
        have := v.isLt
        simp [Fin.ext_iff, Fin.castLE] at heq
        omega
      rw [this]
      exact Nat.zero_le t

/-- If the class-bounded chromatic number is at most `k`, then a class-bounded `k`-coloring
exists. -/
lemma classBoundedColoringExists_of_chromatic_le
    {n k t : ℕ} (G : SimpleGraph (Fin n)) (ht : 0 < t)
    (hle : classBoundedChromaticNumber n t G ≤ k) :
    ClassBoundedColoringExists n k t G := by
  have hne := classBoundedColoringExists_nonempty G ht
  have hmin : ClassBoundedColoringExists n (classBoundedChromaticNumber n t G) t G := by
    simpa [classBoundedChromaticNumber] using Nat.sInf_mem hne
  exact classBoundedColoringExists_mono_k G hle hmin

/-- The `t = α - 1` level used in the Part B threshold error term. -/
def partBThresholdLevel (n : ℕ) : ℕ :=
  max 1 (thresholdFloor n - 1)

/-- Positivity proof for `partBThresholdLevel`. -/
lemma partBThresholdLevel_pos (n : ℕ) : 0 < partBThresholdLevel n :=
  Nat.lt_of_lt_of_le one_pos (le_max_left 1 _)

/-- The first-moment threshold witness at the Part B level. -/
def kThresholdAlphaMinusOne (n : ℕ) : ℕ :=
  firstMomentThreshold n (partBThresholdLevel n) (partBThresholdLevel_pos n)

/-- The `t = α - 2` level used in the Phase 2 crossing-window route.

    **Tiny-n collapse (red-team P2-1, 2026-05-12).** For very small `n`
    where `thresholdFloor n ≤ 2`, both `partBThresholdLevel n` and
    `kThresholdAlphaMinus2Level n` collapse to `1` via the `max 1 ⋯`,
    and the (α−1) vs (α−2) distinction disappears in that range. This
    is harmless because every downstream theorem and axiom carries an
    `∃ n₀, ∀ n ≥ n₀, …` quantifier that skips this finite prefix.
    Asymptotically `thresholdFloor n ≈ 2·log₂ n`, so the collapse only
    affects `n ≤ a few hundred` (cosmetic). -/
def kThresholdAlphaMinus2Level (n : ℕ) : ℕ :=
  max 1 (thresholdFloor n - 2)

/-- Positivity proof for `kThresholdAlphaMinus2Level`. -/
lemma kThresholdAlphaMinus2Level_pos (n : ℕ) : 0 < kThresholdAlphaMinus2Level n :=
  Nat.lt_of_lt_of_le one_pos (Nat.le_max_left 1 _)

/-- The first-moment threshold at the `α - 2` level. -/
noncomputable def kThresholdAlphaMinus2 (n : ℕ) : ℕ :=
  firstMomentThreshold n (kThresholdAlphaMinus2Level n) (kThresholdAlphaMinus2Level_pos n)

/-- The `k_t - 1` colour count used by the live Part B first-moment error term. -/
def partBErrorColorCount (n : ℕ) : ℕ :=
  kThresholdAlphaMinusOne n - 1

/-- The `k_t - 2` colour count appearing in the paper's first-moment obstruction for proving
`χ_t ≥ k_t - 1`.

This is separate from `partBErrorColorCount` because the current Lean probability shell is still
wired to the stronger ordered-count error term at `k_t - 1`. -/
def partBPaperObstructionColorCount (n : ℕ) : ℕ :=
  kThresholdAlphaMinusOne n - 2

/-- Exact small-error target currently exposed as
`threshold_tBoundedColoringError_le_with_error` in `ChromaticConnection.lean`.

This is the final Part B target that the profile-level `L_0` route must prove. Keeping the
target here avoids accidentally replacing it with the invalid reciprocal witness inequality. -/
def ProfileLevelPartBErrorTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    Nat.factorial (partBErrorColorCount n) *
      expectedTBoundedColorings n (partBErrorColorCount n) (partBThresholdLevel n) ≤ δ

/-- Paper-aligned unordered first-moment obstruction target.

HP Lemma `lowerbound` proves `χ_a ≥ k_a - 1` by showing that the unordered expectation
`E_{n,k_a-2,a}` tends to zero. This is likely the right replacement direction for the current
over-strong ordered `k! * E_{n,k_t-1,t}` live axiom, but it is not wired into the theorem chain yet:
the Lean probability shell must first count unordered colourings or otherwise quotient the current
ordered count. -/
def PaperPartBUnorderedObstructionTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    expectedTBoundedColorings n (partBPaperObstructionColorCount n) (partBThresholdLevel n) ≤ δ

/-- Probability-level lower-bound target corresponding to the Part B class-bounded surface.

This is the target currently obtained from the over-strong ordered shell in
`ChromaticConnection.lean`; the paper-aligned replacement should obtain it from the unordered
obstruction target above. -/
def PaperPartBLowerProbabilityTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    1 - ENNReal.ofReal δ ≤
      gnHalf n {G : SimpleGraph (Fin n) |
        partBErrorColorCount n ≤ classBoundedChromaticNumber n (partBThresholdLevel n) G}

/-- Probability target for the bad complement of `PaperPartBLowerProbabilityTarget`.

This is a useful intermediate shell: it separates the measure-theoretic complement step from the
paper-specific unordered first-moment obstruction. -/
def PaperPartBLowerFailureProbabilityTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    gnHalf n ({G : SimpleGraph (Fin n) |
      partBErrorColorCount n ≤ classBoundedChromaticNumber n (partBThresholdLevel n) G}ᶜ) ≤
      ENNReal.ofReal δ

/-- Event-level unordered obstruction target: the probability that an unordered
`k_t - 2` class-bounded coloring exists is small. -/
def PaperPartBUnorderedFailureEventTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    gnHalf n {G : SimpleGraph (Fin n) |
      UnorderedClassBoundedColoringExists n
        (partBPaperObstructionColorCount n) (partBThresholdLevel n) G} ≤
      ENNReal.ofReal δ

/-- Profiles with no empty colour classes.

This is the profile-side counterpart of the exact/surjective quotient count. Filtering by
`f_0 = 0` removes precisely the empty-label convention that invalidated the direct comparison
between possibly-empty quotient orbits and the paper's full `k!` normalization. -/
def noEmptyColoringProfileFinset (n k t : ℕ) :
    Finset (Fin (n + 1) → Fin (n + 1)) :=
  (coloringProfileFinset n k t).filter
    (fun f => (f ⟨0, Nat.succ_pos n⟩).val = 0)

lemma mem_noEmptyColoringProfileFinset_iff
    {n k t : ℕ} {f : Fin (n + 1) → Fin (n + 1)} :
    f ∈ noEmptyColoringProfileFinset n k t ↔
      f ∈ coloringProfileFinset n k t ∧ (f ⟨0, Nat.succ_pos n⟩).val = 0 := by
  simp [noEmptyColoringProfileFinset]

/-- Crude ambient bound for the number of no-empty profiles.

This is intentionally coarse but robust: it avoids unfolding the profile constraints and is enough
for later logarithmic denominator estimates. -/
lemma noEmptyColoringProfileFinset_card_le_ambient (n k t : ℕ) :
    (noEmptyColoringProfileFinset n k t).card ≤ (n + 1) ^ (n + 1) := by
  calc
    (noEmptyColoringProfileFinset n k t).card ≤
        Fintype.card (Fin (n + 1) → Fin (n + 1)) := Finset.card_le_univ _
    _ = (n + 1) ^ (n + 1) := by
      simp [Fintype.card_fin]

lemma partBExactNoEmptyProfileRange_card (n : ℕ) :
    (Finset.range (partBPaperObstructionColorCount n + 1)).card =
      partBPaperObstructionColorCount n + 1 := by
  simp

/-- A surjective colouring has no colour class of size zero in its profile. -/
lemma coloringProfileOf_zero_eq_zero_of_surjective
    {n k : ℕ} (π : Fin n → Fin k) (hsurj : Function.Surjective π) :
    (coloringProfileOf n k π ⟨0, Nat.succ_pos n⟩).val = 0 := by
  simp only [coloringProfileOf]
  have hnone :
      ((Finset.univ (α := Fin k)).filter
        (fun i => (Finset.univ.filter (fun v : Fin n => π v = i)).card = 0)).card = 0 := by
    rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
    intro i _hi_univ hcard
    rcases hsurj i with ⟨v, hv⟩
    have hv_mem : v ∈ Finset.univ.filter (fun v : Fin n => π v = i) :=
      Finset.mem_filter.mpr ⟨Finset.mem_univ _, hv⟩
    have hpos : 0 < (Finset.univ.filter (fun v : Fin n => π v = i)).card :=
      Finset.card_pos.mpr ⟨v, hv_mem⟩
    omega
  change min
      ((Finset.univ (α := Fin k)).filter
        (fun i => (Finset.univ.filter (fun v : Fin n => π v = i)).card = 0)).card n = 0
  rw [hnone]
  simp

/-- The profile of a surjective class-bounded colouring lies in the no-empty profile finset. -/
lemma coloringProfileOf_mem_noEmptyColoringProfileFinset
    (n k t : ℕ) (π : Fin n → Fin k) (hk : k ≤ n)
    (hbound : ∀ i : Fin k, (Finset.univ.filter (fun v => π v = i)).card ≤ t)
    (hsurj : Function.Surjective π) :
    coloringProfileOf n k π ∈ noEmptyColoringProfileFinset n k t := by
  rw [mem_noEmptyColoringProfileFinset_iff]
  exact ⟨coloringProfileOf_mem_finset n k t π hk hbound,
    coloringProfileOf_zero_eq_zero_of_surjective π hsurj⟩

/-- If the zero-class entry of a profile is zero and `k ≤ n`, the colouring is surjective. -/
lemma surjective_of_coloringProfileOf_zero_eq_zero
    {n k : ℕ} (π : Fin n → Fin k) (hk : k ≤ n)
    (hzero : (coloringProfileOf n k π ⟨0, Nat.succ_pos n⟩).val = 0) :
    Function.Surjective π := by
  intro i
  by_contra hmissing
  push_neg at hmissing
  have hclass_zero : (Finset.univ.filter (fun v : Fin n => π v = i)).card = 0 := by
    rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
    intro v _hv hvi
    exact hmissing v hvi
  let Z : Finset (Fin k) :=
    Finset.univ.filter
      (fun j => (Finset.univ.filter (fun v : Fin n => π v = j)).card = 0)
  have hiZ : i ∈ Z := by
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, hclass_zero⟩
  have hZ_pos : 0 < Z.card := Finset.card_pos.mpr ⟨i, hiZ⟩
  have hZ_le_n : Z.card ≤ n := by
    calc
      Z.card ≤ (Finset.univ (α := Fin k)).card := Finset.card_filter_le _ _
      _ = k := Fintype.card_fin k
      _ ≤ n := hk
  have hprofile_zero : (coloringProfileOf n k π ⟨0, Nat.succ_pos n⟩).val = Z.card := by
    change min
        ((Finset.univ (α := Fin k)).filter
          (fun j => (Finset.univ.filter (fun v : Fin n => π v = j)).card = 0)).card n =
        Z.card
    rw [show ((Finset.univ (α := Fin k)).filter
          (fun j => (Finset.univ.filter (fun v : Fin n => π v = j)).card = 0)).card =
        Z.card from rfl]
    exact Nat.min_eq_left hZ_le_n
  omega

/-- If an ordered colouring has a `t`-bounded profile, then all of its colour classes are
`t`-bounded.

This extracts the boundedness direction needed for exact profile-fiber regrouping. -/
lemma colorClass_card_le_of_coloringProfileOf_eq_mem
    {n k t : ℕ} {π : Fin n → Fin k} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ coloringProfileFinset n k t)
    (hπf : coloringProfileOf n k π = f) :
    ∀ i : Fin k, (Finset.univ.filter (fun v : Fin n => π v = i)).card ≤ t := by
  intro i
  set s := (Finset.univ.filter (fun v : Fin n => π v = i)).card
  by_contra hle
  push_neg at hle
  have hs_lt : s < n + 1 := by
    apply Nat.lt_succ_of_le
    calc
      s ≤ Fintype.card (Fin n) := Finset.card_le_univ _
      _ = n := Fintype.card_fin n
  have hfs0 : (f ⟨s, hs_lt⟩).val = 0 :=
    (mem_coloringProfileFinset_iff.mp hf).2.2 _ hle
  have hpos : 0 < (coloringProfileOf n k π ⟨s, hs_lt⟩).val := by
    simp only [coloringProfileOf]
    apply Nat.pos_of_ne_zero
    intro h
    simp only [Nat.min_eq_zero_iff] at h
    rcases h with hcount_zero | hn_zero
    · have hmem : i ∈ (Finset.univ (α := Fin k)).filter
          (fun j => (Finset.univ.filter (fun v : Fin n => π v = j)).card = s) :=
        Finset.mem_filter.mpr ⟨Finset.mem_univ _, rfl⟩
      have hcard_pos := Finset.card_pos.mpr ⟨i, hmem⟩
      omega
    · omega
  rw [hπf] at hpos
  simp [hfs0] at hpos

/-- Given properness, exact class-bounded validity is equivalent to having a no-empty
`t`-bounded profile. -/
lemma isSurjectiveClassBoundedProperColoring_iff_profile_noEmpty_of_proper
    {n k t : ℕ} {G : SimpleGraph (Fin n)} {π : Fin n → Fin k}
    (hk : k ≤ n) (hproper : IsProperColoring G k π) :
    IsSurjectiveClassBoundedProperColoring G t π ↔
      coloringProfileOf n k π ∈ noEmptyColoringProfileFinset n k t := by
  constructor
  · intro hπ
    exact coloringProfileOf_mem_noEmptyColoringProfileFinset n k t π hk hπ.1.2 hπ.2
  · intro hprof
    rcases mem_noEmptyColoringProfileFinset_iff.mp hprof with ⟨hf, hzero⟩
    refine ⟨⟨hproper, ?_⟩, ?_⟩
    · exact colorClass_card_le_of_coloringProfileOf_eq_mem hf rfl
    · exact surjective_of_coloringProfileOf_zero_eq_zero π hk hzero

lemma surjectiveClassColoringCount_eq_sum
    (n k t : ℕ) (G : SimpleGraph (Fin n)) :
    (surjectiveClassColoringCount n k t G : ℝ≥0∞) =
      ∑ π : Fin n → Fin k,
        if IsSurjectiveClassBoundedProperColoring G t π then 1 else 0 := by
  simp only [surjectiveClassColoringCount, surjectiveClassColoringFinset]
  letI : DecidablePred
      (fun π : Fin n → Fin k => IsSurjectiveClassBoundedProperColoring G t π) :=
    fun _ => Classical.propDecidable _
  rw [Finset.card_eq_sum_ones, Finset.sum_filter]
  push_cast
  rfl

lemma measurableSet_isSurjectiveClassBoundedProperColoring
    (n k t : ℕ) (π : Fin n → Fin k) :
    MeasurableSet
      {G : SimpleGraph (Fin n) | IsSurjectiveClassBoundedProperColoring G t π} := by
  by_cases hsurj : Function.Surjective π
  · have heq :
        {G : SimpleGraph (Fin n) | IsSurjectiveClassBoundedProperColoring G t π} =
          {G : SimpleGraph (Fin n) | IsClassBoundedProperColoring G k t π} := by
      ext G
      simp [IsSurjectiveClassBoundedProperColoring, hsurj]
    rw [heq]
    exact measurableSet_isClassBoundedProperColoring n k t π
  · have heq :
        {G : SimpleGraph (Fin n) | IsSurjectiveClassBoundedProperColoring G t π} = ∅ := by
      ext G
      simp [IsSurjectiveClassBoundedProperColoring, hsurj]
    rw [heq]
    exact MeasurableSet.empty

lemma gnHalf_surjectiveClassBounded_prob (n k t : ℕ) (π : Fin n → Fin k) :
    gnHalf n
        {G : SimpleGraph (Fin n) | IsSurjectiveClassBoundedProperColoring G t π} =
      if (∀ i : Fin k, (Finset.univ.filter (fun v => π v = i)).card ≤ t) ∧
          Function.Surjective π
      then (1 / 2 : ℝ≥0∞) ^ (monoEdgesFinset n k π).card
      else 0 := by
  by_cases hsurj : Function.Surjective π
  · have heq :
        {G : SimpleGraph (Fin n) | IsSurjectiveClassBoundedProperColoring G t π} =
          {G : SimpleGraph (Fin n) | IsClassBoundedProperColoring G k t π} := by
      ext G
      simp [IsSurjectiveClassBoundedProperColoring, hsurj]
    rw [heq, gnHalf_classBounded_prob n k t π]
    by_cases hbound : ∀ i : Fin k, (Finset.univ.filter (fun v => π v = i)).card ≤ t
    · simp [hbound, hsurj]
    · simp [hbound]
  · have heq :
        {G : SimpleGraph (Fin n) | IsSurjectiveClassBoundedProperColoring G t π} = ∅ := by
      ext G
      simp [IsSurjectiveClassBoundedProperColoring, hsurj]
    rw [heq, measure_empty]
    simp [hsurj]

lemma gnHalf_surjective_class_coloring_indicator_measurable
    (n k t : ℕ) (π : Fin n → Fin k) :
    Measurable (fun G : SimpleGraph (Fin n) =>
      ({G' : SimpleGraph (Fin n) |
          IsSurjectiveClassBoundedProperColoring G' t π} : Set _).indicator
        (1 : SimpleGraph (Fin n) → ℝ≥0∞) G) := by
  apply Measurable.indicator
  · exact measurable_const
  · exact measurableSet_isSurjectiveClassBoundedProperColoring n k t π

private lemma sum_monoEdges_surjective_eq_factorial_times_noEmpty_profiles
    (n k t : ℕ) (hk : k ≤ n) :
    ∑ π : Fin n → Fin k,
      (if (∀ i : Fin k, (Finset.univ.filter (fun v => π v = i)).card ≤ t) ∧
            Function.Surjective π
       then (1 / 2 : ℝ≥0∞) ^ (monoEdgesFinset n k π).card
       else 0) =
    (Nat.factorial k : ℝ≥0∞) *
      ENNReal.ofReal
        (∑ f ∈ noEmptyColoringProfileFinset n k t, profileContribution n f) := by
  let validSet := (Finset.univ (α := Fin n → Fin k)).filter
    (fun π =>
      (∀ i : Fin k, (Finset.univ.filter (fun v => π v = i)).card ≤ t) ∧
        Function.Surjective π)
  have hLHS : ∑ π : Fin n → Fin k,
      (if (∀ i : Fin k, (Finset.univ.filter (fun v => π v = i)).card ≤ t) ∧
            Function.Surjective π
       then (1 / 2 : ℝ≥0∞) ^ (monoEdgesFinset n k π).card
       else 0) =
      ∑ π ∈ validSet, (1 / 2 : ℝ≥0∞) ^ (monoEdgesFinset n k π).card := by
    simp only [validSet, Finset.sum_filter]
  rw [hLHS]
  have hmaps : ∀ π ∈ validSet,
      coloringProfileOf n k π ∈ noEmptyColoringProfileFinset n k t := by
    intro π hπ
    exact coloringProfileOf_mem_noEmptyColoringProfileFinset n k t π hk
      (Finset.mem_filter.mp hπ).2.1 (Finset.mem_filter.mp hπ).2.2
  rw [← Finset.sum_fiberwise_of_maps_to hmaps]
  have hvalid_fiber_card : ∀ f ∈ noEmptyColoringProfileFinset n k t,
      (validSet.filter (fun π => coloringProfileOf n k π = f)).card =
      ((Finset.univ (α := Fin n → Fin k)).filter
        (fun π => coloringProfileOf n k π = f)).card := by
    intro f hf
    congr 1
    ext π
    simp only [validSet, Finset.mem_filter, Finset.mem_univ, true_and]
    constructor
    · intro h
      exact h.2
    · intro heq
      rcases mem_noEmptyColoringProfileFinset_iff.mp hf with ⟨hf_all, hzero⟩
      refine ⟨⟨?_, ?_⟩, heq⟩
      · exact colorClass_card_le_of_coloringProfileOf_eq_mem hf_all heq
      · exact surjective_of_coloringProfileOf_zero_eq_zero π hk (by simpa [heq] using hzero)
  have hfiber_eq : ∀ f ∈ noEmptyColoringProfileFinset n k t,
      ∑ π ∈ validSet.filter (fun π => coloringProfileOf n k π = f),
        (1 / 2 : ℝ≥0∞) ^ (monoEdgesFinset n k π).card =
      ENNReal.ofReal
          (Nat.factorial k * profileP n (fun u => (f u).val) /
            profileSymm n (fun u => (f u).val)) *
        (1 / 2 : ℝ≥0∞) ^ profileF n (fun u => (f u).val) := by
    intro f hf
    have hconst : ∀ π ∈ validSet.filter (fun π => coloringProfileOf n k π = f),
        (1 / 2 : ℝ≥0∞) ^ (monoEdgesFinset n k π).card =
        (1 / 2 : ℝ≥0∞) ^ profileF n (fun u => (f u).val) := by
      intro π hπ
      congr 1
      have heq : coloringProfileOf n k π = f := (Finset.mem_filter.mp hπ).2
      rw [monoEdgesFinset_card_eq_profileF n k π]
      congr 1
      exact funext (fun u => congrArg Fin.val (congrFun heq u))
    rw [Finset.sum_congr rfl hconst, Finset.sum_const, nsmul_eq_mul]
    congr 1
    rw [hvalid_fiber_card f hf]
    rw [← ENNReal.ofReal_natCast]
    exact congrArg ENNReal.ofReal
      (fiber_count_eq n k t f (mem_noEmptyColoringProfileFinset_iff.mp hf).1)
  rw [Finset.sum_congr rfl hfiber_eq]
  have h12 : (1 / 2 : ℝ≥0∞) = ENNReal.ofReal (1 / 2 : ℝ) := by
    simp [ENNReal.ofReal_inv_of_pos, ENNReal.ofReal_ofNat]
  have h12nn : (0 : ℝ) ≤ 1 / 2 := by norm_num
  have hterm : ∀ f ∈ noEmptyColoringProfileFinset n k t,
      ENNReal.ofReal
          (Nat.factorial k * profileP n (fun u => (f u).val) /
            profileSymm n (fun u => (f u).val)) *
        (1 / 2 : ℝ≥0∞) ^ profileF n (fun u => (f u).val) =
      (Nat.factorial k : ℝ≥0∞) * ENNReal.ofReal (profileContribution n f) := by
    intro f _hf
    rw [h12, ← ENNReal.ofReal_pow h12nn, ← ENNReal.ofReal_mul (by positivity)]
    rw [show (Nat.factorial k : ℝ≥0∞) = ENNReal.ofReal (Nat.factorial k : ℝ) by simp]
    rw [← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ (Nat.factorial k : ℝ))]
    congr 1
    simp [profileContribution]
    ring_nf
  rw [Finset.sum_congr rfl hterm]
  rw [← Finset.mul_sum]
  rw [← ENNReal.ofReal_sum_of_nonneg (fun f _ => profileContribution_nonneg n f)]

theorem gnHalf_expected_surjectiveClassColoringCount_noEmptyProfileSum
    (n k t : ℕ) (hk : k ≤ n) :
    ∫⁻ G : SimpleGraph (Fin n),
        (surjectiveClassColoringCount n k t G : ℝ≥0∞) ∂(gnHalf n) =
      (Nat.factorial k : ℝ≥0∞) *
        ENNReal.ofReal
          (∑ f ∈ noEmptyColoringProfileFinset n k t, profileContribution n f) := by
  have hif_eq : ∀ π : Fin n → Fin k, ∀ G : SimpleGraph (Fin n),
      (if IsSurjectiveClassBoundedProperColoring G t π then (1 : ℝ≥0∞) else 0) =
        ({G' : SimpleGraph (Fin n) |
          IsSurjectiveClassBoundedProperColoring G' t π} : Set _).indicator 1 G := by
    intro π G
    simp [Set.indicator]
  conv_lhs =>
    arg 2
    ext G
    rw [surjectiveClassColoringCount_eq_sum n k t G]
  simp_rw [hif_eq]
  rw [MeasureTheory.lintegral_finset_sum Finset.univ
    (f := fun π G =>
      ({G' : SimpleGraph (Fin n) |
        IsSurjectiveClassBoundedProperColoring G' t π} : Set _).indicator 1 G)
    (fun π _ => gnHalf_surjective_class_coloring_indicator_measurable n k t π)]
  have hind : ∀ π : Fin n → Fin k,
      ∫⁻ G : SimpleGraph (Fin n),
          ({G' : SimpleGraph (Fin n) |
            IsSurjectiveClassBoundedProperColoring G' t π} : Set _).indicator 1 G
            ∂(gnHalf n) =
        gnHalf n {G | IsSurjectiveClassBoundedProperColoring G t π} := by
    intro π
    exact lintegral_indicator_one
      (measurableSet_isSurjectiveClassBoundedProperColoring n k t π)
  simp_rw [hind]
  conv_lhs =>
    arg 2
    ext π
    rw [gnHalf_surjectiveClassBounded_prob n k t π]
  exact sum_monoEdges_surjective_eq_factorial_times_noEmpty_profiles n k t hk

/-- Exact-colour expectation comparison against no-empty profile sums.

This is now the active counting theorem for the empty-colour repair: prove that the expectation of
the unordered surjective quotient count is bounded by the corresponding no-empty profile
contribution sum. -/
def PaperPartBExactUnorderedExpectationComparisonTarget : Prop :=
  ∀ n m : ℕ,
    (∫⁻ G : SimpleGraph (Fin n),
      (unorderedSurjectiveClassColoringCount n m (partBThresholdLevel n) G : ℝ≥0∞)
        ∂(gnHalf n)) ≤
      ENNReal.ofReal
        (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
          profileContribution n f)

/-- Ordered exact-colour expectation comparison against no-empty profile sums.

This is the form most directly reachable by regrouping ordered colourings by no-empty profile.
The checked orbit-normalization theorem below then cancels the finite `m!` factor and recovers the
unordered comparison target. -/
def PaperPartBExactOrderedExpectationComparisonTarget : Prop :=
  ∀ n m : ℕ,
    (∫⁻ G : SimpleGraph (Fin n),
      (surjectiveClassColoringCount n m (partBThresholdLevel n) G : ℝ≥0∞)
        ∂(gnHalf n)) ≤
      (Nat.factorial m : ℝ≥0∞) *
        ENNReal.ofReal
          (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
            profileContribution n f)

theorem paperPartBExactOrderedExpectationComparisonTarget_proved :
    PaperPartBExactOrderedExpectationComparisonTarget := by
  intro n m
  by_cases hm : m ≤ n
  · rw [gnHalf_expected_surjectiveClassColoringCount_noEmptyProfileSum n m
      (partBThresholdLevel n) hm]
  · have hnosurj : ∀ π : Fin n → Fin m, ¬ Function.Surjective π := by
      intro π hπ
      have hcard := Fintype.card_le_of_surjective π hπ
      simp only [Fintype.card_fin] at hcard
      omega
    have hpoint : ∀ G : SimpleGraph (Fin n),
        (surjectiveClassColoringCount n m (partBThresholdLevel n) G : ℝ≥0∞) = 0 := by
      intro G
      have hcard0 : surjectiveClassColoringCount n m (partBThresholdLevel n) G = 0 := by
        unfold surjectiveClassColoringCount surjectiveClassColoringFinset
        rw [Finset.card_eq_zero]
        apply Finset.eq_empty_iff_forall_notMem.mpr
        intro π hπ
        exact hnosurj π (Finset.mem_filter.mp hπ).2.2
      simp [hcard0]
    calc
      (∫⁻ G : SimpleGraph (Fin n),
        (surjectiveClassColoringCount n m (partBThresholdLevel n) G : ℝ≥0∞)
          ∂(gnHalf n)) = ∫⁻ _G : SimpleGraph (Fin n), (0 : ℝ≥0∞) ∂(gnHalf n) := by
          exact lintegral_congr_ae (Filter.Eventually.of_forall hpoint)
      _ ≤ (Nat.factorial m : ℝ≥0∞) *
          ENNReal.ofReal
            (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
              profileContribution n f) := by
        simp

/-- The ordered exact expectation comparison implies the unordered exact comparison by cancelling
the checked `m!` orbit factor. -/
theorem paperPartBExactUnorderedExpectationComparisonTarget_of_ordered
    (hordered : PaperPartBExactOrderedExpectationComparisonTarget) :
    PaperPartBExactUnorderedExpectationComparisonTarget := by
  intro n m
  let c : ℝ≥0∞ := (Nat.factorial m : ℝ≥0∞)
  let U : SimpleGraph (Fin n) → ℝ≥0∞ :=
    fun G => (unorderedSurjectiveClassColoringCount n m (partBThresholdLevel n) G : ℝ≥0∞)
  let O : SimpleGraph (Fin n) → ℝ≥0∞ :=
    fun G => (surjectiveClassColoringCount n m (partBThresholdLevel n) G : ℝ≥0∞)
  have hpoint : ∀ G : SimpleGraph (Fin n), O G = c * U G := by
    intro G
    have hnat := surjectiveClassColoringCount_eq_factorial_mul_unordered
      n m (partBThresholdLevel n) G
    simp [O, U, c, hnat, Nat.cast_mul]
  have hlin :
      (∫⁻ G : SimpleGraph (Fin n), O G ∂(gnHalf n)) =
        c * ∫⁻ G : SimpleGraph (Fin n), U G ∂(gnHalf n) := by
    calc
      (∫⁻ G : SimpleGraph (Fin n), O G ∂(gnHalf n)) =
          ∫⁻ G : SimpleGraph (Fin n), c * U G ∂(gnHalf n) := by
        exact lintegral_congr_ae (Filter.Eventually.of_forall hpoint)
      _ = c * ∫⁻ G : SimpleGraph (Fin n), U G ∂(gnHalf n) := by
        exact MeasureTheory.lintegral_const_mul' c U (by simp [c])
  have hc0 : c ≠ 0 := by
    simp [c, Nat.factorial_ne_zero]
  have hctop : c ≠ ∞ := by simp [c]
  have hmul :
      c * (∫⁻ G : SimpleGraph (Fin n), U G ∂(gnHalf n)) ≤
        c *
          ENNReal.ofReal
            (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
              profileContribution n f) := by
    rw [← hlin]
    exact hordered n m
  exact (ENNReal.mul_le_mul_iff_right hc0 hctop).mp hmul

theorem paperPartBExactUnorderedExpectationComparisonTarget_proved :
    PaperPartBExactUnorderedExpectationComparisonTarget :=
  paperPartBExactUnorderedExpectationComparisonTarget_of_ordered
    paperPartBExactOrderedExpectationComparisonTarget_proved

/-- Summed no-empty profile target at the paper obstruction level. -/
def PaperPartBExactNoEmptyProfileUnionTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    (∑ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ENNReal.ofReal
        (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
          profileContribution n f)) ≤ ENNReal.ofReal δ

/-- Inner-budget version of the summed no-empty profile target.

This is a bookkeeping surface: it reduces the finite `m ≤ k_t - 2` union to a uniform budget for
each exact colour count. -/
def PaperPartBExactNoEmptyProfileInnerBudgetTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ENNReal.ofReal
        (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
          profileContribution n f) ≤
        ENNReal.ofReal
          (δ / (((Finset.range (partBPaperObstructionColorCount n + 1)).card + 1 : ℕ) : ℝ))

/-- Real-valued fixed-`m` inner budget. This is the natural target for summed/log-sum-exp
estimates over profiles with a fixed exact colour count. -/
def PaperPartBExactNoEmptyProfileRealInnerBudgetTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        profileContribution n f) ≤
      δ / (((Finset.range (partBPaperObstructionColorCount n + 1)).card + 1 : ℕ) : ℝ)

/-- Logarithmic fixed-`m` inner budget. This keeps the exact profile sum, rather than forcing a
pointwise profile budget through a global profile-count denominator. The zero alternative avoids
the `Real.log 0 = 0` artifact on impossible exact-colour counts. -/
def PaperPartBExactNoEmptyProfileContributionLogSumInnerBudgetTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        profileContribution n f) = 0 ∨
        Real.log
            (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
              profileContribution n f) ≤
          Real.log
            (δ / (((Finset.range (partBPaperObstructionColorCount n + 1)).card + 1 : ℕ) : ℝ))

/-- A non-uniform logarithmic envelope for profile contributions.  The envelope may depend on
`ε, δ, n, m` and the profile; the companion sum target below is responsible for proving that the
resulting local Laplace sum is small. -/
def PaperPartBExactNoEmptyProfileContributionLogEnvelopePointwiseTarget
    (E : ℝ → ℝ → (n : ℕ) → ℕ → (Fin (n + 1) → Fin (n + 1)) → ℝ)
    (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        Real.log (profileContribution n f) ≤ E ε δ n m f

/-- Fixed-`m` envelope-sum budget. Together with the pointwise envelope target, this is a
Lean-facing formulation of the non-uniform log-sum route: prove a sharp upper envelope and sum its
exponential, rather than assigning every profile an equal share of the budget. -/
def PaperPartBExactNoEmptyProfileContributionLogEnvelopeSumTarget
    (E : ℝ → ℝ → (n : ℕ) → ℕ → (Fin (n + 1) → Fin (n + 1)) → ℝ)
    (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        Real.exp (E ε δ n m f)) = 0 ∨
        Real.log
            (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
              Real.exp (E ε δ n m f)) ≤
          Real.log
            (δ / (((Finset.range (partBPaperObstructionColorCount n + 1)).card + 1 : ℕ) : ℝ))

/-- Pointwise no-empty profile budget strong enough for the inner-budget target. -/
def PaperPartBExactNoEmptyProfilePointwiseTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        profileContribution n f ≤
          δ /
            ((((Finset.range (partBPaperObstructionColorCount n + 1)).card + 1 : ℕ) : ℝ) *
              (((noEmptyColoringProfileFinset n m (partBThresholdLevel n)).card + 1 : ℕ) : ℝ))

/-- Raw per-profile budget for the exact no-empty profile union. -/
noncomputable def partBExactNoEmptyRawProfileBudget (δ : ℝ) (n m : ℕ) : ℝ :=
  δ /
    ((((Finset.range (partBPaperObstructionColorCount n + 1)).card + 1 : ℕ) : ℝ) *
      (((noEmptyColoringProfileFinset n m (partBThresholdLevel n)).card + 1 : ℕ) : ℝ))

/-- Fixed-`m` budget used by the summed no-empty profile route. Unlike
`partBExactNoEmptyRawProfileBudget`, this does not divide by the number of profiles. -/
noncomputable def partBExactNoEmptyFixedMInnerBudget (δ : ℝ) (n : ℕ) : ℝ :=
  δ / (((Finset.range (partBPaperObstructionColorCount n + 1)).card + 1 : ℕ) : ℝ)

/-- Direct logarithmic contribution target. This keeps the exact `profileContribution` expression
as the object to estimate, rather than passing through the coarser log-core surfaces. -/
def PaperPartBExactNoEmptyProfileContributionLogPointwiseTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        Real.log (profileContribution n f) ≤
          Real.log (partBExactNoEmptyRawProfileBudget δ n m)

/-- Exact expanded logarithmic LHS for the direct contribution target.

This preserves the `-log(profileSymm)` term rather than discarding it into the older log-core
surfaces. -/
noncomputable def partBExactNoEmptyContributionLogExpandedLhs
    (δ : ℝ) (n m : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  Real.log (profileP n (fun u => (f u).val)) -
    ((profileF n (fun u => (f u).val) : ℝ) * Real.log 2) -
    Real.log (profileSymm n (fun u => (f u).val)) -
    Real.log (partBExactNoEmptyRawProfileBudget δ n m)

/-- Expanded contribution logarithm normalized by the fixed-`m` budget. This is the concrete
Laplace-sum surface for the replacement route: the profile sum is controlled by summing
`exp(log contribution - log fixed-m budget)` over the exact-colour profile class. -/
noncomputable def partBExactNoEmptyContributionLogFixedMExpandedLhs
    (δ : ℝ) (n _m : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  Real.log (profileP n (fun u => (f u).val)) -
    ((profileF n (fun u => (f u).val) : ℝ) * Real.log 2) -
    Real.log (profileSymm n (fun u => (f u).val)) -
    Real.log (partBExactNoEmptyFixedMInnerBudget δ n)

/-- Profile contribution normalized by the fixed-`m` budget. This is the non-logarithmic weight
whose fixed-`m` sum should be at most `1`. -/
noncomputable def partBExactNoEmptyFixedMNormalizedContribution
    (δ : ℝ) (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  profileContribution n f / partBExactNoEmptyFixedMInnerBudget δ n

/-- Expanded direct logarithmic contribution target. -/
def PaperPartBExactNoEmptyProfileContributionLogExpandedPointwiseTarget
    (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        partBExactNoEmptyContributionLogExpandedLhs δ n m f ≤ 0

/-- Fixed-`m` expanded Laplace budget. This is equivalent in spirit to proving the fixed-`m`
profile sum directly after normalizing by the fixed-`m` budget, and avoids any equal-share
division by the number of profiles. -/
def PaperPartBExactNoEmptyProfileContributionFixedMExpandedLaplaceTarget
    (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        Real.exp (partBExactNoEmptyContributionLogFixedMExpandedLhs δ n m f)) ≤ 1

/-- Non-logarithmic fixed-`m` normalized contribution budget. This is the preferred concrete
summed target for future analytic work; the expanded Laplace target is a checked logarithmic
normalization of this surface. -/
def PaperPartBExactNoEmptyProfileContributionFixedMNormalizedContributionTarget
    (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        partBExactNoEmptyFixedMNormalizedContribution δ n f) ≤ 1

/-- Non-logarithmic profile-weight envelope for the normalized contribution target. -/
def PaperPartBExactNoEmptyProfileContributionFixedMNormalizedEnvelopePointwiseTarget
    (W : ℝ → ℝ → (n : ℕ) → ℕ → (Fin (n + 1) → Fin (n + 1)) → ℝ)
    (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        partBExactNoEmptyFixedMNormalizedContribution δ n f ≤ W ε δ n m f

/-- Fixed-`m` sum budget for a non-logarithmic normalized contribution envelope. -/
def PaperPartBExactNoEmptyProfileContributionFixedMNormalizedEnvelopeSumTarget
    (W : ℝ → ℝ → (n : ℕ) → ℕ → (Fin (n + 1) → Fin (n + 1)) → ℝ)
    (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        W ε δ n m f) ≤ 1

lemma partBExactNoEmptyContributionLogExpandedLhs_eq_logContribution_sub_logBudget
    {δ : ℝ} {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) :
    partBExactNoEmptyContributionLogExpandedLhs δ n m f =
      Real.log (profileContribution n f) -
        Real.log (partBExactNoEmptyRawProfileBudget δ n m) := by
  have hf_color : f ∈ coloringProfileFinset n m (partBThresholdLevel n) :=
    (mem_noEmptyColoringProfileFinset_iff.mp hf).1
  have hP : 0 < profileP n (fun u => (f u).val) :=
    profileP_pos_of_mem_coloringProfileFinset hf_color
  rw [log_profileContribution_eq_of_profileP_pos n f hP]
  rw [profileF_log_half_eq_neg_log_two]
  dsimp [partBExactNoEmptyContributionLogExpandedLhs]
  ring

lemma partBExactNoEmptyContributionLogFixedMExpandedLhs_eq_logContribution_sub_logBudget
    {δ : ℝ} {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) :
    partBExactNoEmptyContributionLogFixedMExpandedLhs δ n m f =
      Real.log (profileContribution n f) -
        Real.log (partBExactNoEmptyFixedMInnerBudget δ n) := by
  have hf_color : f ∈ coloringProfileFinset n m (partBThresholdLevel n) :=
    (mem_noEmptyColoringProfileFinset_iff.mp hf).1
  have hP : 0 < profileP n (fun u => (f u).val) :=
    profileP_pos_of_mem_coloringProfileFinset hf_color
  rw [log_profileContribution_eq_of_profileP_pos n f hP]
  rw [profileF_log_half_eq_neg_log_two]
  dsimp [partBExactNoEmptyContributionLogFixedMExpandedLhs]
  ring

lemma partBExactNoEmptyContributionLogFixedMExpandedLhs_exp_eq_normalizedContribution
    {δ : ℝ} {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hδ_pos : 0 < δ)
    (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) :
    Real.exp (partBExactNoEmptyContributionLogFixedMExpandedLhs δ n m f) =
      partBExactNoEmptyFixedMNormalizedContribution δ n f := by
  have hf_color : f ∈ coloringProfileFinset n m (partBThresholdLevel n) :=
    (mem_noEmptyColoringProfileFinset_iff.mp hf).1
  have hP : 0 < profileP n (fun u => (f u).val) :=
    profileP_pos_of_mem_coloringProfileFinset hf_color
  have hcontrib_pos : 0 < profileContribution n f :=
    profileContribution_pos_of_profileP_pos n f hP
  have hB_pos : 0 < partBExactNoEmptyFixedMInnerBudget δ n := by
    dsimp [partBExactNoEmptyFixedMInnerBudget]
    positivity
  calc
    Real.exp (partBExactNoEmptyContributionLogFixedMExpandedLhs δ n m f)
        = Real.exp
            (Real.log (profileContribution n f) -
              Real.log (partBExactNoEmptyFixedMInnerBudget δ n)) := by
          rw [partBExactNoEmptyContributionLogFixedMExpandedLhs_eq_logContribution_sub_logBudget
            hf]
    _ = Real.exp (Real.log (profileContribution n f)) /
        Real.exp (Real.log (partBExactNoEmptyFixedMInnerBudget δ n)) := by
          rw [Real.exp_sub]
    _ = partBExactNoEmptyFixedMNormalizedContribution δ n f := by
      rw [Real.exp_log hcontrib_pos, Real.exp_log hB_pos]
      rfl

theorem paperPartBExactNoEmptyProfileContributionLogPointwiseTarget_of_expanded
    {ε δ : ℝ}
    (hexpanded :
      PaperPartBExactNoEmptyProfileContributionLogExpandedPointwiseTarget ε δ) :
    PaperPartBExactNoEmptyProfileContributionLogPointwiseTarget ε δ := by
  rcases hexpanded with ⟨n₀, hexpanded⟩
  refine ⟨n₀, fun n hn hmain m hm f hf => ?_⟩
  have h := hexpanded n hn hmain m hm f hf
  rw [partBExactNoEmptyContributionLogExpandedLhs_eq_logContribution_sub_logBudget hf] at h
  linarith

/-- Log-core version of `partBExactNoEmptyRawProfileBudget`. -/
noncomputable def partBExactNoEmptyLogCoreBudget (δ : ℝ) (n m : ℕ) : ℝ :=
  Real.log (partBExactNoEmptyRawProfileBudget δ n m)

/-- Coarse raw no-empty budget using only the ambient profile-count bound. -/
noncomputable def partBExactNoEmptyCoarseRawProfileBudget (δ : ℝ) (n : ℕ) : ℝ :=
  δ /
    (((partBPaperObstructionColorCount n + 2 : ℕ) : ℝ) *
      ((((n + 1) ^ (n + 1) + 1 : ℕ) : ℝ)))

/-- Denominator in the coarse no-empty per-profile budget. -/
noncomputable def partBExactNoEmptyCoarseBudgetDenom (n : ℕ) : ℝ :=
  ((partBPaperObstructionColorCount n + 2 : ℕ) : ℝ) *
    ((((n + 1) ^ (n + 1) + 1 : ℕ) : ℝ))

/-- Denominator in the binary no-empty per-profile budget. -/
noncomputable def partBExactNoEmptyBinaryBudgetDenom (n : ℕ) : ℝ :=
  ((partBPaperObstructionColorCount n + 2 : ℕ) : ℝ) *
    (((2 ^ n + 1 : ℕ) : ℝ))

/-- Coarse log-core no-empty budget using only the ambient profile-count bound. -/
noncomputable def partBExactNoEmptyCoarseLogCoreBudget (δ : ℝ) (n : ℕ) : ℝ :=
  Real.log (partBExactNoEmptyCoarseRawProfileBudget δ n)

/-- Candidate sharper no-empty profile-count bound. This is the next combinatorial counting
target replacing the too-coarse ambient function-space bound `(n+1)^(n+1)`. -/
def PaperPartBExactNoEmptyProfileBinaryCardBoundTarget : Prop :=
  ∀ n m : ℕ,
    (noEmptyColoringProfileFinset n m (partBThresholdLevel n)).card ≤ 2 ^ n

/-- Starting boundary for the `j`th colour class of size `u`, after sorting classes by size. -/
noncomputable def noEmptyProfileBoundaryStart
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) (u : Fin (n + 1)) (j : ℕ) : ℕ :=
  (∑ v ∈ (Finset.univ.filter (fun v : Fin (n + 1) => v.val < u.val)),
    v.val * (f v).val) +
  j * u.val

/-- Boundary encoding of a no-empty profile as a subset of `Fin n`.

The intended encoding sorts colour-class sizes increasingly and records the starting vertex index
of each block. The injectivity of this encoding is isolated below as the next finite-combinatorial
target for proving the binary profile-count bound. -/
noncomputable def noEmptyProfileBoundaryEncoding
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : Finset (Fin n) :=
  Finset.univ.filter (fun s : Fin n =>
    ∃ u : Fin (n + 1), 0 < u.val ∧
      ∃ j : ℕ, j < (f u).val ∧
        s.val = noEmptyProfileBoundaryStart n f u j)

lemma mem_noEmptyProfileBoundaryEncoding_iff
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)} {s : Fin n} :
    s ∈ noEmptyProfileBoundaryEncoding n f ↔
      ∃ u : Fin (n + 1), 0 < u.val ∧
        ∃ j : ℕ, j < (f u).val ∧
          s.val = noEmptyProfileBoundaryStart n f u j := by
  simp [noEmptyProfileBoundaryEncoding]

lemma noEmptyProfileBoundaryStart_mem_encoding
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)} {u : Fin (n + 1)} {j : ℕ}
    (hu_pos : 0 < u.val) (hj : j < (f u).val)
    (hstart : noEmptyProfileBoundaryStart n f u j < n) :
    ⟨noEmptyProfileBoundaryStart n f u j, hstart⟩ ∈
      noEmptyProfileBoundaryEncoding n f := by
  rw [mem_noEmptyProfileBoundaryEncoding_iff]
  exact ⟨u, hu_pos, j, hj, rfl⟩

/-- Next local finite-combinatorial target: every recorded block start is actually below `n`.

This is separated from injectivity because it is a pure prefix-sum bound from the profile's total
vertex weight. -/
def PaperPartBExactNoEmptyProfileBoundaryStartLtTarget : Prop :=
  ∀ n m : ℕ, ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
    ∀ u : Fin (n + 1), 0 < u.val →
      ∀ j : ℕ, j < (f u).val →
        noEmptyProfileBoundaryStart n f u j < n

theorem paperPartBExactNoEmptyProfileBoundaryStartLtTarget :
    PaperPartBExactNoEmptyProfileBoundaryStartLtTarget := by
  change ∀ n m : ℕ, ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
    ∀ u : Fin (n + 1), 0 < u.val →
      ∀ j : ℕ, j < (f u).val →
        noEmptyProfileBoundaryStart n f u j < n
  intro n m f hf u hu_pos j hj
  classical
  let prefixSet : Finset (Fin (n + 1)) :=
    Finset.univ.filter (fun v : Fin (n + 1) => v.val < u.val)
  let blockSet : Finset (Fin (n + 1)) := insert u prefixSet
  let term : Fin (n + 1) → ℕ := fun v => v.val * (f v).val
  have hblock_le_total :
      (∑ v ∈ blockSet, term v) ≤ ∑ v : Fin (n + 1), term v := by
    have hsubset : blockSet ⊆ Finset.univ := by
      intro x _hx
      exact Finset.mem_univ x
    exact Finset.sum_le_sum_of_subset (s := blockSet) (t := Finset.univ) (f := term) hsubset
  have hblock_sum :
      (∑ v ∈ blockSet, term v) = term u + ∑ v ∈ prefixSet, term v := by
    have hu_not_prefix : u ∉ prefixSet := by
      simp [prefixSet]
    simp [blockSet, hu_not_prefix]
  have hblock_le_n :
      (∑ v ∈ prefixSet, term v) + (f u).val * u.val ≤ n := by
    have htotal : (∑ v : Fin (n + 1), term v) = n := by
      have hf_color : f ∈ coloringProfileFinset n m (partBThresholdLevel n) :=
        (mem_noEmptyColoringProfileFinset_iff.mp hf).1
      simpa [profileVertexWeight, term] using
        profileVertexWeight_eq_of_mem_coloringProfileFinset hf_color
    have htmp : term u + ∑ v ∈ prefixSet, term v ≤ n := by
      calc
        term u + ∑ v ∈ prefixSet, term v = ∑ v ∈ blockSet, term v := hblock_sum.symm
        _ ≤ ∑ v : Fin (n + 1), term v := hblock_le_total
        _ = n := htotal
    simpa [term, Nat.add_comm, Nat.mul_comm] using htmp
  have hjmul : j * u.val < (f u).val * u.val :=
    Nat.mul_lt_mul_of_pos_right hj hu_pos
  have hstart_lt_block :
      noEmptyProfileBoundaryStart n f u j <
        (∑ v ∈ prefixSet, term v) + (f u).val * u.val := by
    dsimp [noEmptyProfileBoundaryStart, prefixSet, term]
    exact Nat.add_lt_add_left hjmul _
  exact lt_of_lt_of_le hstart_lt_block hblock_le_n

lemma noEmptyProfileBoundaryStart_lt_of_same_size
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)} {u : Fin (n + 1)} {j l : ℕ}
    (hu_pos : 0 < u.val) (hjl : j < l) :
    noEmptyProfileBoundaryStart n f u j < noEmptyProfileBoundaryStart n f u l := by
  dsimp [noEmptyProfileBoundaryStart]
  exact Nat.add_lt_add_left (Nat.mul_lt_mul_of_pos_right hjl hu_pos) _

lemma noEmptyProfileBoundaryStart_lt_of_lt_size
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)} {u v : Fin (n + 1)} {j l : ℕ}
    (hu_pos : 0 < u.val) (huv : u.val < v.val) (hj : j < (f u).val) :
    noEmptyProfileBoundaryStart n f u j < noEmptyProfileBoundaryStart n f v l := by
  classical
  let prefixU : Finset (Fin (n + 1)) :=
    Finset.univ.filter (fun w : Fin (n + 1) => w.val < u.val)
  let prefixV : Finset (Fin (n + 1)) :=
    Finset.univ.filter (fun w : Fin (n + 1) => w.val < v.val)
  let blockU : Finset (Fin (n + 1)) := insert u prefixU
  let term : Fin (n + 1) → ℕ := fun w => w.val * (f w).val
  have hblock_subset : blockU ⊆ prefixV := by
    intro x hx
    simp only [blockU, prefixU, prefixV, Finset.mem_insert, Finset.mem_filter,
      Finset.mem_univ, true_and] at hx ⊢
    rcases hx with rfl | hx
    · exact huv
    · exact lt_trans hx huv
  have hblock_le_prefixV :
      (∑ w ∈ blockU, term w) ≤ ∑ w ∈ prefixV, term w :=
    Finset.sum_le_sum_of_subset (s := blockU) (t := prefixV) (f := term) hblock_subset
  have hblock_sum :
      (∑ w ∈ blockU, term w) = term u + ∑ w ∈ prefixU, term w := by
    have hu_not_prefix : u ∉ prefixU := by
      simp [prefixU]
    simp [blockU, hu_not_prefix]
  have hstart_lt_block :
      noEmptyProfileBoundaryStart n f u j < ∑ w ∈ blockU, term w := by
    calc
      noEmptyProfileBoundaryStart n f u j =
          (∑ w ∈ prefixU, term w) + j * u.val := by
            dsimp [noEmptyProfileBoundaryStart, prefixU, term]
      _ < (∑ w ∈ prefixU, term w) + (f u).val * u.val := by
            exact Nat.add_lt_add_left (Nat.mul_lt_mul_of_pos_right hj hu_pos) _
      _ = term u + ∑ w ∈ prefixU, term w := by
            simp [term, Nat.add_comm, Nat.mul_comm]
      _ = ∑ w ∈ blockU, term w := hblock_sum.symm
  have hprefixV_le_startV :
      (∑ w ∈ prefixV, term w) ≤ noEmptyProfileBoundaryStart n f v l := by
    dsimp [noEmptyProfileBoundaryStart, prefixV, term]
    exact Nat.le_add_right _ _
  exact lt_of_lt_of_le hstart_lt_block (hblock_le_prefixV.trans hprefixV_le_startV)

lemma noEmptyProfileBoundaryStart_add_size_le_of_same_size_lt_index
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)} {u : Fin (n + 1)} {j l : ℕ}
    (hjl : j < l) :
    noEmptyProfileBoundaryStart n f u j + u.val ≤ noEmptyProfileBoundaryStart n f u l := by
  dsimp [noEmptyProfileBoundaryStart]
  have hmul : (j + 1) * u.val ≤ l * u.val :=
    Nat.mul_le_mul_right u.val (Nat.succ_le_of_lt hjl)
  have hstep : j * u.val + u.val ≤ l * u.val := by
    simpa [Nat.add_mul, Nat.one_mul, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc] using hmul
  omega

lemma noEmptyProfileBoundaryStart_add_size_le_of_lt_size
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)} {u v : Fin (n + 1)} {j l : ℕ}
    (huv : u.val < v.val) (hj : j < (f u).val) :
    noEmptyProfileBoundaryStart n f u j + u.val ≤ noEmptyProfileBoundaryStart n f v l := by
  classical
  let prefixU : Finset (Fin (n + 1)) :=
    Finset.univ.filter (fun w : Fin (n + 1) => w.val < u.val)
  let prefixV : Finset (Fin (n + 1)) :=
    Finset.univ.filter (fun w : Fin (n + 1) => w.val < v.val)
  let blockU : Finset (Fin (n + 1)) := insert u prefixU
  let term : Fin (n + 1) → ℕ := fun w => w.val * (f w).val
  have hblock_subset : blockU ⊆ prefixV := by
    intro x hx
    simp only [blockU, prefixU, prefixV, Finset.mem_insert, Finset.mem_filter,
      Finset.mem_univ, true_and] at hx ⊢
    rcases hx with rfl | hx
    · exact huv
    · exact lt_trans hx huv
  have hblock_le_prefixV :
      (∑ w ∈ blockU, term w) ≤ ∑ w ∈ prefixV, term w :=
    Finset.sum_le_sum_of_subset (s := blockU) (t := prefixV) (f := term) hblock_subset
  have hblock_sum :
      (∑ w ∈ blockU, term w) = term u + ∑ w ∈ prefixU, term w := by
    have hu_not_prefix : u ∉ prefixU := by
      simp [prefixU]
    simp [blockU, hu_not_prefix]
  have hstart_end_le_block :
      noEmptyProfileBoundaryStart n f u j + u.val ≤ ∑ w ∈ blockU, term w := by
    have hmul : (j + 1) * u.val ≤ (f u).val * u.val :=
      Nat.mul_le_mul_right u.val (Nat.succ_le_of_lt hj)
    have hstep : j * u.val + u.val ≤ (f u).val * u.val := by
      simpa [Nat.add_mul, Nat.one_mul, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc] using hmul
    calc
      noEmptyProfileBoundaryStart n f u j + u.val =
          (∑ w ∈ prefixU, term w) + (j * u.val + u.val) := by
            dsimp [noEmptyProfileBoundaryStart, prefixU, term]
            omega
      _ ≤ (∑ w ∈ prefixU, term w) + (f u).val * u.val :=
            Nat.add_le_add_left hstep _
      _ = term u + ∑ w ∈ prefixU, term w := by
            simp [term, Nat.add_comm, Nat.mul_comm]
      _ = ∑ w ∈ blockU, term w := hblock_sum.symm
  have hprefixV_le_startV :
      (∑ w ∈ prefixV, term w) ≤ noEmptyProfileBoundaryStart n f v l := by
    dsimp [noEmptyProfileBoundaryStart, prefixV, term]
    exact Nat.le_add_right _ _
  exact hstart_end_le_block.trans (hblock_le_prefixV.trans hprefixV_le_startV)

lemma noEmptyProfileBoundaryStart_injective_of_valid_blocks
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)} {u v : Fin (n + 1)} {j l : ℕ}
    (hu_pos : 0 < u.val) (hv_pos : 0 < v.val)
    (hj : j < (f u).val) (hl : l < (f v).val)
    (hstart :
      noEmptyProfileBoundaryStart n f u j = noEmptyProfileBoundaryStart n f v l) :
    u = v ∧ j = l := by
  rcases lt_trichotomy u.val v.val with huv | huv_eq | huv_gt
  · have hlt := noEmptyProfileBoundaryStart_lt_of_lt_size
      (n := n) (f := f) (u := u) (v := v) (j := j) (l := l) hu_pos huv hj
    exact False.elim ((ne_of_lt hlt) hstart)
  · have huv_fin : u = v := Fin.ext huv_eq
    subst v
    refine ⟨rfl, ?_⟩
    rcases lt_trichotomy j l with hjl | hj_eq | hlj
    · have hlt := noEmptyProfileBoundaryStart_lt_of_same_size
        (n := n) (f := f) (u := u) hu_pos hjl
      exact False.elim ((ne_of_lt hlt) hstart)
    · exact hj_eq
    · have hlt := noEmptyProfileBoundaryStart_lt_of_same_size
        (n := n) (f := f) (u := u) hu_pos hlj
      exact False.elim ((ne_of_gt hlt) hstart)
  · have hlt := noEmptyProfileBoundaryStart_lt_of_lt_size
      (n := n) (f := f) (u := v) (v := u) (j := l) (l := j) hv_pos huv_gt hl
    exact False.elim ((ne_of_gt hlt) hstart)

lemma noEmptyProfileBoundaryEncoding_repr_unique
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)} {s : Fin n}
    {u v : Fin (n + 1)} {j l : ℕ}
    (hu_pos : 0 < u.val) (hv_pos : 0 < v.val)
    (hj : j < (f u).val) (hl : l < (f v).val)
    (hsu : s.val = noEmptyProfileBoundaryStart n f u j)
    (hsv : s.val = noEmptyProfileBoundaryStart n f v l) :
    u = v ∧ j = l := by
  exact noEmptyProfileBoundaryStart_injective_of_valid_blocks
    (n := n) (f := f) (u := u) (v := v) (j := j) (l := l)
    hu_pos hv_pos hj hl (hsu.symm.trans hsv)

/-- Explicit finite domain of positive profile blocks recorded by the boundary encoding. -/
noncomputable def noEmptyProfileBoundaryBlockFinset
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : Finset (Fin (n + 1) × ℕ) :=
  (((Finset.univ : Finset (Fin (n + 1))).product (Finset.range (n + 1))).filter
    (fun p => 0 < p.1.val ∧ p.2 < (f p.1).val))

lemma mem_noEmptyProfileBoundaryBlockFinset_iff
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)} {p : Fin (n + 1) × ℕ} :
    p ∈ noEmptyProfileBoundaryBlockFinset n f ↔
      0 < p.1.val ∧ p.2 < (f p.1).val := by
  constructor
  · intro hp
    have hfull :
        p.2 ≤ n ∧ 0 < p.1.val ∧ p.2 < (f p.1).val := by
      simpa [noEmptyProfileBoundaryBlockFinset] using hp
    exact hfull.2
  · intro hp
    have hj_range : p.2 < n + 1 := lt_trans hp.2 (f p.1).isLt
    simpa [noEmptyProfileBoundaryBlockFinset, hj_range] using hp

/-- The natural-number starts generated by all valid positive profile blocks. -/
noncomputable def noEmptyProfileBoundaryStartNatImage
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : Finset ℕ :=
  (noEmptyProfileBoundaryBlockFinset n f).image
    (fun p => noEmptyProfileBoundaryStart n f p.1 p.2)

lemma noEmptyProfileBoundaryEncoding_val_image_eq_startNatImage
    {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) :
    (noEmptyProfileBoundaryEncoding n f).image (fun s : Fin n => s.val) =
      noEmptyProfileBoundaryStartNatImage n f := by
  classical
  ext a
  constructor
  · intro ha
    rcases Finset.mem_image.mp ha with ⟨s, hs, hsa⟩
    rcases mem_noEmptyProfileBoundaryEncoding_iff.mp hs with ⟨u, hu_pos, j, hj, hs_start⟩
    have hp : (u, j) ∈ noEmptyProfileBoundaryBlockFinset n f := by
      rw [mem_noEmptyProfileBoundaryBlockFinset_iff]
      exact ⟨hu_pos, hj⟩
    rw [noEmptyProfileBoundaryStartNatImage]
    exact Finset.mem_image.mpr ⟨(u, j), hp, hs_start.symm.trans hsa⟩
  · intro ha
    rw [noEmptyProfileBoundaryStartNatImage] at ha
    rcases Finset.mem_image.mp ha with ⟨p, hp, hpa⟩
    rcases mem_noEmptyProfileBoundaryBlockFinset_iff.mp hp with ⟨hu_pos, hj⟩
    have hstart_lt :
        noEmptyProfileBoundaryStart n f p.1 p.2 < n :=
      paperPartBExactNoEmptyProfileBoundaryStartLtTarget n m f hf p.1 hu_pos p.2 hj
    let s : Fin n := ⟨noEmptyProfileBoundaryStart n f p.1 p.2, hstart_lt⟩
    have hs : s ∈ noEmptyProfileBoundaryEncoding n f :=
      noEmptyProfileBoundaryStart_mem_encoding hu_pos hj hstart_lt
    exact Finset.mem_image.mpr ⟨s, hs, by simpa [s] using hpa⟩

lemma noEmptyProfileBoundaryStart_injOn_blockFinset
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) :
    Set.InjOn
      (fun p : Fin (n + 1) × ℕ => noEmptyProfileBoundaryStart n f p.1 p.2)
      (↑(noEmptyProfileBoundaryBlockFinset n f) : Set (Fin (n + 1) × ℕ)) := by
  intro p hp q hq hpq
  rcases mem_noEmptyProfileBoundaryBlockFinset_iff.mp hp with ⟨hp_pos, hpj⟩
  rcases mem_noEmptyProfileBoundaryBlockFinset_iff.mp hq with ⟨hq_pos, hqj⟩
  rcases noEmptyProfileBoundaryStart_injective_of_valid_blocks
      (n := n) (f := f) (u := p.1) (v := q.1) (j := p.2) (l := q.2)
      hp_pos hq_pos hpj hqj hpq with ⟨huv, hjl⟩
  exact Prod.ext huv hjl

lemma noEmptyProfileBoundaryStartNatImage_card_eq_blockFinset_card
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) :
    (noEmptyProfileBoundaryStartNatImage n f).card =
      (noEmptyProfileBoundaryBlockFinset n f).card := by
  rw [noEmptyProfileBoundaryStartNatImage]
  exact Finset.card_image_of_injOn (noEmptyProfileBoundaryStart_injOn_blockFinset n f)

lemma noEmptyProfileBoundaryEncoding_card_eq_startNatImage_card
    {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) :
    (noEmptyProfileBoundaryEncoding n f).card =
      (noEmptyProfileBoundaryStartNatImage n f).card := by
  have hval_inj :
      Set.InjOn (fun s : Fin n => s.val)
        (↑(noEmptyProfileBoundaryEncoding n f) : Set (Fin n)) := by
    intro s _hs t _ht hst
    exact Fin.ext hst
  have hcard :
      ((noEmptyProfileBoundaryEncoding n f).image (fun s : Fin n => s.val)).card =
        (noEmptyProfileBoundaryEncoding n f).card :=
    Finset.card_image_of_injOn hval_inj
  rw [noEmptyProfileBoundaryEncoding_val_image_eq_startNatImage hf] at hcard
  exact hcard.symm

lemma noEmptyProfileBoundaryEncoding_card_eq_blockFinset_card
    {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) :
    (noEmptyProfileBoundaryEncoding n f).card =
      (noEmptyProfileBoundaryBlockFinset n f).card := by
  rw [noEmptyProfileBoundaryEncoding_card_eq_startNatImage_card hf]
  exact noEmptyProfileBoundaryStartNatImage_card_eq_blockFinset_card n f

lemma noEmptyProfileBoundaryBlockFinset_card_eq_positiveSum
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) :
    (noEmptyProfileBoundaryBlockFinset n f).card =
      ∑ u : Fin (n + 1), if 0 < u.val then (f u).val else 0 := by
  rw [noEmptyProfileBoundaryBlockFinset, Finset.card_filter]
  change
    (∑ i ∈ (Finset.univ : Finset (Fin (n + 1))) ×ˢ Finset.range (n + 1),
        if 0 < i.1.val ∧ i.2 < (f i.1).val then 1 else 0) =
      ∑ u : Fin (n + 1), if 0 < u.val then (f u).val else 0
  rw [Finset.sum_product]
  apply Finset.sum_congr rfl
  intro u _hu
  by_cases hpos : 0 < u.val
  · have hfilter :
        (Finset.range (n + 1)).filter (fun j : ℕ => j < (f u).val) =
          Finset.range (f u).val := by
      ext j
      simp only [Finset.mem_filter, Finset.mem_range]
      constructor
      · intro hj
        exact hj.2
      · intro hj
        exact ⟨lt_trans hj (f u).isLt, hj⟩
    rw [← Finset.card_filter]
    simp [hpos, hfilter]
  · simp [hpos]

lemma noEmptyProfileBoundaryBlockFinset_filter_fst_card
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) (u : Fin (n + 1)) :
    ((noEmptyProfileBoundaryBlockFinset n f).filter (fun p => p.1 = u)).card =
      if 0 < u.val then (f u).val else 0 := by
  by_cases hpos : 0 < u.val
  · rw [if_pos hpos]
    have hfilter_eq :
        (noEmptyProfileBoundaryBlockFinset n f).filter (fun p => p.1 = u) =
          ({u} : Finset (Fin (n + 1))).product (Finset.range (f u).val) := by
      ext p
      constructor
      · intro hp
        rcases Finset.mem_filter.mp hp with ⟨hp_block, hp_fst⟩
        rcases mem_noEmptyProfileBoundaryBlockFinset_iff.mp hp_block with ⟨_hp_pos, hp_j⟩
        exact Finset.mem_product.mpr
          ⟨by simpa using hp_fst, by simpa [hp_fst] using hp_j⟩
      · intro hp
        rcases Finset.mem_product.mp hp with ⟨hp_fst, hp_j_range⟩
        have hp_fst_eq : p.1 = u := by simpa using hp_fst
        have hp_j : p.2 < (f p.1).val := by
          simpa [hp_fst_eq] using Finset.mem_range.mp hp_j_range
        refine Finset.mem_filter.mpr ⟨?_, hp_fst_eq⟩
        rw [mem_noEmptyProfileBoundaryBlockFinset_iff]
        exact ⟨by simpa [hp_fst_eq] using hpos, hp_j⟩
    rw [hfilter_eq]
    calc
      (({u} : Finset (Fin (n + 1))).product (Finset.range (f u).val)).card =
          ({u} : Finset (Fin (n + 1))).card * (Finset.range (f u).val).card :=
        Finset.card_product _ _
      _ = (f u).val := by simp
  · rw [if_neg hpos]
    rw [Finset.card_eq_zero]
    ext p
    constructor
    · intro hp
      rcases Finset.mem_filter.mp hp with ⟨hp_block, hp_fst⟩
      rcases mem_noEmptyProfileBoundaryBlockFinset_iff.mp hp_block with ⟨hp_pos, _hp_j⟩
      exact False.elim (hpos (by simpa [hp_fst] using hp_pos))
    · intro hp
      simp at hp

lemma noEmptyProfileBoundaryBlockFinset_card_eq_profileColorCount
    {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) :
    (noEmptyProfileBoundaryBlockFinset n f).card = profileColorCount n f := by
  rw [noEmptyProfileBoundaryBlockFinset_card_eq_positiveSum]
  have hzero : (f ⟨0, Nat.succ_pos n⟩).val = 0 :=
    (mem_noEmptyColoringProfileFinset_iff.mp hf).2
  rw [profileColorCount]
  apply Finset.sum_congr rfl
  intro u _hu
  by_cases hpos : 0 < u.val
  · simp [hpos]
  · have hu_val : u.val = 0 := Nat.eq_zero_of_not_pos hpos
    have hu_eq : u = ⟨0, Nat.succ_pos n⟩ := Fin.ext hu_val
    subst u
    exact hzero.symm

lemma noEmptyProfileBoundaryBlockFinset_card_eq_colorCount
    {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) :
    (noEmptyProfileBoundaryBlockFinset n f).card = m := by
  rw [noEmptyProfileBoundaryBlockFinset_card_eq_profileColorCount hf]
  exact profileColorCount_eq_of_mem_coloringProfileFinset
    (mem_noEmptyColoringProfileFinset_iff.mp hf).1

lemma noEmptyProfileBoundaryEncoding_card_eq_colorCount
    {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) :
    (noEmptyProfileBoundaryEncoding n f).card = m := by
  rw [noEmptyProfileBoundaryEncoding_card_eq_blockFinset_card hf]
  exact noEmptyProfileBoundaryBlockFinset_card_eq_colorCount hf

/-- Next recorded start after `s`, or the terminal boundary `n` if `s` is the last start. -/
noncomputable def noEmptyProfileBoundaryNextStart
    (n : ℕ) (S : Finset (Fin n)) (s : Fin n) : ℕ :=
  if hnext : ∃ t ∈ S, s.val < t.val then
    ((S.filter (fun t : Fin n => s.val < t.val)).min'
      (by
        rcases hnext with ⟨t, htS, hst⟩
        exact ⟨t, Finset.mem_filter.mpr ⟨htS, hst⟩⟩)).val
  else n

/-- Gap from a recorded start to the next recorded start, with terminal boundary `n`. -/
noncomputable def noEmptyProfileBoundaryGap
    (n : ℕ) (S : Finset (Fin n)) (s : Fin n) : ℕ :=
  noEmptyProfileBoundaryNextStart n S s - s.val

/-- Decoder target for the boundary encoding: multiplicity of size `u` is the number of starts
whose next-start gap is exactly `u`. -/
def PaperPartBExactNoEmptyProfileBoundaryGapRecoveryTarget : Prop :=
  ∀ n m : ℕ, ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
    ∀ u : Fin (n + 1),
      (f u).val =
        ((noEmptyProfileBoundaryEncoding n f).filter
          (fun s : Fin n =>
            noEmptyProfileBoundaryGap n (noEmptyProfileBoundaryEncoding n f) s = u.val)).card

/-- Fiber-count transport target from encoded starts back to the explicit valid-block domain. -/
def PaperPartBExactNoEmptyProfileBoundaryGapFiberTransportTarget : Prop :=
  ∀ n m : ℕ, ∀ f, (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) →
    ∀ u : Fin (n + 1),
      ((noEmptyProfileBoundaryEncoding n f).filter
        (fun s : Fin n =>
          noEmptyProfileBoundaryGap n (noEmptyProfileBoundaryEncoding n f) s = u.val)).card =
        ((noEmptyProfileBoundaryBlockFinset n f).filter (fun p => p.1 = u)).card

theorem paperPartBExactNoEmptyProfileBoundaryGapRecoveryTarget_of_fiberTransport
    (htransport : PaperPartBExactNoEmptyProfileBoundaryGapFiberTransportTarget) :
    PaperPartBExactNoEmptyProfileBoundaryGapRecoveryTarget := by
  intro n m f hf u
  rw [htransport n m f hf u]
  rw [noEmptyProfileBoundaryBlockFinset_filter_fst_card]
  by_cases hpos : 0 < u.val
  · simp [hpos]
  · have hu_val : u.val = 0 := Nat.eq_zero_of_not_pos hpos
    have hu_eq : u = ⟨0, Nat.succ_pos n⟩ := Fin.ext hu_val
    have hzero : (f ⟨0, Nat.succ_pos n⟩).val = 0 :=
      (mem_noEmptyColoringProfileFinset_iff.mp hf).2
    subst u
    simpa using hzero

/-- Pointwise decoder target: the terminal gap after the start of each valid block is its size. -/
def PaperPartBExactNoEmptyProfileBoundaryGapValueTarget : Prop :=
  ∀ n m : ℕ, ∀ f, (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) →
    ∀ u : Fin (n + 1), (hu_pos : 0 < u.val) →
      ∀ j : ℕ, (hj : j < (f u).val) →
        noEmptyProfileBoundaryGap n (noEmptyProfileBoundaryEncoding n f)
          ⟨noEmptyProfileBoundaryStart n f u j,
            paperPartBExactNoEmptyProfileBoundaryStartLtTarget n m f hf u hu_pos j hj⟩ =
          u.val

/-- No encoded start lies strictly inside the open interval covered by a valid block. -/
def PaperPartBExactNoEmptyProfileBoundaryNoInteriorStartTarget : Prop :=
  ∀ n m : ℕ, ∀ f, (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) →
    ∀ u : Fin (n + 1), (hu_pos : 0 < u.val) →
      ∀ j : ℕ, (hj : j < (f u).val) →
        ∀ s : Fin n, s ∈ noEmptyProfileBoundaryEncoding n f →
          noEmptyProfileBoundaryStart n f u j < s.val →
            s.val < noEmptyProfileBoundaryStart n f u j + u.val → False

/-- The end of every valid block is either another encoded start or the terminal boundary `n`. -/
def PaperPartBExactNoEmptyProfileBoundaryBlockEndTarget : Prop :=
  ∀ n m : ℕ, ∀ f, (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) →
    ∀ u : Fin (n + 1), (hu_pos : 0 < u.val) →
      ∀ j : ℕ, (hj : j < (f u).val) →
        noEmptyProfileBoundaryStart n f u j + u.val = n ∨
          ∃ s ∈ noEmptyProfileBoundaryEncoding n f,
            s.val = noEmptyProfileBoundaryStart n f u j + u.val

lemma noEmptyProfileBoundaryBlockEnd_mem_encoding_of_succ_index
    {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n))
    {u : Fin (n + 1)} (hu_pos : 0 < u.val) {j : ℕ}
    (hj_succ : j + 1 < (f u).val) :
    ∃ s ∈ noEmptyProfileBoundaryEncoding n f,
      s.val = noEmptyProfileBoundaryStart n f u j + u.val := by
  have hstart_succ_lt :
      noEmptyProfileBoundaryStart n f u (j + 1) < n :=
    paperPartBExactNoEmptyProfileBoundaryStartLtTarget n m f hf u hu_pos (j + 1) hj_succ
  let s : Fin n := ⟨noEmptyProfileBoundaryStart n f u (j + 1), hstart_succ_lt⟩
  have hs : s ∈ noEmptyProfileBoundaryEncoding n f :=
    noEmptyProfileBoundaryStart_mem_encoding hu_pos hj_succ hstart_succ_lt
  refine ⟨s, hs, ?_⟩
  dsimp [s, noEmptyProfileBoundaryStart]
  simp [Nat.add_mul, Nat.add_comm, Nat.add_assoc]

/-- Endpoint target for the last block of a fixed size. -/
def PaperPartBExactNoEmptyProfileBoundaryLastInSizeBlockEndTarget : Prop :=
  ∀ n m : ℕ, ∀ f, (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) →
    ∀ u : Fin (n + 1), (hu_pos : 0 < u.val) →
      ∀ j : ℕ, (hj : j < (f u).val) →
        j + 1 = (f u).val →
          noEmptyProfileBoundaryStart n f u j + u.val = n ∨
            ∃ s ∈ noEmptyProfileBoundaryEncoding n f,
              s.val = noEmptyProfileBoundaryStart n f u j + u.val

/-- Positive sizes strictly larger than `u`. -/
noncomputable def noEmptyProfileLargerPositiveSizeFinset
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) (u : Fin (n + 1)) : Finset (Fin (n + 1)) :=
  Finset.univ.filter (fun v : Fin (n + 1) => u.val < v.val ∧ 0 < (f v).val)

/-- If a larger positive size exists, the first such size starts at the current last block end. -/
def PaperPartBExactNoEmptyProfileBoundaryNextPositiveStartTarget : Prop :=
  ∀ n m : ℕ, ∀ f, (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) →
    ∀ u : Fin (n + 1), (hu_pos : 0 < u.val) →
      ∀ j : ℕ, (hj : j < (f u).val) →
        j + 1 = (f u).val →
          ∀ hlarger : (noEmptyProfileLargerPositiveSizeFinset n f u).Nonempty,
            noEmptyProfileBoundaryStart n f
                ((noEmptyProfileLargerPositiveSizeFinset n f u).min' hlarger) 0 =
              noEmptyProfileBoundaryStart n f u j + u.val

/-- If no larger positive size exists, the current last block ends at the terminal boundary. -/
def PaperPartBExactNoEmptyProfileBoundaryLastSizeTerminalTarget : Prop :=
  ∀ n m : ℕ, ∀ f, (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) →
    ∀ u : Fin (n + 1), (hu_pos : 0 < u.val) →
      ∀ j : ℕ, (hj : j < (f u).val) →
        j + 1 = (f u).val →
          (noEmptyProfileLargerPositiveSizeFinset n f u).card = 0 →
            noEmptyProfileBoundaryStart n f u j + u.val = n

theorem paperPartBExactNoEmptyProfileBoundaryLastInSizeBlockEndTarget_of_nextPositive_or_terminal
    (hnext : PaperPartBExactNoEmptyProfileBoundaryNextPositiveStartTarget)
    (hterminal : PaperPartBExactNoEmptyProfileBoundaryLastSizeTerminalTarget) :
    PaperPartBExactNoEmptyProfileBoundaryLastInSizeBlockEndTarget := by
  intro n m f hf u hu_pos j hj hj_last
  classical
  let L := noEmptyProfileLargerPositiveSizeFinset n f u
  by_cases hL : L.Nonempty
  · right
    let v : Fin (n + 1) := L.min' hL
    have hvL : v ∈ L := Finset.min'_mem L hL
    have hv_pos_count : 0 < (f v).val := by
      simpa [L, noEmptyProfileLargerPositiveSizeFinset] using
        (Finset.mem_filter.mp hvL).2.2
    have hstart_v_lt :
        noEmptyProfileBoundaryStart n f v 0 < n :=
      paperPartBExactNoEmptyProfileBoundaryStartLtTarget n m f hf v
        (by
          have hv_gt_u : u.val < v.val := by
            simpa [L, noEmptyProfileLargerPositiveSizeFinset] using
              (Finset.mem_filter.mp hvL).2.1
          exact lt_trans hu_pos hv_gt_u)
        0 hv_pos_count
    let s : Fin n := ⟨noEmptyProfileBoundaryStart n f v 0, hstart_v_lt⟩
    have hs : s ∈ noEmptyProfileBoundaryEncoding n f :=
      noEmptyProfileBoundaryStart_mem_encoding
        (by
          have hv_gt_u : u.val < v.val := by
            simpa [L, noEmptyProfileLargerPositiveSizeFinset] using
              (Finset.mem_filter.mp hvL).2.1
          exact lt_trans hu_pos hv_gt_u)
        hv_pos_count hstart_v_lt
    refine ⟨s, hs, ?_⟩
    dsimp [s]
    exact hnext n m f hf u hu_pos j hj hj_last hL
  · left
    have hcard : (noEmptyProfileLargerPositiveSizeFinset n f u).card = 0 := by
      rw [Finset.card_eq_zero]
      exact Finset.not_nonempty_iff_eq_empty.mp hL
    exact hterminal n m f hf u hu_pos j hj hj_last hcard

theorem paperPartBExactNoEmptyProfileBoundaryLastSizeTerminalTarget :
    PaperPartBExactNoEmptyProfileBoundaryLastSizeTerminalTarget := by
  intro n m f hf u hu_pos j hj hj_last hno_larger
  classical
  let prefixU : Finset (Fin (n + 1)) :=
    Finset.univ.filter (fun w : Fin (n + 1) => w.val < u.val)
  let blockU : Finset (Fin (n + 1)) := insert u prefixU
  let term : Fin (n + 1) → ℕ := fun w => w.val * (f w).val
  have hu_not_prefix : u ∉ prefixU := by
    simp [prefixU]
  have hblock_subset : blockU ⊆ Finset.univ := by
    intro x _hx
    exact Finset.mem_univ x
  have hL_empty : noEmptyProfileLargerPositiveSizeFinset n f u = ∅ :=
    Finset.card_eq_zero.mp hno_larger
  have hzero_outside : ∀ x ∈ Finset.univ, x ∉ blockU → term x = 0 := by
    intro x _hx_univ hx_not_block
    rcases lt_trichotomy x.val u.val with hxu | hxu_eq | hux
    · have hx_prefix : x ∈ prefixU := by
        change x ∈ Finset.univ.filter (fun w : Fin (n + 1) => w.val < u.val)
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ x, hxu⟩
      exact False.elim (hx_not_block (Finset.mem_insert.mpr (Or.inr hx_prefix)))
    · have hx_eq : x = u := Fin.ext hxu_eq
      exact False.elim (hx_not_block (Finset.mem_insert.mpr (Or.inl hx_eq)))
    · have hfx_not_pos : ¬ 0 < (f x).val := by
        intro hfx_pos
        have hxL : x ∈ noEmptyProfileLargerPositiveSizeFinset n f u := by
          rw [noEmptyProfileLargerPositiveSizeFinset]
          exact Finset.mem_filter.mpr ⟨Finset.mem_univ x, ⟨hux, hfx_pos⟩⟩
        rw [hL_empty] at hxL
        simp at hxL
      have hfx_zero : (f x).val = 0 := Nat.eq_zero_of_not_pos hfx_not_pos
      simp [term, hfx_zero]
  have hblock_sum :
      (∑ w ∈ blockU, term w) = term u + ∑ w ∈ prefixU, term w := by
    simp [blockU, hu_not_prefix]
  have htotal : (∑ w : Fin (n + 1), term w) = n := by
    have hf_color : f ∈ coloringProfileFinset n m (partBThresholdLevel n) :=
      (mem_noEmptyColoringProfileFinset_iff.mp hf).1
    simpa [profileVertexWeight, term] using
      profileVertexWeight_eq_of_mem_coloringProfileFinset hf_color
  have hblock_eq_n : (∑ w ∈ blockU, term w) = n := by
    rw [Finset.sum_subset hblock_subset hzero_outside]
    exact htotal
  calc
    noEmptyProfileBoundaryStart n f u j + u.val =
        (∑ w ∈ prefixU, term w) + (j * u.val + u.val) := by
          dsimp [noEmptyProfileBoundaryStart, prefixU, term]
          omega
    _ = (∑ w ∈ prefixU, term w) + (f u).val * u.val := by
          have hmul : (j + 1) * u.val = (f u).val * u.val := by
            rw [hj_last]
          have hstep : j * u.val + u.val = (f u).val * u.val := by
            simpa [Nat.add_mul, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc] using hmul
          rw [hstep]
    _ = term u + ∑ w ∈ prefixU, term w := by
          simp [term, Nat.add_comm, Nat.mul_comm]
    _ = ∑ w ∈ blockU, term w := hblock_sum.symm
    _ = n := hblock_eq_n

theorem paperPartBExactNoEmptyProfileBoundaryNextPositiveStartTarget :
    PaperPartBExactNoEmptyProfileBoundaryNextPositiveStartTarget := by
  intro n m f hf u hu_pos j hj hj_last hlarger
  classical
  let L := noEmptyProfileLargerPositiveSizeFinset n f u
  let v : Fin (n + 1) := L.min' hlarger
  let prefixU : Finset (Fin (n + 1)) :=
    Finset.univ.filter (fun w : Fin (n + 1) => w.val < u.val)
  let prefixV : Finset (Fin (n + 1)) :=
    Finset.univ.filter (fun w : Fin (n + 1) => w.val < v.val)
  let blockU : Finset (Fin (n + 1)) := insert u prefixU
  let term : Fin (n + 1) → ℕ := fun w => w.val * (f w).val
  have hvL : v ∈ L := Finset.min'_mem L hlarger
  have huv : u.val < v.val := by
    simpa [L, noEmptyProfileLargerPositiveSizeFinset, v] using
      (Finset.mem_filter.mp hvL).2.1
  have hu_not_prefix : u ∉ prefixU := by
    simp [prefixU]
  have hblock_subset : blockU ⊆ prefixV := by
    intro x hx
    simp only [blockU, prefixU, prefixV, Finset.mem_insert, Finset.mem_filter,
      Finset.mem_univ, true_and] at hx ⊢
    rcases hx with rfl | hx
    · exact huv
    · exact lt_trans hx huv
  have hzero_between : ∀ x ∈ prefixV, x ∉ blockU → term x = 0 := by
    intro x hx_prefixV hx_not_block
    have hx_lt_v : x.val < v.val := by
      simpa [prefixV] using (Finset.mem_filter.mp hx_prefixV).2
