lemma partBExactNoEmptyPhiRemainderBinaryBudgetExpandedLhs_eq_noDelta_sub_log
    {δ : ℝ} (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) (hδ_pos : 0 < δ) :
    partBExactNoEmptyPhiRemainderBinaryBudgetExpandedLhs δ n f =
      partBExactNoEmptyPhiRemainderBinaryBudgetExpandedNoDeltaLhs n f - Real.log δ := by
