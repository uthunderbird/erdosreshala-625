  calc
    profileContribution n (partBTerminalProfile n m)
        = Real.exp (Real.log (profileContribution n (partBTerminalProfile n m))) :=
          (Real.exp_log hcontrib_pos).symm
    _ ≤ Real.exp (Real.log B) := Real.exp_le_exp.mpr hlog_le
    _ = B := Real.exp_log hB_pos
    _ = δ / (((Finset.range (partBPaperObstructionColorCount n + 1)).card + 1 : ℕ) : ℝ) := by
      rfl

