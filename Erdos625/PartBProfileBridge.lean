lemma partBTerminalPDenom_log_eq
    (n m : ℕ) :
    Real.log
      (((Nat.factorial (partBThresholdLevel n)) ^ partBTerminalTopCount n m *
        (Nat.factorial (partBThresholdLevel n - 1)) ^ partBTerminalLowCount n m : ℕ) : ℝ) =
      (partBTerminalTopCount n m : ℝ) *
        Real.log (Nat.factorial (partBThresholdLevel n)) +
        (partBTerminalLowCount n m : ℝ) *
          Real.log (Nat.factorial (partBThresholdLevel n - 1)) := by
  have htop_pos : 0 < ((Nat.factorial (partBThresholdLevel n) : ℕ) : ℝ) := by positivity
  have hlow_pos : 0 < ((Nat.factorial (partBThresholdLevel n - 1) : ℕ) : ℝ) := by positivity
  rw [Nat.cast_mul, Nat.cast_pow, Nat.cast_pow]
  rw [Real.log_mul (pow_ne_zero _ htop_pos.ne') (pow_ne_zero _ hlow_pos.ne')]
  rw [Real.log_pow, Real.log_pow]

lemma partBTerminalSymmDenom_log_eq
    (n m : ℕ) :
    Real.log
      ((Nat.factorial (partBTerminalTopCount n m) *
        Nat.factorial (partBTerminalLowCount n m) : ℕ) : ℝ) =
      Real.log (Nat.factorial (partBTerminalTopCount n m)) +
        Real.log (Nat.factorial (partBTerminalLowCount n m)) := by
  have htop_pos : 0 < ((Nat.factorial (partBTerminalTopCount n m) : ℕ) : ℝ) := by
    positivity
  have hlow_pos : 0 < ((Nat.factorial (partBTerminalLowCount n m) : ℕ) : ℝ) := by
    positivity
  rw [Nat.cast_mul]
  exact Real.log_mul htop_pos.ne' hlow_pos.ne'

lemma partBTerminalContributionRealQuotientSemiExpandedLogInnerBudgetLhs_eq_expanded
    {δ : ℝ} {n m : ℕ} :
    partBTerminalContributionRealQuotientSemiExpandedLogInnerBudgetLhs δ n m =
      partBTerminalContributionRealQuotientExpandedLogInnerBudgetLhs δ n m := by
  dsimp [partBTerminalContributionRealQuotientSemiExpandedLogInnerBudgetLhs,
    partBTerminalContributionRealQuotientExpandedLogInnerBudgetLhs]
  rw [partBTerminalPDenom_log_eq n m, partBTerminalSymmDenom_log_eq n m]
  ring

lemma partBTerminalContributionRealQuotientLogInnerBudgetLhs_eq_semiExpanded
    {δ : ℝ} {n m : ℕ} :
    partBTerminalContributionRealQuotientLogInnerBudgetLhs δ n m =
      partBTerminalContributionRealQuotientSemiExpandedLogInnerBudgetLhs δ n m := by
  set D : ℝ :=
    (((Nat.factorial (partBThresholdLevel n)) ^ partBTerminalTopCount n m *
      (Nat.factorial (partBThresholdLevel n - 1)) ^ partBTerminalLowCount n m : ℕ) : ℝ)
  set F : ℕ :=
    Nat.choose (partBThresholdLevel n) 2 * partBTerminalTopCount n m +
      Nat.choose (partBThresholdLevel n - 1) 2 * partBTerminalLowCount n m
  set Q : ℝ := (1 / 2 : ℝ) ^ F
  set S : ℝ :=
    ((Nat.factorial (partBTerminalTopCount n m) *
      Nat.factorial (partBTerminalLowCount n m) : ℕ) : ℝ)
  have hN_pos : 0 < (Nat.factorial n : ℝ) := by positivity
  have hD_pos : 0 < D := by
    dsimp [D]
    positivity
  have hQ_pos : 0 < Q := by
    dsimp [Q]
    positivity
  have hS_pos : 0 < S := by
    dsimp [S]
    positivity
  have hlogQ : Real.log Q = -((F : ℝ) * Real.log 2) := by
    dsimp [Q]
    rw [← Real.rpow_natCast, Real.log_rpow (by positivity : (0 : ℝ) < 1 / 2)]
    rw [show Real.log (1 / 2 : ℝ) = -Real.log 2 by
      rw [show (1 / 2 : ℝ) = (2 : ℝ)⁻¹ by norm_num, Real.log_inv]]
    ring
  dsimp [partBTerminalContributionRealQuotientLogInnerBudgetLhs,
    partBTerminalContributionRealQuotientSemiExpandedLogInnerBudgetLhs,
    partBTerminalContributionRealQuotientUpperFormula]
  change Real.log (((Nat.factorial n : ℝ) / D * Q / S)) -
      Real.log (partBFixedMInnerBudget δ n) =
    Real.log (Nat.factorial n) - Real.log D - ((F : ℝ) * Real.log 2) -
      Real.log S - Real.log (partBFixedMInnerBudget δ n)
  rw [Real.log_div (mul_ne_zero (div_ne_zero hN_pos.ne' hD_pos.ne') hQ_pos.ne') hS_pos.ne',
    Real.log_mul (div_ne_zero hN_pos.ne' hD_pos.ne') hQ_pos.ne',
    Real.log_div hN_pos.ne' hD_pos.ne', hlogQ]
  ring

lemma partBTerminalContributionFormulaLogInnerBudgetLhs_le_realQuotient
    {δ : ℝ} {n m : ℕ} (hfeas : PartBTerminalProfileFeasible n m) :
    partBTerminalContributionFormulaLogInnerBudgetLhs δ n m ≤
      partBTerminalContributionRealQuotientLogInnerBudgetLhs δ n m := by
  have hformula_pos : 0 < partBTerminalContributionFormula n m := by
    rw [← partBTerminalProfileContribution_eq_formula hfeas]
    exact partBTerminalProfileContribution_pos hfeas
  have hle :=
    partBTerminalContributionFormula_le_realQuotientUpper n m
  have hlog_le :
      Real.log (partBTerminalContributionFormula n m) ≤
        Real.log (partBTerminalContributionRealQuotientUpperFormula n m) :=
    Real.log_le_log hformula_pos hle
  dsimp [partBTerminalContributionFormulaLogInnerBudgetLhs,
    partBTerminalContributionRealQuotientLogInnerBudgetLhs]
  linarith

noncomputable def partBTerminalContributionDivisionFreeUpperFormula (n m : ℕ) : ℝ :=
  (Nat.factorial n : ℝ) *
    (1 / 2 : ℝ) ^
      (Nat.choose (partBThresholdLevel n) 2 * partBTerminalTopCount n m +
        Nat.choose (partBThresholdLevel n - 1) 2 * partBTerminalLowCount n m) /
    ((Nat.factorial (partBTerminalTopCount n m) *
      Nat.factorial (partBTerminalLowCount n m) : ℕ) : ℝ)

lemma partBTerminalContributionFormula_le_divisionFreeUpper
    (n m : ℕ) :
    partBTerminalContributionFormula n m ≤
      partBTerminalContributionDivisionFreeUpperFormula n m := by
  set D : ℕ :=
    (Nat.factorial (partBThresholdLevel n)) ^ partBTerminalTopCount n m *
      (Nat.factorial (partBThresholdLevel n - 1)) ^ partBTerminalLowCount n m
  set Q : ℝ :=
    (1 / 2 : ℝ) ^
      (Nat.choose (partBThresholdLevel n) 2 * partBTerminalTopCount n m +
        Nat.choose (partBThresholdLevel n - 1) 2 * partBTerminalLowCount n m)
  set S : ℝ :=
    ((Nat.factorial (partBTerminalTopCount n m) *
      Nat.factorial (partBTerminalLowCount n m) : ℕ) : ℝ)
  have hdiv : (((Nat.factorial n / D : ℕ) : ℝ)) ≤ (Nat.factorial n : ℝ) := by
    exact_mod_cast Nat.div_le_self (Nat.factorial n) D
  have hQ_nonneg : 0 ≤ Q := by
    dsimp [Q]
    positivity
  have hS_nonneg : 0 ≤ S := by
    dsimp [S]
    positivity
  dsimp [partBTerminalContributionFormula, partBTerminalContributionDivisionFreeUpperFormula]
  change (((Nat.factorial n / D : ℕ) : ℝ)) * Q / S ≤ (Nat.factorial n : ℝ) * Q / S
  exact div_le_div_of_nonneg_right
    (mul_le_mul_of_nonneg_right hdiv hQ_nonneg) hS_nonneg

noncomputable def partBTerminalContributionDivisionFreeLogInnerBudgetLhs
    (δ : ℝ) (n m : ℕ) : ℝ :=
  Real.log (partBTerminalContributionDivisionFreeUpperFormula n m) -
    Real.log (partBFixedMInnerBudget δ n)

lemma partBTerminalContributionFormulaLogInnerBudgetLhs_le_divisionFree
    {δ : ℝ} {n m : ℕ} (hfeas : PartBTerminalProfileFeasible n m) :
    partBTerminalContributionFormulaLogInnerBudgetLhs δ n m ≤
      partBTerminalContributionDivisionFreeLogInnerBudgetLhs δ n m := by
  have hformula_pos : 0 < partBTerminalContributionFormula n m := by
    rw [← partBTerminalProfileContribution_eq_formula hfeas]
    exact partBTerminalProfileContribution_pos hfeas
  have hle :=
    partBTerminalContributionFormula_le_divisionFreeUpper n m
  have hlog_le :
      Real.log (partBTerminalContributionFormula n m) ≤
        Real.log (partBTerminalContributionDivisionFreeUpperFormula n m) :=
    Real.log_le_log hformula_pos hle
  dsimp [partBTerminalContributionFormulaLogInnerBudgetLhs,
    partBTerminalContributionDivisionFreeLogInnerBudgetLhs]
  linarith

lemma partBTerminalContributionLogInnerBudgetLhs_eq_formula
    {δ : ℝ} {n m : ℕ} (hfeas : PartBTerminalProfileFeasible n m) :
    partBTerminalContributionLogInnerBudgetLhs δ n m =
      partBTerminalContributionFormulaLogInnerBudgetLhs δ n m := by
  dsimp [partBTerminalContributionLogInnerBudgetLhs,
    partBTerminalContributionFormulaLogInnerBudgetLhs]
  rw [partBTerminalProfileContribution_eq_formula hfeas]

/-- Terminal-specific logarithmic necessary budget target. Positivity of the terminal
contribution lets this avoid the zero-sum alternative required by the full fixed-`m` log-sum
target. -/
def PaperPartBTerminalContributionLogInnerBudgetTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      PartBTerminalProfileFeasible n m →
        partBTerminalContributionLogInnerBudgetLhs δ n m ≤ 0

