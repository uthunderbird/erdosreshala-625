def PaperPartBTerminalContributionEntropyFloorExactForbiddenUpperWorstMNoDeltaCoarseNPlusTwoTopPenaltyDenomSlopeLowerTarget
    (B ε : ℝ) : Prop :=
  ∃ b : ℝ, 0 < b ∧
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
      0 < partBPaperAverageClassLowerDenom B n →
        b * (n : ℝ) ≤
          ((((n : ℝ) -
                ((n : ℝ) / partBPaperAverageClassLowerDenom B n) *
                  ((partBThresholdLevel n - 1 : ℕ) : ℝ)) *
              (partBThresholdLevel n : ℝ) / 2) *
            Real.log 2)

noncomputable def partBTerminalContributionEntropyFloorExactForbiddenUpperWorstMNoDeltaCoarseNPlusTwoTopPenaltyDenomCoeff
    (B : ℝ) (n : ℕ) : ℝ :=
  (1 -
      (((partBThresholdLevel n - 1 : ℕ) : ℝ) /
        partBPaperAverageClassLowerDenom B n)) *
    (partBThresholdLevel n : ℝ) / 2 * Real.log 2

