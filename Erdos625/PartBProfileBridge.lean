    have hmul : (c / 4) * (((n + 2 : ℕ) : ℝ)) ≤ (c / 4) * (2 * (n : ℝ)) :=
      mul_le_mul_of_nonneg_left hn2_le (by linarith : 0 ≤ c / 4)
