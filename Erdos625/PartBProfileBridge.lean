    · intro s hsE
      rcases Finset.mem_filter.mp hsE with ⟨hs_enc, hs_gap⟩
      rcases mem_noEmptyProfileBoundaryEncoding_iff.mp hs_enc with ⟨v, hv_pos, j, hj, hs_repr⟩
      have hgap_v := paperPartBExactNoEmptyProfileBoundaryGapValueTarget n m f hf v hv_pos j hj
      let hstart_lt :=
        paperPartBExactNoEmptyProfileBoundaryStartLtTarget n m f hf v hv_pos j hj
      let sv : Fin n := ⟨noEmptyProfileBoundaryStart n f v j, hstart_lt⟩
      have hsv_eq : sv = s := by
        apply Fin.ext
