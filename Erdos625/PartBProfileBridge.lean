        rw [mem_noEmptyProfileBoundaryBlockFinset_iff]
        exact ⟨hv_pos, hj⟩
      have hpB : p ∈ B := by
        exact Finset.mem_filter.mpr ⟨hp_block, by simpa [p] using hv_eq_u⟩
