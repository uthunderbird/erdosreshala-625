        partBExactNoEmptyExplicitCoarseCoreProfileKernel n u ≤ 0

theorem paperPartBExactNoEmptyExplicitCoarseCoreProfileKernelNonposTarget_of_slope
    (hslope : PaperPartBExactNoEmptyExplicitCoarseCoreKernelSlopeNonposTarget) :
    PaperPartBExactNoEmptyExplicitCoarseCoreProfileKernelNonposTarget := by
  intro ε hε_pos
  rcases hslope ε hε_pos with ⟨n₀, hslope⟩
  refine ⟨n₀, fun n hn hmain u => ?_⟩
  exact partBExactNoEmptyExplicitCoarseCoreProfileKernel_nonpos_of_slope_nonpos
