    {δ : ℝ} {n m : ℕ} (hfeas : PartBTerminalProfileFeasible n m) :
    partBTerminalContributionLogExpandedLhs δ n m =
      Real.log (profileContribution n (partBTerminalProfile n m)) -
        Real.log (partBExactNoEmptyRawProfileBudget δ n m) := by
  exact partBExactNoEmptyContributionLogExpandedLhs_eq_logContribution_sub_logBudget
