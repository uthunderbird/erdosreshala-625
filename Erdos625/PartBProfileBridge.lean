def PaperPartBEndpointClosedVectorTailMomentExactFullDecayQBoundedProductSplitEnvelopeSumTarget
    (B : ℝ → ℝ → ℕ → ℕ) (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n),
      (∑ q ∈
          (partBEndpointNoEmptyDeficitVectorTailMomentFinset n hfeas.2.2.2.2).filter
            (fun q => q ≤ B ε δ n),
          partBEndpointClosedVectorTailMomentQBoundedProductCardUpper ε δ n q *
            partBEndpointClosedVectorTailMomentExpEnvelope
              (partBEndpointClosedVectorTailMomentFactorialSubFullDecayUpper
                partBEndpointClosedVectorTailMomentExactLayerFullDecayMin)
                  ε δ n q) +
        (∑ q ∈
          (partBEndpointNoEmptyDeficitVectorTailMomentFinset n hfeas.2.2.2.2).filter
            (fun q => ¬ q ≤ B ε δ n),
          partBEndpointClosedVectorTailMomentQBoundedProductCardUpper ε δ n q *
            partBEndpointClosedVectorTailMomentExpEnvelope
              (partBEndpointClosedVectorTailMomentFactorialSubFullDecayUpper
                partBEndpointClosedVectorTailMomentExactLayerFullDecayMin)
                  ε δ n q) ≤ (1 : ℝ) / 2

