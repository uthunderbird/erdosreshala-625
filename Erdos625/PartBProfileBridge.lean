    _ ≤ ∑ j ∈ pairSet, (e j).val := hsubset_sum
    _ ≤ (e top).val + (e pred).val := hpair_sum
    _ = partBEndpointDeficitVectorNearTopPairCountSumNat n e := by
      simp [partBEndpointDeficitVectorNearTopPairCountSumNat, top, pred]

lemma two_pow_sub_one_le_factorial (k : ℕ) :
    2 ^ (k - 1) ≤ Nat.factorial k := by
  induction k with
  | zero =>
      norm_num
  | succ k ih =>
      cases k with
      | zero =>
          norm_num
      | succ k =>
          have htwo : 2 ≤ k + 2 := by omega
          have hmul := Nat.mul_le_mul htwo ih
          simpa [Nat.factorial, pow_succ, Nat.mul_comm, Nat.mul_left_comm, Nat.mul_assoc]
            using hmul

lemma two_pow_add_sub_two_le_factorial_mul_factorial (a b : ℕ) :
    2 ^ (a + b - 2) ≤ Nat.factorial a * Nat.factorial b := by
  have ha := two_pow_sub_one_le_factorial a
  have hb := two_pow_sub_one_le_factorial b
  have hexp : a + b - 2 ≤ (a - 1) + (b - 1) := by
    omega
  calc
    2 ^ (a + b - 2) ≤ 2 ^ ((a - 1) + (b - 1)) :=
      Nat.pow_le_pow_right (by norm_num) hexp
    _ = 2 ^ (a - 1) * 2 ^ (b - 1) := by
      rw [pow_add]
    _ ≤ Nat.factorial a * Nat.factorial b :=
      Nat.mul_le_mul ha hb

