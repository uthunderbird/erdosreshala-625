    (δ : ℝ) (n : ℕ)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) : ℝ :=
  Real.log (partBEndpointDeficitVectorProfileP n e) -
    ((partBEndpointDeficitVectorProfileF n e : ℝ) * Real.log 2) -
    Real.log (partBEndpointDeficitVectorProfileSymm n e) -
    Real.log (partBExactNoEmptyFixedMInnerBudget δ n)

