/-- A pointwise no-empty profile budget implies the per-colour-count inner budget. -/
theorem paperPartBExactNoEmptyProfileInnerBudgetTarget_of_pointwise
    {ε δ : ℝ} (hδ_nonneg : 0 ≤ δ)
    (hpoint : PaperPartBExactNoEmptyProfilePointwiseTarget ε δ) :
    PaperPartBExactNoEmptyProfileInnerBudgetTarget ε δ := by
  rcases hpoint with ⟨n₀, hpoint⟩
  refine ⟨n₀, fun n hn hmain m hm => ?_⟩
  set R := Finset.range (partBPaperObstructionColorCount n + 1)
  set S := noEmptyColoringProfileFinset n m (partBThresholdLevel n)
  set B : ℝ := δ / ((((R.card + 1 : ℕ) : ℝ) * (((S.card + 1 : ℕ) : ℝ))))
  have h_each : ∀ f ∈ S, profileContribution n f ≤ B := by
    intro f hf
    simpa [R, S, B] using hpoint n hn hmain m hm f hf
  have hsum_le : (∑ f ∈ S, profileContribution n f) ≤ ∑ f ∈ S, B :=
    Finset.sum_le_sum h_each
  have hsum_const : ∑ f ∈ S, B = (S.card : ℝ) * B := by
    simp
  have hB_nonneg : 0 ≤ B := by
    dsimp [B]
    positivity
  have hinner_nonneg : 0 ≤ δ / (((R.card + 1 : ℕ) : ℝ)) := by
    positivity
  have hcard_budget :
      (S.card : ℝ) * B ≤ δ / (((R.card + 1 : ℕ) : ℝ)) := by
    dsimp [B]
    set A : ℝ := ((R.card + 1 : ℕ) : ℝ)
    set D : ℝ := ((S.card + 1 : ℕ) : ℝ)
    have hA_pos : 0 < A := by positivity
    have hD_pos : 0 < D := by positivity
    have hS_le_D : (S.card : ℝ) ≤ D := by
      dsimp [D]
      exact_mod_cast Nat.le_succ S.card
    calc
      (S.card : ℝ) * (δ / (A * D))
          ≤ D * (δ / (A * D)) := by
            exact mul_le_mul_of_nonneg_right hS_le_D
              (div_nonneg hδ_nonneg (mul_pos hA_pos hD_pos).le)
      _ = δ / A := by
        field_simp [ne_of_gt hA_pos, ne_of_gt hD_pos]
  exact ENNReal.ofReal_le_ofReal
    (le_trans hsum_le (by simpa [hsum_const, R, S, B] using hcard_budget))

/-- A real fixed-`m` inner budget implies the `ℝ≥0∞` inner budget used by the union bridge. -/
theorem paperPartBExactNoEmptyProfileInnerBudgetTarget_of_realInnerBudget
    {ε δ : ℝ}
    (hreal : PaperPartBExactNoEmptyProfileRealInnerBudgetTarget ε δ) :
    PaperPartBExactNoEmptyProfileInnerBudgetTarget ε δ := by
  rcases hreal with ⟨n₀, hreal⟩
  exact ⟨n₀, fun n hn hmain m hm =>
    ENNReal.ofReal_le_ofReal (hreal n hn hmain m hm)⟩

/-- A logarithmic fixed-`m` inner budget implies the corresponding real inner budget. -/
theorem paperPartBExactNoEmptyProfileRealInnerBudgetTarget_of_logSum
    {ε δ : ℝ} (hδ_pos : 0 < δ)
    (hlog : PaperPartBExactNoEmptyProfileContributionLogSumInnerBudgetTarget ε δ) :
    PaperPartBExactNoEmptyProfileRealInnerBudgetTarget ε δ := by
  rcases hlog with ⟨n₀, hlog⟩
  refine ⟨n₀, fun n hn hmain m hm => ?_⟩
  set R := Finset.range (partBPaperObstructionColorCount n + 1)
  set S := noEmptyColoringProfileFinset n m (partBThresholdLevel n)
  set X : ℝ := ∑ f ∈ S, profileContribution n f
  set B : ℝ := δ / (((R.card + 1 : ℕ) : ℝ))
  have hB_pos : 0 < B := by
    dsimp [B]
    positivity
  have hX_nonneg : 0 ≤ X := by
    dsimp [X]
    exact Finset.sum_nonneg (fun f _ => profileContribution_nonneg n f)
  by_cases hX_zero : X = 0
  · rw [hX_zero]
    simpa [R, B] using hB_pos.le
  · have hX_pos : 0 < X := lt_of_le_of_ne hX_nonneg (Ne.symm hX_zero)
    have hlog_le : Real.log X ≤ Real.log B := by
      rcases hlog n hn hmain m hm with hzero | hlog_le
      · exact False.elim (hX_zero (by simpa [S, X] using hzero))
      · simpa [R, S, X, B] using hlog_le
    calc
      (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
          profileContribution n f)
          = X := rfl
      _ = Real.exp (Real.log X) := (Real.exp_log hX_pos).symm
      _ ≤ Real.exp (Real.log B) := Real.exp_le_exp.mpr hlog_le
      _ = B := Real.exp_log hB_pos
      _ = δ / (((Finset.range (partBPaperObstructionColorCount n + 1)).card + 1 : ℕ) : ℝ) := by
        simp [R, B]

/-- A real fixed-`m` inner budget also gives the logarithmic fixed-`m` target, with the same
zero-sum convention. -/
theorem paperPartBExactNoEmptyProfileContributionLogSumInnerBudgetTarget_of_realInnerBudget
    {ε δ : ℝ} (hδ_pos : 0 < δ)
    (hreal : PaperPartBExactNoEmptyProfileRealInnerBudgetTarget ε δ) :
    PaperPartBExactNoEmptyProfileContributionLogSumInnerBudgetTarget ε δ := by
  rcases hreal with ⟨n₀, hreal⟩
  refine ⟨n₀, fun n hn hmain m hm => ?_⟩
  set R := Finset.range (partBPaperObstructionColorCount n + 1)
  set S := noEmptyColoringProfileFinset n m (partBThresholdLevel n)
  set X : ℝ := ∑ f ∈ S, profileContribution n f
  set B : ℝ := δ / (((R.card + 1 : ℕ) : ℝ))
  have hB_pos : 0 < B := by
    dsimp [B]
    positivity
  have hX_nonneg : 0 ≤ X := by
    dsimp [X]
    exact Finset.sum_nonneg (fun f _ => profileContribution_nonneg n f)
  have hX_le : X ≤ B := by
    simpa [R, S, X, B] using hreal n hn hmain m hm
  by_cases hX_zero : X = 0
  · left
    simpa [S, X] using hX_zero
  · right
    have hX_pos : 0 < X := lt_of_le_of_ne hX_nonneg (Ne.symm hX_zero)
    have hlog_le : Real.log X ≤ Real.log B :=
      Real.log_le_log hX_pos hX_le
    simpa [R, S, X, B] using hlog_le

/-- The fixed-`m` expanded Laplace target proves the real fixed-`m` inner budget. -/
theorem paperPartBExactNoEmptyProfileRealInnerBudgetTarget_of_fixedMExpandedLaplace
    {ε δ : ℝ} (hδ_pos : 0 < δ)
    (hlaplace :
      PaperPartBExactNoEmptyProfileContributionFixedMExpandedLaplaceTarget ε δ) :
    PaperPartBExactNoEmptyProfileRealInnerBudgetTarget ε δ := by
  rcases hlaplace with ⟨n₀, hlaplace⟩
  refine ⟨n₀, fun n hn hmain m hm => ?_⟩
  set S := noEmptyColoringProfileFinset n m (partBThresholdLevel n)
  set B : ℝ := partBExactNoEmptyFixedMInnerBudget δ n
  set X : ℝ := ∑ f ∈ S, profileContribution n f
  have hB_pos : 0 < B := by
    dsimp [B, partBExactNoEmptyFixedMInnerBudget]
    positivity
  have h_each :
      ∀ f ∈ S,
        Real.exp (partBExactNoEmptyContributionLogFixedMExpandedLhs δ n m f) =
          profileContribution n f / B := by
    intro f hf
    have hf_color : f ∈ coloringProfileFinset n m (partBThresholdLevel n) :=
      (mem_noEmptyColoringProfileFinset_iff.mp hf).1
    have hP : 0 < profileP n (fun u => (f u).val) :=
      profileP_pos_of_mem_coloringProfileFinset hf_color
    have hcontrib_pos : 0 < profileContribution n f :=
      profileContribution_pos_of_profileP_pos n f hP
    calc
      Real.exp (partBExactNoEmptyContributionLogFixedMExpandedLhs δ n m f)
          = Real.exp (Real.log (profileContribution n f) - Real.log B) := by
            rw [partBExactNoEmptyContributionLogFixedMExpandedLhs_eq_logContribution_sub_logBudget
              (by simpa [S] using hf)]
      _ = Real.exp (Real.log (profileContribution n f)) / Real.exp (Real.log B) := by
        rw [Real.exp_sub]
      _ = profileContribution n f / B := by
        rw [Real.exp_log hcontrib_pos, Real.exp_log hB_pos]
  have hsum_eq :
      (∑ f ∈ S,
        Real.exp (partBExactNoEmptyContributionLogFixedMExpandedLhs δ n m f)) = X / B := by
    calc
      (∑ f ∈ S,
        Real.exp (partBExactNoEmptyContributionLogFixedMExpandedLhs δ n m f))
          = ∑ f ∈ S, profileContribution n f / B := by
            exact Finset.sum_congr rfl (fun f hf => h_each f hf)
      _ = X / B := by
        simp [X, div_eq_mul_inv, Finset.sum_mul]
  have hdiv_le : X / B ≤ 1 := by
    simpa [S, B, X, hsum_eq] using hlaplace n hn hmain m hm
  have hX_le : X ≤ B := by
    have hmul := (div_le_iff₀ hB_pos).mp hdiv_le
    simpa using hmul
  simpa [S, B, X, partBExactNoEmptyFixedMInnerBudget] using hX_le

/-- The non-logarithmic normalized contribution target proves the expanded Laplace target. -/
