theorem paperPartBExactNoEmptyProfileBinaryBalancedQuadraticScalarPointwiseTarget_of_uniformDecay
    {ε δ : ℝ}
    (hdecay : PaperPartBExactNoEmptyBinaryBalancedQuadraticUniformDecayTarget)
    (hε_pos : 0 < ε) (hδ_pos : 0 < δ) :
    PaperPartBExactNoEmptyProfileBinaryBalancedQuadraticScalarPointwiseTarget ε δ := by
  rcases hdecay ε (Real.log δ) hε_pos with ⟨n₀, hdecay⟩
  refine ⟨n₀, fun n hn hmain m hm hm_pos => ?_⟩
  have h :=
    hdecay n hn hmain m hm hm_pos
  have hbudget :
      partBExactNoEmptyBinaryLogCoreBudget δ n =
        Real.log δ - Real.log (partBExactNoEmptyBinaryBudgetDenom n) :=
    partBExactNoEmptyBinaryLogCoreBudget_eq_log_sub_log_denom n hδ_pos
  linarith

