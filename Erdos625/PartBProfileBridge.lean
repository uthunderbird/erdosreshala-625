/-- Expectation-level quotient-count target for the paper-aligned obstruction event.

This is the first-moment statement the paper route should actually prove after quotienting by
colour-label permutations. Markov's inequality then turns it into
`PaperPartBUnorderedFailureEventTarget` without the ordered `k!` loss. -/
def PaperPartBUnorderedCountExpectationTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    (∫⁻ G : SimpleGraph (Fin n),
      (unorderedClassColoringCount n
        (partBPaperObstructionColorCount n) (partBThresholdLevel n) G : ℝ≥0∞) ∂(gnHalf n)) ≤
      ENNReal.ofReal δ

/-- The remaining paper-level expectation shell for the unordered Part B route.

This target names the only mathematical step still missing after the quotient-count Markov bridge:
convert the paper obstruction estimate into the corresponding expectation bound for the
quotient-count random variable. -/
def PaperPartBUnorderedExpectationShellTarget : Prop :=
  ∀ ε δ : ℝ, 0 < ε → 0 < δ →
    PaperPartBUnorderedObstructionTarget ε δ → PaperPartBUnorderedCountExpectationTarget ε δ

/-- Direct quotient-count expectation comparison needed to discharge the unordered expectation
shell.

This is a candidate counting theorem suggested by the paper formula. It remains under audit:
the current quotient count treats empty colour labels by orbit stabilizers, while
`expectedTBoundedColorings` is normalized by the full `k!` ordered-label factor. A proof of this
target must first resolve the empty-colour convention or replace the random variable by a
paper-weighted one. -/
def PaperPartBUnorderedExpectationComparisonTarget : Prop :=
  ∀ n : ℕ,
    (∫⁻ G : SimpleGraph (Fin n),
      (unorderedClassColoringCount n
        (partBPaperObstructionColorCount n) (partBThresholdLevel n) G : ℝ≥0∞) ∂(gnHalf n)) ≤
      ENNReal.ofReal
        (expectedTBoundedColorings n
          (partBPaperObstructionColorCount n) (partBThresholdLevel n))

/-- The direct quotient-count expectation comparison discharges the named expectation shell. -/
theorem paperPartBUnorderedExpectationShellTarget_of_expectationComparison
    (hcompare : PaperPartBUnorderedExpectationComparisonTarget) :
    PaperPartBUnorderedExpectationShellTarget := by
  intro ε δ _hε_pos _hδ_pos hobstruction
  obtain ⟨n₀, hobstruction⟩ := hobstruction
  refine ⟨n₀, ?_⟩
  intro n hn hnMain
  exact (hcompare n).trans
    (ENNReal.ofReal_le_ofReal (hobstruction n hn hnMain))

/-- Markov conversion from the quotient-count expectation target to the unordered obstruction
event target. -/
theorem paperPartBUnorderedFailureEventTarget_of_countExpectation
    {ε δ : ℝ} (hcount : PaperPartBUnorderedCountExpectationTarget ε δ) :
    PaperPartBUnorderedFailureEventTarget ε δ := by
  obtain ⟨n₀, hcount⟩ := hcount
  refine ⟨n₀, ?_⟩
  intro n hn hnMain
  set k := partBPaperObstructionColorCount n
  set t := partBThresholdLevel n
  have hmarkov :
      gnHalf n {G : SimpleGraph (Fin n) | 1 ≤ unorderedClassColoringCount n k t G} ≤
        ∫⁻ G : SimpleGraph (Fin n),
          (unorderedClassColoringCount n k t G : ℝ≥0∞) ∂(gnHalf n) :=
    MeasureTheory.meas_le_lintegral₀
      (f := fun G : SimpleGraph (Fin n) =>
        (unorderedClassColoringCount n k t G : ℝ≥0∞))
      (aemeasurable_unorderedClassColoringCount n k t)
      (fun G hG => by
        simp only [Set.mem_setOf_eq] at hG
        have hG' :
            ((1 : ℕ) : ℝ≥0∞) ≤
              (unorderedClassColoringCount n k t G : ℝ≥0∞) := by
          exact_mod_cast hG
        simpa using hG')
  have hset_sub :
      {G : SimpleGraph (Fin n) | UnorderedClassBoundedColoringExists n k t G} ⊆
        {G : SimpleGraph (Fin n) | 1 ≤ unorderedClassColoringCount n k t G} := by
    intro G hG
    simp only [Set.mem_setOf_eq]
    exact Nat.succ_le_of_lt ((unorderedClassColoringCount_pos_iff n k t G).mp hG)
  calc
    gnHalf n {G : SimpleGraph (Fin n) | UnorderedClassBoundedColoringExists n k t G} ≤
        gnHalf n {G : SimpleGraph (Fin n) | 1 ≤ unorderedClassColoringCount n k t G} :=
      MeasureTheory.measure_mono hset_sub
    _ ≤ ∫⁻ G : SimpleGraph (Fin n),
          (unorderedClassColoringCount n k t G : ℝ≥0∞) ∂(gnHalf n) :=
      hmarkov
    _ ≤ ENNReal.ofReal δ := by
      simpa [k, t] using hcount n hn hnMain

/-- Event-shell target for the paper-aligned unordered route. This is the now-isolated
probabilistic obligation: turn the paper obstruction estimate into a small probability for the
unordered `k_t - 2` obstruction event. -/
def PaperPartBUnorderedEventShellTarget : Prop :=
  ∀ ε δ : ℝ, 0 < ε → 0 < δ →
    PaperPartBUnorderedObstructionTarget ε δ → PaperPartBUnorderedFailureEventTarget ε δ

/-- The expectation shell implies the event shell by the checked quotient-count Markov bridge. -/
theorem paperPartBUnorderedEventShellTarget_of_countExpectationShell
    (hshell : PaperPartBUnorderedExpectationShellTarget) :
    PaperPartBUnorderedEventShellTarget := by
  intro ε δ hε_pos hδ_pos hobstruction
  exact paperPartBUnorderedFailureEventTarget_of_countExpectation
    (hshell ε δ hε_pos hδ_pos hobstruction)

/-- The bad lower-bound event implies existence of an unordered `k_t - 2` obstruction. -/
lemma partBLowerFailure_subset_unorderedPaperObstructionExists (n : ℕ) :
    ({G : SimpleGraph (Fin n) |
      partBErrorColorCount n ≤ classBoundedChromaticNumber n (partBThresholdLevel n) G}ᶜ) ⊆
      {G : SimpleGraph (Fin n) |
        UnorderedClassBoundedColoringExists n
          (partBPaperObstructionColorCount n) (partBThresholdLevel n) G} := by
  intro G hG
  simp only [Set.mem_compl_iff, Set.mem_setOf_eq] at hG ⊢
  have hlt :
      classBoundedChromaticNumber n (partBThresholdLevel n) G < partBErrorColorCount n :=
    Nat.lt_of_not_ge hG
  have hle :
      classBoundedChromaticNumber n (partBThresholdLevel n) G ≤
        partBPaperObstructionColorCount n := by
    unfold partBErrorColorCount at hlt
    unfold partBPaperObstructionColorCount
    omega
  exact (unorderedClassBoundedColoringExists_iff n
    (partBPaperObstructionColorCount n) (partBThresholdLevel n) G).mpr
      (classBoundedColoringExists_of_chromatic_le G (partBThresholdLevel_pos n) hle)

/-- A small unordered obstruction event probability gives the bad-event target. -/
theorem paperPartBLowerFailureProbabilityTarget_of_unorderedFailureEvent
    {ε δ : ℝ} (hevent : PaperPartBUnorderedFailureEventTarget ε δ) :
    PaperPartBLowerFailureProbabilityTarget ε δ := by
  obtain ⟨n₀, hevent⟩ := hevent
  refine ⟨n₀, ?_⟩
  intro n hn hnMain
  exact (MeasureTheory.measure_mono
    (partBLowerFailure_subset_unorderedPaperObstructionExists n)).trans
      (hevent n hn hnMain)

/-- A small bad-event probability immediately gives the lower-probability target. -/
theorem paperPartBLowerProbabilityTarget_of_failureProbability
    {ε δ : ℝ} (hfail : PaperPartBLowerFailureProbabilityTarget ε δ) :
    PaperPartBLowerProbabilityTarget ε δ := by
  obtain ⟨n₀, hfail⟩ := hfail
  refine ⟨n₀, ?_⟩
  intro n hn hnMain
  let A : Set (SimpleGraph (Fin n)) :=
    {G : SimpleGraph (Fin n) |
      partBErrorColorCount n ≤ classBoundedChromaticNumber n (partBThresholdLevel n) G}
  have hAc_le : gnHalf n Aᶜ ≤ ENNReal.ofReal δ := by
    simpa [A] using hfail n hn hnMain
  have hA_meas : MeasurableSet A := (Set.to_countable A).measurableSet
  haveI : IsProbabilityMeasure (gnHalf n) := by
    unfold gnHalf
    infer_instance
  have hprob_A : 1 - ENNReal.ofReal δ ≤ gnHalf n A := by
    calc
      1 - ENNReal.ofReal δ ≤ 1 - gnHalf n Aᶜ := tsub_le_tsub_left hAc_le 1
      _ = gnHalf n A := by
        rw [prob_compl_eq_one_sub (μ := gnHalf n) hA_meas]
        exact ENNReal.sub_sub_cancel one_ne_top prob_le_one
  simpa [A] using hprob_A

/-- A small unordered obstruction event probability gives the lower-probability target directly. -/
theorem paperPartBLowerProbabilityTarget_of_unorderedFailureEvent
    {ε δ : ℝ} (hevent : PaperPartBUnorderedFailureEventTarget ε δ) :
    PaperPartBLowerProbabilityTarget ε δ :=
  paperPartBLowerProbabilityTarget_of_failureProbability
    (paperPartBLowerFailureProbabilityTarget_of_unorderedFailureEvent hevent)

/-- Missing unordered probability shell for the paper-aligned Part B route.

Proving this target, together with `PaperPartBUnorderedObstructionTarget`, would replace the
current ordered `k! * E_{n,k_t-1,t}` shell by the paper's first-moment obstruction at `k_t - 2`.
It is deliberately not used by the live theorem chain yet. -/
def PaperPartBUnorderedProbabilityShellTarget : Prop :=
  ∀ ε δ : ℝ, 0 < ε → 0 < δ →
    PaperPartBUnorderedObstructionTarget ε δ → PaperPartBLowerProbabilityTarget ε δ

/-- More decomposed unordered shell target: prove only that the paper obstruction estimate makes
the bad lower-bound event rare. The complement conversion is handled by
`paperPartBLowerProbabilityTarget_of_failureProbability`. -/
def PaperPartBUnorderedFailureShellTarget : Prop :=
  ∀ ε δ : ℝ, 0 < ε → 0 < δ →
    PaperPartBUnorderedObstructionTarget ε δ → PaperPartBLowerFailureProbabilityTarget ε δ

/-- The decomposed bad-event shell is sufficient for the probability shell currently selected in
the roadmap. -/
theorem paperPartBUnorderedProbabilityShellTarget_of_failureShell
    (hshell : PaperPartBUnorderedFailureShellTarget) :
    PaperPartBUnorderedProbabilityShellTarget := by
  intro ε δ hε_pos hδ_pos hobstruction
  exact paperPartBLowerProbabilityTarget_of_failureProbability
    (hshell ε δ hε_pos hδ_pos hobstruction)

/-- The event-shell target implies the failure-shell target. -/
theorem paperPartBUnorderedFailureShellTarget_of_eventShell
    (hshell : PaperPartBUnorderedEventShellTarget) :
    PaperPartBUnorderedFailureShellTarget := by
  intro ε δ hε_pos hδ_pos hobstruction
  exact paperPartBLowerFailureProbabilityTarget_of_unorderedFailureEvent
    (hshell ε δ hε_pos hδ_pos hobstruction)

/-- The event-shell target implies the full selected unordered probability shell. -/
theorem paperPartBUnorderedProbabilityShellTarget_of_eventShell
    (hshell : PaperPartBUnorderedEventShellTarget) :
    PaperPartBUnorderedProbabilityShellTarget :=
  paperPartBUnorderedProbabilityShellTarget_of_failureShell
    (paperPartBUnorderedFailureShellTarget_of_eventShell hshell)

/-- The expectation shell implies the selected unordered probability shell. -/
theorem paperPartBUnorderedProbabilityShellTarget_of_countExpectationShell
    (hshell : PaperPartBUnorderedExpectationShellTarget) :
    PaperPartBUnorderedProbabilityShellTarget :=
  paperPartBUnorderedProbabilityShellTarget_of_eventShell
    (paperPartBUnorderedEventShellTarget_of_countExpectationShell hshell)

/-- Profile finset at the Part B error level. -/
def partBErrorProfileFinset (n : ℕ) : Finset (Fin (n + 1) → Fin (n + 1)) :=
  coloringProfileFinset n (partBErrorColorCount n) (partBThresholdLevel n)

/-- Profile finset at the paper's unordered obstruction level `k_t - 2`. -/
def partBPaperObstructionProfileFinset (n : ℕ) : Finset (Fin (n + 1) → Fin (n + 1)) :=
  coloringProfileFinset n (partBPaperObstructionColorCount n) (partBThresholdLevel n)

lemma mem_partBErrorProfileFinset_iff
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)} :
    f ∈ partBErrorProfileFinset n ↔
      profileVertexWeight n f = n ∧
      profileColorCount n f = partBErrorColorCount n ∧
      ∀ u : Fin (n + 1), partBThresholdLevel n < u.val → (f u).val = 0 := by
  simp [partBErrorProfileFinset, mem_coloringProfileFinset_iff]

lemma profileVertexWeight_eq_of_mem_partBErrorProfileFinset
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ partBErrorProfileFinset n) :
    profileVertexWeight n f = n :=
  (mem_partBErrorProfileFinset_iff.mp hf).1

lemma profileColorCount_eq_of_mem_partBErrorProfileFinset
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ partBErrorProfileFinset n) :
    profileColorCount n f = partBErrorColorCount n :=
  (mem_partBErrorProfileFinset_iff.mp hf).2.1

lemma support_zero_above_partBThresholdLevel_of_mem_partBErrorProfileFinset
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ partBErrorProfileFinset n) :
    ∀ u : Fin (n + 1), partBThresholdLevel n < u.val → (f u).val = 0 :=
  (mem_partBErrorProfileFinset_iff.mp hf).2.2

/-- Re-express a Part B profile with its own colour count.

Many profile lemmas in `FirstMomentThreshold.lean` are stated with the colour count
`∑ u, f u`. This bridge keeps the Part B finset as the source of truth while exposing that
API shape. -/
lemma mem_coloringProfileFinset_profileColorCount_of_mem_partBErrorProfileFinset
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ partBErrorProfileFinset n) :
    f ∈ coloringProfileFinset n (profileColorCount n f) (partBThresholdLevel n) := by
  rw [mem_coloringProfileFinset_iff]
  exact ⟨profileVertexWeight_eq_of_mem_partBErrorProfileFinset hf, rfl,
    support_zero_above_partBThresholdLevel_of_mem_partBErrorProfileFinset hf⟩

lemma mem_coloringProfileFinset_sumColorCount_of_mem_partBErrorProfileFinset
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ partBErrorProfileFinset n) :
    f ∈ coloringProfileFinset n (∑ u : Fin (n + 1), (f u).val) (partBThresholdLevel n) := by
  simpa [profileColorCount] using
    mem_coloringProfileFinset_profileColorCount_of_mem_partBErrorProfileFinset hf

/-- Normalize the Part B level once the main-range proof has shown `thresholdFloor n - 1 ≥ 1`. -/
lemma partBThresholdLevel_eq_thresholdFloor_sub_one_of_one_le
    {n : ℕ} (hαm1_ge_one : 1 ≤ thresholdFloor n - 1) :
    partBThresholdLevel n = thresholdFloor n - 1 :=
  max_eq_right hαm1_ge_one

/-- Rewrite the Part B profile finset when the threshold level has already been normalized to
`thresholdFloor n - 1`. This is the form used by most existing profile-route targets. -/
lemma mem_thresholdMinusOneProfile_of_mem_partBErrorProfileFinset
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (ht : partBThresholdLevel n = thresholdFloor n - 1)
    (hf : f ∈ partBErrorProfileFinset n) :
    f ∈ coloringProfileFinset n (∑ u : Fin (n + 1), (f u).val) (thresholdFloor n - 1) := by
  simpa [ht] using mem_coloringProfileFinset_sumColorCount_of_mem_partBErrorProfileFinset hf

/-- Main-use variant of `mem_thresholdMinusOneProfile_of_mem_partBErrorProfileFinset` with the
usual threshold-level side condition instead of a precomputed equality. -/
lemma mem_thresholdMinusOneProfile_of_mem_partBErrorProfileFinset_of_one_le
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hαm1_ge_one : 1 ≤ thresholdFloor n - 1)
    (hf : f ∈ partBErrorProfileFinset n) :
    f ∈ coloringProfileFinset n (∑ u : Fin (n + 1), (f u).val) (thresholdFloor n - 1) :=
  mem_thresholdMinusOneProfile_of_mem_partBErrorProfileFinset
    (partBThresholdLevel_eq_thresholdFloor_sub_one_of_one_le hαm1_ge_one) hf

/-- The Part B first-moment error as an explicit profile-contribution sum. -/
def ProfileContributionSumPartBErrorTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    Nat.factorial (partBErrorColorCount n) *
      (∑ f ∈ partBErrorProfileFinset n, profileContribution n f) ≤ δ

/-- Pointwise profile-contribution target strong enough to sum over all Part B profiles.

The denominator uses `card + 1` instead of `card` to avoid a nonemptiness side condition. This is
not intended as the final sharp analytic statement; it is a safe summation interface for future
profile-level estimates. -/
def ProfileContributionPointwisePartBTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ f ∈ partBErrorProfileFinset n,
      Nat.factorial (partBErrorColorCount n) * profileContribution n f ≤
        δ / ((partBErrorProfileFinset n).card + 1 : ℝ)

/-- Per-profile raw contribution budget after reserving a uniform `(card + 1)` share and the
factorial bookkeeping from the first-moment bound. -/
noncomputable def partBRawProfileContributionBudget (δ : ℝ) (n : ℕ) : ℝ :=
  δ /
    ((Nat.factorial (partBErrorColorCount n) : ℝ) *
      ((partBErrorProfileFinset n).card + 1 : ℝ))

/-- Log-core version of `partBRawProfileContributionBudget`. -/
noncomputable def partBLogCoreBudget (δ : ℝ) (n : ℕ) : ℝ :=
  Real.log (partBRawProfileContributionBudget δ n)

lemma partBRawProfileContributionBudget_pos
    {δ : ℝ} (n : ℕ) (hδ_pos : 0 < δ) :
    0 < partBRawProfileContributionBudget δ n := by
  dsimp [partBRawProfileContributionBudget]
  positivity

lemma partBLogCoreBudget_exp
    {δ : ℝ} (n : ℕ) (hδ_pos : 0 < δ) :
    Real.exp (partBLogCoreBudget δ n) = partBRawProfileContributionBudget δ n := by
  rw [partBLogCoreBudget, Real.exp_log (partBRawProfileContributionBudget_pos n hδ_pos)]

/-- Raw profile-contribution target before multiplying by `k!`.

This is closer to the paper's unordered-profile expectation estimates: the analytic route should
bound `profileContribution n f`, and this module then supplies the factorial and finite-sum
bookkeeping. -/
def RawProfileContributionPointwisePartBTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ f ∈ partBErrorProfileFinset n,
      profileContribution n f ≤ partBRawProfileContributionBudget δ n

/-- Log-core pointwise target for the Part B profile route.

This is the most direct current interface to the existing `FirstMomentThreshold.lean`
profile machinery: future `L_0`/cont2 estimates should bound `profileCombinatorialLogCore`,
and the theorem below converts that into the raw contribution target. -/
def ProfileCombinatorialLogCorePointwisePartBTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ f ∈ partBErrorProfileFinset n,
      profileCombinatorialLogCore n f ≤ partBLogCoreBudget δ n

/-- Concrete remaining theorem surface for the profile-level Part B route.

Once this target is proved from the paper's `L_0`/cont2 analysis, the exact Part B error target
follows by already-checked bookkeeping lemmas in this file. -/
def ProfileLogCoreBridgeTarget : Prop :=
  ∀ ε δ : ℝ, 0 < ε → 0 < δ → ProfileCombinatorialLogCorePointwisePartBTarget ε δ

/-- At the Part B level, `expectedTBoundedColorings` is exactly the profile contribution sum.

This theorem is the first concrete decomposition step for the `L_0` route: future estimates can
target the summands/profiles directly and then reassemble the original Part B error target. -/
theorem expectedTBoundedColorings_partB_eq_profileContribution_sum (n : ℕ) :
    expectedTBoundedColorings n (partBErrorColorCount n) (partBThresholdLevel n) =
      ∑ f ∈ partBErrorProfileFinset n, profileContribution n f := by
  simp [expectedTBoundedColorings, profileContribution, partBErrorProfileFinset]

/-- At the paper obstruction level, `expectedTBoundedColorings` is the corresponding profile
contribution sum. -/
theorem expectedTBoundedColorings_partBPaperObstruction_eq_profileContribution_sum (n : ℕ) :
    expectedTBoundedColorings n
        (partBPaperObstructionColorCount n) (partBThresholdLevel n) =
      ∑ f ∈ partBPaperObstructionProfileFinset n, profileContribution n f := by
  simp [expectedTBoundedColorings, profileContribution, partBPaperObstructionProfileFinset]

/-- A bound on the explicit profile-contribution sum implies the exact Part B error target. -/
theorem profileLevelPartBErrorTarget_of_profileContributionSum
    {ε δ : ℝ} (hsum : ProfileContributionSumPartBErrorTarget ε δ) :
    ProfileLevelPartBErrorTarget ε δ := by
  rcases hsum with ⟨n₀, hsum⟩
  refine ⟨n₀, fun n hn hmain => ?_⟩
  simpa [expectedTBoundedColorings_partB_eq_profileContribution_sum] using hsum n hn hmain

/-- A pointwise profile-contribution bound implies the summed profile-contribution target. -/
theorem profileContributionSumPartBErrorTarget_of_pointwise
    {ε δ : ℝ} (hδ_nonneg : 0 ≤ δ)
    (hpoint : ProfileContributionPointwisePartBTarget ε δ) :
    ProfileContributionSumPartBErrorTarget ε δ := by
  rcases hpoint with ⟨n₀, hpoint⟩
  refine ⟨n₀, fun n hn hmain => ?_⟩
  set S := partBErrorProfileFinset n
  set B : ℝ := δ / ((S.card + 1 : ℕ) : ℝ)
  have h_each : ∀ f ∈ S,
      Nat.factorial (partBErrorColorCount n) * profileContribution n f ≤ B := by
    intro f hf
    simpa [S, B] using hpoint n hn hmain f hf
  have hsum_le : Nat.factorial (partBErrorColorCount n) *
      (∑ f ∈ S, profileContribution n f) ≤ ∑ f ∈ S, B := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum h_each
  have hB_nonneg : 0 ≤ B := by
    dsimp [B]
    positivity
  have hsum_const : ∑ f ∈ S, B = (S.card : ℝ) * B := by
    simp
  have hcard_le : (S.card : ℝ) * B ≤ δ := by
    dsimp [B]
    by_cases hδ : δ = 0
    · simp [hδ]
    · have hδ_pos : 0 < δ := lt_of_le_of_ne hδ_nonneg (Ne.symm hδ)
      have hden_pos : 0 < ((S.card + 1 : ℕ) : ℝ) := by positivity
      have hcard_le_succ : (S.card : ℝ) ≤ ((S.card + 1 : ℕ) : ℝ) := by exact_mod_cast Nat.le_succ _
      calc
        (S.card : ℝ) * (δ / ((S.card + 1 : ℕ) : ℝ))
            ≤ ((S.card + 1 : ℕ) : ℝ) * (δ / ((S.card + 1 : ℕ) : ℝ)) := by
              exact mul_le_mul_of_nonneg_right hcard_le_succ (div_nonneg hδ_nonneg hden_pos.le)
        _ = δ := by field_simp [ne_of_gt hden_pos]
  calc
    Nat.factorial (partBErrorColorCount n) * (∑ f ∈ S, profileContribution n f)
        ≤ ∑ f ∈ S, B := hsum_le
    _ = (S.card : ℝ) * B := hsum_const
    _ ≤ δ := hcard_le

/-- A pointwise profile-contribution bound implies the exact Part B error target. -/
theorem profileLevelPartBErrorTarget_of_pointwiseProfileContribution
    {ε δ : ℝ} (hδ_nonneg : 0 ≤ δ)
    (hpoint : ProfileContributionPointwisePartBTarget ε δ) :
    ProfileLevelPartBErrorTarget ε δ :=
  profileLevelPartBErrorTarget_of_profileContributionSum
    (profileContributionSumPartBErrorTarget_of_pointwise hδ_nonneg hpoint)

/-- A raw profile-contribution target implies the factorial-weighted pointwise target. -/
theorem profileContributionPointwisePartBTarget_of_raw
    {ε δ : ℝ} (hraw : RawProfileContributionPointwisePartBTarget ε δ) :
    ProfileContributionPointwisePartBTarget ε δ := by
  rcases hraw with ⟨n₀, hraw⟩
  refine ⟨n₀, fun n hn hmain f hf => ?_⟩
  set S := partBErrorProfileFinset n
  set F : ℝ := (Nat.factorial (partBErrorColorCount n) : ℝ)
  set D : ℝ := ((S.card + 1 : ℕ) : ℝ)
  have hF_pos : 0 < F := by
    dsimp [F]
    exact_mod_cast Nat.factorial_pos (partBErrorColorCount n)
  have hD_pos : 0 < D := by positivity
  have hraw' : profileContribution n f ≤ δ / (F * D) := by
    simpa [S, F, D] using hraw n hn hmain f hf
  calc
    Nat.factorial (partBErrorColorCount n) * profileContribution n f
        ≤ F * (δ / (F * D)) := by
          simpa [F] using mul_le_mul_of_nonneg_left hraw' hF_pos.le
    _ = δ / D := by
          field_simp [ne_of_gt hF_pos, ne_of_gt hD_pos]
    _ = δ / ((S.card : ℝ) + 1) := by
          simp [D]

/-- A raw profile-contribution target implies the exact Part B error target. -/
theorem profileLevelPartBErrorTarget_of_rawProfileContribution
    {ε δ : ℝ} (hδ_nonneg : 0 ≤ δ)
    (hraw : RawProfileContributionPointwisePartBTarget ε δ) :
    ProfileLevelPartBErrorTarget ε δ :=
  profileLevelPartBErrorTarget_of_pointwiseProfileContribution hδ_nonneg
    (profileContributionPointwisePartBTarget_of_raw hraw)

/-- A log-core pointwise target implies the raw profile-contribution target. -/
theorem rawProfileContributionPointwisePartBTarget_of_logCore
    {ε δ : ℝ} (hδ_pos : 0 < δ)
    (hcore : ProfileCombinatorialLogCorePointwisePartBTarget ε δ) :
    RawProfileContributionPointwisePartBTarget ε δ := by
  rcases hcore with ⟨n₀, hcore⟩
  refine ⟨n₀, fun n hn hmain f hf => ?_⟩
  set S := partBErrorProfileFinset n
  set F : ℝ := (Nat.factorial (partBErrorColorCount n) : ℝ)
  set D : ℝ := ((S.card + 1 : ℕ) : ℝ)
  set R : ℝ := δ / (F * D)
  have hF_pos : 0 < F := by
    dsimp [F]
    exact_mod_cast Nat.factorial_pos (partBErrorColorCount n)
  have hD_pos : 0 < D := by positivity
  have hR_pos : 0 < R := by
    dsimp [R]
    positivity
  have hf' : f ∈ coloringProfileFinset n (partBErrorColorCount n) (partBThresholdLevel n) := by
    simpa [S, partBErrorProfileFinset] using hf
  have hP : 0 < profileP n (fun u => (f u).val) :=
    profileP_pos_of_mem_coloringProfileFinset hf'
  have hcontrib_pos : 0 < profileContribution n f :=
    profileContribution_pos_of_profileP_pos n f hP
  have hcore' : profileCombinatorialLogCore n f ≤ Real.log R := by
    simpa [S, F, D, R] using hcore n hn hmain f hf
  calc
    profileContribution n f ≤ Real.exp (Real.log R) :=
      profileContribution_le_exp_of_core_bound hcontrib_pos hP hcore'
    _ = R := Real.exp_log hR_pos
    _ = δ / (F * ((S.card : ℝ) + 1)) := by
      simp [R, D]

/-- A log-core pointwise target implies the exact Part B error target. -/
theorem profileLevelPartBErrorTarget_of_logCore
    {ε δ : ℝ} (hδ_pos : 0 < δ)
    (hcore : ProfileCombinatorialLogCorePointwisePartBTarget ε δ) :
    ProfileLevelPartBErrorTarget ε δ :=
  profileLevelPartBErrorTarget_of_rawProfileContribution hδ_pos.le
    (rawProfileContributionPointwisePartBTarget_of_logCore hδ_pos hcore)

/-- A concrete log-core bridge proves the exact Part B error target for all positive `ε, δ`. -/
theorem profileLevelPartBErrorTarget_of_logCoreBridge
    (hbridge : ProfileLogCoreBridgeTarget)
    (ε δ : ℝ) (hε_pos : 0 < ε) (hδ_pos : 0 < δ) :
    ProfileLevelPartBErrorTarget ε δ :=
  profileLevelPartBErrorTarget_of_logCore hδ_pos (hbridge ε δ hε_pos hδ_pos)

/-- Unfolded form of `ProfileLevelPartBErrorTarget`.

This is intentionally definitionally the same shape as the live Part B axiom
`threshold_tBoundedColoringError_le_with_error` in `ChromaticConnection.lean`, but without
importing that heavier module. -/
theorem profileLevelPartBErrorTarget_unfold (ε δ : ℝ) :
    ProfileLevelPartBErrorTarget ε δ ↔
      ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
        Nat.factorial
            (firstMomentThreshold n (max 1 (thresholdFloor n - 1))
              (Nat.lt_of_lt_of_le one_pos (le_max_left 1 _)) - 1) *
          expectedTBoundedColorings n
            (firstMomentThreshold n (max 1 (thresholdFloor n - 1))
              (Nat.lt_of_lt_of_le one_pos (le_max_left 1 _)) - 1)
            (max 1 (thresholdFloor n - 1)) ≤ δ := by
  rfl

/-- Single bundled target for the live Part B profile bridge.

This is intentionally just the checked log-core bridge plus its proof. Earlier drafts tried to
bundle `L_0` threshold/drop and `k^*` special-profile surfaces here, but that mixed the Part C
cochromatic special-profile construction with the live Part B small-error target. Any future
`L_0` theorem should feed `ProfileLogCoreBridgeTarget` directly before being accepted here. -/
structure ProfileLevelPartBBridgeTarget : Type where
  /-- Concrete log-core theorem surface sufficient for the live Part B small-error target. -/
  logCoreBridge : ProfileLogCoreBridgeTarget

/-- The bundled profile bridge is sufficient for the exact Part B error target. -/
theorem profileLevelPartBErrorTarget_of_bridge
    (hbridge : ProfileLevelPartBBridgeTarget)
    (ε δ : ℝ) (hε_pos : 0 < ε) (hδ_pos : 0 < δ) :
    ProfileLevelPartBErrorTarget ε δ := by
  exact profileLevelPartBErrorTarget_of_logCoreBridge hbridge.logCoreBridge ε δ hε_pos hδ_pos

end

