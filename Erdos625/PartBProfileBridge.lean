theorem paperPartBThresholdRealSqrtHalfUpperTarget_of_logAffine
    {A B ε : ℝ}
    (hupper : PaperPartBThresholdLogAffineUpperTarget A B ε)
    (hsqrt : PaperPartBLogAffineSqrtHalfUpperTarget A B ε) :
    PaperPartBThresholdRealSqrtHalfUpperTarget ε := by
  rcases hupper with ⟨n₀u, hupper⟩
  rcases hsqrt with ⟨n₀s, hsqrt⟩
  refine ⟨max n₀u n₀s, fun n hn hmain => ?_⟩
  have hnu : n₀u ≤ n := (le_max_left n₀u n₀s).trans hn
  have hns : n₀s ≤ n := (le_max_right n₀u n₀s).trans hn
  exact (hupper n hnu hmain).trans (hsqrt n hns hmain)

theorem paperPartBThresholdLogAffineUpperTarget_four_four
    {ε : ℝ} :
    PaperPartBThresholdLogAffineUpperTarget 4 4 ε := by
  refine ⟨2, fun n hn _hmain => ?_⟩
  have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hlog2_ge_half : (1 : ℝ) / 2 ≤ Real.log 2 := by
    linarith [Real.log_two_gt_d9]
  have hn_gt_one_nat : 1 < n := Nat.lt_of_lt_of_le (by norm_num : 1 < 2) hn
  have hn_gt_one : (1 : ℝ) < n := by exact_mod_cast hn_gt_one_nat
  have hlogn_pos : 0 < Real.log (n : ℝ) := Real.log_pos hn_gt_one
  have hlog2_le_logn : Real.log 2 ≤ Real.log (n : ℝ) :=
    Real.log_le_log (by norm_num) (by exact_mod_cast hn)
  have hlogb_ge_one : (1 : ℝ) ≤ Real.logb 2 (n : ℝ) := by
    rw [Real.logb]
    rw [le_div_iff₀ hlog2_pos]
    simpa using hlog2_le_logn
  have hlog_logb_nonneg : 0 ≤ Real.log (Real.logb 2 (n : ℝ)) :=
    Real.log_nonneg hlogb_ge_one
  have hneg_nonpos :
      -(2 * (Real.log (Real.logb 2 (n : ℝ)) / Real.log 2)) ≤ 0 := by
    have hdiv_nonneg :
        0 ≤ Real.log (Real.logb 2 (n : ℝ)) / Real.log 2 := by positivity
    linarith
  have hlog_exp_half : Real.log (Real.exp 1 / 2) = 1 - Real.log 2 := by
    rw [Real.log_div (Real.exp_pos 1).ne' (by norm_num : (2 : ℝ) ≠ 0), Real.log_exp]
  have hcoeff : (2 : ℝ) / Real.log 2 ≤ 4 := by
    rw [div_le_iff₀ hlog2_pos]
    linarith
  have hmain_bound :
      threshold n + 1 ≤ (2 / Real.log 2) * Real.log (n : ℝ) + 2 / Real.log 2 := by
    dsimp [threshold]
    rw [hlog_exp_half]
    rw [show Real.log (Real.log (n : ℝ) / Real.log 2) =
        Real.log (Real.logb 2 (n : ℝ)) by rfl]
    have hrewrite :
