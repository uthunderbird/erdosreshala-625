  have h := Nat.find_min (fmtExists n t ht) hk
  push_neg at h
  linarith

theorem paperPartBTerminalContributionEntropyFloorExactForbiddenUpperWorstMFeasibleUpperWitnessRealSlackTarget_of_belowExpectation
    {ε : ℝ}
    (hbelow :
