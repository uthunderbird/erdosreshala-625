theorem paperPartBExactNoEmptyProfileContributionFixedMTerminalZeroTailEraseHalfBudgetTarget_of_exactLayerContributionSum
    {ε δ : ℝ}
    (hsum :
      PaperPartBExactNoEmptyProfileContributionFixedMTerminalZeroTailExactLayerContributionSumTarget
        ε δ) :
    PaperPartBExactNoEmptyProfileContributionFixedMTerminalZeroTailEraseHalfBudgetTarget ε δ := by
  rcases hsum with ⟨n₀, hsum⟩
  refine ⟨n₀, fun n hn hmain m hm => ?_⟩
  let S := noEmptyProfileTerminalZeroTailEraseFinset n m
  let dist := fun f : Fin (n + 1) → Fin (n + 1) => partBProfileTerminalL1Distance n m f
  let D := noEmptyProfileTerminalZeroTailDistanceFinset n m
  have hmaps : ∀ f ∈ S, dist f ∈ D := by
    intro f hf
    exact Finset.mem_image.mpr ⟨f, hf, rfl⟩
  have hregroup :
      (∑ f ∈ S, partBExactNoEmptyFixedMNormalizedContribution δ n f) =
        ∑ d ∈ D, ∑ f ∈ S.filter (fun f => dist f = d),
          partBExactNoEmptyFixedMNormalizedContribution δ n f := by
    rw [← Finset.sum_fiberwise_of_maps_to hmaps]
  calc
    (∑ f ∈ (noEmptyColoringProfileFinset n m (partBThresholdLevel n)).erase
        (partBTerminalProfile n m),
        partBExactNoEmptyFixedMNormalizedContribution δ n f)
        = ∑ d ∈ D, ∑ f ∈ S.filter (fun f => dist f = d),
          partBExactNoEmptyFixedMNormalizedContribution δ n f := by
          simpa [S] using hregroup
    _ =
        ∑ d ∈ noEmptyProfileTerminalZeroTailDistanceFinset n m,
          ∑ f ∈ noEmptyProfileTerminalZeroTailDistanceLayerFinset n m d,
            partBExactNoEmptyFixedMNormalizedContribution δ n f := by
          simp [S, D, dist, noEmptyProfileTerminalZeroTailDistanceLayerFinset]
    _ ≤ (1 : ℝ) / 2 := hsum n hn hmain m hm

