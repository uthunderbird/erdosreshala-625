theorem paperPartBExactNoEmptyProfileBinaryBalancedQuadraticPointwiseTarget_of_scalar
    {ε δ : ℝ}
    (hscalar : PaperPartBExactNoEmptyProfileBinaryBalancedQuadraticScalarPointwiseTarget ε δ) :
    PaperPartBExactNoEmptyProfileBinaryBalancedQuadraticPointwiseTarget ε δ := by
  rcases hscalar with ⟨n₀, hscalar⟩
  refine ⟨max n₀ 1, fun n hn hmain m hm f hf => ?_⟩
  have hn₀ : n₀ ≤ n := (le_max_left n₀ 1).trans hn
  have hn_pos : 0 < n := by omega
  have hf_color : f ∈ coloringProfileFinset n m (partBThresholdLevel n) :=
    (mem_noEmptyColoringProfileFinset_iff.mp hf).1
  have hm_pos : 0 < m :=
    profileColorCount_pos_of_mem_coloringProfileFinset hn_pos hf_color
  simpa [partBExactNoEmptyBalancedQuadraticLhs] using
    hscalar n hn₀ hmain m hm hm_pos

