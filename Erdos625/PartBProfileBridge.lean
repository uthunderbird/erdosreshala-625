  dsimp [partBEndpointDeficitVectorExpandedLogLhs,
    partBEndpointDeficitVectorExpandedLogClosedLhs,
    partBExactNoEmptyContributionLogFixedMExpandedLhs]
  rw [profileP_endpointProfileOfDeficitVector n htn e,
    profileF_endpointProfileOfDeficitVector n htn e,
    profileSymm_endpointProfileOfDeficitVector n htn e]

