/-- Crude closed range for terminal L1-distance. It ignores all asymptotic parameters and only
uses the coordinatewise `Fin (n+1)` bound. -/
def partBTerminalZeroTailCrudeDistanceRange :
    ℝ → ℝ → (n : ℕ) → ℕ → ℕ :=
  fun _ε _δ n _m => (n + 1) * (2 * n)

