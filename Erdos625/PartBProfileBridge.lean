lemma partBExactNoEmptyPhiRemainderBinaryBudgetLhs_eq_expanded_of_mem
    {n m t : ℕ} {δ : ℝ} {f : Fin (n + 1) → Fin (n + 1)}
    (hn : 0 < n) (hf : f ∈ coloringProfileFinset n m t) :
    partBExactNoEmptyPhiRemainderBinaryBudgetLhs δ n f =
      partBExactNoEmptyPhiRemainderBinaryBudgetExpandedLhs δ n f := by
