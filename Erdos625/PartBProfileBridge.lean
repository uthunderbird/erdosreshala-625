/-- One-dimensional balanced-quadratic target after the paper average-class upper bound has
converted `m ≤ k_t - 2` into an explicit denominator bound. -/
def PaperPartBExactNoEmptyProfileDenomBalancedQuadraticPointwiseTarget
    (ε δ C : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      (m : ℝ) ≤ (n : ℝ) / partBPaperAverageClassDenom C n →
        (((n : ℝ) - (m : ℝ)) * Real.log m + (m : ℝ) -
            Real.log m / 2 - Real.log (2 * Real.pi) / 2) -
          ((m * Nat.choose (n / m) 2 : ℕ) : ℝ) * Real.log 2 ≤
          partBExactNoEmptyCoarseLogCoreBudget δ n

/-- One-dimensional balanced-quadratic target against the binary budget after the paper
average-class upper bound has supplied `m ≤ n / (threshold - 1 - 2/log 2 - C)`. -/
def PaperPartBExactNoEmptyProfileDenomBinaryBalancedQuadraticPointwiseTarget
    (ε δ C : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      (m : ℝ) ≤ (n : ℝ) / partBPaperAverageClassDenom C n →
        partBExactNoEmptyBalancedQuadraticLhs n m ≤
          partBExactNoEmptyBinaryLogCoreBudget δ n

/-- δ-free denominator-controlled uniform decay target after the paper average-class upper bound
has supplied `m ≤ n / (threshold - 1 - 2/log 2 - C)`. -/
def PaperPartBExactNoEmptyDenomBalancedQuadraticUniformDecayTarget (C : ℝ) : Prop :=
  ∀ ε A : ℝ, 0 < ε →
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
      ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
        0 < m →
          (m : ℝ) ≤ (n : ℝ) / partBPaperAverageClassDenom C n →
            partBExactNoEmptyBalancedQuadraticLhs n m +
              Real.log (partBExactNoEmptyCoarseBudgetDenom n) ≤ A

/-- δ-free denominator-controlled uniform decay target against the binary budget denominator. -/
def PaperPartBExactNoEmptyDenomBinaryBalancedQuadraticUniformDecayTarget (C : ℝ) : Prop :=
  ∀ ε A : ℝ, 0 < ε →
