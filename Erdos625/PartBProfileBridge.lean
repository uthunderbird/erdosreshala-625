lemma partB_eight_mul_pred_le_two_pow_succ
    {t : ℕ} (ht : 3 ≤ t) :
    8 * (t - 1) ≤ 2 ^ (t + 1) := by
  refine Nat.le_induction
    (m := 3)
    (P := fun k _ => 8 * (k - 1) ≤ 2 ^ (k + 1))
    ?base ?step t ht
  · norm_num
  · intro k hk ih
    have h8 : 8 ≤ 2 ^ (k + 1) := by
      have hexp : 3 ≤ k + 1 := by omega
      calc
        8 = 2 ^ 3 := by norm_num
        _ ≤ 2 ^ (k + 1) := Nat.pow_le_pow_right (by norm_num) hexp
    calc
      8 * (k + 1 - 1) = 8 * (k - 1) + 8 := by omega
      _ ≤ 2 ^ (k + 1) + 2 ^ (k + 1) := Nat.add_le_add ih h8
      _ = 2 ^ (k + 1 + 1) := by rw [← two_mul, mul_comm, ← pow_succ]

lemma partB_eight_mul_pred_le_two_pow_mul_pred
    {t : ℕ} (ht : 3 ≤ t) :
    (8 : ℝ) * (((t - 1 : ℕ) : ℝ)) ≤ (2 : ℝ) ^ (t * (t - 1)) := by
  have hsmall : 8 * (t - 1) ≤ 2 ^ (t + 1) :=
    partB_eight_mul_pred_le_two_pow_succ ht
  have hexp : t + 1 ≤ t * (t - 1) := by
    have hmul : 3 * (t - 1) ≤ t * (t - 1) :=
      Nat.mul_le_mul_right (t - 1) ht
    have hlin : t + 1 ≤ 3 * (t - 1) := by omega
    exact hlin.trans hmul
  have hpow : 2 ^ (t + 1) ≤ 2 ^ (t * (t - 1)) :=
    Nat.pow_le_pow_right (by norm_num) hexp
  exact_mod_cast hsmall.trans hpow

theorem paperPartBTerminalContributionEntropyFloorExactForbiddenPenaltyStepElementaryGrowthTarget :
    PaperPartBTerminalContributionEntropyFloorExactForbiddenPenaltyStepElementaryGrowthTarget := by
  intro n ht_three
  simpa using
