/-- Exact layer-cardinality model for the erased zero-tail. This keeps the one-dimensional
distance sum exact instead of paying a global profile-count upper bound at every distance. -/
def partBTerminalZeroTailExactLayerCard :
    ℝ → ℝ → (n : ℕ) → ℕ → ℕ → ℝ :=
  fun _ε _δ n m d => ((noEmptyProfileTerminalZeroTailDistanceLayerFinset n m d).card : ℝ)

/-- Exact logarithmic layer envelope for the erased zero-tail. On realized distances it is the
maximum fixed-`m` expanded log contribution among profiles in that terminal-distance layer; on
unrealized distances it is set to zero. -/
noncomputable def partBTerminalZeroTailExactLayerLogMax :
    ℝ → ℝ → (n : ℕ) → ℕ → ℕ → ℝ :=
  fun _ε δ n m d =>
    let S := noEmptyProfileTerminalZeroTailDistanceLayerFinset n m d
    if hS : S.Nonempty then
      (S.image (fun f => partBExactNoEmptyContributionLogFixedMExpandedLhs δ n m f)).max'
        (hS.image _)
    else 0

/-- Exponentiated logarithmic distance envelope. -/
noncomputable def partBTerminalZeroTailExpDistanceEnvelope
    (L : ℝ → ℝ → (n : ℕ) → ℕ → ℕ → ℝ) :
    ℝ → ℝ → (n : ℕ) → ℕ → ℕ → ℝ :=
  fun ε δ n m d => Real.exp (L ε δ n m d)

/-- Exact realized-distance summability target for the erased zero-tail, using the actual
