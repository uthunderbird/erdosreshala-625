private lemma sum_nat_mul_cast_mul_right
    {ι : Type*} [Fintype ι] (a b : ι → ℕ) (c : ℝ) :
    (∑ i : ι, ((a i * b i : ℕ) : ℝ)) * c =
      ∑ i : ι, (b i : ℝ) * ((a i : ℝ) * c) := by
  rw [Finset.sum_mul]
  refine Finset.sum_congr rfl ?_
  intro i _
  norm_num [Nat.cast_mul]
  ring

private lemma mul_sum_nat_mul_cast
    {ι : Type*} [Fintype ι] (a b : ι → ℕ) (t : ι → ℝ) (c : ℝ) :
    c * (∑ i : ι, (((a i * b i : ℕ) : ℝ) * t i)) =
      ∑ i : ι, (b i : ℝ) * (c * (a i : ℝ) * t i) := by
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl ?_
  intro i _
  norm_num [Nat.cast_mul]
  ring

private lemma int_sum_mul_nat_cast
    {ι : Type*} [Fintype ι] (a : ι → ℤ) (b : ι → ℕ) :
    ((∑ i : ι, a i * (b i : ℤ) : ℤ) : ℝ) =
      ∑ i : ι, (b i : ℝ) * ((a i : ℝ)) := by
  rw [Int.cast_sum]
  refine Finset.sum_congr rfl ?_
  intro i _
  norm_num [Int.cast_mul]
  ring

lemma partBExactNoEmptyExplicitCoarseCoreProfileTerm_eq_sum_kernel
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) :
    partBExactNoEmptyExplicitCoarseCoreProfileTerm n f =
      ∑ u : Fin (n + 1),
        ((f u).val : ℝ) * partBExactNoEmptyExplicitCoarseCoreProfileKernel n u := by
  dsimp [partBExactNoEmptyExplicitCoarseCoreProfileTerm]
  rw [sum_nat_mul_cast_mul_right
    (a := fun u : Fin (n + 1) => (u.val * (u.val - 1)) / 2)
    (b := fun u : Fin (n + 1) => (f u).val)
    (c := Real.log 2)]
  rw [mul_sum_nat_mul_cast
    (a := fun u : Fin (n + 1) => u.val)
    (b := fun u : Fin (n + 1) => (f u).val)
    (t := fun u : Fin (n + 1) => threshold n - (1 + 2 / Real.log 2) - u.val)
    (c := Real.log 2 / 2)]
  rw [int_sum_mul_nat_cast
    (a := fun u : Fin (n + 1) => (thresholdFloor n - u.val : ℤ))
    (b := fun u : Fin (n + 1) => (f u).val)]
  rw [← Finset.sum_neg_distrib, ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl ?_
  intro u _
  dsimp [partBExactNoEmptyExplicitCoarseCoreProfileKernel]
  ring

lemma partBExactNoEmptyExplicitCoarseCoreProfileTerm_nonpos_of_kernel_nonpos
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hkernel :
      ∀ u : Fin (n + 1),
        partBExactNoEmptyExplicitCoarseCoreProfileKernel n u ≤ 0) :
    partBExactNoEmptyExplicitCoarseCoreProfileTerm n f ≤ 0 := by
  rw [partBExactNoEmptyExplicitCoarseCoreProfileTerm_eq_sum_kernel]
  exact Finset.sum_nonpos fun u _ =>
    mul_nonpos_of_nonneg_of_nonpos (by positivity : (0 : ℝ) ≤ (f u).val) (hkernel u)

/-- Eventual nonpositivity target for the whole profile-dependent term in the explicit
coarse-core LHS split. -/
def PaperPartBExactNoEmptyExplicitCoarseCoreProfileTermNonposTarget : Prop :=
  ∀ ε : ℝ, 0 < ε →
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
      ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
        ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
          partBExactNoEmptyExplicitCoarseCoreProfileTerm n f ≤ 0

theorem paperPartBExactNoEmptyExplicitCoarseCoreProfileTermNonposTarget_of_kernel
    (hkernel : PaperPartBExactNoEmptyExplicitCoarseCoreProfileKernelNonposTarget) :
    PaperPartBExactNoEmptyExplicitCoarseCoreProfileTermNonposTarget := by
  intro ε hε_pos
  rcases hkernel ε hε_pos with ⟨n₀, hkernel⟩
  refine ⟨n₀, fun n hn hmain m _ f _ => ?_⟩
  exact partBExactNoEmptyExplicitCoarseCoreProfileTerm_nonpos_of_kernel_nonpos
    (hkernel n hn hmain)

theorem paperPartBExactNoEmptyExplicitCoarseCoreProfileTermNonposTarget_proved :
    PaperPartBExactNoEmptyExplicitCoarseCoreProfileTermNonposTarget :=
  paperPartBExactNoEmptyExplicitCoarseCoreProfileTermNonposTarget_of_kernel
    paperPartBExactNoEmptyExplicitCoarseCoreProfileKernelNonposTarget_proved

lemma partBExactNoEmptyExplicitCoarseCoreProfileTerm_eq_scalar_of_mem
    {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) :
    partBExactNoEmptyExplicitCoarseCoreProfileTerm n f =
      (n : ℝ) * partBExactNoEmptyExplicitCoarseCoreKernelSlope n -
        (m : ℝ) * thresholdFloor n := by
  have hf_color :
      f ∈ coloringProfileFinset n m (partBThresholdLevel n) :=
    (mem_noEmptyColoringProfileFinset_iff.mp hf).1
  have hverts_nat : profileVertexWeight n f = n :=
    profileVertexWeight_eq_of_mem_coloringProfileFinset hf_color
  have hcolors_nat : profileColorCount n f = m :=
    profileColorCount_eq_of_mem_coloringProfileFinset hf_color
  have hverts :
      (∑ u : Fin (n + 1), (((u.val * (f u).val : ℕ) : ℝ))) = (n : ℝ) := by
    exact_mod_cast hverts_nat
  have hcolors :
      (∑ u : Fin (n + 1), ((f u).val : ℝ)) = (m : ℝ) := by
    exact_mod_cast hcolors_nat
  rw [partBExactNoEmptyExplicitCoarseCoreProfileTerm_eq_sum_kernel]
  simp_rw [partBExactNoEmptyExplicitCoarseCoreProfileKernel_eq_linear]
  calc
    ∑ u : Fin (n + 1),
        ((f u).val : ℝ) *
          ((u.val : ℝ) * partBExactNoEmptyExplicitCoarseCoreKernelSlope n -
            thresholdFloor n)
        =
          ∑ u : Fin (n + 1),
            ((((u.val * (f u).val : ℕ) : ℝ)) *
              partBExactNoEmptyExplicitCoarseCoreKernelSlope n -
              ((f u).val : ℝ) * thresholdFloor n) := by
            refine Finset.sum_congr rfl ?_
            intro u _
            norm_num [Nat.cast_mul]
            ring
    _ =
        (∑ u : Fin (n + 1), (((u.val * (f u).val : ℕ) : ℝ))) *
            partBExactNoEmptyExplicitCoarseCoreKernelSlope n -
          (∑ u : Fin (n + 1), ((f u).val : ℝ)) * thresholdFloor n := by
            rw [Finset.sum_sub_distrib, Finset.sum_mul, Finset.sum_mul]
    _ = (n : ℝ) * partBExactNoEmptyExplicitCoarseCoreKernelSlope n -
        (m : ℝ) * thresholdFloor n := by
          rw [hverts, hcolors]

/-- Global tail term in the retained `phi + L_0` exponent. It appears with a negative sign in
the LHS-normalized comparison. -/
noncomputable def partBExactNoEmptyExplicitCoarseCoreTailTerm (n : ℕ) : ℝ :=
  (n : ℝ) * Real.log (Real.log n) / Real.log n

/-- Scalar LHS obtained after using the exact profile sums in the weighted kernel term. -/
noncomputable def partBExactNoEmptyExplicitCoarseCoreScalarLhs (n m : ℕ) : ℝ :=
  partBExactNoEmptyExplicitCoarseCoreEntropyTerm n m +
    (n : ℝ) * partBExactNoEmptyExplicitCoarseCoreKernelSlope n -
    (m : ℝ) * thresholdFloor n -
    partBExactNoEmptyExplicitCoarseCoreTailTerm n

lemma partBExactNoEmptyExplicitCoarseCoreCont2Lhs_eq_entropy_profile_tail
    (n m : ℕ) (f : Fin (n + 1) → Fin (n + 1)) :
    partBExactNoEmptyExplicitCoarseCoreCont2Lhs n m f =
      partBExactNoEmptyExplicitCoarseCoreEntropyTerm n m +
        partBExactNoEmptyExplicitCoarseCoreProfileTerm n f -
        partBExactNoEmptyExplicitCoarseCoreTailTerm n := by
  dsimp [partBExactNoEmptyExplicitCoarseCoreCont2Lhs,
    partBExactNoEmptyExplicitCoarseCoreEntropyTerm,
    partBExactNoEmptyExplicitCoarseCoreProfileTerm,
    partBExactNoEmptyExplicitCoarseCoreTailTerm]
  ring

lemma partBExactNoEmptyExplicitCoarseCoreCont2Lhs_eq_scalar_of_mem
    {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) :
    partBExactNoEmptyExplicitCoarseCoreCont2Lhs n m f =
      partBExactNoEmptyExplicitCoarseCoreScalarLhs n m := by
  rw [partBExactNoEmptyExplicitCoarseCoreCont2Lhs_eq_entropy_profile_tail]
  rw [partBExactNoEmptyExplicitCoarseCoreProfileTerm_eq_scalar_of_mem hf]
  dsimp [partBExactNoEmptyExplicitCoarseCoreScalarLhs]
  ring

lemma profileVertexWeight_le_bound_mul_colorCount_of_mem_coloringProfileFinset
    {n k t : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ coloringProfileFinset n k t) :
    profileVertexWeight n f ≤ t * profileColorCount n f := by
  dsimp [profileVertexWeight, profileColorCount]
  calc
    ∑ u : Fin (n + 1), u.val * (f u).val
        ≤ ∑ u : Fin (n + 1), t * (f u).val := by
          exact Finset.sum_le_sum fun u _ => by
            by_cases hu : u.val ≤ t
            · exact Nat.mul_le_mul_right (f u).val hu
            · have hzero : (f u).val = 0 :=
                (mem_coloringProfileFinset_iff.mp hf).2.2 u (Nat.lt_of_not_ge hu)
              simp [hzero]
    _ = t * ∑ u : Fin (n + 1), (f u).val := by
          rw [Finset.mul_sum]

lemma noEmptyProfile_vertexCount_le_colorCount_mul_threshold
    {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) :
    n ≤ m * partBThresholdLevel n := by
  have hf_color :
      f ∈ coloringProfileFinset n m (partBThresholdLevel n) :=
    (mem_noEmptyColoringProfileFinset_iff.mp hf).1
  have h :=
    profileVertexWeight_le_bound_mul_colorCount_of_mem_coloringProfileFinset hf_color
  rw [profileVertexWeight_eq_of_mem_coloringProfileFinset hf_color,
    profileColorCount_eq_of_mem_coloringProfileFinset hf_color] at h
  simpa [Nat.mul_comm] using h

lemma noEmptyProfile_colorCount_le_vertexCount
    {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) :
    profileColorCount n f ≤ profileVertexWeight n f := by
  have hzero := (mem_noEmptyColoringProfileFinset_iff.mp hf).2
  dsimp [profileColorCount, profileVertexWeight]
  refine Finset.sum_le_sum ?_
  intro u _
  by_cases hu0 : u.val = 0
  · have hu : u = ⟨0, Nat.succ_pos n⟩ := Fin.ext hu0
    subst u
    rw [hzero]
    simp
  · have hu_pos : 1 ≤ u.val := Nat.succ_le_of_lt (Nat.pos_of_ne_zero hu0)
    calc
      (f u).val = 1 * (f u).val := by simp
      _ ≤ u.val * (f u).val := Nat.mul_le_mul_right (f u).val hu_pos

lemma noEmptyProfile_colorCount_le_vertexCount_of_mem
    {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) :
    m ≤ n := by
  have hf_color :
      f ∈ coloringProfileFinset n m (partBThresholdLevel n) :=
    (mem_noEmptyColoringProfileFinset_iff.mp hf).1
  have h := noEmptyProfile_colorCount_le_vertexCount (n := n) (m := m) (f := f) hf
  rw [profileColorCount_eq_of_mem_coloringProfileFinset hf_color,
    profileVertexWeight_eq_of_mem_coloringProfileFinset hf_color] at h
  exact h

lemma coloringProfile_vertexCount_le_colorCount_mul_thresholdLevel
    {n k : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ coloringProfileFinset n k (partBThresholdLevel n)) :
    n ≤ k * partBThresholdLevel n := by
  have h :=
    profileVertexWeight_le_bound_mul_colorCount_of_mem_coloringProfileFinset hf
  rw [profileVertexWeight_eq_of_mem_coloringProfileFinset hf,
    profileColorCount_eq_of_mem_coloringProfileFinset hf] at h
  simpa [Nat.mul_comm] using h

/-- Number of terminal-size colour classes in the two-size terminal profile with sizes
`partBThresholdLevel n` and `partBThresholdLevel n - 1`. -/
def partBTerminalTopCount (n m : ℕ) : ℕ :=
  n - m * (partBThresholdLevel n - 1)

/-- Number of lower terminal colour classes in the two-size terminal profile. -/
def partBTerminalLowCount (n m : ℕ) : ℕ :=
  m - partBTerminalTopCount n m

lemma partBTerminalTopCount_le
    {n m : ℕ}
    (hupper : n ≤ m * partBThresholdLevel n) :
    partBTerminalTopCount n m ≤ m := by
  set t := partBThresholdLevel n
  have ht_le : t ≤ (t - 1) + 1 := by omega
  have hmt_le : m * t ≤ m * (t - 1) + m := by
    have h := Nat.mul_le_mul_left m ht_le
    simpa [Nat.mul_add, Nat.add_comm] using h
  have hn_le : n ≤ m * (t - 1) + m := by
    exact hupper.trans hmt_le
  change n - m * (t - 1) ≤ m
  omega

lemma partBTerminalLowCount_add_topCount
    {n m : ℕ}
    (hupper : n ≤ m * partBThresholdLevel n) :
    partBTerminalLowCount n m + partBTerminalTopCount n m = m := by
  have htop := partBTerminalTopCount_le (n := n) (m := m) hupper
  dsimp [partBTerminalLowCount]
  omega

lemma partBTerminalTopCount_eq_zero_of_le_lower
    {n m : ℕ}
    (hlower : n ≤ m * (partBThresholdLevel n - 1)) :
    partBTerminalTopCount n m = 0 := by
  dsimp [partBTerminalTopCount]
  exact Nat.sub_eq_zero_of_le hlower

lemma partBTerminalTopCount_pos_of_lower_lt
    {n m : ℕ}
    (hlower : m * (partBThresholdLevel n - 1) < n) :
    0 < partBTerminalTopCount n m := by
  dsimp [partBTerminalTopCount]
  exact Nat.sub_pos_of_lt hlower

lemma partBTerminalLowerBase_add_topCount
    {n m : ℕ}
    (hlower : m * (partBThresholdLevel n - 1) ≤ n) :
    m * (partBThresholdLevel n - 1) + partBTerminalTopCount n m = n := by
  dsimp [partBTerminalTopCount]
  exact Nat.add_sub_of_le hlower

lemma partBTerminalTopCount_cast_eq_sub_mul
    {n m : ℕ}
    (hlower : m * (partBThresholdLevel n - 1) ≤ n) :
    (partBTerminalTopCount n m : ℝ) =
      (n : ℝ) - (m : ℝ) * ((partBThresholdLevel n - 1 : ℕ) : ℝ) := by
  dsimp [partBTerminalTopCount]
  rw [Nat.cast_sub hlower, Nat.cast_mul]

lemma partBTerminalTopCount_cast_ge_of_colorCount_upper
    {n m : ℕ} {D : ℝ}
    (hlower : m * (partBThresholdLevel n - 1) ≤ n)
    (hm_upper : (m : ℝ) ≤ (n : ℝ) / D) :
    (n : ℝ) - ((n : ℝ) / D) * ((partBThresholdLevel n - 1 : ℕ) : ℝ) ≤
      (partBTerminalTopCount n m : ℝ) := by
  have htop_eq :=
    partBTerminalTopCount_cast_eq_sub_mul (n := n) (m := m) hlower
  have hfactor_nonneg : 0 ≤ (((partBThresholdLevel n - 1 : ℕ) : ℝ)) := by
    positivity
  have hmul :
      (m : ℝ) * ((partBThresholdLevel n - 1 : ℕ) : ℝ) ≤
        ((n : ℝ) / D) * ((partBThresholdLevel n - 1 : ℕ) : ℝ) :=
    mul_le_mul_of_nonneg_right hm_upper hfactor_nonneg
  rw [htop_eq]
  linarith

lemma partBTerminalWeightedCount_eq
    {n m : ℕ}
    (hlower : m * (partBThresholdLevel n - 1) ≤ n)
    (hupper : n ≤ m * partBThresholdLevel n) :
    partBTerminalTopCount n m * partBThresholdLevel n +
        partBTerminalLowCount n m * (partBThresholdLevel n - 1) = n := by
  set t := partBThresholdLevel n
  set top := partBTerminalTopCount n m
  set low := partBTerminalLowCount n m
  have hlow_top : low + top = m := by
    simpa [low, top, t] using
      partBTerminalLowCount_add_topCount (n := n) (m := m) hupper
  have hbase : m * (t - 1) + top = n := by
    simpa [top, t] using
      partBTerminalLowerBase_add_topCount (n := n) (m := m) hlower
  have ht_pos : 0 < t := by simpa [t] using partBThresholdLevel_pos n
  have htop_mul : top * t = top * (t - 1) + top := by
    have ht_eq : t - 1 + 1 = t := Nat.succ_pred_eq_of_pos ht_pos
    calc
      top * t = top * ((t - 1) + 1) := by rw [ht_eq]
      _ = top * (t - 1) + top := by simp [Nat.mul_add, Nat.add_comm]
  calc
    top * t + low * (t - 1)
        = top * (t - 1) + top + low * (t - 1) := by rw [htop_mul]
    _ = (low + top) * (t - 1) + top := by
          ring
    _ = m * (t - 1) + top := by rw [hlow_top]
    _ = n := hbase

lemma partBTerminalLowCount_eq_deficit
    {n m : ℕ}
    (hlower : m * (partBThresholdLevel n - 1) ≤ n)
    (hupper : n ≤ m * partBThresholdLevel n) :
    partBTerminalLowCount n m = m * partBThresholdLevel n - n := by
  set t := partBThresholdLevel n
  have ht_pos : 0 < t := by simpa [t] using partBThresholdLevel_pos n
  have hmul : m * t = m * (t - 1) + m := by
    conv_lhs => rw [← Nat.succ_pred_eq_of_pos ht_pos]
    simp [Nat.mul_add]
  have hmul' :
      m * partBThresholdLevel n = m * (partBThresholdLevel n - 1) + m := by
    simpa [t] using hmul
  have hleft_le : n - m * (partBThresholdLevel n - 1) ≤ m := by
    rw [hmul'] at hupper
    omega
  dsimp [partBTerminalLowCount, partBTerminalTopCount]
  apply Nat.cast_injective (R := ℤ)
  rw [Nat.cast_sub hleft_le, Nat.cast_sub hupper, Nat.cast_sub hlower]
  norm_num [Nat.cast_mul]
  have hmul_int : (m : ℤ) * (t : ℤ) = (m : ℤ) * ((t - 1 : ℕ) : ℤ) + (m : ℤ) := by
    exact_mod_cast hmul
  rw [hmul_int]
  ring

lemma partBTerminalTopCount_eq_colorCount_sub_deficit
    {n m : ℕ}
    (hlower : m * (partBThresholdLevel n - 1) ≤ n)
    (hupper : n ≤ m * partBThresholdLevel n) :
    partBTerminalTopCount n m = m - (m * partBThresholdLevel n - n) := by
  have hlow := partBTerminalLowCount_eq_deficit (n := n) (m := m) hlower hupper
  have hsum := partBTerminalLowCount_add_topCount (n := n) (m := m) hupper
  rw [hlow] at hsum
  omega

/-- Safely coerce a natural profile count into the bounded profile codomain `Fin (n+1)`. -/
def partBCountAsProfileValue (n a : ℕ) : Fin (n + 1) :=
  ⟨min a n, Nat.lt_succ_of_le (Nat.min_le_right a n)⟩

lemma partBCountAsProfileValue_val_of_le
    {n a : ℕ} (ha : a ≤ n) :
    (partBCountAsProfileValue n a).val = a := by
  simp [partBCountAsProfileValue, Nat.min_eq_left ha]

/-- Candidate two-size terminal profile at fixed exact colour count `m`. It places mass at
`partBThresholdLevel n` and `partBThresholdLevel n - 1`, with all other sizes zero. -/
def partBTerminalProfile (n m : ℕ) : Fin (n + 1) → Fin (n + 1) :=
  fun u =>
    if u.val = partBThresholdLevel n then
      partBCountAsProfileValue n (partBTerminalTopCount n m)
    else if u.val = partBThresholdLevel n - 1 then
      partBCountAsProfileValue n (partBTerminalLowCount n m)
    else
      0

lemma partBTerminalProfile_apply_of_ne
    {n m : ℕ} {u : Fin (n + 1)}
    (htop : u.val ≠ partBThresholdLevel n)
    (hlow : u.val ≠ partBThresholdLevel n - 1) :
    partBTerminalProfile n m u = 0 := by
  simp [partBTerminalProfile, htop, hlow]

lemma partBTerminalProfile_top_val
    {n m : ℕ} {u : Fin (n + 1)}
    (hu : u.val = partBThresholdLevel n) :
    (partBTerminalProfile n m u).val = partBTerminalTopCount n m := by
  have htop_le_n : partBTerminalTopCount n m ≤ n := by
    dsimp [partBTerminalTopCount]
    exact Nat.sub_le _ _
  simp [partBTerminalProfile, hu, partBCountAsProfileValue_val_of_le htop_le_n]

lemma partBTerminalProfile_low_val
    {n m : ℕ} {u : Fin (n + 1)}
    (hu_low : u.val = partBThresholdLevel n - 1)
    (hu_ne_top : u.val ≠ partBThresholdLevel n)
    (hmn : m ≤ n) :
    (partBTerminalProfile n m u).val = partBTerminalLowCount n m := by
  have hlow_le_n : partBTerminalLowCount n m ≤ n := by
    dsimp [partBTerminalLowCount]
    exact (Nat.sub_le _ _).trans hmn
  have hlow_ne_top : partBThresholdLevel n - 1 ≠ partBThresholdLevel n := by
    intro h
    exact hu_ne_top (by simpa [hu_low] using h)
  simp [partBTerminalProfile, hu_low, hlow_ne_top,
    partBCountAsProfileValue_val_of_le hlow_le_n]

lemma partBTerminalProfile_zero_above_threshold
    {n m : ℕ} {u : Fin (n + 1)}
    (hu : partBThresholdLevel n < u.val) :
    (partBTerminalProfile n m u).val = 0 := by
  have htop : u.val ≠ partBThresholdLevel n := by omega
  have hlow : u.val ≠ partBThresholdLevel n - 1 := by omega
  have h := partBTerminalProfile_apply_of_ne (n := n) (m := m) (u := u) htop hlow
  simpa using congrArg Fin.val h

lemma partBTerminalProfile_zero_empty_of_one_lt_threshold
    {n m : ℕ}
    (ht : 1 < partBThresholdLevel n) :
    (partBTerminalProfile n m ⟨0, Nat.succ_pos n⟩).val = 0 := by
  have htop : (0 : ℕ) ≠ partBThresholdLevel n := by omega
  have hlow : (0 : ℕ) ≠ partBThresholdLevel n - 1 := by omega
  have h := partBTerminalProfile_apply_of_ne
    (n := n) (m := m) (u := ⟨0, Nat.succ_pos n⟩) htop hlow
  simpa using congrArg Fin.val h

lemma finset_univ_sum_two_point
    {α β : Type*} [Fintype α] [DecidableEq α] [AddCommMonoid β]
    (a b : α) (A B : β) (hab : a ≠ b) :
    (∑ u : α, if u = a then A else if u = b then B else 0) = A + B := by
  have hpoint : ∀ u : α,
      (if u = a then A else if u = b then B else 0) =
        (if u = a then A else 0) + (if u = b then B else 0) := by
    intro u
    by_cases hua : u = a
    · have hub : u ≠ b := by
        intro h
        exact hab (by rw [← hua, h])
      simp [hua, hab]
    · by_cases hub : u = b
      · have hba : b ≠ a := Ne.symm hab
        simp [hub, hba]
      · simp [hua, hub]
  calc
    (∑ u : α, if u = a then A else if u = b then B else 0)
        = ∑ u : α, ((if u = a then A else 0) + (if u = b then B else 0)) := by
          exact Finset.sum_congr rfl (fun u _ => hpoint u)
    _ = A + B := by
          rw [Finset.sum_add_distrib]
          simp [Finset.sum_ite_eq']

lemma finset_univ_prod_two_point
    {α β : Type*} [Fintype α] [DecidableEq α] [CommMonoid β]
    (a b : α) (A B : β) (hab : a ≠ b) :
    (∏ u : α, if u = a then A else if u = b then B else 1) = A * B := by
  have hpoint : ∀ u : α,
      (if u = a then A else if u = b then B else 1) =
        (if u = a then A else 1) * (if u = b then B else 1) := by
    intro u
    by_cases hua : u = a
    · have hub : u ≠ b := by
        intro h
        exact hab (by rw [← hua, h])
      simp [hua, hab]
    · by_cases hub : u = b
      · have hba : b ≠ a := Ne.symm hab
        simp [hub, hba]
      · simp [hua, hub]
  calc
    (∏ u : α, if u = a then A else if u = b then B else 1)
        = ∏ u : α, ((if u = a then A else 1) * (if u = b then B else 1)) := by
          exact Finset.prod_congr rfl (fun u _ => hpoint u)
    _ = A * B := by
          rw [Finset.prod_mul_distrib]
          simp [Finset.prod_ite_eq']

/-- Feasibility window in which the two-size terminal profile should be a genuine no-empty profile
with `m` colours and `n` vertices. -/
def PartBTerminalProfileFeasible (n m : ℕ) : Prop :=
  m * (partBThresholdLevel n - 1) ≤ n ∧
    n ≤ m * partBThresholdLevel n ∧
    m ≤ n ∧
    1 < partBThresholdLevel n ∧
    partBThresholdLevel n ≤ n

lemma partBTerminalProfileFeasible_of_between
    {n m k r : ℕ}
    (hm : PartBTerminalProfileFeasible n m)
    (hk : PartBTerminalProfileFeasible n k)
    (hmr : m ≤ r)
    (hrk : r ≤ k) :
    PartBTerminalProfileFeasible n r := by
  rcases hm with ⟨_hm_lower, hm_upper, _hmn, ht_one, htn⟩
  rcases hk with ⟨hk_lower, _hk_upper, hkn, _ht_one_k, _htn_k⟩
  refine ⟨?_, ?_, ?_, ht_one, htn⟩
  · exact (Nat.mul_le_mul_right (partBThresholdLevel n - 1) hrk).trans hk_lower
  · exact hm_upper.trans (Nat.mul_le_mul_right (partBThresholdLevel n) hmr)
  · exact hrk.trans hkn

lemma partBTerminalTopCount_succ_add
    {n m : ℕ}
    (hfeas_succ : PartBTerminalProfileFeasible n (m + 1)) :
    partBTerminalTopCount n (m + 1) + (partBThresholdLevel n - 1) =
      partBTerminalTopCount n m := by
  rcases hfeas_succ with ⟨h_succ_lower, _h_succ_upper, _hmn, _ht_one, _htn⟩
  have h_lower : m * (partBThresholdLevel n - 1) ≤ n :=
    (Nat.mul_le_mul_right (partBThresholdLevel n - 1) (Nat.le_succ m)).trans h_succ_lower
  have hsucc_mul :
      (m + 1) * (partBThresholdLevel n - 1) =
        m * (partBThresholdLevel n - 1) + (partBThresholdLevel n - 1) := by
    rw [Nat.succ_mul]
  dsimp [partBTerminalTopCount] at *
  omega

lemma partBTerminalLowCount_succ_eq
    {n m : ℕ}
    (hfeas : PartBTerminalProfileFeasible n m)
    (hfeas_succ : PartBTerminalProfileFeasible n (m + 1)) :
    partBTerminalLowCount n (m + 1) =
      partBTerminalLowCount n m + partBThresholdLevel n := by
  rcases hfeas with ⟨_h_lower, h_upper, _hmn, _ht_one, _htn⟩
  have htop_le : partBTerminalTopCount n m ≤ m :=
    partBTerminalTopCount_le (n := n) (m := m) h_upper
  have htop_succ_add :=
    partBTerminalTopCount_succ_add (n := n) (m := m) hfeas_succ
  dsimp [partBTerminalLowCount]
  omega

/-- Named remaining finite-sum/membership target for the terminal-band decomposition. -/
def PaperPartBTerminalProfileMembershipTarget : Prop :=
  ∀ n m : ℕ, PartBTerminalProfileFeasible n m →
    partBTerminalProfile n m ∈
      noEmptyColoringProfileFinset n m (partBThresholdLevel n)

def PaperPartBTerminalProfileColorCountTarget : Prop :=
  ∀ n m : ℕ, PartBTerminalProfileFeasible n m →
    profileColorCount n (partBTerminalProfile n m) = m

def PaperPartBTerminalProfileVertexWeightTarget : Prop :=
  ∀ n m : ℕ, PartBTerminalProfileFeasible n m →
    profileVertexWeight n (partBTerminalProfile n m) = n

theorem paperPartBTerminalProfileColorCountTarget :
    PaperPartBTerminalProfileColorCountTarget := by
  intro n m hfeas
  rcases hfeas with ⟨_hlower, hupper, hmn, ht_one, htn⟩
  let uTop : Fin (n + 1) := ⟨partBThresholdLevel n, Nat.lt_succ_of_le htn⟩
  let uLow : Fin (n + 1) :=
    ⟨partBThresholdLevel n - 1,
      Nat.lt_succ_of_le ((Nat.sub_le _ _).trans htn)⟩
  have hneq : uTop ≠ uLow := by
    intro h
    have hval := congrArg Fin.val h
    dsimp [uTop, uLow] at hval
    omega
  have hval : ∀ u : Fin (n + 1),
      (partBTerminalProfile n m u).val =
        if u = uTop then partBTerminalTopCount n m
        else if u = uLow then partBTerminalLowCount n m
        else 0 := by
    intro u
    by_cases htop : u = uTop
    · have hu : u.val = partBThresholdLevel n := by
        simpa [uTop] using congrArg Fin.val htop
      rw [htop]
      simpa using partBTerminalProfile_top_val (n := n) (m := m) (u := uTop) (by simp [uTop])
    · by_cases hlow : u = uLow
      · have hu_low : u.val = partBThresholdLevel n - 1 := by
          simpa [uLow] using congrArg Fin.val hlow
        have hu_ne_top : u.val ≠ partBThresholdLevel n := by
          intro h
          apply htop
          exact Fin.ext (by simpa [uTop] using h)
        rw [hlow]
        have hLowNeTop : uLow ≠ uTop := Ne.symm hneq
        simpa [hLowNeTop] using
          partBTerminalProfile_low_val (n := n) (m := m) (u := uLow)
            (by simp [uLow]) (by simpa [hlow] using hu_ne_top) hmn
      · have hu_ne_top : u.val ≠ partBThresholdLevel n := by
          intro h
          exact htop (Fin.ext (by simpa [uTop] using h))
        have hu_ne_low : u.val ≠ partBThresholdLevel n - 1 := by
          intro h
          exact hlow (Fin.ext (by simpa [uLow] using h))
        have hzero := partBTerminalProfile_apply_of_ne
          (n := n) (m := m) (u := u) hu_ne_top hu_ne_low
        simp [htop, hlow, hzero]
  rw [profileColorCount]
  calc
    (∑ u : Fin (n + 1), (partBTerminalProfile n m u).val)
        = ∑ u : Fin (n + 1),
            if u = uTop then partBTerminalTopCount n m
            else if u = uLow then partBTerminalLowCount n m
            else 0 := by
          exact Finset.sum_congr rfl (fun u _ => hval u)
    _ = partBTerminalTopCount n m + partBTerminalLowCount n m := by
          exact finset_univ_sum_two_point uTop uLow
            (partBTerminalTopCount n m) (partBTerminalLowCount n m) hneq
    _ = m := by
          have hsum := partBTerminalLowCount_add_topCount (n := n) (m := m) hupper
          omega

theorem paperPartBTerminalProfileVertexWeightTarget :
    PaperPartBTerminalProfileVertexWeightTarget := by
  intro n m hfeas
  rcases hfeas with ⟨hlower, hupper, hmn, ht_one, htn⟩
  let uTop : Fin (n + 1) := ⟨partBThresholdLevel n, Nat.lt_succ_of_le htn⟩
  let uLow : Fin (n + 1) :=
    ⟨partBThresholdLevel n - 1,
      Nat.lt_succ_of_le ((Nat.sub_le _ _).trans htn)⟩
  have hneq : uTop ≠ uLow := by
    intro h
    have hval := congrArg Fin.val h
    dsimp [uTop, uLow] at hval
    omega
  have hval : ∀ u : Fin (n + 1),
      u.val * (partBTerminalProfile n m u).val =
        if u = uTop then partBTerminalTopCount n m * partBThresholdLevel n
        else if u = uLow then
          partBTerminalLowCount n m * (partBThresholdLevel n - 1)
        else 0 := by
    intro u
    by_cases htop : u = uTop
    · have hu : u.val = partBThresholdLevel n := by
        simpa [uTop] using congrArg Fin.val htop
      rw [htop]
      have htop_val :=
        partBTerminalProfile_top_val (n := n) (m := m) (u := uTop) (by simp [uTop])
      have hcalc :
          uTop.val * (partBTerminalProfile n m uTop).val =
            partBTerminalTopCount n m * partBThresholdLevel n := by
        rw [htop_val]
        simp [uTop, Nat.mul_comm]
      simpa using hcalc
    · by_cases hlow : u = uLow
      · have hu_low : u.val = partBThresholdLevel n - 1 := by
          simpa [uLow] using congrArg Fin.val hlow
        have hu_ne_top : u.val ≠ partBThresholdLevel n := by
          intro h
          apply htop
          exact Fin.ext (by simpa [uTop] using h)
        rw [hlow]
        have hLowNeTop : uLow ≠ uTop := Ne.symm hneq
        have hlow_val :=
          partBTerminalProfile_low_val (n := n) (m := m) (u := uLow)
            (by simp [uLow]) (by simpa [hlow] using hu_ne_top) hmn
        have hcalc :
            uLow.val * (partBTerminalProfile n m uLow).val =
              partBTerminalLowCount n m * (partBThresholdLevel n - 1) := by
          rw [hlow_val]
          simp [uLow, Nat.mul_comm]
        simpa [hLowNeTop] using hcalc
      · have hu_ne_top : u.val ≠ partBThresholdLevel n := by
          intro h
          exact htop (Fin.ext (by simpa [uTop] using h))
        have hu_ne_low : u.val ≠ partBThresholdLevel n - 1 := by
          intro h
          exact hlow (Fin.ext (by simpa [uLow] using h))
        have hzero := partBTerminalProfile_apply_of_ne
          (n := n) (m := m) (u := u) hu_ne_top hu_ne_low
        simp [htop, hlow, hzero]
  rw [profileVertexWeight]
  calc
    (∑ u : Fin (n + 1), u.val * (partBTerminalProfile n m u).val)
        = ∑ u : Fin (n + 1),
            if u = uTop then partBTerminalTopCount n m * partBThresholdLevel n
            else if u = uLow then
              partBTerminalLowCount n m * (partBThresholdLevel n - 1)
            else 0 := by
          exact Finset.sum_congr rfl (fun u _ => hval u)
    _ = partBTerminalTopCount n m * partBThresholdLevel n +
          partBTerminalLowCount n m * (partBThresholdLevel n - 1) := by
          exact finset_univ_sum_two_point uTop uLow
            (partBTerminalTopCount n m * partBThresholdLevel n)
            (partBTerminalLowCount n m * (partBThresholdLevel n - 1)) hneq
    _ = n := partBTerminalWeightedCount_eq (n := n) (m := m) hlower hupper

theorem paperPartBTerminalProfileMembershipTarget_of_colorCount_vertexWeight
    (hcolor : PaperPartBTerminalProfileColorCountTarget)
    (hvertex : PaperPartBTerminalProfileVertexWeightTarget) :
    PaperPartBTerminalProfileMembershipTarget := by
  intro n m hfeas
  rcases hfeas with ⟨_hlower, _hupper, _hmn, ht_one, _htn⟩
  rw [mem_noEmptyColoringProfileFinset_iff, mem_coloringProfileFinset_iff]
  refine ⟨⟨hvertex n m ⟨_hlower, _hupper, _hmn, ht_one, _htn⟩,
    hcolor n m ⟨_hlower, _hupper, _hmn, ht_one, _htn⟩, ?_⟩, ?_⟩
  · intro u hu
    exact partBTerminalProfile_zero_above_threshold (n := n) (m := m) (u := u) hu
  · exact partBTerminalProfile_zero_empty_of_one_lt_threshold (n := n) (m := m) ht_one

theorem paperPartBTerminalProfileMembershipTarget :
    PaperPartBTerminalProfileMembershipTarget :=
  paperPartBTerminalProfileMembershipTarget_of_colorCount_vertexWeight
    paperPartBTerminalProfileColorCountTarget
    paperPartBTerminalProfileVertexWeightTarget

/-- L1 distance from the two-size terminal profile. This is a structural coordinate for splitting
the fixed-`m` profile sum into a near-terminal band and a tail. -/
noncomputable def partBProfileTerminalL1Distance
    (n m : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : ℕ :=
  ∑ u : Fin (n + 1),
    (((f u).val - (partBTerminalProfile n m u).val) +
      ((partBTerminalProfile n m u).val - (f u).val))

lemma partBProfileTerminalL1Distance_eq_zero_iff
    {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)} :
    partBProfileTerminalL1Distance n m f = 0 ↔ f = partBTerminalProfile n m := by
  constructor
  · intro hdist
    ext u
    have hterm_le :
        ((f u).val - (partBTerminalProfile n m u).val) +
          ((partBTerminalProfile n m u).val - (f u).val) ≤
            partBProfileTerminalL1Distance n m f := by
      dsimp [partBProfileTerminalL1Distance]
      exact Finset.single_le_sum
        (s := Finset.univ)
        (f := fun v : Fin (n + 1) =>
          ((f v).val - (partBTerminalProfile n m v).val) +
            ((partBTerminalProfile n m v).val - (f v).val))
        (fun _ _ => Nat.zero_le _) (Finset.mem_univ u)
    have hterm_zero :
        ((f u).val - (partBTerminalProfile n m u).val) +
          ((partBTerminalProfile n m u).val - (f u).val) = 0 := by
      rw [hdist] at hterm_le
      exact Nat.eq_zero_of_le_zero hterm_le
    have hleft : (f u).val - (partBTerminalProfile n m u).val = 0 := by omega
    have hright : (partBTerminalProfile n m u).val - (f u).val = 0 := by omega
    have hle_left : (f u).val ≤ (partBTerminalProfile n m u).val :=
      Nat.sub_eq_zero_iff_le.mp hleft
    have hle_right : (partBTerminalProfile n m u).val ≤ (f u).val :=
      Nat.sub_eq_zero_iff_le.mp hright
    exact Nat.le_antisymm hle_left hle_right
  · intro h
    subst f
    simp [partBProfileTerminalL1Distance]

/-- Crude universal upper bound for terminal-profile L1-distance. It uses only the fact that each
profile coordinate lies in `Fin (n+1)`, so every coordinate contributes at most `2*n`. -/
lemma partBProfileTerminalL1Distance_le_crude
    (n m : ℕ) (f : Fin (n + 1) → Fin (n + 1)) :
    partBProfileTerminalL1Distance n m f ≤ (n + 1) * (2 * n) := by
  dsimp [partBProfileTerminalL1Distance]
  calc
    (∑ u : Fin (n + 1),
        (((f u).val - (partBTerminalProfile n m u).val) +
          ((partBTerminalProfile n m u).val - (f u).val))) ≤
        (Finset.univ : Finset (Fin (n + 1))).card • (2 * n) := by
      refine Finset.sum_le_card_nsmul _ _ _ ?_
      intro u _hu
      have hf_le : (f u).val ≤ n := Nat.le_of_lt_succ (f u).isLt
      have hterm_le : (partBTerminalProfile n m u).val ≤ n :=
        Nat.le_of_lt_succ (partBTerminalProfile n m u).isLt
      have hleft :
          (f u).val - (partBTerminalProfile n m u).val ≤ n :=
        (Nat.sub_le _ _).trans hf_le
      have hright :
          (partBTerminalProfile n m u).val - (f u).val ≤ n :=
        (Nat.sub_le _ _).trans hterm_le
      omega
    _ = (n + 1) * (2 * n) := by
      simp [Fintype.card_fin]

/-- Sharper coordinatewise universal upper bound for terminal-profile L1-distance. Since both
coordinates in a summand are at most `n`, the absolute difference term is at most `n`. -/
lemma partBProfileTerminalL1Distance_le_coordinate
    (n m : ℕ) (f : Fin (n + 1) → Fin (n + 1)) :
    partBProfileTerminalL1Distance n m f ≤ (n + 1) * n := by
  dsimp [partBProfileTerminalL1Distance]
  calc
    (∑ u : Fin (n + 1),
        (((f u).val - (partBTerminalProfile n m u).val) +
          ((partBTerminalProfile n m u).val - (f u).val))) ≤
        (Finset.univ : Finset (Fin (n + 1))).card • n := by
      refine Finset.sum_le_card_nsmul _ _ _ ?_
      intro u _hu
      have hf_le : (f u).val ≤ n := Nat.le_of_lt_succ (f u).isLt
      have hterm_le : (partBTerminalProfile n m u).val ≤ n :=
        Nat.le_of_lt_succ (partBTerminalProfile n m u).isLt
      omega
    _ = (n + 1) * n := by
      simp [Fintype.card_fin]

/-- No-empty profiles within terminal L1-distance `D`. -/
noncomputable def noEmptyProfileTerminalBandFinset
    (n m D : ℕ) : Finset (Fin (n + 1) → Fin (n + 1)) :=
  (noEmptyColoringProfileFinset n m (partBThresholdLevel n)).filter
    (fun f => partBProfileTerminalL1Distance n m f ≤ D)

/-- Complementary terminal tail outside L1-distance `D`. -/
noncomputable def noEmptyProfileTerminalTailFinset
    (n m D : ℕ) : Finset (Fin (n + 1) → Fin (n + 1)) :=
  (noEmptyColoringProfileFinset n m (partBThresholdLevel n)).filter
    (fun f => ¬ partBProfileTerminalL1Distance n m f ≤ D)

lemma noEmptyProfileTerminalTailFinset_zero_eq_erase
    (n m : ℕ) :
    noEmptyProfileTerminalTailFinset n m 0 =
      (noEmptyColoringProfileFinset n m (partBThresholdLevel n)).erase
        (partBTerminalProfile n m) := by
  classical
  ext f
  constructor
  · intro hf
    have hf_filter :
        f ∈ (noEmptyColoringProfileFinset n m (partBThresholdLevel n)).filter
          (fun f => ¬ partBProfileTerminalL1Distance n m f ≤ 0) := by
      simpa [noEmptyProfileTerminalTailFinset] using hf
    rcases Finset.mem_filter.mp hf_filter with ⟨hfS, hnot_le⟩
    refine Finset.mem_erase.mpr ⟨?_, hfS⟩
    intro hf_terminal
    subst f
    exact hnot_le (by simp [partBProfileTerminalL1Distance])
  · intro hf
    rcases Finset.mem_erase.mp hf with ⟨hf_ne, hfS⟩
    apply Finset.mem_filter.mpr
    refine ⟨hfS, ?_⟩
    intro hle
    have hdist_zero : partBProfileTerminalL1Distance n m f = 0 :=
      Nat.eq_zero_of_le_zero hle
    exact hf_ne (partBProfileTerminalL1Distance_eq_zero_iff.mp hdist_zero)

/-- Budget for the near-terminal band of the fixed-`m` normalized contribution sum. -/
def PaperPartBExactNoEmptyProfileContributionFixedMTerminalBandBudgetTarget
    (D : ℝ → ℝ → ℕ → ℕ → ℕ) (θ : ℝ → ℝ → ℕ → ℕ → ℝ)
    (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      (∑ f ∈ noEmptyProfileTerminalBandFinset n m (D ε δ n m),
        partBExactNoEmptyFixedMNormalizedContribution δ n f) ≤ θ ε δ n m

/-- Budget for the tail outside the near-terminal band. -/
def PaperPartBExactNoEmptyProfileContributionFixedMTerminalTailBudgetTarget
    (D : ℝ → ℝ → ℕ → ℕ → ℕ) (θ : ℝ → ℝ → ℕ → ℕ → ℝ)
    (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      (∑ f ∈ noEmptyProfileTerminalTailFinset n m (D ε δ n m),
        partBExactNoEmptyFixedMNormalizedContribution δ n f) ≤ 1 - θ ε δ n m

/-- Erase-form version of the concrete zero-tail half-budget. This is equivalent to the
`D = 0`, `θ = 1/2` tail target but is better suited for terminal-vs-nonterminal estimates. -/
def PaperPartBExactNoEmptyProfileContributionFixedMTerminalZeroTailEraseHalfBudgetTarget
    (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      (∑ f ∈ (noEmptyColoringProfileFinset n m (partBThresholdLevel n)).erase
        (partBTerminalProfile n m),
        partBExactNoEmptyFixedMNormalizedContribution δ n f) ≤ (1 : ℝ) / 2

/-- The erased zero-tail profile set, named to keep the distance-layer interface compact. -/
noncomputable def noEmptyProfileTerminalZeroTailEraseFinset (n m : ℕ) :
    Finset (Fin (n + 1) → Fin (n + 1)) :=
  (noEmptyColoringProfileFinset n m (partBThresholdLevel n)).erase (partBTerminalProfile n m)

/-- The realized L1-distance values on the erased zero-tail profile set. -/
noncomputable def noEmptyProfileTerminalZeroTailDistanceFinset (n m : ℕ) : Finset ℕ :=
  (noEmptyProfileTerminalZeroTailEraseFinset n m).image
    (fun f => partBProfileTerminalL1Distance n m f)

/-- One erased zero-tail layer at fixed terminal L1-distance. -/
noncomputable def noEmptyProfileTerminalZeroTailDistanceLayerFinset (n m d : ℕ) :
    Finset (Fin (n + 1) → Fin (n + 1)) :=
  (noEmptyProfileTerminalZeroTailEraseFinset n m).filter
    (fun f => partBProfileTerminalL1Distance n m f = d)

def PaperPartBExactNoEmptyProfileContributionFixedMTerminalZeroTailEraseEnvelopePointwiseTarget
    (W : ℝ → ℝ → (n : ℕ) → ℕ → (Fin (n + 1) → Fin (n + 1)) → ℝ)
    (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∀ f ∈ (noEmptyColoringProfileFinset n m (partBThresholdLevel n)).erase
        (partBTerminalProfile n m),
        partBExactNoEmptyFixedMNormalizedContribution δ n f ≤ W ε δ n m f

def PaperPartBExactNoEmptyProfileContributionFixedMTerminalZeroTailEraseEnvelopeSumTarget
    (W : ℝ → ℝ → (n : ℕ) → ℕ → (Fin (n + 1) → Fin (n + 1)) → ℝ)
    (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      (∑ f ∈ (noEmptyColoringProfileFinset n m (partBThresholdLevel n)).erase
        (partBTerminalProfile n m), W ε δ n m f) ≤ (1 : ℝ) / 2

/-- Distance-only envelope for the erased zero-tail. This is the next useful specialization of
the arbitrary profile envelope: the analytic estimate may depend on a profile only through its
L1-distance from the terminal profile. -/
def PaperPartBExactNoEmptyProfileContributionFixedMTerminalZeroTailEraseDistanceEnvelopePointwiseTarget
    (V : ℝ → ℝ → (n : ℕ) → ℕ → ℕ → ℝ) (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∀ f ∈ (noEmptyColoringProfileFinset n m (partBThresholdLevel n)).erase
        (partBTerminalProfile n m),
        partBExactNoEmptyFixedMNormalizedContribution δ n f ≤
          V ε δ n m (partBProfileTerminalL1Distance n m f)

/-- Logarithmic distance-only envelope for the erased zero-tail. This is the analytic side of
the distance envelope before exponentiating the normalized fixed-`m` contribution. -/
def PaperPartBExactNoEmptyProfileContributionFixedMTerminalZeroTailEraseDistanceLogEnvelopePointwiseTarget
    (L : ℝ → ℝ → (n : ℕ) → ℕ → ℕ → ℝ) (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∀ f ∈ (noEmptyColoringProfileFinset n m (partBThresholdLevel n)).erase
        (partBTerminalProfile n m),
        partBExactNoEmptyContributionLogFixedMExpandedLhs δ n m f ≤
          L ε δ n m (partBProfileTerminalL1Distance n m f)

/-- Summability side of the distance-only erased zero-tail envelope. -/
def PaperPartBExactNoEmptyProfileContributionFixedMTerminalZeroTailEraseDistanceEnvelopeSumTarget
    (V : ℝ → ℝ → (n : ℕ) → ℕ → ℕ → ℝ) (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      (∑ f ∈ (noEmptyColoringProfileFinset n m (partBThresholdLevel n)).erase
        (partBTerminalProfile n m),
        V ε δ n m (partBProfileTerminalL1Distance n m f)) ≤ (1 : ℝ) / 2

/-- Layered summability side of the distance-only erased zero-tail envelope. This exposes the
finite sum over realized L1-distance layers without needing a separate a priori distance bound. -/
def PaperPartBExactNoEmptyProfileContributionFixedMTerminalZeroTailEraseDistanceLayerEnvelopeSumTarget
    (V : ℝ → ℝ → (n : ℕ) → ℕ → ℕ → ℝ) (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      (∑ d ∈ noEmptyProfileTerminalZeroTailDistanceFinset n m,
        ∑ _f ∈ noEmptyProfileTerminalZeroTailDistanceLayerFinset n m d,
          V ε δ n m d) ≤ (1 : ℝ) / 2

/-- Cardinality form of the realized-distance layer envelope. This is the one-dimensional
version of the layer target: each distance layer contributes its cardinality times the
distance-dependent envelope value. -/
def PaperPartBExactNoEmptyProfileContributionFixedMTerminalZeroTailEraseDistanceLayerCardEnvelopeSumTarget
    (V : ℝ → ℝ → (n : ℕ) → ℕ → ℕ → ℝ) (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      (∑ d ∈ noEmptyProfileTerminalZeroTailDistanceFinset n m,
        ((noEmptyProfileTerminalZeroTailDistanceLayerFinset n m d).card : ℝ) *
          V ε δ n m d) ≤ (1 : ℝ) / 2

/-- Lossless realized-distance regrouping target for the erased zero-tail, using the actual
normalized contribution sum inside each distance layer. -/
def PaperPartBExactNoEmptyProfileContributionFixedMTerminalZeroTailExactLayerContributionSumTarget
    (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      (∑ d ∈ noEmptyProfileTerminalZeroTailDistanceFinset n m,
        ∑ f ∈ noEmptyProfileTerminalZeroTailDistanceLayerFinset n m d,
          partBExactNoEmptyFixedMNormalizedContribution δ n f) ≤ (1 : ℝ) / 2

/-- Sharp window target suggested by the all-`m` probe: below the paper obstruction endpoint,
there is not enough `t`-capacity to cover all `n` vertices. -/
def PaperPartBPaperObstructionStrictLowerMEmptyWindowTarget (ε : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m : ℕ, m < partBPaperObstructionColorCount n →
      m * partBThresholdLevel n < n

noncomputable def partBTerminalLowerEndpointColorCount (n : ℕ) : ℕ :=
  ⌈(n : ℝ) / (partBThresholdLevel n : ℝ)⌉₊

def PaperPartBPaperObstructionLowerEndpointUpperTarget (ε : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    partBPaperObstructionColorCount n ≤ partBTerminalLowerEndpointColorCount n

def PaperPartBLowerEndpointPlusTwoExpectationTarget (ε : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    (1 : ℝ) ≤ expectedTBoundedColorings n
      (partBTerminalLowerEndpointColorCount n + 2)
      (partBThresholdLevel n)

/-- Endpoint-only version of the lossless zero-tail contribution target. The empty-window bridge
below lifts this back to the full all-`m` target once all lower `m` are proved infeasible. -/
def PaperPartBExactNoEmptyProfileContributionFixedMTerminalZeroTailEndpointExactLayerContributionSumTarget
    (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    (∑ d ∈ noEmptyProfileTerminalZeroTailDistanceFinset n
        (partBPaperObstructionColorCount n),
      ∑ f ∈ noEmptyProfileTerminalZeroTailDistanceLayerFinset n
        (partBPaperObstructionColorCount n) d,
        partBExactNoEmptyFixedMNormalizedContribution δ n f) ≤ (1 : ℝ) / 2

/-- Size index `t-j` for endpoint deficit coordinates. The explicit hypothesis
`partBThresholdLevel n ≤ n` keeps the coordinate honest: this bound is eventual in the main range,
not a global definitional fact. -/
def partBEndpointDeficitSize
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (j : Fin (partBThresholdLevel n + 1)) : Fin (n + 1) :=
  ⟨partBThresholdLevel n - j.val,
    Nat.lt_succ_of_le ((Nat.sub_le _ _).trans htn)⟩

/-- Endpoint deficit coordinate `e_j = f_{t-j}`. -/
def partBEndpointDeficitCount
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1))
    (j : Fin (partBThresholdLevel n + 1)) : ℕ :=
  (f (partBEndpointDeficitSize n htn j)).val

lemma partBEndpointDeficitSize_val
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (j : Fin (partBThresholdLevel n + 1)) :
    (partBEndpointDeficitSize n htn j).val = partBThresholdLevel n - j.val := rfl

/-- The endpoint deficit coordinate change `j ↦ t-j` is a bijection from deficit indices onto
the original size coordinates at or below the threshold. -/
def partBEndpointDeficitSizeSubtypeEquiv
    (n : ℕ) (htn : partBThresholdLevel n ≤ n) :
    Fin (partBThresholdLevel n + 1) ≃
      {u : Fin (n + 1) // u.val ≤ partBThresholdLevel n} where
  toFun j :=
    ⟨partBEndpointDeficitSize n htn j, Nat.sub_le _ _⟩
  invFun u :=
    ⟨partBThresholdLevel n - u.1.val, Nat.lt_succ_of_le (Nat.sub_le _ _)⟩
  left_inv j := by
    apply Fin.ext
    simp [partBEndpointDeficitSize]
    have hj : j.val ≤ partBThresholdLevel n := Nat.le_of_lt_succ j.isLt
    omega
  right_inv u := by
    apply Subtype.ext
    apply Fin.ext
    simp [partBEndpointDeficitSize]
    exact Nat.sub_sub_self u.2

lemma partBEndpointDeficitCount_zero
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) :
    partBEndpointDeficitCount n htn f ⟨0, Nat.succ_pos _⟩ =
      (f ⟨partBThresholdLevel n, Nat.lt_succ_of_le htn⟩).val := by
  rfl

lemma partBEndpointDeficitCount_last_eq_zero_of_mem_noEmpty
    {n m : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (htn : partBThresholdLevel n ≤ n)
    (hf : f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n)) :
    partBEndpointDeficitCount n htn f (Fin.last (partBThresholdLevel n)) = 0 := by
  have hzero := (mem_noEmptyColoringProfileFinset_iff.mp hf).2
  simpa [partBEndpointDeficitCount, partBEndpointDeficitSize] using hzero

/-- Real color-count in endpoint coefficient notation. This is the unreindexed precursor of
`sum_j e_j = K`. -/
noncomputable def partBEndpointProfileColorCountReal
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  ∑ u : Fin (n + 1), ((f u).val : ℝ)

lemma partBEndpointProfileColorCountReal_eq_of_mem_coloringProfileFinset
    {n k : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ coloringProfileFinset n k (partBThresholdLevel n)) :
    partBEndpointProfileColorCountReal n f = k := by
  simpa [partBEndpointProfileColorCountReal, profileColorCount] using
    congrArg (fun m : ℕ => (m : ℝ)) (profileColorCount_eq_of_mem_coloringProfileFinset hf)

lemma partBEndpointProfileColorCountReal_eq_endpoint_of_mem_noEmpty
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n)) :
    partBEndpointProfileColorCountReal n f = partBPaperObstructionColorCount n := by
  have hf_color : f ∈ coloringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n) :=
    (mem_noEmptyColoringProfileFinset_iff.mp hf).1
  exact partBEndpointProfileColorCountReal_eq_of_mem_coloringProfileFinset hf_color

lemma partBEndpointProfileColorCountReal_eq_thresholdSubtypeSum_of_mem_coloringProfileFinset
    {n k : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ coloringProfileFinset n k (partBThresholdLevel n)) :
    partBEndpointProfileColorCountReal n f =
      ∑ u : {u : Fin (n + 1) // u.val ≤ partBThresholdLevel n},
        ((f u.1).val : ℝ) := by
  classical
  dsimp [partBEndpointProfileColorCountReal]
  have hzero_compl :
      (∑ u : {u : Fin (n + 1) // ¬ u.val ≤ partBThresholdLevel n},
        ((f u.1).val : ℝ)) = 0 := by
    refine Fintype.sum_eq_zero
      (f := fun u : {u : Fin (n + 1) // ¬ u.val ≤ partBThresholdLevel n} =>
        ((f u.1).val : ℝ)) ?_
    intro u
    have htu : partBThresholdLevel n < u.1.val := Nat.lt_of_not_ge u.2
    have hzero : (f u.1).val = 0 :=
      (mem_coloringProfileFinset_iff.mp hf).2.2 u.1 htu
    simp [hzero]
  have hsplit := Fintype.sum_subtype_add_sum_subtype
    (fun u : Fin (n + 1) => u.val ≤ partBThresholdLevel n)
    (fun u : Fin (n + 1) => ((f u).val : ℝ))
  rw [← hsplit, hzero_compl, add_zero]

/-- Real deficit moment in the original size coordinate: `sum_u f_u * (t-u)`. This avoids a
premature finite-sum reindex while exposing the same endpoint quantity that becomes
`sum_j j e_j` after the `e_j = f_{t-j}` change of variables. -/
noncomputable def partBEndpointProfileDeficitMomentReal
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  ∑ u : Fin (n + 1),
    ((f u).val : ℝ) * ((partBThresholdLevel n : ℝ) - (u.val : ℝ))

lemma partBEndpointProfileDeficitMomentReal_eq_of_mem_coloringProfileFinset
    {n k : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ coloringProfileFinset n k (partBThresholdLevel n)) :
    (partBThresholdLevel n : ℝ) * k - n =
      partBEndpointProfileDeficitMomentReal n f := by
  have hcountR :
      (∑ u : Fin (n + 1), ((f u).val : ℝ)) = k := by
    simpa [profileColorCount] using
      congrArg (fun m : ℕ => (m : ℝ)) (profileColorCount_eq_of_mem_coloringProfileFinset hf)
  have hweightR :
      (∑ u : Fin (n + 1), ((u.val * (f u).val : ℕ) : ℝ)) = n := by
    simpa [profileVertexWeight] using
      congrArg (fun m : ℕ => (m : ℝ)) (profileVertexWeight_eq_of_mem_coloringProfileFinset hf)
  calc
    (partBThresholdLevel n : ℝ) * k - n
        = (partBThresholdLevel n : ℝ) *
            (∑ u : Fin (n + 1), ((f u).val : ℝ)) -
            ∑ u : Fin (n + 1), ((u.val * (f u).val : ℕ) : ℝ) := by
              rw [hcountR, hweightR]
    _ = ∑ u : Fin (n + 1),
          ((partBThresholdLevel n : ℝ) * ((f u).val : ℝ)) -
            ∑ u : Fin (n + 1), ((u.val * (f u).val : ℕ) : ℝ) := by
              rw [← Finset.mul_sum]
    _ = ∑ u : Fin (n + 1),
          (((partBThresholdLevel n : ℝ) * ((f u).val : ℝ)) -
            ((u.val * (f u).val : ℕ) : ℝ)) := by
              rw [← Finset.sum_sub_distrib]
    _ = partBEndpointProfileDeficitMomentReal n f := by
          dsimp [partBEndpointProfileDeficitMomentReal]
          refine Finset.sum_congr rfl ?_
          intro u _hu
          norm_num [Nat.cast_mul]
          ring

lemma partBEndpointProfileDeficitMomentReal_eq_endpoint_of_mem_noEmpty
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n)) :
    partBEndpointProfileDeficitMomentReal n f =
      (partBThresholdLevel n : ℝ) * partBPaperObstructionColorCount n - n := by
  have hf_color : f ∈ coloringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n) :=
    (mem_noEmptyColoringProfileFinset_iff.mp hf).1
  exact (partBEndpointProfileDeficitMomentReal_eq_of_mem_coloringProfileFinset hf_color).symm

lemma partBEndpointProfileDeficitMomentReal_eq_thresholdSubtypeSum_of_mem_coloringProfileFinset
    {n k : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ coloringProfileFinset n k (partBThresholdLevel n)) :
    partBEndpointProfileDeficitMomentReal n f =
      ∑ u : {u : Fin (n + 1) // u.val ≤ partBThresholdLevel n},
        ((f u.1).val : ℝ) * ((partBThresholdLevel n : ℝ) - (u.1.val : ℝ)) := by
  classical
  dsimp [partBEndpointProfileDeficitMomentReal]
  have hzero_compl :
      (∑ u : {u : Fin (n + 1) // ¬ u.val ≤ partBThresholdLevel n},
        ((f u.1).val : ℝ) * ((partBThresholdLevel n : ℝ) - (u.1.val : ℝ))) = 0 := by
    refine Fintype.sum_eq_zero
      (f := fun u : {u : Fin (n + 1) // ¬ u.val ≤ partBThresholdLevel n} =>
        ((f u.1).val : ℝ) * ((partBThresholdLevel n : ℝ) - (u.1.val : ℝ))) ?_
    intro u
    have htu : partBThresholdLevel n < u.1.val := Nat.lt_of_not_ge u.2
    have hzero : (f u.1).val = 0 :=
      (mem_coloringProfileFinset_iff.mp hf).2.2 u.1 htu
    simp [hzero]
  have hsplit := Fintype.sum_subtype_add_sum_subtype
    (fun u : Fin (n + 1) => u.val ≤ partBThresholdLevel n)
    (fun u : Fin (n + 1) =>
      ((f u).val : ℝ) * ((partBThresholdLevel n : ℝ) - (u.val : ℝ)))
  rw [← hsplit, hzero_compl, add_zero]

/-- Reindexed endpoint color-count sum in typed deficit coordinates. -/
noncomputable def partBEndpointDeficitColorCountSumReal
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  ∑ j : Fin (partBThresholdLevel n + 1),
    (partBEndpointDeficitCount n htn f j : ℝ)

/-- Natural-number endpoint color-count sum in typed deficit coordinates. -/
noncomputable def partBEndpointDeficitColorCountSumNat
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) : ℕ :=
  ∑ j : Fin (partBThresholdLevel n + 1),
    partBEndpointDeficitCount n htn f j

lemma partBEndpointDeficitColorCountSumReal_eq_natCast
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) :
    partBEndpointDeficitColorCountSumReal n htn f =
      (partBEndpointDeficitColorCountSumNat n htn f : ℝ) := by
  simp [partBEndpointDeficitColorCountSumReal, partBEndpointDeficitColorCountSumNat,
    Nat.cast_sum]

lemma partBEndpointDeficitColorCountSumReal_eq_thresholdSubtypeSum
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) :
    partBEndpointDeficitColorCountSumReal n htn f =
      ∑ u : {u : Fin (n + 1) // u.val ≤ partBThresholdLevel n},
        ((f u.1).val : ℝ) := by
  dsimp [partBEndpointDeficitColorCountSumReal, partBEndpointDeficitCount]
  let e := partBEndpointDeficitSizeSubtypeEquiv n htn
  exact Fintype.sum_equiv e
    (fun j : Fin (partBThresholdLevel n + 1) =>
      ((f (partBEndpointDeficitSize n htn j)).val : ℝ))
    (fun u : {u : Fin (n + 1) // u.val ≤ partBThresholdLevel n} =>
      ((f u.1).val : ℝ))
    (by intro j; rfl)

/-- Reindexed endpoint deficit moment in typed deficit coordinates. -/
noncomputable def partBEndpointDeficitMomentSumReal
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  ∑ j : Fin (partBThresholdLevel n + 1),
    (j.val : ℝ) * (partBEndpointDeficitCount n htn f j : ℝ)

/-- Natural-number endpoint deficit moment in typed deficit coordinates. -/
noncomputable def partBEndpointDeficitMomentSumNat
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) : ℕ :=
  ∑ j : Fin (partBThresholdLevel n + 1),
    j.val * partBEndpointDeficitCount n htn f j

lemma partBEndpointDeficitMomentSumReal_eq_natCast
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) :
    partBEndpointDeficitMomentSumReal n htn f =
      (partBEndpointDeficitMomentSumNat n htn f : ℝ) := by
  simp [partBEndpointDeficitMomentSumReal, partBEndpointDeficitMomentSumNat,
    Nat.cast_sum, Nat.cast_mul]

/-- The endpoint tail deficit moment `Q = sum_{j >= 2} j e_j`. Note 241 predicts
`terminal L1 distance = 2 * Q` for endpoint erased profiles; the named target below keeps that
finite identity separate from the later coefficient/saddle analysis. -/
noncomputable def partBEndpointDeficitTailMomentSumReal
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  ∑ j : Fin (partBThresholdLevel n + 1),
    if 2 ≤ j.val then
      (j.val : ℝ) * (partBEndpointDeficitCount n htn f j : ℝ)
    else 0

/-- Endpoint tail count `S = sum_{j >= 2} e_j`, used together with the tail moment
`Q = sum_{j >= 2} j e_j` in the finite proof of `L1 = 2Q`. -/
noncomputable def partBEndpointDeficitTailCountSumReal
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  ∑ j : Fin (partBThresholdLevel n + 1),
    if 2 ≤ j.val then
      (partBEndpointDeficitCount n htn f j : ℝ)
    else 0

/-- Natural-number version of the endpoint tail deficit moment `Q = sum_{j >= 2} j e_j`.
This is the preferred surface for finite L1 arithmetic before coercing to real estimates. -/
noncomputable def partBEndpointDeficitTailMomentSumNat
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) : ℕ :=
  ∑ j : Fin (partBThresholdLevel n + 1),
    if 2 ≤ j.val then
      j.val * partBEndpointDeficitCount n htn f j
    else 0

/-- Natural-number version of the endpoint tail count `S = sum_{j >= 2} e_j`. -/
noncomputable def partBEndpointDeficitTailCountSumNat
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) : ℕ :=
  ∑ j : Fin (partBThresholdLevel n + 1),
    if 2 ≤ j.val then
      partBEndpointDeficitCount n htn f j
    else 0

lemma partBEndpointDeficitTailMomentSumReal_eq_natCast
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) :
    partBEndpointDeficitTailMomentSumReal n htn f =
      (partBEndpointDeficitTailMomentSumNat n htn f : ℝ) := by
  simp [partBEndpointDeficitTailMomentSumReal, partBEndpointDeficitTailMomentSumNat,
    Nat.cast_sum, Nat.cast_mul]

lemma partBEndpointDeficitTailCountSumReal_eq_natCast
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) :
    partBEndpointDeficitTailCountSumReal n htn f =
      (partBEndpointDeficitTailCountSumNat n htn f : ℝ) := by
  simp [partBEndpointDeficitTailCountSumReal, partBEndpointDeficitTailCountSumNat, Nat.cast_sum]

lemma partBEndpointDeficitColorCountSumNat_eq_zero_one_tail
    {n : ℕ} (ht_one : 1 < partBThresholdLevel n)
    (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) :
    partBEndpointDeficitColorCountSumNat n htn f =
      partBEndpointDeficitCount n htn f 0 +
        partBEndpointDeficitCount n htn f ⟨1, by omega⟩ +
        partBEndpointDeficitTailCountSumNat n htn f := by
  classical
  let j0 : Fin (partBThresholdLevel n + 1) := 0
  let j1 : Fin (partBThresholdLevel n + 1) := ⟨1, by omega⟩
  let e : Fin (partBThresholdLevel n + 1) → ℕ :=
    fun j => partBEndpointDeficitCount n htn f j
  have hpoint : ∀ j : Fin (partBThresholdLevel n + 1),
      e j =
        (if j = j0 then e j else 0) +
          (if j = j1 then e j else 0) +
          (if 2 ≤ j.val then e j else 0) := by
    intro j
    by_cases hj0 : j = j0
    · subst j
      have h01 : j0 ≠ j1 := by
        intro h
        have hval := congrArg Fin.val h
        simp [j0, j1] at hval
      simp [j0, j1, h01]
    · by_cases hj1 : j = j1
      · subst j
        have h10 : j1 ≠ j0 := by
          intro h
          have hval := congrArg Fin.val h
          simp [j0, j1] at hval
        simp [j0, j1, h10]
      · have hjge : 2 ≤ j.val := by
          have hj0val : j.val ≠ 0 := by
            intro h
            exact hj0 (Fin.ext (by simpa [j0] using h))
          have hj1val : j.val ≠ 1 := by
            intro h
            exact hj1 (Fin.ext (by simpa [j1] using h))
          omega
        simp [hj0, hj1, hjge]
  calc
    partBEndpointDeficitColorCountSumNat n htn f = ∑ j, e j := by
      rfl
    _ = (∑ j : Fin (partBThresholdLevel n + 1),
        ((if j = j0 then e j else 0) +
          (if j = j1 then e j else 0) +
          (if 2 ≤ j.val then e j else 0))) := by
          exact Finset.sum_congr rfl (fun j _ => hpoint j)
    _ = (∑ j : Fin (partBThresholdLevel n + 1), if j = j0 then e j else 0) +
          (∑ j : Fin (partBThresholdLevel n + 1), if j = j1 then e j else 0) +
          ∑ j : Fin (partBThresholdLevel n + 1), if 2 ≤ j.val then e j else 0 := by
          simp [Finset.sum_add_distrib, add_assoc]
    _ = partBEndpointDeficitCount n htn f 0 +
          partBEndpointDeficitCount n htn f ⟨1, by omega⟩ +
          partBEndpointDeficitTailCountSumNat n htn f := by
          simp [partBEndpointDeficitTailCountSumNat, e, j0, j1]

lemma partBEndpointDeficitMomentSumNat_eq_one_tailMoment
    {n : ℕ} (ht_one : 1 < partBThresholdLevel n)
    (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) :
    partBEndpointDeficitMomentSumNat n htn f =
      partBEndpointDeficitCount n htn f ⟨1, by omega⟩ +
        partBEndpointDeficitTailMomentSumNat n htn f := by
  classical
  let j0 : Fin (partBThresholdLevel n + 1) := 0
  let j1 : Fin (partBThresholdLevel n + 1) := ⟨1, by omega⟩
  let e : Fin (partBThresholdLevel n + 1) → ℕ :=
    fun j => partBEndpointDeficitCount n htn f j
  have hpoint : ∀ j : Fin (partBThresholdLevel n + 1),
      j.val * e j =
        (if j = j1 then e j else 0) +
          (if 2 ≤ j.val then j.val * e j else 0) := by
    intro j
    by_cases hj0 : j = j0
    · subst j
      have h01 : j0 ≠ j1 := by
        intro h
        have hval := congrArg Fin.val h
        simp [j0, j1] at hval
      simp [j0, j1, h01]
    · by_cases hj1 : j = j1
      · subst j
        simp [j1]
      · have hjge : 2 ≤ j.val := by
          have hj0val : j.val ≠ 0 := by
            intro h
            exact hj0 (Fin.ext (by simpa [j0] using h))
          have hj1val : j.val ≠ 1 := by
            intro h
            exact hj1 (Fin.ext (by simpa [j1] using h))
          omega
        simp [hj1, hjge]
  calc
    partBEndpointDeficitMomentSumNat n htn f = ∑ j, j.val * e j := by
      rfl
    _ = (∑ j : Fin (partBThresholdLevel n + 1),
        ((if j = j1 then e j else 0) +
          (if 2 ≤ j.val then j.val * e j else 0))) := by
          exact Finset.sum_congr rfl (fun j _ => hpoint j)
    _ = (∑ j : Fin (partBThresholdLevel n + 1), if j = j1 then e j else 0) +
          ∑ j : Fin (partBThresholdLevel n + 1), if 2 ≤ j.val then j.val * e j else 0 := by
          simp [Finset.sum_add_distrib]
    _ = partBEndpointDeficitCount n htn f ⟨1, by omega⟩ +
          partBEndpointDeficitTailMomentSumNat n htn f := by
          simp [partBEndpointDeficitTailMomentSumNat, e, j1]

lemma partBEndpointDeficitTailCountSumNat_le_tailMomentSumNat
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) :
    partBEndpointDeficitTailCountSumNat n htn f ≤
      partBEndpointDeficitTailMomentSumNat n htn f := by
  classical
  dsimp [partBEndpointDeficitTailCountSumNat, partBEndpointDeficitTailMomentSumNat]
  refine Finset.sum_le_sum ?_
  intro j _hj
  by_cases hj2 : 2 ≤ j.val
  · simp [hj2]
    exact Nat.le_mul_of_pos_left (partBEndpointDeficitCount n htn f j) (by omega)
  · simp [hj2]

/-- Terminal endpoint deficit counts: `e_0 = K-D`, `e_1 = D`, and all higher deficit
coordinates are zero, where `D = K*t - n`. -/
def partBEndpointTerminalDeficitCount
    (n : ℕ) (j : Fin (partBThresholdLevel n + 1)) : ℕ :=
  if j.val = 0 then
    partBPaperObstructionColorCount n -
      (partBPaperObstructionColorCount n * partBThresholdLevel n - n)
  else if j.val = 1 then
    partBPaperObstructionColorCount n * partBThresholdLevel n - n
  else 0

lemma partBEndpointTerminalDeficitCount_eq_zeroCoord
    (n : ℕ) (j : Fin (partBThresholdLevel n + 1)) (hj : j.val = 0) :
    partBEndpointTerminalDeficitCount n j =
      partBPaperObstructionColorCount n -
        (partBPaperObstructionColorCount n * partBThresholdLevel n - n) := by
  simp [partBEndpointTerminalDeficitCount, hj]

lemma partBEndpointTerminalDeficitCount_eq_oneCoord
    (n : ℕ) (j : Fin (partBThresholdLevel n + 1)) (hj : j.val = 1) :
    partBEndpointTerminalDeficitCount n j =
      partBPaperObstructionColorCount n * partBThresholdLevel n - n := by
  simp [partBEndpointTerminalDeficitCount, hj]

lemma partBEndpointTerminalDeficitCount_eq_zero_of_two_le
    (n : ℕ) (j : Fin (partBThresholdLevel n + 1)) (hj : 2 ≤ j.val) :
    partBEndpointTerminalDeficitCount n j = 0 := by
  have hj0 : j.val ≠ 0 := by omega
  have hj1 : j.val ≠ 1 := by omega
  simp [partBEndpointTerminalDeficitCount, hj0, hj1]

/-- Endpoint L1 distance in typed deficit coordinates. This is the exact coordinate analogue of
`partBProfileTerminalL1Distance` before reducing the terminal-profile differences to `2Q`. -/
noncomputable def partBEndpointDeficitL1Distance
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) : ℕ :=
  ∑ j : Fin (partBThresholdLevel n + 1),
    ((partBEndpointDeficitCount n htn f j - partBEndpointTerminalDeficitCount n j) +
      (partBEndpointTerminalDeficitCount n j - partBEndpointDeficitCount n htn f j))

lemma partBEndpointDeficitL1Distance_eq_zero_one_tail
    {n : ℕ} (ht_one : 1 < partBThresholdLevel n)
    (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) :
    partBEndpointDeficitL1Distance n htn f =
      ((partBEndpointDeficitCount n htn f 0 - partBEndpointTerminalDeficitCount n 0) +
        (partBEndpointTerminalDeficitCount n 0 - partBEndpointDeficitCount n htn f 0)) +
      ((partBEndpointDeficitCount n htn f ⟨1, by omega⟩ -
          partBEndpointTerminalDeficitCount n ⟨1, by omega⟩) +
        (partBEndpointTerminalDeficitCount n ⟨1, by omega⟩ -
          partBEndpointDeficitCount n htn f ⟨1, by omega⟩)) +
      partBEndpointDeficitTailCountSumNat n htn f := by
  classical
  let j0 : Fin (partBThresholdLevel n + 1) := 0
  let j1 : Fin (partBThresholdLevel n + 1) := ⟨1, by omega⟩
  let e : Fin (partBThresholdLevel n + 1) → ℕ :=
    fun j => partBEndpointDeficitCount n htn f j
  let term : Fin (partBThresholdLevel n + 1) → ℕ :=
    fun j => partBEndpointTerminalDeficitCount n j
  let d : Fin (partBThresholdLevel n + 1) → ℕ :=
    fun j => (e j - term j) + (term j - e j)
  have hpoint : ∀ j : Fin (partBThresholdLevel n + 1),
      d j =
        (if j = j0 then d j else 0) +
          (if j = j1 then d j else 0) +
          (if 2 ≤ j.val then d j else 0) := by
    intro j
    by_cases hj0 : j = j0
    · subst j
      have h01 : j0 ≠ j1 := by
        intro h
        have hval := congrArg Fin.val h
        simp [j0, j1] at hval
      simp [j0, j1, h01]
    · by_cases hj1 : j = j1
      · subst j
        have h10 : j1 ≠ j0 := by
          intro h
          have hval := congrArg Fin.val h
          simp [j0, j1] at hval
        simp [j0, j1, h10]
      · have hjge : 2 ≤ j.val := by
          have hj0val : j.val ≠ 0 := by
            intro h
            exact hj0 (Fin.ext (by simpa [j0] using h))
          have hj1val : j.val ≠ 1 := by
            intro h
            exact hj1 (Fin.ext (by simpa [j1] using h))
          omega
        simp [hj0, hj1, hjge]
  have htail :
      (∑ j : Fin (partBThresholdLevel n + 1), if 2 ≤ j.val then d j else 0) =
        partBEndpointDeficitTailCountSumNat n htn f := by
    refine Finset.sum_congr rfl ?_
    intro j _hj
    by_cases hj2 : 2 ≤ j.val
    · have hterm : term j = 0 := by
        simp [term, partBEndpointTerminalDeficitCount_eq_zero_of_two_le n j hj2]
      simp [hj2, d, e, hterm]
    · simp [hj2]
  calc
    partBEndpointDeficitL1Distance n htn f = ∑ j, d j := by
      rfl
    _ = (∑ j : Fin (partBThresholdLevel n + 1),
        ((if j = j0 then d j else 0) +
          (if j = j1 then d j else 0) +
          (if 2 ≤ j.val then d j else 0))) := by
          exact Finset.sum_congr rfl (fun j _ => hpoint j)
    _ = (∑ j : Fin (partBThresholdLevel n + 1), if j = j0 then d j else 0) +
          (∑ j : Fin (partBThresholdLevel n + 1), if j = j1 then d j else 0) +
          ∑ j : Fin (partBThresholdLevel n + 1), if 2 ≤ j.val then d j else 0 := by
          simp [Finset.sum_add_distrib, add_assoc]
    _ = d j0 + d j1 + partBEndpointDeficitTailCountSumNat n htn f := by
          simp [htail]
    _ = ((partBEndpointDeficitCount n htn f 0 - partBEndpointTerminalDeficitCount n 0) +
          (partBEndpointTerminalDeficitCount n 0 - partBEndpointDeficitCount n htn f 0)) +
        ((partBEndpointDeficitCount n htn f ⟨1, by omega⟩ -
            partBEndpointTerminalDeficitCount n ⟨1, by omega⟩) +
          (partBEndpointTerminalDeficitCount n ⟨1, by omega⟩ -
            partBEndpointDeficitCount n htn f ⟨1, by omega⟩)) +
        partBEndpointDeficitTailCountSumNat n htn f := by
          simp [d, e, term, j0, j1, add_assoc]

lemma partBEndpointDeficitMomentSumReal_eq_thresholdSubtypeSum
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) :
    partBEndpointDeficitMomentSumReal n htn f =
      ∑ u : {u : Fin (n + 1) // u.val ≤ partBThresholdLevel n},
        ((partBThresholdLevel n : ℝ) - (u.1.val : ℝ)) * ((f u.1).val : ℝ) := by
  dsimp [partBEndpointDeficitMomentSumReal, partBEndpointDeficitCount]
  refine Fintype.sum_equiv (partBEndpointDeficitSizeSubtypeEquiv n htn)
    (fun j : Fin (partBThresholdLevel n + 1) =>
      (j.val : ℝ) * ((f (partBEndpointDeficitSize n htn j)).val : ℝ))
    (fun u : {u : Fin (n + 1) // u.val ≤ partBThresholdLevel n} =>
      ((partBThresholdLevel n : ℝ) - (u.1.val : ℝ)) * ((f u.1).val : ℝ))
    ?_
  intro j
  simp [partBEndpointDeficitSizeSubtypeEquiv, partBEndpointDeficitSize]
  have hj : j.val ≤ partBThresholdLevel n := Nat.le_of_lt_succ j.isLt
  have hreal :
      (partBThresholdLevel n : ℝ) -
          ((partBThresholdLevel n - j.val : ℕ) : ℝ) = (j.val : ℝ) := by
    have hsub : partBThresholdLevel n - (partBThresholdLevel n - j.val) = j.val :=
      Nat.sub_sub_self hj
    rw [← Nat.cast_sub (Nat.sub_le _ _)]
    exact_mod_cast hsub
  rw [hreal]
  exact Or.inl rfl

def PaperPartBEndpointDeficitReindexTarget (ε : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ f ∈ noEmptyColoringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n),
      ∀ htn : partBThresholdLevel n ≤ n,
        partBEndpointDeficitColorCountSumReal n htn f =
          partBEndpointProfileColorCountReal n f ∧
        partBEndpointDeficitMomentSumReal n htn f =
          partBEndpointProfileDeficitMomentReal n f

def PaperPartBEndpointDeficitCoordinateEquationsTarget (ε : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ f ∈ noEmptyColoringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n),
      ∀ htn : partBThresholdLevel n ≤ n,
        partBEndpointDeficitColorCountSumReal n htn f =
          partBPaperObstructionColorCount n ∧
        partBEndpointDeficitMomentSumReal n htn f =
          (partBThresholdLevel n : ℝ) * partBPaperObstructionColorCount n - n

/-- Local finite target for note 241's endpoint distance formula. Proving this target will let the
distance-layer route be rewritten as a Laplace sum over the tail deficit moment
`Q = sum_{j >= 2} j e_j`. -/
def PaperPartBEndpointDeficitDistanceFormulaLocalTarget : Prop :=
  ∀ n : ℕ, PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n) →
    ∀ f ∈ noEmptyProfileTerminalZeroTailEraseFinset n
      (partBPaperObstructionColorCount n),
    ∀ htn : partBThresholdLevel n ≤ n,
      (partBProfileTerminalL1Distance n (partBPaperObstructionColorCount n) f : ℝ) =
        2 * partBEndpointDeficitTailMomentSumReal n htn f

def PaperPartBEndpointDeficitDistanceFormulaNatLocalTarget : Prop :=
  ∀ n : ℕ, PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n) →
    ∀ f ∈ noEmptyProfileTerminalZeroTailEraseFinset n
      (partBPaperObstructionColorCount n),
    ∀ htn : partBThresholdLevel n ≤ n,
      partBEndpointDeficitL1Distance n htn f =
        2 * partBEndpointDeficitTailMomentSumNat n htn f

theorem paperPartBEndpointDeficitReindexTarget_of_profileSupport (ε : ℝ) :
    PaperPartBEndpointDeficitReindexTarget ε := by
  refine ⟨0, fun n _hn _hmain f hf htn => ?_⟩
  have hf_color : f ∈ coloringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n) :=
    (mem_noEmptyColoringProfileFinset_iff.mp hf).1
  constructor
  · rw [partBEndpointDeficitColorCountSumReal_eq_thresholdSubtypeSum]
    exact (partBEndpointProfileColorCountReal_eq_thresholdSubtypeSum_of_mem_coloringProfileFinset
      hf_color).symm
  · rw [partBEndpointDeficitMomentSumReal_eq_thresholdSubtypeSum]
    rw [partBEndpointProfileDeficitMomentReal_eq_thresholdSubtypeSum_of_mem_coloringProfileFinset
      hf_color]
    simp [mul_comm]

theorem paperPartBEndpointDeficitCoordinateEquationsTarget_of_reindex
    {ε : ℝ} (hreindex : PaperPartBEndpointDeficitReindexTarget ε) :
    PaperPartBEndpointDeficitCoordinateEquationsTarget ε := by
  rcases hreindex with ⟨n₀, hreindex⟩
  refine ⟨n₀, fun n hn hmain f hf htn => ?_⟩
  rcases hreindex n hn hmain f hf htn with ⟨hcolor_reindex, hmoment_reindex⟩
  exact ⟨
    hcolor_reindex.trans (partBEndpointProfileColorCountReal_eq_endpoint_of_mem_noEmpty hf),
    hmoment_reindex.trans (partBEndpointProfileDeficitMomentReal_eq_endpoint_of_mem_noEmpty hf)⟩

theorem paperPartBEndpointDeficitCoordinateEquationsTarget_proved (ε : ℝ) :
    PaperPartBEndpointDeficitCoordinateEquationsTarget ε :=
  paperPartBEndpointDeficitCoordinateEquationsTarget_of_reindex
    (paperPartBEndpointDeficitReindexTarget_of_profileSupport ε)

lemma partBEndpointDeficitCoordinateEquations_of_mem_noEmpty
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n))
    (htn : partBThresholdLevel n ≤ n) :
    partBEndpointDeficitColorCountSumReal n htn f =
        partBPaperObstructionColorCount n ∧
      partBEndpointDeficitMomentSumReal n htn f =
        (partBThresholdLevel n : ℝ) * partBPaperObstructionColorCount n - n := by
  have hf_color : f ∈ coloringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n) :=
    (mem_noEmptyColoringProfileFinset_iff.mp hf).1
  constructor
  · rw [partBEndpointDeficitColorCountSumReal_eq_thresholdSubtypeSum]
    rw [← partBEndpointProfileColorCountReal_eq_thresholdSubtypeSum_of_mem_coloringProfileFinset
      hf_color]
    exact partBEndpointProfileColorCountReal_eq_endpoint_of_mem_noEmpty hf
  · rw [partBEndpointDeficitMomentSumReal_eq_thresholdSubtypeSum]
    calc
      (∑ u : {u : Fin (n + 1) // u.val ≤ partBThresholdLevel n},
          ((partBThresholdLevel n : ℝ) - (u.1.val : ℝ)) * ((f u.1).val : ℝ))
          =
          ∑ u : {u : Fin (n + 1) // u.val ≤ partBThresholdLevel n},
            ((f u.1).val : ℝ) * ((partBThresholdLevel n : ℝ) - (u.1.val : ℝ)) := by
            simp [mul_comm]
      _ = partBEndpointProfileDeficitMomentReal n f :=
          (partBEndpointProfileDeficitMomentReal_eq_thresholdSubtypeSum_of_mem_coloringProfileFinset
            hf_color).symm
      _ = (partBThresholdLevel n : ℝ) * partBPaperObstructionColorCount n - n :=
          partBEndpointProfileDeficitMomentReal_eq_endpoint_of_mem_noEmpty hf

lemma partBEndpointDeficitCoordinateEquations_of_mem_endpointErase
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyProfileTerminalZeroTailEraseFinset n
      (partBPaperObstructionColorCount n))
    (htn : partBThresholdLevel n ≤ n) :
    partBEndpointDeficitColorCountSumReal n htn f =
        partBPaperObstructionColorCount n ∧
      partBEndpointDeficitMomentSumReal n htn f =
        (partBThresholdLevel n : ℝ) * partBPaperObstructionColorCount n - n := by
  have hf_noEmpty : f ∈ noEmptyColoringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n) := by
    exact (Finset.mem_erase.mp (by
      simpa [noEmptyProfileTerminalZeroTailEraseFinset] using hf)).2
  exact partBEndpointDeficitCoordinateEquations_of_mem_noEmpty hf_noEmpty htn

lemma partBEndpointDeficitCoordinateEquationsNat_of_mem_endpointErase
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n))
    (hf : f ∈ noEmptyProfileTerminalZeroTailEraseFinset n
      (partBPaperObstructionColorCount n))
    (htn : partBThresholdLevel n ≤ n) :
    partBEndpointDeficitColorCountSumNat n htn f =
        partBPaperObstructionColorCount n ∧
      partBEndpointDeficitMomentSumNat n htn f =
        partBPaperObstructionColorCount n * partBThresholdLevel n - n := by
  rcases hfeas with ⟨_hlower, hupper, _hmn, _ht_one, _htn_feas⟩
  rcases partBEndpointDeficitCoordinateEquations_of_mem_endpointErase hf htn with
    ⟨hcolor_real, hmoment_real⟩
  constructor
  · apply Nat.cast_injective (R := ℝ)
    rw [← partBEndpointDeficitColorCountSumReal_eq_natCast n htn f]
    exact hcolor_real
  · apply Nat.cast_injective (R := ℝ)
    rw [← partBEndpointDeficitMomentSumReal_eq_natCast n htn f]
    calc
      partBEndpointDeficitMomentSumReal n htn f
          = (partBThresholdLevel n : ℝ) * partBPaperObstructionColorCount n - n :=
            hmoment_real
      _ = (partBPaperObstructionColorCount n * partBThresholdLevel n - n : ℕ) := by
            rw [Nat.cast_sub hupper, Nat.cast_mul]
            ring

lemma partBEndpointDeficitCoordinateEquationsNat_of_mem_noEmpty
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n))
    (hf : f ∈ noEmptyColoringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n))
    (htn : partBThresholdLevel n ≤ n) :
    partBEndpointDeficitColorCountSumNat n htn f =
        partBPaperObstructionColorCount n ∧
      partBEndpointDeficitMomentSumNat n htn f =
        partBPaperObstructionColorCount n * partBThresholdLevel n - n := by
  rcases hfeas with ⟨_hlower, hupper, _hmn, _ht_one, _htn_feas⟩
  rcases partBEndpointDeficitCoordinateEquations_of_mem_noEmpty hf htn with
    ⟨hcolor_real, hmoment_real⟩
  constructor
  · apply Nat.cast_injective (R := ℝ)
    rw [← partBEndpointDeficitColorCountSumReal_eq_natCast n htn f]
    exact hcolor_real
  · apply Nat.cast_injective (R := ℝ)
    rw [← partBEndpointDeficitMomentSumReal_eq_natCast n htn f]
    calc
      partBEndpointDeficitMomentSumReal n htn f
          = (partBThresholdLevel n : ℝ) * partBPaperObstructionColorCount n - n :=
            hmoment_real
      _ = (partBPaperObstructionColorCount n * partBThresholdLevel n - n : ℕ) := by
            rw [Nat.cast_sub hupper, Nat.cast_mul]
            ring

lemma partBEndpointDeficitOneCount_eq_deficit_sub_tailMoment
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n))
    (hf : f ∈ noEmptyProfileTerminalZeroTailEraseFinset n
      (partBPaperObstructionColorCount n))
    (htn : partBThresholdLevel n ≤ n) :
    partBEndpointDeficitCount n htn f ⟨1, by
        rcases hfeas with ⟨_hlower, _hupper, _hmn, ht_one, _htn_feas⟩
        omega⟩ =
      (partBPaperObstructionColorCount n * partBThresholdLevel n - n) -
        partBEndpointDeficitTailMomentSumNat n htn f := by
  rcases hfeas with ⟨hlower, hupper, hmn, ht_one, htn_feas⟩
  have hcoord := partBEndpointDeficitCoordinateEquationsNat_of_mem_endpointErase
    (hfeas := ⟨hlower, hupper, hmn, ht_one, htn_feas⟩) hf htn
  have hsplit := partBEndpointDeficitMomentSumNat_eq_one_tailMoment
    (n := n) ht_one htn f
  rw [hsplit] at hcoord
  omega

lemma partBEndpointDeficitZeroCount_eq_color_sub_one_tailCount
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n))
    (hf : f ∈ noEmptyProfileTerminalZeroTailEraseFinset n
      (partBPaperObstructionColorCount n))
    (htn : partBThresholdLevel n ≤ n) :
    partBEndpointDeficitCount n htn f 0 =
      partBPaperObstructionColorCount n -
        partBEndpointDeficitCount n htn f ⟨1, by
          rcases hfeas with ⟨_hlower, _hupper, _hmn, ht_one, _htn_feas⟩
          omega⟩ -
        partBEndpointDeficitTailCountSumNat n htn f := by
  rcases hfeas with ⟨hlower, hupper, hmn, ht_one, htn_feas⟩
  have hcoord := partBEndpointDeficitCoordinateEquationsNat_of_mem_endpointErase
    (hfeas := ⟨hlower, hupper, hmn, ht_one, htn_feas⟩) hf htn
  have hsplit := partBEndpointDeficitColorCountSumNat_eq_zero_one_tail
    (n := n) ht_one htn f
  rw [hsplit] at hcoord
  omega

theorem paperPartBEndpointDeficitDistanceFormulaNatLocalTarget_proved :
    PaperPartBEndpointDeficitDistanceFormulaNatLocalTarget := by
  intro n hfeas f hf htn
  rcases hfeas with ⟨hlower, hupper, hmn, ht_one, htn_feas⟩
  let K := partBPaperObstructionColorCount n
  let T := partBThresholdLevel n
  let D := K * T - n
  let Q := partBEndpointDeficitTailMomentSumNat n htn f
  let S := partBEndpointDeficitTailCountSumNat n htn f
  let j1 : Fin (partBThresholdLevel n + 1) := ⟨1, by omega⟩
  have hfeas' : PartBTerminalProfileFeasible n K :=
    ⟨hlower, hupper, hmn, ht_one, htn_feas⟩
  have hsplit := partBEndpointDeficitL1Distance_eq_zero_one_tail
    (n := n) ht_one htn f
  have hsplit' :
      partBEndpointDeficitL1Distance n htn f =
        ((partBEndpointDeficitCount n htn f 0 - partBEndpointTerminalDeficitCount n 0) +
          (partBEndpointTerminalDeficitCount n 0 - partBEndpointDeficitCount n htn f 0)) +
        ((partBEndpointDeficitCount n htn f j1 -
            partBEndpointTerminalDeficitCount n j1) +
          (partBEndpointTerminalDeficitCount n j1 -
            partBEndpointDeficitCount n htn f j1)) +
        S := by
    simpa [j1, S] using hsplit
  have hcoord := partBEndpointDeficitCoordinateEquationsNat_of_mem_endpointErase
    (hfeas := hfeas') hf htn
  have hcolor_split := partBEndpointDeficitColorCountSumNat_eq_zero_one_tail
    (n := n) ht_one htn f
  have hmoment_split := partBEndpointDeficitMomentSumNat_eq_one_tailMoment
    (n := n) ht_one htn f
  rw [hcolor_split] at hcoord
  rw [hmoment_split] at hcoord
  have hcolor_add :
      partBEndpointDeficitCount n htn f 0 +
          partBEndpointDeficitCount n htn f j1 + S = K := by
    simpa [K, S, j1] using hcoord.1
  have hmoment_add :
      partBEndpointDeficitCount n htn f j1 + Q = D := by
    simpa [K, T, D, Q, j1] using hcoord.2
  have hcolor_eq :
      K = partBEndpointDeficitCount n htn f 0 +
          partBEndpointDeficitCount n htn f j1 + S := hcolor_add.symm
  have hmoment_eq :
      D = partBEndpointDeficitCount n htn f j1 + Q := hmoment_add.symm
  have hSleQ : S ≤ Q := by
    simpa [S, Q] using partBEndpointDeficitTailCountSumNat_le_tailMomentSumNat n htn f
  have hDleK : D ≤ K := by
    have hlow :=
      partBTerminalLowCount_eq_deficit (n := n) (m := K) hlower hupper
    have hsum :=
      partBTerminalLowCount_add_topCount (n := n) (m := K) hupper
    have hsumD : D + partBTerminalTopCount n K = K := by
      rw [hlow] at hsum
      simpa [D, K, T] using hsum
    omega
  have h1leD :
      partBEndpointDeficitCount n htn f j1 ≤ D := by
    omega
  have h0geTerm :
      K - D ≤ partBEndpointDeficitCount n htn f 0 := by
    omega
  have h0eq :
      partBEndpointDeficitCount n htn f 0 = (Q - S) + (K - D) := by
    omega
  have h0sub :
      partBEndpointDeficitCount n htn f 0 - (K - D) = Q - S := by
    exact Nat.sub_eq_of_eq_add h0eq
  have h1sub :
      D - partBEndpointDeficitCount n htn f j1 = Q := by
    omega
  have hterm0 : partBEndpointTerminalDeficitCount n 0 = K - D := by
    simpa [K, T, D] using
      partBEndpointTerminalDeficitCount_eq_zeroCoord n
        (0 : Fin (partBThresholdLevel n + 1)) rfl
  have hterm1 :
      partBEndpointTerminalDeficitCount n j1 = D := by
    simpa [K, T, D] using
      partBEndpointTerminalDeficitCount_eq_oneCoord n
        j1 (by simp [j1])
  rw [hsplit']
  simp [hterm0, hterm1, h0sub, h1sub,
    Nat.sub_eq_zero_of_le h0geTerm, Nat.sub_eq_zero_of_le h1leD]
  omega

lemma partBEndpointDeficitCount_terminalProfile_eq
    {n : ℕ}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n))
    (htn : partBThresholdLevel n ≤ n)
    (j : Fin (partBThresholdLevel n + 1)) :
    partBEndpointDeficitCount n htn
        (partBTerminalProfile n (partBPaperObstructionColorCount n)) j =
      partBEndpointTerminalDeficitCount n j := by
  rcases hfeas with ⟨hlower, hupper, hmn, _ht_one, _htn_feas⟩
  by_cases hj0 : j.val = 0
  · have hsize :
        (partBEndpointDeficitSize n htn j).val = partBThresholdLevel n := by
      simp [partBEndpointDeficitSize, hj0]
    have htop := partBTerminalProfile_top_val
      (n := n) (m := partBPaperObstructionColorCount n)
      (u := partBEndpointDeficitSize n htn j) hsize
    rw [partBEndpointDeficitCount, htop,
      partBTerminalTopCount_eq_colorCount_sub_deficit (n := n)
        (m := partBPaperObstructionColorCount n) hlower hupper]
    simp [partBEndpointTerminalDeficitCount, hj0]
  · by_cases hj1 : j.val = 1
    · have hsize :
          (partBEndpointDeficitSize n htn j).val = partBThresholdLevel n - 1 := by
        simp [partBEndpointDeficitSize, hj1]
      have hne_top :
          (partBEndpointDeficitSize n htn j).val ≠ partBThresholdLevel n := by
        omega
      have hlow := partBTerminalProfile_low_val
        (n := n) (m := partBPaperObstructionColorCount n)
        (u := partBEndpointDeficitSize n htn j) hsize hne_top hmn
      rw [partBEndpointDeficitCount, hlow,
        partBTerminalLowCount_eq_deficit (n := n)
          (m := partBPaperObstructionColorCount n) hlower hupper]
      simp [partBEndpointTerminalDeficitCount, hj1]
    · have htop_ne :
          (partBEndpointDeficitSize n htn j).val ≠ partBThresholdLevel n := by
        simp [partBEndpointDeficitSize]
        omega
      have hlow_ne :
          (partBEndpointDeficitSize n htn j).val ≠ partBThresholdLevel n - 1 := by
        simp [partBEndpointDeficitSize]
        omega
      have hzero := partBTerminalProfile_apply_of_ne
        (n := n) (m := partBPaperObstructionColorCount n)
        (u := partBEndpointDeficitSize n htn j) htop_ne hlow_ne
      rw [partBEndpointDeficitCount, hzero]
      simp [partBEndpointTerminalDeficitCount, hj0, hj1]

lemma partBProfileTerminalL1Distance_eq_endpointDeficitL1Distance
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n))
    (hf : f ∈ noEmptyColoringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n))
    (htn : partBThresholdLevel n ≤ n) :
    partBProfileTerminalL1Distance n (partBPaperObstructionColorCount n) f =
      partBEndpointDeficitL1Distance n htn f := by
  classical
  have hf_color : f ∈ coloringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n) :=
    (mem_noEmptyColoringProfileFinset_iff.mp hf).1
  dsimp [partBProfileTerminalL1Distance, partBEndpointDeficitL1Distance,
    partBEndpointDeficitCount]
  let p : Fin (n + 1) → Prop := fun u => u.val ≤ partBThresholdLevel n
  have hzero_compl :
      (∑ u : {u : Fin (n + 1) // ¬ p u},
        (((f u.1).val - (partBTerminalProfile n (partBPaperObstructionColorCount n) u.1).val) +
          ((partBTerminalProfile n (partBPaperObstructionColorCount n) u.1).val -
            (f u.1).val))) = 0 := by
    refine Fintype.sum_eq_zero
      (f := fun u : {u : Fin (n + 1) // ¬ p u} =>
        (((f u.1).val - (partBTerminalProfile n (partBPaperObstructionColorCount n) u.1).val) +
          ((partBTerminalProfile n (partBPaperObstructionColorCount n) u.1).val -
            (f u.1).val))) ?_
    intro u
    have htu : partBThresholdLevel n < u.1.val := Nat.lt_of_not_ge u.2
    have hf_zero : (f u.1).val = 0 :=
      (mem_coloringProfileFinset_iff.mp hf_color).2.2 u.1 htu
    have hterm_zero :
        (partBTerminalProfile n (partBPaperObstructionColorCount n) u.1).val = 0 :=
      partBTerminalProfile_zero_above_threshold (n := n)
        (m := partBPaperObstructionColorCount n) (u := u.1) htu
    simp [hf_zero, hterm_zero]
  have hsplit := Fintype.sum_subtype_add_sum_subtype p
    (fun u : Fin (n + 1) =>
      (((f u).val - (partBTerminalProfile n (partBPaperObstructionColorCount n) u).val) +
        ((partBTerminalProfile n (partBPaperObstructionColorCount n) u).val - (f u).val)))
  rw [← hsplit, hzero_compl, add_zero]
  let e := partBEndpointDeficitSizeSubtypeEquiv n htn
  refine (Fintype.sum_equiv e
    (fun j : Fin (partBThresholdLevel n + 1) =>
      ((f (partBEndpointDeficitSize n htn j)).val -
          partBEndpointTerminalDeficitCount n j) +
        (partBEndpointTerminalDeficitCount n j -
          (f (partBEndpointDeficitSize n htn j)).val))
    (fun u : {u : Fin (n + 1) // u.val ≤ partBThresholdLevel n} =>
      (((f u.1).val - (partBTerminalProfile n (partBPaperObstructionColorCount n) u.1).val) +
        ((partBTerminalProfile n (partBPaperObstructionColorCount n) u.1).val -
          (f u.1).val)))
    ?_).symm
  intro j
  have hterm :=
    partBEndpointDeficitCount_terminalProfile_eq (n := n) hfeas htn j
  dsimp [partBEndpointDeficitCount] at hterm
  simp [e, partBEndpointDeficitSizeSubtypeEquiv, hterm]

theorem paperPartBEndpointDeficitDistanceFormulaLocalTarget_of_nat
    (hnat : PaperPartBEndpointDeficitDistanceFormulaNatLocalTarget) :
    PaperPartBEndpointDeficitDistanceFormulaLocalTarget := by
  intro n hfeas f hf htn
  rw [partBProfileTerminalL1Distance_eq_endpointDeficitL1Distance hfeas
    (by
      exact (Finset.mem_erase.mp (by
        simpa [noEmptyProfileTerminalZeroTailEraseFinset] using hf)).2)
    htn]
  rw [hnat n hfeas f hf htn]
  rw [partBEndpointDeficitTailMomentSumReal_eq_natCast n htn f]
  norm_num

theorem paperPartBEndpointDeficitDistanceFormulaLocalTarget_proved :
    PaperPartBEndpointDeficitDistanceFormulaLocalTarget :=
  paperPartBEndpointDeficitDistanceFormulaLocalTarget_of_nat
    paperPartBEndpointDeficitDistanceFormulaNatLocalTarget_proved

/-- Endpoint profile written as a bounded deficit vector `e_j = f_{t-j}`. Keeping this as a
function into `Fin (n+1)` lets later coefficient work sum over a finite vector surface directly. -/
def partBEndpointDeficitVector
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (f : Fin (n + 1) → Fin (n + 1)) :
    Fin (partBThresholdLevel n + 1) → Fin (n + 1) :=
  fun j => f (partBEndpointDeficitSize n htn j)

lemma partBEndpointDeficitVector_terminalProfile_val_eq
    {n : ℕ}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n))
    (htn : partBThresholdLevel n ≤ n)
    (j : Fin (partBThresholdLevel n + 1)) :
    ((partBEndpointDeficitVector n htn
      (partBTerminalProfile n (partBPaperObstructionColorCount n))) j).val =
        partBEndpointTerminalDeficitCount n j := by
  simpa [partBEndpointDeficitVector, partBEndpointDeficitCount] using
    partBEndpointDeficitCount_terminalProfile_eq (n := n) hfeas htn j

/-- Finite surface of endpoint deficit vectors satisfying the two coordinate equations
`sum e_j = K` and `sum j e_j = D`. This is the finite carrier for the future raw coefficient
identity before introducing any generating-function notation. -/
noncomputable def partBEndpointDeficitVectorFinset (n : ℕ) :
    Finset (Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :=
  Finset.univ.filter (fun e =>
    (∑ j : Fin (partBThresholdLevel n + 1), (e j).val) =
        partBPaperObstructionColorCount n ∧
      (∑ j : Fin (partBThresholdLevel n + 1), j.val * (e j).val) =
        partBPaperObstructionColorCount n * partBThresholdLevel n - n)

lemma mem_partBEndpointDeficitVectorFinset_iff
    {n : ℕ} {e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)} :
    e ∈ partBEndpointDeficitVectorFinset n ↔
      (∑ j : Fin (partBThresholdLevel n + 1), (e j).val) =
          partBPaperObstructionColorCount n ∧
        (∑ j : Fin (partBThresholdLevel n + 1), j.val * (e j).val) =
          partBPaperObstructionColorCount n * partBThresholdLevel n - n := by
  simp [partBEndpointDeficitVectorFinset]

lemma partBEndpointDeficitVector_mem_finset_of_endpointErase
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n))
    (hf : f ∈ noEmptyProfileTerminalZeroTailEraseFinset n
      (partBPaperObstructionColorCount n))
    (htn : partBThresholdLevel n ≤ n) :
    partBEndpointDeficitVector n htn f ∈ partBEndpointDeficitVectorFinset n := by
  rcases partBEndpointDeficitCoordinateEquationsNat_of_mem_endpointErase
    (hfeas := hfeas) hf htn with ⟨hcolor, hmoment⟩
  rw [mem_partBEndpointDeficitVectorFinset_iff]
  constructor
  · simpa [partBEndpointDeficitVector, partBEndpointDeficitColorCountSumNat,
      partBEndpointDeficitCount] using hcolor
  · simpa [partBEndpointDeficitVector, partBEndpointDeficitMomentSumNat,
      partBEndpointDeficitCount] using hmoment

lemma partBEndpointDeficitVector_mem_finset_of_noEmpty
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n))
    (hf : f ∈ noEmptyColoringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n))
    (htn : partBThresholdLevel n ≤ n) :
    partBEndpointDeficitVector n htn f ∈ partBEndpointDeficitVectorFinset n := by
  rcases partBEndpointDeficitCoordinateEquationsNat_of_mem_noEmpty
    (hfeas := hfeas) hf htn with ⟨hcolor, hmoment⟩
  rw [mem_partBEndpointDeficitVectorFinset_iff]
  constructor
  · simpa [partBEndpointDeficitVector, partBEndpointDeficitColorCountSumNat,
      partBEndpointDeficitCount] using hcolor
  · simpa [partBEndpointDeficitVector, partBEndpointDeficitMomentSumNat,
      partBEndpointDeficitCount] using hmoment

/-- No-empty endpoint deficit vectors. The extra condition `e_t = 0` excludes empty colour
classes, which the two coordinate equations alone do not rule out. -/
noncomputable def partBEndpointNoEmptyDeficitVectorFinset (n : ℕ) :
    Finset (Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :=
  (partBEndpointDeficitVectorFinset n).filter
    (fun e => (e (Fin.last (partBThresholdLevel n))).val = 0)

lemma mem_partBEndpointNoEmptyDeficitVectorFinset_iff
    {n : ℕ} {e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)} :
    e ∈ partBEndpointNoEmptyDeficitVectorFinset n ↔
      e ∈ partBEndpointDeficitVectorFinset n ∧
        (e (Fin.last (partBThresholdLevel n))).val = 0 := by
  simp [partBEndpointNoEmptyDeficitVectorFinset]

lemma partBEndpointDeficitVector_last_eq_zero_of_mem_noEmpty
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n))
    (htn : partBThresholdLevel n ≤ n) :
    ((partBEndpointDeficitVector n htn f)
      (Fin.last (partBThresholdLevel n))).val = 0 := by
  have hf_empty := (mem_noEmptyColoringProfileFinset_iff.mp hf).2
  have hsize :
      partBEndpointDeficitSize n htn (Fin.last (partBThresholdLevel n)) = 0 := by
    ext
    simp [partBEndpointDeficitSize]
  simpa [partBEndpointDeficitVector, hsize] using hf_empty

lemma partBEndpointDeficitVector_mem_noEmptyFinset_of_endpointErase
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n))
    (hf : f ∈ noEmptyProfileTerminalZeroTailEraseFinset n
      (partBPaperObstructionColorCount n))
    (htn : partBThresholdLevel n ≤ n) :
    partBEndpointDeficitVector n htn f ∈ partBEndpointNoEmptyDeficitVectorFinset n := by
  rw [mem_partBEndpointNoEmptyDeficitVectorFinset_iff]
  constructor
  · exact partBEndpointDeficitVector_mem_finset_of_endpointErase hfeas hf htn
  · have hf_noEmpty : f ∈ noEmptyColoringProfileFinset n
        (partBPaperObstructionColorCount n) (partBThresholdLevel n) := by
      exact (Finset.mem_erase.mp (by
        simpa [noEmptyProfileTerminalZeroTailEraseFinset] using hf)).2
    exact partBEndpointDeficitVector_last_eq_zero_of_mem_noEmpty hf_noEmpty htn

lemma partBEndpointDeficitVector_mem_noEmptyFinset_of_noEmpty
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n))
    (hf : f ∈ noEmptyColoringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n))
    (htn : partBThresholdLevel n ≤ n) :
    partBEndpointDeficitVector n htn f ∈ partBEndpointNoEmptyDeficitVectorFinset n := by
  rw [mem_partBEndpointNoEmptyDeficitVectorFinset_iff]
  constructor
  · exact partBEndpointDeficitVector_mem_finset_of_noEmpty hfeas hf htn
  · exact partBEndpointDeficitVector_last_eq_zero_of_mem_noEmpty hf htn

lemma partBEndpointDeficitVector_terminalProfile_mem_noEmptyFinset
    {n : ℕ}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n)) :
    partBEndpointDeficitVector n hfeas.2.2.2.2
      (partBTerminalProfile n (partBPaperObstructionColorCount n)) ∈
        partBEndpointNoEmptyDeficitVectorFinset n := by
  have hterm : partBTerminalProfile n (partBPaperObstructionColorCount n) ∈
      noEmptyColoringProfileFinset n
        (partBPaperObstructionColorCount n) (partBThresholdLevel n) :=
    paperPartBTerminalProfileMembershipTarget n
      (partBPaperObstructionColorCount n) hfeas
  exact partBEndpointDeficitVector_mem_noEmptyFinset_of_noEmpty
    hfeas hterm hfeas.2.2.2.2

/-- Reconstruct an endpoint profile from a deficit vector by setting the coordinate of size
`u <= t` to `e_{t-u}` and all larger sizes to zero. -/
def partBEndpointProfileOfDeficitVector
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    Fin (n + 1) → Fin (n + 1) :=
  fun u =>
    if _hu : u.val ≤ partBThresholdLevel n then
      e ⟨partBThresholdLevel n - u.val, Nat.lt_succ_of_le (Nat.sub_le _ _)⟩
    else 0

lemma partBEndpointDeficitVector_profileOfDeficitVector
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    partBEndpointDeficitVector n htn
      (partBEndpointProfileOfDeficitVector n e) = e := by
  funext j
  have hle : partBThresholdLevel n - j.val ≤ partBThresholdLevel n := Nat.sub_le _ _
  have hidx : partBThresholdLevel n - (partBThresholdLevel n - j.val) = j.val := by
    omega
  simp [partBEndpointDeficitVector, partBEndpointProfileOfDeficitVector,
    partBEndpointDeficitSize, hle, hidx]

lemma partBEndpointProfileOfDeficitVector_zero_above_threshold
    {n : ℕ} (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1))
    (u : Fin (n + 1)) (hu : partBThresholdLevel n < u.val) :
    (partBEndpointProfileOfDeficitVector n e u).val = 0 := by
  have hnot : ¬ u.val ≤ partBThresholdLevel n := Nat.not_le.mpr hu
  simp [partBEndpointProfileOfDeficitVector, hnot]

lemma partBEndpointProfileOfDeficitVector_empty_eq_last
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    (partBEndpointProfileOfDeficitVector n e 0).val =
      (e (Fin.last (partBThresholdLevel n))).val := by
  unfold partBEndpointProfileOfDeficitVector
  simp only [Fin.val_zero, Nat.zero_le, dite_true, Nat.sub_zero]
  congr

lemma partBEndpointProfileOfDeficitVector_empty_eq_zero_of_mem_noEmptyVector
    {n : ℕ} {e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)}
    (he : e ∈ partBEndpointNoEmptyDeficitVectorFinset n) :
    (partBEndpointProfileOfDeficitVector n e 0).val = 0 := by
  have hlast := (mem_partBEndpointNoEmptyDeficitVectorFinset_iff.mp he).2
  rw [partBEndpointProfileOfDeficitVector_empty_eq_last]
  exact hlast

lemma partBEndpointProfileOfDeficitVector_profileColorCount
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    profileColorCount n (partBEndpointProfileOfDeficitVector n e) =
      ∑ j : Fin (partBThresholdLevel n + 1), (e j).val := by
  classical
  rw [profileColorCount]
  let p : Fin (n + 1) → Prop := fun u => u.val ≤ partBThresholdLevel n
  have hzero_compl :
      ∑ u : {u : Fin (n + 1) // ¬ p u},
          ((partBEndpointProfileOfDeficitVector n e) u.1).val = 0 := by
    refine Fintype.sum_eq_zero
      (f := fun u : {u : Fin (n + 1) // ¬ p u} =>
        ((partBEndpointProfileOfDeficitVector n e) u.1).val) ?_
    intro u
    have htu : partBThresholdLevel n < u.1.val := Nat.lt_of_not_ge u.2
    simp [partBEndpointProfileOfDeficitVector_zero_above_threshold e u.1 htu]
  have hsplit := Fintype.sum_subtype_add_sum_subtype p
    (fun u : Fin (n + 1) => ((partBEndpointProfileOfDeficitVector n e) u).val)
  rw [← hsplit, hzero_compl, add_zero]
  let equiv := partBEndpointDeficitSizeSubtypeEquiv n htn
  refine (Fintype.sum_equiv equiv
    (fun j : Fin (partBThresholdLevel n + 1) => (e j).val)
    (fun u : {u : Fin (n + 1) // u.val ≤ partBThresholdLevel n} =>
      ((partBEndpointProfileOfDeficitVector n e) u.1).val)
    ?_).symm
  intro j
  have hidx :
      (⟨partBThresholdLevel n - (partBThresholdLevel n - j.val),
        Nat.lt_succ_of_le (Nat.sub_le _ _)⟩ :
        Fin (partBThresholdLevel n + 1)) = j := by
    ext
    simp
    omega
  simp [equiv, partBEndpointDeficitSizeSubtypeEquiv, partBEndpointProfileOfDeficitVector,
    partBEndpointDeficitSize, hidx]

lemma partBEndpointProfileOfDeficitVector_profileVertexWeight_as_deficitSum
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    profileVertexWeight n (partBEndpointProfileOfDeficitVector n e) =
      ∑ j : Fin (partBThresholdLevel n + 1),
        (partBThresholdLevel n - j.val) * (e j).val := by
  classical
  rw [profileVertexWeight]
  let p : Fin (n + 1) → Prop := fun u => u.val ≤ partBThresholdLevel n
  have hzero_compl :
      ∑ u : {u : Fin (n + 1) // ¬ p u},
          u.1.val * ((partBEndpointProfileOfDeficitVector n e) u.1).val = 0 := by
    refine Fintype.sum_eq_zero
      (f := fun u : {u : Fin (n + 1) // ¬ p u} =>
        u.1.val * ((partBEndpointProfileOfDeficitVector n e) u.1).val) ?_
    intro u
    have htu : partBThresholdLevel n < u.1.val := Nat.lt_of_not_ge u.2
    simp [partBEndpointProfileOfDeficitVector_zero_above_threshold e u.1 htu]
  have hsplit := Fintype.sum_subtype_add_sum_subtype p
    (fun u : Fin (n + 1) =>
      u.val * ((partBEndpointProfileOfDeficitVector n e) u).val)
  rw [← hsplit, hzero_compl, add_zero]
  let equiv := partBEndpointDeficitSizeSubtypeEquiv n htn
  refine (Fintype.sum_equiv equiv
    (fun j : Fin (partBThresholdLevel n + 1) =>
      (partBThresholdLevel n - j.val) * (e j).val)
    (fun u : {u : Fin (n + 1) // u.val ≤ partBThresholdLevel n} =>
      u.1.val * ((partBEndpointProfileOfDeficitVector n e) u.1).val)
    ?_).symm
  intro j
  have hidx :
      (⟨partBThresholdLevel n - (partBThresholdLevel n - j.val),
        Nat.lt_succ_of_le (Nat.sub_le _ _)⟩ :
        Fin (partBThresholdLevel n + 1)) = j := by
    ext
    simp
    omega
  simp [equiv, partBEndpointDeficitSizeSubtypeEquiv, partBEndpointProfileOfDeficitVector,
    partBEndpointDeficitSize, hidx]

lemma partBEndpointProfileOfDeficitVector_profileColorCount_of_mem
    {n : ℕ} (htn : partBThresholdLevel n ≤ n)
    {e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)}
    (he : e ∈ partBEndpointNoEmptyDeficitVectorFinset n) :
    profileColorCount n (partBEndpointProfileOfDeficitVector n e) =
      partBPaperObstructionColorCount n := by
  have he_carrier :=
    (mem_partBEndpointNoEmptyDeficitVectorFinset_iff.mp he).1
  have hcolor := (mem_partBEndpointDeficitVectorFinset_iff.mp he_carrier).1
  rw [partBEndpointProfileOfDeficitVector_profileColorCount n htn]
  exact hcolor

lemma partBEndpointProfileOfDeficitVector_profileVertexWeight_of_mem
    {n : ℕ} (htn : partBThresholdLevel n ≤ n)
    (hcap : n ≤ partBPaperObstructionColorCount n * partBThresholdLevel n)
    {e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)}
    (he : e ∈ partBEndpointNoEmptyDeficitVectorFinset n) :
    profileVertexWeight n (partBEndpointProfileOfDeficitVector n e) = n := by
  let K := partBPaperObstructionColorCount n
  let t := partBThresholdLevel n
  let S := ∑ j : Fin (t + 1), (t - j.val) * (e j).val
  let M := ∑ j : Fin (t + 1), j.val * (e j).val
  let C := ∑ j : Fin (t + 1), (e j).val
  have he_carrier :=
    (mem_partBEndpointNoEmptyDeficitVectorFinset_iff.mp he).1
  have hcolor : C = K := by
    simpa [C, K, t] using
      (mem_partBEndpointDeficitVectorFinset_iff.mp he_carrier).1
  have hmoment : M = K * t - n := by
    simpa [M, K, t] using
      (mem_partBEndpointDeficitVectorFinset_iff.mp he_carrier).2
  have htotal : S + M = t * C := by
    calc
      S + M =
          ∑ j : Fin (t + 1),
            ((t - j.val) * (e j).val + j.val * (e j).val) := by
        simp [S, M, Finset.sum_add_distrib]
      _ = ∑ j : Fin (t + 1), t * (e j).val := by
        refine Finset.sum_congr rfl ?_
        intro j _
        have hjle : j.val ≤ t := Nat.lt_succ_iff.mp j.isLt
        rw [← Nat.add_mul, Nat.sub_add_cancel hjle]
      _ = t * C := by
        simpa [C] using
          (Finset.mul_sum (s := Finset.univ)
            (f := fun j : Fin (t + 1) => (e j).val) t).symm
  rw [partBEndpointProfileOfDeficitVector_profileVertexWeight_as_deficitSum n htn]
  change S = n
  have htotalK : S + (K * t - n) = K * t := by
    rw [← hmoment, ← hcolor]
    simpa [Nat.mul_comm] using htotal
  have hcapK : n ≤ K * t := by
    simpa [K, t] using hcap
  omega

lemma partBEndpointProfileOfDeficitVector_mem_noEmptyColoringProfileFinset_of_mem
    {n : ℕ}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n))
    {e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)}
    (he : e ∈ partBEndpointNoEmptyDeficitVectorFinset n) :
    partBEndpointProfileOfDeficitVector n e ∈
      noEmptyColoringProfileFinset n
        (partBPaperObstructionColorCount n) (partBThresholdLevel n) := by
  rw [mem_noEmptyColoringProfileFinset_iff, mem_coloringProfileFinset_iff]
  constructor
  · constructor
    · exact partBEndpointProfileOfDeficitVector_profileVertexWeight_of_mem
        hfeas.2.2.2.2 hfeas.2.1 he
    · constructor
      · exact partBEndpointProfileOfDeficitVector_profileColorCount_of_mem
          hfeas.2.2.2.2 he
      · intro u hu
        exact partBEndpointProfileOfDeficitVector_zero_above_threshold e u hu
  · exact partBEndpointProfileOfDeficitVector_empty_eq_zero_of_mem_noEmptyVector he

lemma partBEndpointDeficitVector_surjective_on_noEmptyCarrier
    {n : ℕ}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n))
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1))
    (he : e ∈ partBEndpointNoEmptyDeficitVectorFinset n) :
    ∃ f ∈ noEmptyColoringProfileFinset n
        (partBPaperObstructionColorCount n) (partBThresholdLevel n),
      partBEndpointDeficitVector n hfeas.2.2.2.2 f = e := by
  refine ⟨partBEndpointProfileOfDeficitVector n e, ?_, ?_⟩
  · exact partBEndpointProfileOfDeficitVector_mem_noEmptyColoringProfileFinset_of_mem
      hfeas he
  · exact partBEndpointDeficitVector_profileOfDeficitVector n hfeas.2.2.2.2 e

lemma partBEndpointDeficitVector_injective_of_mem_noEmpty
    {n : ℕ} {f g : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n))
    (hg : g ∈ noEmptyColoringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n))
    (htn : partBThresholdLevel n ≤ n)
    (hvec : partBEndpointDeficitVector n htn f =
      partBEndpointDeficitVector n htn g) :
    f = g := by
  classical
  funext u
  have hf_color : f ∈ coloringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n) :=
    (mem_noEmptyColoringProfileFinset_iff.mp hf).1
  have hg_color : g ∈ coloringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n) :=
    (mem_noEmptyColoringProfileFinset_iff.mp hg).1
  by_cases hu : u.val ≤ partBThresholdLevel n
  · let j : Fin (partBThresholdLevel n + 1) :=
      ⟨partBThresholdLevel n - u.val, Nat.lt_succ_of_le (Nat.sub_le _ _)⟩
    have hsize : partBEndpointDeficitSize n htn j = u := by
      ext
      simp [partBEndpointDeficitSize, j]
      omega
    have hv := congrFun hvec j
    simpa [partBEndpointDeficitVector, hsize] using hv
  · have htu : partBThresholdLevel n < u.val := Nat.lt_of_not_ge hu
    have hf_zero : (f u).val = 0 :=
      (mem_coloringProfileFinset_iff.mp hf_color).2.2 u htu
    have hg_zero : (g u).val = 0 :=
      (mem_coloringProfileFinset_iff.mp hg_color).2.2 u htu
    exact Fin.ext (by simp [hf_zero, hg_zero])

lemma partBEndpointProfileOfDeficitVector_endpointDeficitVector_of_mem_noEmpty
    {n : ℕ} {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyColoringProfileFinset n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n))
    (htn : partBThresholdLevel n ≤ n) :
    partBEndpointProfileOfDeficitVector n (partBEndpointDeficitVector n htn f) = f := by
  funext u
  by_cases hu : u.val ≤ partBThresholdLevel n
  · have hidx :
        partBEndpointDeficitSize n htn
          ⟨partBThresholdLevel n - u.val, Nat.lt_succ_of_le (Nat.sub_le _ _)⟩ = u := by
      ext
      simp [partBEndpointDeficitSize]
      omega
    simp [partBEndpointProfileOfDeficitVector, partBEndpointDeficitVector, hu, hidx]
  · have htu : partBThresholdLevel n < u.val := Nat.lt_of_not_ge hu
    have hf_color : f ∈ coloringProfileFinset n
        (partBPaperObstructionColorCount n) (partBThresholdLevel n) :=
      (mem_noEmptyColoringProfileFinset_iff.mp hf).1
    have hf_zero : (f u).val = 0 :=
      (mem_coloringProfileFinset_iff.mp hf_color).2.2 u htu
    have hprof_zero :
        (partBEndpointProfileOfDeficitVector n
          (partBEndpointDeficitVector n htn f) u).val = 0 :=
      partBEndpointProfileOfDeficitVector_zero_above_threshold
        (partBEndpointDeficitVector n htn f) u htu
    exact Fin.ext (by simp [hprof_zero, hf_zero])

/-- The no-empty endpoint deficit-vector carrier with the terminal profile vector removed. -/
noncomputable def partBEndpointNoEmptyDeficitVectorTerminalEraseFinset
    (n : ℕ) (htn : partBThresholdLevel n ≤ n) :
    Finset (Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :=
  (partBEndpointNoEmptyDeficitVectorFinset n).erase
    (partBEndpointDeficitVector n htn
      (partBTerminalProfile n (partBPaperObstructionColorCount n)))

lemma partBEndpointDeficitVector_mem_terminalEraseFinset_of_endpointErase
    {n : ℕ}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n))
    {f : Fin (n + 1) → Fin (n + 1)}
    (hf : f ∈ noEmptyProfileTerminalZeroTailEraseFinset n
      (partBPaperObstructionColorCount n)) :
    partBEndpointDeficitVector n hfeas.2.2.2.2 f ∈
      partBEndpointNoEmptyDeficitVectorTerminalEraseFinset n hfeas.2.2.2.2 := by
  rw [partBEndpointNoEmptyDeficitVectorTerminalEraseFinset, Finset.mem_erase]
  constructor
  · intro hvec
    have hf_noEmpty : f ∈ noEmptyColoringProfileFinset n
        (partBPaperObstructionColorCount n) (partBThresholdLevel n) := by
      exact (Finset.mem_erase.mp (by
        simpa [noEmptyProfileTerminalZeroTailEraseFinset] using hf)).2
    have hterm : partBTerminalProfile n (partBPaperObstructionColorCount n) ∈
        noEmptyColoringProfileFinset n
          (partBPaperObstructionColorCount n) (partBThresholdLevel n) :=
      paperPartBTerminalProfileMembershipTarget n
        (partBPaperObstructionColorCount n) hfeas
    have hprofile := partBEndpointDeficitVector_injective_of_mem_noEmpty
      hf_noEmpty hterm hfeas.2.2.2.2 hvec
    have hf_ne :=
      (Finset.mem_erase.mp (by
        simpa [noEmptyProfileTerminalZeroTailEraseFinset] using hf)).1
    exact hf_ne hprofile
  · exact partBEndpointDeficitVector_mem_noEmptyFinset_of_endpointErase
      hfeas hf hfeas.2.2.2.2

lemma partBEndpointProfileOfDeficitVector_mem_endpointErase_of_mem_terminalEraseFinset
    {n : ℕ}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n))
    {e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)}
    (he : e ∈
      partBEndpointNoEmptyDeficitVectorTerminalEraseFinset n hfeas.2.2.2.2) :
    partBEndpointProfileOfDeficitVector n e ∈
      noEmptyProfileTerminalZeroTailEraseFinset n
        (partBPaperObstructionColorCount n) := by
  rw [partBEndpointNoEmptyDeficitVectorTerminalEraseFinset] at he
  rcases Finset.mem_erase.mp he with ⟨hne, hcarrier⟩
  rw [noEmptyProfileTerminalZeroTailEraseFinset, Finset.mem_erase]
  constructor
  · intro hprofile
    apply hne
    have hround :=
      partBEndpointDeficitVector_profileOfDeficitVector n hfeas.2.2.2.2 e
    rw [hprofile] at hround
    exact hround.symm
  · exact partBEndpointProfileOfDeficitVector_mem_noEmptyColoringProfileFinset_of_mem
      hfeas hcarrier

/-- Vector-side endpoint contribution, before expanding the reconstructed profile into a closed
coefficient weight. -/
noncomputable def partBEndpointDeficitVectorContribution
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) : ℝ :=
  profileContribution n (partBEndpointProfileOfDeficitVector n e)

/-- Forbidden-edge exponent of an endpoint deficit vector, still in finite vector coordinates. -/
noncomputable def partBEndpointDeficitVectorProfileF
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) : ℕ :=
  ∑ j : Fin (partBThresholdLevel n + 1),
    Nat.choose (partBThresholdLevel n - j.val) 2 * (e j).val

/-- Symmetry-factor denominator of an endpoint deficit vector. -/
noncomputable def partBEndpointDeficitVectorProfileSymm
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) : ℕ :=
  ∏ j : Fin (partBThresholdLevel n + 1), Nat.factorial (e j).val

/-- Factorial-size denominator in the profile partition count, in endpoint deficit coordinates. -/
noncomputable def partBEndpointDeficitVectorProfilePDenom
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) : ℕ :=
  ∏ j : Fin (partBThresholdLevel n + 1),
    (Nat.factorial (partBThresholdLevel n - j.val)) ^ (e j).val

/-- Profile partition count `P` in endpoint deficit coordinates. -/
noncomputable def partBEndpointDeficitVectorProfileP
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) : ℕ :=
  Nat.factorial n / partBEndpointDeficitVectorProfilePDenom n e

lemma profileF_endpointProfileOfDeficitVector
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    profileF n (fun u => ((partBEndpointProfileOfDeficitVector n e) u).val) =
      partBEndpointDeficitVectorProfileF n e := by
  classical
  rw [profileF, partBEndpointDeficitVectorProfileF]
  let p : Fin (n + 1) → Prop := fun u => u.val ≤ partBThresholdLevel n
  have hzero_compl :
      ∑ u : {u : Fin (n + 1) // ¬ p u},
          Nat.choose u.1.val 2 *
            ((partBEndpointProfileOfDeficitVector n e) u.1).val = 0 := by
    refine Fintype.sum_eq_zero
      (f := fun u : {u : Fin (n + 1) // ¬ p u} =>
        Nat.choose u.1.val 2 *
          ((partBEndpointProfileOfDeficitVector n e) u.1).val) ?_
    intro u
    have htu : partBThresholdLevel n < u.1.val := Nat.lt_of_not_ge u.2
    simp [partBEndpointProfileOfDeficitVector_zero_above_threshold e u.1 htu]
  have hsplit := Fintype.sum_subtype_add_sum_subtype p
    (fun u : Fin (n + 1) =>
      Nat.choose u.val 2 * ((partBEndpointProfileOfDeficitVector n e) u).val)
  rw [← hsplit, hzero_compl, add_zero]
  let equiv := partBEndpointDeficitSizeSubtypeEquiv n htn
  refine (Fintype.sum_equiv equiv
    (fun j : Fin (partBThresholdLevel n + 1) =>
      Nat.choose (partBThresholdLevel n - j.val) 2 * (e j).val)
    (fun u : {u : Fin (n + 1) // u.val ≤ partBThresholdLevel n} =>
      Nat.choose u.1.val 2 * ((partBEndpointProfileOfDeficitVector n e) u.1).val)
    ?_).symm
  intro j
  have hidx :
      (⟨partBThresholdLevel n - (partBThresholdLevel n - j.val),
        Nat.lt_succ_of_le (Nat.sub_le _ _)⟩ :
        Fin (partBThresholdLevel n + 1)) = j := by
    ext
    simp
    omega
  simp [equiv, partBEndpointDeficitSizeSubtypeEquiv, partBEndpointProfileOfDeficitVector,
    partBEndpointDeficitSize, hidx]

lemma profilePDenom_endpointProfileOfDeficitVector
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    (∏ u : Fin (n + 1),
        (Nat.factorial u.val) ^
          ((partBEndpointProfileOfDeficitVector n e) u).val) =
      partBEndpointDeficitVectorProfilePDenom n e := by
  classical
  rw [partBEndpointDeficitVectorProfilePDenom]
  let p : Fin (n + 1) → Prop := fun u => u.val ≤ partBThresholdLevel n
  have hcompl :
      ∏ u : {u : Fin (n + 1) // ¬ p u},
          (Nat.factorial u.1.val) ^
            ((partBEndpointProfileOfDeficitVector n e) u.1).val = 1 := by
    refine Fintype.prod_eq_one
      (f := fun u : {u : Fin (n + 1) // ¬ p u} =>
        (Nat.factorial u.1.val) ^
          ((partBEndpointProfileOfDeficitVector n e) u.1).val) ?_
    intro u
    have htu : partBThresholdLevel n < u.1.val := Nat.lt_of_not_ge u.2
    simp [partBEndpointProfileOfDeficitVector_zero_above_threshold e u.1 htu]
  have hsplit := Fintype.prod_subtype_mul_prod_subtype p
    (fun u : Fin (n + 1) =>
      (Nat.factorial u.val) ^ ((partBEndpointProfileOfDeficitVector n e) u).val)
  rw [← hsplit, hcompl, mul_one]
  let equiv := partBEndpointDeficitSizeSubtypeEquiv n htn
  refine (Fintype.prod_equiv equiv
    (fun j : Fin (partBThresholdLevel n + 1) =>
      (Nat.factorial (partBThresholdLevel n - j.val)) ^ (e j).val)
    (fun u : {u : Fin (n + 1) // u.val ≤ partBThresholdLevel n} =>
      (Nat.factorial u.1.val) ^
        ((partBEndpointProfileOfDeficitVector n e) u.1).val)
    ?_).symm
  intro j
  have hidx :
      (⟨partBThresholdLevel n - (partBThresholdLevel n - j.val),
        Nat.lt_succ_of_le (Nat.sub_le _ _)⟩ :
        Fin (partBThresholdLevel n + 1)) = j := by
    ext
    simp
    omega
  simp [equiv, partBEndpointDeficitSizeSubtypeEquiv, partBEndpointProfileOfDeficitVector,
    partBEndpointDeficitSize, hidx]

lemma profileP_endpointProfileOfDeficitVector
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    profileP n (fun u => ((partBEndpointProfileOfDeficitVector n e) u).val) =
      partBEndpointDeficitVectorProfileP n e := by
  rw [profileP, partBEndpointDeficitVectorProfileP,
    profilePDenom_endpointProfileOfDeficitVector n htn e]

lemma log_nat_cast_le_log_nat_cast_of_le
    {a b : ℕ} (hb : 1 ≤ b) (hab : a ≤ b) :
    Real.log (a : ℝ) ≤ Real.log (b : ℝ) := by
  by_cases ha : a = 0
  · subst a
    have hlog_b_nonneg : 0 ≤ Real.log (b : ℝ) := by
      exact Real.log_nonneg (by exact_mod_cast hb)
    simpa [Real.log_zero] using hlog_b_nonneg
  · exact Real.log_le_log (by exact_mod_cast Nat.pos_of_ne_zero ha)
      (by exact_mod_cast hab)

lemma partBEndpointDeficitVectorProfileP_le_factorial
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    partBEndpointDeficitVectorProfileP n e ≤ Nat.factorial n := by
  rw [partBEndpointDeficitVectorProfileP]
  exact Nat.div_le_self (Nat.factorial n) (partBEndpointDeficitVectorProfilePDenom n e)

lemma partBEndpointDeficitVectorProfileP_log_le_factorial
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    Real.log (partBEndpointDeficitVectorProfileP n e) ≤ Real.log (Nat.factorial n) := by
  exact log_nat_cast_le_log_nat_cast_of_le
    (Nat.succ_le_of_lt (Nat.factorial_pos n))
    (partBEndpointDeficitVectorProfileP_le_factorial n e)

lemma profileSymm_endpointProfileOfDeficitVector
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    profileSymm n (fun u => ((partBEndpointProfileOfDeficitVector n e) u).val) =
      partBEndpointDeficitVectorProfileSymm n e := by
  classical
  rw [profileSymm, partBEndpointDeficitVectorProfileSymm]
  let p : Fin (n + 1) → Prop := fun u => u.val ≤ partBThresholdLevel n
  have hcompl :
      ∏ u : {u : Fin (n + 1) // ¬ p u},
          Nat.factorial ((partBEndpointProfileOfDeficitVector n e) u.1).val = 1 := by
    refine Fintype.prod_eq_one
      (f := fun u : {u : Fin (n + 1) // ¬ p u} =>
        Nat.factorial ((partBEndpointProfileOfDeficitVector n e) u.1).val) ?_
    intro u
    have htu : partBThresholdLevel n < u.1.val := Nat.lt_of_not_ge u.2
    simp [partBEndpointProfileOfDeficitVector_zero_above_threshold e u.1 htu]
  have hsplit := Fintype.prod_subtype_mul_prod_subtype p
    (fun u : Fin (n + 1) =>
      Nat.factorial ((partBEndpointProfileOfDeficitVector n e) u).val)
  rw [← hsplit, hcompl, mul_one]
  let equiv := partBEndpointDeficitSizeSubtypeEquiv n htn
  refine (Fintype.prod_equiv equiv
    (fun j : Fin (partBThresholdLevel n + 1) => Nat.factorial (e j).val)
    (fun u : {u : Fin (n + 1) // u.val ≤ partBThresholdLevel n} =>
      Nat.factorial ((partBEndpointProfileOfDeficitVector n e) u.1).val)
    ?_).symm
  intro j
  have hidx :
      (⟨partBThresholdLevel n - (partBThresholdLevel n - j.val),
        Nat.lt_succ_of_le (Nat.sub_le _ _)⟩ :
        Fin (partBThresholdLevel n + 1)) = j := by
    ext
    simp
    omega
  simp [equiv, partBEndpointDeficitSizeSubtypeEquiv, partBEndpointProfileOfDeficitVector,
    partBEndpointDeficitSize, hidx]

lemma one_le_partBEndpointDeficitVectorProfileSymm
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    1 ≤ partBEndpointDeficitVectorProfileSymm n e := by
  classical
  rw [partBEndpointDeficitVectorProfileSymm]
  exact Finset.one_le_prod (fun j _ => Nat.succ_le_of_lt (Nat.factorial_pos (e j).val))

lemma partBEndpointDeficitVectorProfileSymm_log_nonneg
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    0 ≤ Real.log (partBEndpointDeficitVectorProfileSymm n e) := by
  exact Real.log_nonneg (by
    exact_mod_cast one_le_partBEndpointDeficitVectorProfileSymm n e)

/-- Closed finite product weight for an endpoint deficit vector, before asymptotic estimation. -/
noncomputable def partBEndpointDeficitVectorClosedContribution
    (n : ℕ) (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) : ℝ :=
  (partBEndpointDeficitVectorProfileP n e : ℝ) *
    (1 / 2 : ℝ) ^ partBEndpointDeficitVectorProfileF n e /
      (partBEndpointDeficitVectorProfileSymm n e : ℝ)

lemma partBEndpointDeficitVectorContribution_eq_closed
    (n : ℕ) (htn : partBThresholdLevel n ≤ n)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    partBEndpointDeficitVectorContribution n e =
      partBEndpointDeficitVectorClosedContribution n e := by
  rw [partBEndpointDeficitVectorContribution, partBEndpointDeficitVectorClosedContribution,
    profileContribution_eq]
  simp [profileP_endpointProfileOfDeficitVector n htn e,
    profileF_endpointProfileOfDeficitVector n htn e,
    profileSymm_endpointProfileOfDeficitVector n htn e]

/-- The raw endpoint erased zero-tail contribution sum, before fixed-`m` normalization. This is the
Lean-facing value that should eventually match the closed unordered coefficient expression
`n! * [z^K q^D](exp(z*A(q)) - terminal)`. -/
noncomputable def partBEndpointRawDeficitCoefficientValue (n : ℕ) : ℝ :=
  ∑ d ∈ noEmptyProfileTerminalZeroTailDistanceFinset n
      (partBPaperObstructionColorCount n),
    ∑ f ∈ noEmptyProfileTerminalZeroTailDistanceLayerFinset n
      (partBPaperObstructionColorCount n) d,
      profileContribution n f

lemma partBEndpointRawDeficitCoefficientValue_eq_eraseSum (n : ℕ) :
    partBEndpointRawDeficitCoefficientValue n =
      ∑ f ∈ noEmptyProfileTerminalZeroTailEraseFinset n
          (partBPaperObstructionColorCount n),
        profileContribution n f := by
  let m := partBPaperObstructionColorCount n
  let S := noEmptyProfileTerminalZeroTailEraseFinset n m
  let dist := fun f : Fin (n + 1) → Fin (n + 1) => partBProfileTerminalL1Distance n m f
  let D := noEmptyProfileTerminalZeroTailDistanceFinset n m
  have hmaps : ∀ f ∈ S, dist f ∈ D := by
    intro f hf
    exact Finset.mem_image.mpr ⟨f, hf, rfl⟩
  have hregroup :
      (∑ f ∈ S, profileContribution n f) =
        ∑ d ∈ D, ∑ f ∈ S.filter (fun f => dist f = d), profileContribution n f := by
    rw [← Finset.sum_fiberwise_of_maps_to hmaps]
  calc
    partBEndpointRawDeficitCoefficientValue n =
        ∑ d ∈ D, ∑ f ∈ S.filter (fun f => dist f = d), profileContribution n f := by
          simp [partBEndpointRawDeficitCoefficientValue, S, D, dist,
            noEmptyProfileTerminalZeroTailDistanceLayerFinset, m]
    _ = ∑ f ∈ noEmptyProfileTerminalZeroTailEraseFinset n
          (partBPaperObstructionColorCount n),
        profileContribution n f := by
          simpa [S, m] using hregroup.symm

lemma partBEndpointRawDeficitCoefficientValue_eq_vectorTerminalEraseSum
    {n : ℕ}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n)) :
    partBEndpointRawDeficitCoefficientValue n =
      ∑ e ∈ partBEndpointNoEmptyDeficitVectorTerminalEraseFinset n hfeas.2.2.2.2,
        partBEndpointDeficitVectorContribution n e := by
  rw [partBEndpointRawDeficitCoefficientValue_eq_eraseSum]
  let S := noEmptyProfileTerminalZeroTailEraseFinset n
    (partBPaperObstructionColorCount n)
  let T := partBEndpointNoEmptyDeficitVectorTerminalEraseFinset n hfeas.2.2.2.2
  let φ : (Fin (n + 1) → Fin (n + 1)) →
      (Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :=
    fun f => partBEndpointDeficitVector n hfeas.2.2.2.2 f
  let ψ : (Fin (partBThresholdLevel n + 1) → Fin (n + 1)) →
      (Fin (n + 1) → Fin (n + 1)) :=
    fun e => partBEndpointProfileOfDeficitVector n e
  refine Finset.sum_bij' (s := S) (t := T)
    (f := fun f => profileContribution n f)
    (g := fun e => partBEndpointDeficitVectorContribution n e)
    (fun f _ => φ f) (fun e _ => ψ e) ?_ ?_ ?_ ?_ ?_
  · intro f hf
    exact partBEndpointDeficitVector_mem_terminalEraseFinset_of_endpointErase
      hfeas (by simpa [S] using hf)
  · intro e he
    exact partBEndpointProfileOfDeficitVector_mem_endpointErase_of_mem_terminalEraseFinset
      hfeas (by simpa [T] using he)
  · intro f hf
    have hf_noEmpty : f ∈ noEmptyColoringProfileFinset n
        (partBPaperObstructionColorCount n) (partBThresholdLevel n) := by
      exact (Finset.mem_erase.mp (by
        simpa [S, noEmptyProfileTerminalZeroTailEraseFinset] using hf)).2
    exact partBEndpointProfileOfDeficitVector_endpointDeficitVector_of_mem_noEmpty
      hf_noEmpty hfeas.2.2.2.2
  · intro e _he
    exact partBEndpointDeficitVector_profileOfDeficitVector n hfeas.2.2.2.2 e
  · intro f hf
    have hf_noEmpty : f ∈ noEmptyColoringProfileFinset n
        (partBPaperObstructionColorCount n) (partBThresholdLevel n) := by
      exact (Finset.mem_erase.mp (by
        simpa [S, noEmptyProfileTerminalZeroTailEraseFinset] using hf)).2
    simp [partBEndpointDeficitVectorContribution, φ,
      partBEndpointProfileOfDeficitVector_endpointDeficitVector_of_mem_noEmpty
        hf_noEmpty hfeas.2.2.2.2]

lemma partBEndpointRawDeficitCoefficientValue_eq_vectorClosedTerminalEraseSum
    {n : ℕ}
    (hfeas : PartBTerminalProfileFeasible n (partBPaperObstructionColorCount n)) :
    partBEndpointRawDeficitCoefficientValue n =
      ∑ e ∈ partBEndpointNoEmptyDeficitVectorTerminalEraseFinset n hfeas.2.2.2.2,
        partBEndpointDeficitVectorClosedContribution n e := by
  rw [partBEndpointRawDeficitCoefficientValue_eq_vectorTerminalEraseSum hfeas]
  refine Finset.sum_congr rfl ?_
  intro e _he
  rw [partBEndpointDeficitVectorContribution_eq_closed n hfeas.2.2.2.2 e]

/-- The endpoint erased zero-tail contribution sum, named as the Lean-facing normalized value that
a future deficit-coefficient identity plus fixed-`m` budget comparison should compute. -/
noncomputable def partBEndpointDeficitCoefficientValue (δ : ℝ) (n : ℕ) : ℝ :=
  ∑ d ∈ noEmptyProfileTerminalZeroTailDistanceFinset n
      (partBPaperObstructionColorCount n),
    ∑ f ∈ noEmptyProfileTerminalZeroTailDistanceLayerFinset n
      (partBPaperObstructionColorCount n) d,
      partBExactNoEmptyFixedMNormalizedContribution δ n f

/-- Lean-facing coefficient-identity target for the endpoint deficit route. The parameter `C`
stands for the future normalized closed-form coefficient expression, i.e. the raw endpoint
coefficient divided by the fixed-`m` inner budget. -/
def PaperPartBEndpointDeficitCoefficientTarget
    (C : ℝ → ℕ → ℝ) (ε δ : ℝ) : Prop :=
