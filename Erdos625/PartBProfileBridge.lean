theorem paperPartBTerminalContributionEntropyFloorExactForbiddenUpperWorstMFeasibleUpperWitnessSlackTarget_of_realSlack
    {ε : ℝ}
    (hreal :
      PaperPartBTerminalContributionEntropyFloorExactForbiddenUpperWorstMFeasibleUpperWitnessRealSlackTarget ε) :
