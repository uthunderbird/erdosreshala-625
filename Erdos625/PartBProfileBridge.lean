theorem paperPartBTerminalContributionEntropyFloorExactForbiddenPenaltyStepProductBoundTarget_of_elementaryGrowth
    (helem :
      PaperPartBTerminalContributionEntropyFloorExactForbiddenPenaltyStepElementaryGrowthTarget) :
    PaperPartBTerminalContributionEntropyFloorExactForbiddenPenaltyStepProductBoundTarget := by
  intro n ht_one
  set t := partBThresholdLevel n with ht_def
  have ht_pos : 0 < t := Nat.lt_trans (by norm_num) ht_one
  have htm1_pos_nat : 0 < t - 1 := Nat.sub_pos_of_lt ht_one
  have htm1_nonneg : 0 ≤ (((t - 1 : ℕ) : ℝ)) := by positivity
  have ht_nonneg : 0 ≤ (t : ℝ) := by positivity
  have hpi : (2 : ℝ) * Real.pi ≤ 8 := by
    nlinarith [Real.pi_le_four]
  by_cases ht_two : t = 2
  · rw [ht_two]
    norm_num
    nlinarith [Real.pi_le_four]
  · have ht_three : 3 ≤ t := by omega
    have hsucc : (t - 1) + 1 = t := Nat.succ_pred_eq_of_pos ht_pos
    have hpow :
        (((t - 1 : ℕ) : ℝ) ^ t) ≤
          (((t - 1 : ℕ) : ℝ) * ((t : ℝ) ^ (t - 1))) := by
      calc
        (((t - 1 : ℕ) : ℝ) ^ t)
            = (((t - 1 : ℕ) : ℝ) ^ ((t - 1) + 1)) := by rw [hsucc]
        _ = (((t - 1 : ℕ) : ℝ) ^ (t - 1)) * (((t - 1 : ℕ) : ℝ)) := by
              rw [pow_succ]
        _ ≤ ((t : ℝ) ^ (t - 1)) * (((t - 1 : ℕ) : ℝ)) := by
              exact mul_le_mul_of_nonneg_right
                (pow_le_pow_left₀ htm1_nonneg (by exact_mod_cast Nat.sub_le t 1) (t - 1))
                htm1_nonneg
        _ = (((t - 1 : ℕ) : ℝ) * ((t : ℝ) ^ (t - 1))) := by ring
    have hmul := mul_le_mul hpi hpow (by positivity) (by positivity)
    calc
      (2 : ℝ) * Real.pi * (((t - 1 : ℕ) : ℝ) ^ t)
          ≤ 8 * ((((t - 1 : ℕ) : ℝ) * ((t : ℝ) ^ (t - 1)))) := by
            simpa [mul_assoc] using hmul
      _ = (8 * (((t - 1 : ℕ) : ℝ))) * ((t : ℝ) ^ (t - 1)) := by ring
      _ ≤ ((2 : ℝ) ^ (t * (t - 1))) * ((t : ℝ) ^ (t - 1)) := by
            exact mul_le_mul_of_nonneg_right
              (by simpa [ht_def] using helem n ht_three)
              (by positivity)

