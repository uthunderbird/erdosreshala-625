    _ = δ / (A * B) := by ring
    _ = partBExactNoEmptyRawProfileBudget δ n m := by
      simp [partBExactNoEmptyRawProfileBudget, R, S, A, B]

lemma partBExactNoEmptyCoarseLogCoreBudget_le_logCoreBudget
    {δ : ℝ} (n m : ℕ) (hδ_pos : 0 < δ) :
    partBExactNoEmptyCoarseLogCoreBudget δ n ≤
      partBExactNoEmptyLogCoreBudget δ n m := by
  exact Real.log_le_log
    (partBExactNoEmptyCoarseRawProfileBudget_pos n hδ_pos)
    (partBExactNoEmptyCoarseRawProfileBudget_le_raw n m hδ_pos.le)

lemma partBExactNoEmptyBinaryLogCoreBudget_le_logCoreBudget
    {δ : ℝ} (hcard : PaperPartBExactNoEmptyProfileBinaryCardBoundTarget)
    (n m : ℕ) (hδ_pos : 0 < δ) :
    partBExactNoEmptyBinaryLogCoreBudget δ n ≤
      partBExactNoEmptyLogCoreBudget δ n m := by
  exact Real.log_le_log
    (partBExactNoEmptyBinaryRawProfileBudget_pos n hδ_pos)
    (partBExactNoEmptyBinaryRawProfileBudget_le_raw hcard n m hδ_pos.le)

/-- Log-core pointwise target for the exact no-empty profile union. -/
def PaperPartBExactNoEmptyProfileLogCorePointwiseTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        profileCombinatorialLogCore n f ≤ partBExactNoEmptyLogCoreBudget δ n m

/-- Coarse log-core pointwise target using only the ambient no-empty profile-count bound. -/
def PaperPartBExactNoEmptyProfileCoarseLogCorePointwiseTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        profileCombinatorialLogCore n f ≤ partBExactNoEmptyCoarseLogCoreBudget δ n

/-- Log-core pointwise target using the candidate binary no-empty profile-count bound. -/
def PaperPartBExactNoEmptyProfileBinaryLogCorePointwiseTarget (ε δ : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        profileCombinatorialLogCore n f ≤ partBExactNoEmptyBinaryLogCoreBudget δ n

/-- Non-vacuous `cont2` core-comparison target for the exact no-empty Part B route.

Unlike the older safe-profile surfaces in `FirstMomentThreshold.lean`, this target has no
`SafeProfileUpperBoundRegime` hypothesis. It asks directly for the paper's core comparison on the
actual no-empty profiles at `m ≤ k_t - 2`. -/
def PaperPartBExactNoEmptyProfileCoreCont2PointwiseTarget (ε : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        ProfileCombinatorialCoreCont2BoundPointwise n f

/-- Concrete non-safe coarse-core comparison target for the exact no-empty Part B route.

This is the reusable bridge from the trivial fiber upper exponent to the paper's retained
`phi + L_0` exponent on the actual no-empty profile range. -/
def PaperPartBExactNoEmptyProfileCoarseCoreCont2PointwiseTarget (ε : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        profileCombinatorialCoreCoarseUpper n m f ≤
          profilePhi n f * n + profileRemainder n f

/-- Fully explicit arithmetic form of the non-safe coarse-core comparison.

This unfolds both the fiber-derived coarse upper exponent and the retained paper
`phi + L_0` exponent, leaving only a concrete real inequality over one profile. -/
def PaperPartBExactNoEmptyProfileExplicitCoarseCoreCont2PointwiseTarget (ε : ℝ) : Prop :=
  ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
    ∀ m ∈ Finset.range (partBPaperObstructionColorCount n + 1),
      ∀ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
        (n : ℝ) * Real.log m - Real.log (Nat.factorial m) -
          ((∑ u : Fin (n + 1),
              ((((u.val * (u.val - 1)) / 2 : ℕ) * (f u).val : ℕ) : ℝ)) *
            Real.log 2) ≤
          (Real.log 2 / 2) *
            ∑ u : Fin (n + 1),
              (((u.val * (f u).val : ℕ) : ℝ) *
                (threshold n - (1 + 2 / Real.log 2) - u.val)) +
          ∑ u : Fin (n + 1), (thresholdFloor n - u.val : ℤ) * (f u).val +
          (n : ℝ) * Real.log (Real.log n) / Real.log n

/-- Single left-hand side for the fully explicit non-safe coarse-core comparison.

The target inequality is `partBExactNoEmptyExplicitCoarseCoreCont2Lhs n m f ≤ 0`. -/
noncomputable def partBExactNoEmptyExplicitCoarseCoreCont2Lhs
    (n m : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  ((n : ℝ) * Real.log m - Real.log (Nat.factorial m) -
      ((∑ u : Fin (n + 1),
          ((((u.val * (u.val - 1)) / 2 : ℕ) * (f u).val : ℕ) : ℝ)) *
        Real.log 2)) -
    ((Real.log 2 / 2) *
        ∑ u : Fin (n + 1),
          (((u.val * (f u).val : ℕ) : ℝ) *
            (threshold n - (1 + 2 / Real.log 2) - u.val)) +
      ∑ u : Fin (n + 1), (thresholdFloor n - u.val : ℤ) * (f u).val +
      (n : ℝ) * Real.log (Real.log n) / Real.log n)

/-- Entropy/factorial part of `partBExactNoEmptyExplicitCoarseCoreCont2Lhs`. -/
noncomputable def partBExactNoEmptyExplicitCoarseCoreEntropyTerm (n m : ℕ) : ℝ :=
  (n : ℝ) * Real.log m - Real.log (Nat.factorial m)

/-- Profile-dependent part of `partBExactNoEmptyExplicitCoarseCoreCont2Lhs`, excluding the
global entropy/factorial and tail terms. -/
noncomputable def partBExactNoEmptyExplicitCoarseCoreProfileTerm
    (n : ℕ) (f : Fin (n + 1) → Fin (n + 1)) : ℝ :=
  -((∑ u : Fin (n + 1),
      ((((u.val * (u.val - 1)) / 2 : ℕ) * (f u).val : ℕ) : ℝ)) *
    Real.log 2) -
    (Real.log 2 / 2) *
      ∑ u : Fin (n + 1),
        (((u.val * (f u).val : ℕ) : ℝ) *
          (threshold n - (1 + 2 / Real.log 2) - u.val)) -
    ∑ u : Fin (n + 1), (thresholdFloor n - u.val : ℤ) * (f u).val

/-- Per-size profile kernel in the explicit coarse-core comparison. The profile-dependent term is
the sum of this kernel weighted by the multiplicities `f_u`. -/
noncomputable def partBExactNoEmptyExplicitCoarseCoreProfileKernel
    (n : ℕ) (u : Fin (n + 1)) : ℝ :=
  -(((u.val * (u.val - 1)) / 2 : ℕ) : ℝ) * Real.log 2 -
    (Real.log 2 / 2) * (u.val : ℝ) *
      (threshold n - (1 + 2 / Real.log 2) - u.val) -
    ((thresholdFloor n - u.val : ℤ) : ℝ)

lemma partBExactNoEmptyExplicitCoarseCoreProfileKernel_eq_linear
    (n : ℕ) (u : Fin (n + 1)) :
    partBExactNoEmptyExplicitCoarseCoreProfileKernel n u =
      (u.val : ℝ) * (Real.log 2 + 2 - (Real.log 2 / 2) * threshold n) -
        thresholdFloor n := by
  dsimp [partBExactNoEmptyExplicitCoarseCoreProfileKernel]
  have hchoose :
      (((u.val * (u.val - 1)) / 2 : ℕ) : ℝ) =
        (u.val : ℝ) * ((u.val : ℝ) - 1) / 2 := by
    rw [← Nat.choose_two_right, Nat.cast_choose_two]
  have hint :
      (((thresholdFloor n - u.val : ℤ) : ℝ)) =
        (thresholdFloor n : ℝ) - (u.val : ℝ) := by
    norm_num
  have hlog2_ne : Real.log 2 ≠ 0 := by
    exact ne_of_gt (Real.log_pos (by norm_num : (1 : ℝ) < 2))
  rw [hchoose, hint]
  field_simp [hlog2_ne]
  ring

/-- Slope of the linearized per-size profile kernel. -/
noncomputable def partBExactNoEmptyExplicitCoarseCoreKernelSlope (n : ℕ) : ℝ :=
  Real.log 2 + 2 - (Real.log 2 / 2) * threshold n

lemma partBExactNoEmptyExplicitCoarseCoreProfileKernel_nonpos_of_slope_nonpos
    {n : ℕ} {u : Fin (n + 1)}
    (hslope : partBExactNoEmptyExplicitCoarseCoreKernelSlope n ≤ 0) :
    partBExactNoEmptyExplicitCoarseCoreProfileKernel n u ≤ 0 := by
  rw [partBExactNoEmptyExplicitCoarseCoreProfileKernel_eq_linear]
  dsimp [partBExactNoEmptyExplicitCoarseCoreKernelSlope] at hslope
  have hu_nonneg : (0 : ℝ) ≤ u.val := by positivity
  have hfloor_nonneg : (0 : ℝ) ≤ thresholdFloor n := by positivity
  nlinarith [mul_nonpos_of_nonneg_of_nonpos hu_nonneg hslope]

/-- Eventual target for the slope negativity that would make the entire profile kernel
pointwise nonpositive. -/
def PaperPartBExactNoEmptyExplicitCoarseCoreKernelSlopeNonposTarget : Prop :=
  ∀ ε : ℝ, 0 < ε →
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
      partBExactNoEmptyExplicitCoarseCoreKernelSlope n ≤ 0

/-- Lightweight threshold lower-bound target sufficient to make the explicit coarse-core kernel
slope nonpositive. -/
def PaperPartBThresholdLowerBoundForKernelSlopeTarget : Prop :=
  ∀ ε : ℝ, 0 < ε →
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
      2 * (Real.log 2 + 2) / Real.log 2 ≤ threshold n

/-- A convenient eventual constant lower-bound target for `threshold n`. This is deliberately
separate from the heavier `ChromaticConnection.lean` proof of such bounds. -/
def PaperPartBThresholdEventuallyGeNineTarget : Prop :=
  ∀ ε : ℝ, 0 < ε →
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
      (9 : ℝ) ≤ threshold n

/-- The constant lower bound `9 <= threshold n` is stronger than the scalar threshold lower bound
needed for the kernel-slope bridge. -/
lemma partB_kernelSlopeThresholdConstant_le_nine :
    2 * (Real.log 2 + 2) / Real.log 2 ≤ (9 : ℝ) := by
  have hlog2_pos : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  have hlog2_gt : (4 : ℝ) / 7 < Real.log 2 := by
    linarith [Real.log_two_gt_d9]
  rw [div_le_iff₀ hlog2_pos]
  nlinarith

private lemma partB_log_le_mul_nat_eventually (C : ℝ) (hC : 0 < C) :
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → Real.log (n : ℝ) ≤ C * n := by
  have ho : Real.log =o[Filter.atTop] id := Real.isLittleO_log_id_atTop
  rw [Asymptotics.isLittleO_iff] at ho
  specialize ho hC
  rw [Filter.eventually_atTop] at ho
  obtain ⟨x₀, hx₀⟩ := ho
  refine ⟨⌈max x₀ 0⌉₊, fun n hn => ?_⟩
  have hn_eventual : x₀ ≤ (n : ℝ) := by
    have h1 : max x₀ 0 ≤ (⌈max x₀ 0⌉₊ : ℝ) := Nat.le_ceil _
    have h2 : (⌈max x₀ 0⌉₊ : ℝ) ≤ n := by exact_mod_cast hn
    linarith [le_max_left x₀ 0]
  have hnorm := hx₀ (n : ℝ) hn_eventual
  have hnorm_id : ‖id (n : ℝ)‖ = (n : ℝ) := by
    simp
  calc
    Real.log (n : ℝ) ≤ ‖Real.log (n : ℝ)‖ := le_abs_self _
    _ ≤ C * n := by simpa [hnorm_id] using hnorm

private lemma partB_threshold_tail_eq_logb_ratio
    {n : ℕ} (hn : 1 < n) :
    (2 : ℝ) ^ (1 - threshold n) =
      ((Real.logb 2 (n : ℝ)) ^ (2 : ℝ)) /
        ((n : ℝ) ^ (2 : ℝ) * (Real.exp 1 / 2) ^ (2 : ℝ)) := by
  have h2pos : (0 : ℝ) < 2 := by norm_num
  have h2gt1 : (1 : ℝ) < 2 := by norm_num
  have h2ne1 : (2 : ℝ) ≠ 1 := by norm_num
  have hnpos : 0 < (n : ℝ) := by
    exact_mod_cast Nat.lt_trans Nat.zero_lt_one hn
  have hlogn_pos : 0 < Real.logb 2 (n : ℝ) := by
    exact Real.logb_pos h2gt1 (by exact_mod_cast hn)
  have hexp_pos : 0 < Real.exp 1 / 2 := by positivity
  have hpow_n : (2 : ℝ) ^ (2 * Real.logb 2 (n : ℝ)) = (n : ℝ) ^ (2 : ℝ) := by
    calc
      (2 : ℝ) ^ (2 * Real.logb 2 (n : ℝ)) =
          ((2 : ℝ) ^ (Real.logb 2 (n : ℝ))) ^ (2 : ℝ) := by
        rw [show 2 * Real.logb 2 (n : ℝ) = Real.logb 2 (n : ℝ) * 2 by ring,
          Real.rpow_mul h2pos.le]
      _ = (n : ℝ) ^ (2 : ℝ) := by
        rw [Real.rpow_logb h2pos h2ne1 hnpos]
  have hpow_log :
      (2 : ℝ) ^ (2 * Real.logb 2 (Real.logb 2 (n : ℝ))) =
        (Real.logb 2 (n : ℝ)) ^ (2 : ℝ) := by
    calc
      (2 : ℝ) ^ (2 * Real.logb 2 (Real.logb 2 (n : ℝ))) =
          ((2 : ℝ) ^ (Real.logb 2 (Real.logb 2 (n : ℝ)))) ^ (2 : ℝ) := by
        rw [show 2 * Real.logb 2 (Real.logb 2 (n : ℝ)) =
          Real.logb 2 (Real.logb 2 (n : ℝ)) * 2 by ring, Real.rpow_mul h2pos.le]
      _ = (Real.logb 2 (n : ℝ)) ^ (2 : ℝ) := by
        rw [Real.rpow_logb h2pos h2ne1 hlogn_pos]
  have hpow_exp : (2 : ℝ) ^ (2 * Real.logb 2 (Real.exp 1 / 2)) =
      (Real.exp 1 / 2) ^ (2 : ℝ) := by
    calc
      (2 : ℝ) ^ (2 * Real.logb 2 (Real.exp 1 / 2)) =
          ((2 : ℝ) ^ (Real.logb 2 (Real.exp 1 / 2))) ^ (2 : ℝ) := by
        rw [show 2 * Real.logb 2 (Real.exp 1 / 2) =
          Real.logb 2 (Real.exp 1 / 2) * 2 by ring, Real.rpow_mul h2pos.le]
      _ = (Real.exp 1 / 2) ^ (2 : ℝ) := by
        rw [Real.rpow_logb h2pos h2ne1 hexp_pos]
  unfold threshold
  simp only [Real.log_div_log]
  rw [show (1 - (2 * Real.logb 2 (n : ℝ) - 2 * Real.logb 2 (Real.logb 2 (n : ℝ)) +
      2 * Real.logb 2 (Real.exp 1 / 2) + 1)) =
      -(2 * Real.logb 2 (n : ℝ)) + 2 * Real.logb 2 (Real.logb 2 (n : ℝ)) -
        (2 * Real.logb 2 (Real.exp 1 / 2)) by ring]
  rw [show (-(2 * Real.logb 2 (n : ℝ)) + 2 * Real.logb 2 (Real.logb 2 (n : ℝ)) -
      (2 * Real.logb 2 (Real.exp 1 / 2))) =
      (2 * Real.logb 2 (Real.logb 2 (n : ℝ))) +
        (-(2 * Real.logb 2 (n : ℝ)) + -(2 * Real.logb 2 (Real.exp 1 / 2))) by ring]
  rw [Real.rpow_add (by positivity), Real.rpow_add (by positivity)]
  rw [Real.rpow_neg h2pos.le, Real.rpow_neg h2pos.le]
  rw [hpow_n, hpow_log, hpow_exp]
  field_simp

private lemma partB_threshold_ge_nine_eventually :
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → (9 : ℝ) ≤ threshold n := by
  have hlog2 : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  set C := Real.log 2 * (Real.exp 1 / 2) / 16 with hC_def
  have hC_pos : 0 < C := by positivity
  obtain ⟨n₀, hn₀⟩ := partB_log_le_mul_nat_eventually C hC_pos
  refine ⟨max n₀ 2, fun n hn => ?_⟩
  have hn₀' : n₀ ≤ n := le_trans (Nat.le_max_left _ _) hn
  have hn2 : 2 ≤ n := le_trans (Nat.le_max_right _ _) hn
  have hn1 : 1 < n := Nat.lt_of_lt_of_le (by norm_num) hn2
  have htail := partB_threshold_tail_eq_logb_ratio hn1
  have hlogb_bound : Real.logb 2 n ≤ (Real.exp 1 / 2) * n / 16 := by
    simp only [Real.logb]
    have h := div_le_div_of_nonneg_right (hn₀ n hn₀') (le_of_lt hlog2)
    rw [hC_def] at h
    have hcancel : Real.log 2 * (Real.exp 1 / 2) / 16 * ↑n / Real.log 2 =
        (Real.exp 1 / 2) * ↑n / 16 := by
      field_simp
    linarith
  have hlogb_pos : 0 ≤ Real.logb 2 n :=
    le_of_lt (Real.logb_pos (by norm_num) (by exact_mod_cast hn1))
  have hbound2 : (Real.logb 2 n)^2 ≤ ((Real.exp 1 / 2) * n / 16)^2 :=
    pow_le_pow_left₀ hlogb_pos hlogb_bound 2
  have htail_le :
      (Real.logb 2 n)^(2 : ℝ) /
          ((n : ℝ)^(2 : ℝ) * (Real.exp 1 / 2)^(2 : ℝ)) ≤ (1 / 2 : ℝ)^8 := by
    rw [div_le_iff₀ (by positivity)]
    have hrpow1 : (Real.logb 2 n)^(2 : ℝ) = (Real.logb 2 n)^2 := Real.rpow_natCast _ 2
    have hrpow2 : (n : ℝ)^(2 : ℝ) = (n : ℝ)^2 := Real.rpow_natCast _ 2
    have hrpow3 : (Real.exp 1 / 2 : ℝ)^(2 : ℝ) = (Real.exp 1 / 2)^2 :=
      Real.rpow_natCast _ 2
    rw [hrpow1, hrpow2, hrpow3]
    calc (Real.logb 2 n)^2
        ≤ ((Real.exp 1 / 2) * n / 16)^2 := hbound2
      _ = (1 / 2 : ℝ)^8 * ((n : ℝ)^2 * (Real.exp 1 / 2)^2) := by ring
  have htail_small : (2 : ℝ)^(1 - threshold n) ≤ (1 / 2 : ℝ)^8 := by
    rw [htail]
    exact htail_le
  have h28 : (1 / 2 : ℝ)^8 = (2 : ℝ)^(1 - (9 : ℝ)) := by
    norm_num [Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2), Real.rpow_natCast]
  rw [h28] at htail_small
  linarith [(Real.rpow_le_rpow_left_iff (by norm_num : (1 : ℝ) < 2)).mp htail_small]

theorem paperPartBThresholdEventuallyGeNineTarget :
    PaperPartBThresholdEventuallyGeNineTarget := by
  obtain ⟨n₀, hge9⟩ := partB_threshold_ge_nine_eventually
  refine fun ε hε_pos => ⟨n₀, fun n hn _ => hge9 n hn⟩

theorem paperPartBThresholdLowerBoundForKernelSlopeTarget_of_thresholdGeNine
    (hge9 : PaperPartBThresholdEventuallyGeNineTarget) :
    PaperPartBThresholdLowerBoundForKernelSlopeTarget := by
  intro ε hε_pos
  rcases hge9 ε hε_pos with ⟨n₀, hge9⟩
  refine ⟨n₀, fun n hn hmain => ?_⟩
  exact partB_kernelSlopeThresholdConstant_le_nine.trans (hge9 n hn hmain)

theorem paperPartBThresholdLowerBoundForKernelSlopeTarget_proved :
    PaperPartBThresholdLowerBoundForKernelSlopeTarget :=
  paperPartBThresholdLowerBoundForKernelSlopeTarget_of_thresholdGeNine
    paperPartBThresholdEventuallyGeNineTarget

theorem paperPartBExactNoEmptyExplicitCoarseCoreKernelSlopeNonposTarget_of_thresholdLower
    (hlower : PaperPartBThresholdLowerBoundForKernelSlopeTarget) :
    PaperPartBExactNoEmptyExplicitCoarseCoreKernelSlopeNonposTarget := by
  intro ε hε_pos
  rcases hlower ε hε_pos with ⟨n₀, hlower⟩
  refine ⟨n₀, fun n hn hmain => ?_⟩
  have hlog2_pos : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  have h := hlower n hn hmain
  have hmul := mul_le_mul_of_nonneg_left h (by positivity : (0 : ℝ) ≤ Real.log 2 / 2)
  have hleft :
      (Real.log 2 / 2) * (2 * (Real.log 2 + 2) / Real.log 2) =
        Real.log 2 + 2 := by
    field_simp [ne_of_gt hlog2_pos]
  rw [hleft] at hmul
  dsimp [partBExactNoEmptyExplicitCoarseCoreKernelSlope]
  nlinarith

theorem paperPartBExactNoEmptyExplicitCoarseCoreKernelSlopeNonposTarget_proved :
    PaperPartBExactNoEmptyExplicitCoarseCoreKernelSlopeNonposTarget :=
  paperPartBExactNoEmptyExplicitCoarseCoreKernelSlopeNonposTarget_of_thresholdLower
    paperPartBThresholdLowerBoundForKernelSlopeTarget_proved

/-- Pointwise nonpositivity target for the per-size profile kernel on the Part B range. -/
def PaperPartBExactNoEmptyExplicitCoarseCoreProfileKernelNonposTarget : Prop :=
  ∀ ε : ℝ, 0 < ε →
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → InMainRange ε n →
