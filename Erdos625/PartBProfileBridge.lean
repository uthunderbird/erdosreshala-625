/-- Injectivity target for the boundary encoding. Proving this discharges the binary profile-count
bound without further analytic work. -/
def PaperPartBExactNoEmptyProfileBoundaryEncodingInjectiveTarget : Prop :=
  ∀ n m : ℕ,
    Set.InjOn (noEmptyProfileBoundaryEncoding n)
      (↑(noEmptyColoringProfileFinset n m (partBThresholdLevel n)) : Set (Fin (n + 1) → Fin (n + 1)))

theorem paperPartBExactNoEmptyProfileBoundaryEncodingInjectiveTarget_of_gapRecovery
    (hgap : PaperPartBExactNoEmptyProfileBoundaryGapRecoveryTarget) :
    PaperPartBExactNoEmptyProfileBoundaryEncodingInjectiveTarget := by
  intro n m f hf g hg henc
  funext u
  apply Fin.ext
  calc
    (f u).val =
        ((noEmptyProfileBoundaryEncoding n f).filter
          (fun s : Fin n =>
            noEmptyProfileBoundaryGap n (noEmptyProfileBoundaryEncoding n f) s = u.val)).card :=
      hgap n m f hf u
    _ =
        ((noEmptyProfileBoundaryEncoding n g).filter
          (fun s : Fin n =>
            noEmptyProfileBoundaryGap n (noEmptyProfileBoundaryEncoding n g) s = u.val)).card := by
      rw [henc]
    _ = (g u).val := (hgap n m g hg u).symm

