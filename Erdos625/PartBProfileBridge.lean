  have hsubset : nearSet ⊆ pairSet := by
    intro j hj
    have hnear :
        2 ≤ j.val ∧ ¬ 2 ≤ partBThresholdLevel n - j.val := by
      simpa [nearSet] using (Finset.mem_filter.mp hj).2
    rcases partBEndpointDeficitVectorNearTop_index_eq_threshold_or_pred hnear with hj_top | hj_pred
    · have hjeq : j = top := by
        ext
        simpa [top] using hj_top
      simp [pairSet, hjeq]
    · have hjeq : j = pred := by
        ext
        simp [pred]
        omega
      simp [pairSet, hjeq]
  have hcount_eq :
      partBEndpointDeficitVectorNearTopCountSumNat n e =
        ∑ j ∈ nearSet, (e j).val := by
    rw [partBEndpointDeficitVectorNearTopCountSumNat]
