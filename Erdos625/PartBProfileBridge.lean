lemma partBExactNoEmptyCoarseRawProfileBudget_le_raw
    {δ : ℝ} (n m : ℕ) (hδ_nonneg : 0 ≤ δ) :
    partBExactNoEmptyCoarseRawProfileBudget δ n ≤
      partBExactNoEmptyRawProfileBudget δ n m := by
  set R := Finset.range (partBPaperObstructionColorCount n + 1)
  set S := noEmptyColoringProfileFinset n m (partBThresholdLevel n)
  set A : ℝ := ((R.card + 1 : ℕ) : ℝ)
  set B : ℝ := ((S.card + 1 : ℕ) : ℝ)
  set A' : ℝ := ((partBPaperObstructionColorCount n + 2 : ℕ) : ℝ)
  set B' : ℝ := ((((n + 1) ^ (n + 1) + 1 : ℕ) : ℝ))
  have hA_eq : A = A' := by
    dsimp [A, A', R]
    simp
    ring
  have hB_le : B ≤ B' := by
    dsimp [B, B', S]
    exact_mod_cast Nat.succ_le_succ (noEmptyColoringProfileFinset_card_le_ambient n m (partBThresholdLevel n))
  have hA_pos : 0 < A := by positivity
  have hB_pos : 0 < B := by positivity
  have hB'_pos : 0 < B' := by positivity
  have hden_le : A * B ≤ A' * B' := by
    rw [hA_eq]
    exact mul_le_mul_of_nonneg_left hB_le (le_of_lt (by simpa [← hA_eq]))
  have hden_pos : 0 < A * B := mul_pos hA_pos hB_pos
  have hden'_pos : 0 < A' * B' := by
    rw [← hA_eq]
    exact mul_pos hA_pos hB'_pos
  have hinv : 1 / (A' * B') ≤ 1 / (A * B) :=
    one_div_le_one_div_of_le hden_pos hden_le
  calc
    partBExactNoEmptyCoarseRawProfileBudget δ n = δ / (A' * B') := by
      simp [partBExactNoEmptyCoarseRawProfileBudget, A', B']
    _ = δ * (1 / (A' * B')) := by ring
    _ ≤ δ * (1 / (A * B)) := by
      exact mul_le_mul_of_nonneg_left hinv hδ_nonneg
    _ = δ / (A * B) := by ring
    _ = partBExactNoEmptyRawProfileBudget δ n m := by
      simp [partBExactNoEmptyRawProfileBudget, R, S, A, B]

