    ℝ → ℝ → (n : ℕ) → ℕ → ℕ :=
  fun _ε _δ n _m => (n + 1) * n

/-- Trivial layer-count upper model: every distance layer is a subset of the full function space
`Fin (n+1) → Fin (n+1)`. -/
def partBTerminalZeroTailFunctionSpaceCardUpper :
    ℝ → ℝ → (n : ℕ) → ℕ → ℕ → ℝ :=
  fun _ε _δ n _m _d => ((n + 1) ^ (n + 1) : ℝ)

/-- Binary profile-count layer upper model: every distance layer is a subset of the no-empty
profile finset, whose cardinality is bounded by `2^n`. -/
def partBTerminalZeroTailBinaryProfileCardUpper :
    ℝ → ℝ → (n : ℕ) → ℕ → ℕ → ℝ :=
