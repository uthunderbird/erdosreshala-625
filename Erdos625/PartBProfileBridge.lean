lemma partBFiniteWindowThresholdLinearRemainderProfileF_le_balancedRemainderProfileF
    {n k : ℕ}
    (hq : partBThresholdLevel n - 1 ≤ n / k) :
    (partBFiniteWindowThresholdLinearRemainderProfileF n k : ℝ) ≤
      (partBFiniteWindowBalancedRemainderProfileF n k : ℝ) := by
  set a : ℕ := partBThresholdLevel n - 1
  set q : ℕ := n / k
  set r : ℕ := n % k
  have hqa : a ≤ q := by simpa [a, q] using hq
  have hdivmod_nat : k * q + r = n := by
    simpa [q, r] using Nat.div_add_mod n k
  have hdivmod : (k : ℝ) * (q : ℝ) + (r : ℝ) = (n : ℝ) := by
    exact_mod_cast hdivmod_nat
  rcases Nat.eq_or_lt_of_le hqa with hqa_eq | hqa_lt
  · have hqa_real : (q : ℝ) = (a : ℝ) := by exact_mod_cast hqa_eq.symm
    dsimp [partBFiniteWindowThresholdLinearRemainderProfileF,
      partBFiniteWindowBalancedRemainderProfileF]
    simp [a, q, hqa_eq, Nat.cast_choose_two]
    have hsub : n - k * (n / k) = n % k := by
      have := Nat.div_add_mod n k
      omega
    rw [hsub]
  · have hqa_real : (a : ℝ) + 1 ≤ (q : ℝ) := by exact_mod_cast hqa_lt
    have hdiff_nonneg : 0 ≤ (q : ℝ) - (a : ℝ) := by linarith
    have hfactor_nonneg : 0 ≤ (k : ℝ) * (((q : ℝ) - (a : ℝ) - 1) / 2) + (r : ℝ) := by
      have : 0 ≤ ((q : ℝ) - (a : ℝ) - 1) / 2 := by linarith
      positivity
    dsimp [partBFiniteWindowThresholdLinearRemainderProfileF,
      partBFiniteWindowBalancedRemainderProfileF]
    simp [Nat.cast_choose_two]
    have hsub_cast :
        ((n - k * a : ℕ) : ℝ) = (n : ℝ) - (k : ℝ) * (a : ℝ) := by
      have hka_le : k * a ≤ n := by
        calc
          k * a ≤ k * q := Nat.mul_le_mul_left k hqa
          _ ≤ n := by
            rw [← hdivmod_nat]
            omega
      rw [Nat.cast_sub hka_le, Nat.cast_mul]
    rw [hsub_cast, ← hdivmod]
    nlinarith [mul_nonneg hdiff_nonneg hfactor_nonneg]

