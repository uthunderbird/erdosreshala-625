    (δ : ℝ) (n : ℕ)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) : ℝ :=
  partBEndpointDeficitVectorClosedContribution n e /
    partBExactNoEmptyFixedMInnerBudget δ n

noncomputable def partBEndpointDeficitVectorTailMomentSumNat
    (n : ℕ)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) : ℕ :=
  ∑ j : Fin (partBThresholdLevel n + 1),
    if 2 ≤ j.val then j.val * (e j).val else 0

noncomputable def partBEndpointDeficitVectorTailCountSumNat
    (n : ℕ)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) : ℕ :=
  ∑ j : Fin (partBThresholdLevel n + 1),
    if 2 ≤ j.val then (e j).val else 0

lemma partBEndpointDeficitVectorColorCountSumNat_eq_zero_one_tail
    {n : ℕ} (ht_one : 1 < partBThresholdLevel n)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    (∑ j : Fin (partBThresholdLevel n + 1), (e j).val) =
      (e 0).val +
        (e ⟨1, by omega⟩).val +
        partBEndpointDeficitVectorTailCountSumNat n e := by
  classical
  let j0 : Fin (partBThresholdLevel n + 1) := 0
  let j1 : Fin (partBThresholdLevel n + 1) := ⟨1, by omega⟩
  let a : Fin (partBThresholdLevel n + 1) → ℕ := fun j => (e j).val
  have hpoint : ∀ j : Fin (partBThresholdLevel n + 1),
      a j =
        (if j = j0 then a j else 0) +
          (if j = j1 then a j else 0) +
          (if 2 ≤ j.val then a j else 0) := by
    intro j
    by_cases hj0 : j = j0
    · subst j
      have h01 : j0 ≠ j1 := by
        intro h
        have hval := congrArg Fin.val h
        simp [j0, j1] at hval
      simp [j0, j1, h01]
    · by_cases hj1 : j = j1
      · subst j
        have h10 : j1 ≠ j0 := by
          intro h
          have hval := congrArg Fin.val h
          simp [j0, j1] at hval
        simp [j0, j1, h10]
      · have hjge : 2 ≤ j.val := by
          have hj0val : j.val ≠ 0 := by
            intro h
            exact hj0 (Fin.ext (by simpa [j0] using h))
          have hj1val : j.val ≠ 1 := by
            intro h
            exact hj1 (Fin.ext (by simpa [j1] using h))
          omega
        simp [hj0, hj1, hjge]
  calc
    (∑ j : Fin (partBThresholdLevel n + 1), (e j).val) = ∑ j, a j := by
      rfl
    _ = (∑ j : Fin (partBThresholdLevel n + 1),
        ((if j = j0 then a j else 0) +
          (if j = j1 then a j else 0) +
          (if 2 ≤ j.val then a j else 0))) := by
          exact Finset.sum_congr rfl (fun j _ => hpoint j)
    _ = (∑ j : Fin (partBThresholdLevel n + 1), if j = j0 then a j else 0) +
          (∑ j : Fin (partBThresholdLevel n + 1), if j = j1 then a j else 0) +
          ∑ j : Fin (partBThresholdLevel n + 1), if 2 ≤ j.val then a j else 0 := by
          simp [Finset.sum_add_distrib, add_assoc]
    _ = (e 0).val +
          (e ⟨1, by omega⟩).val +
          partBEndpointDeficitVectorTailCountSumNat n e := by
          simp [partBEndpointDeficitVectorTailCountSumNat, a, j0, j1]

lemma partBEndpointDeficitVectorMomentSumNat_eq_one_tailMoment
    {n : ℕ} (ht_one : 1 < partBThresholdLevel n)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    (∑ j : Fin (partBThresholdLevel n + 1), j.val * (e j).val) =
      (e ⟨1, by omega⟩).val +
        partBEndpointDeficitVectorTailMomentSumNat n e := by
  classical
  let j0 : Fin (partBThresholdLevel n + 1) := 0
  let j1 : Fin (partBThresholdLevel n + 1) := ⟨1, by omega⟩
  let a : Fin (partBThresholdLevel n + 1) → ℕ := fun j => (e j).val
  have hpoint : ∀ j : Fin (partBThresholdLevel n + 1),
      j.val * a j =
        (if j = j1 then a j else 0) +
          (if 2 ≤ j.val then j.val * a j else 0) := by
    intro j
    by_cases hj0 : j = j0
    · subst j
      have h01 : j0 ≠ j1 := by
        intro h
        have hval := congrArg Fin.val h
        simp [j0, j1] at hval
      simp [j0, j1, h01]
    · by_cases hj1 : j = j1
      · subst j
        simp [j1]
      · have hjge : 2 ≤ j.val := by
          have hj0val : j.val ≠ 0 := by
            intro h
            exact hj0 (Fin.ext (by simpa [j0] using h))
          have hj1val : j.val ≠ 1 := by
            intro h
            exact hj1 (Fin.ext (by simpa [j1] using h))
          omega
        simp [hj1, hjge]
  calc
    (∑ j : Fin (partBThresholdLevel n + 1), j.val * (e j).val) =
        ∑ j, j.val * a j := by
          rfl
    _ = (∑ j : Fin (partBThresholdLevel n + 1),
        ((if j = j1 then a j else 0) +
          (if 2 ≤ j.val then j.val * a j else 0))) := by
          exact Finset.sum_congr rfl (fun j _ => hpoint j)
    _ = (∑ j : Fin (partBThresholdLevel n + 1), if j = j1 then a j else 0) +
          ∑ j : Fin (partBThresholdLevel n + 1),
            if 2 ≤ j.val then j.val * a j else 0 := by
          simp [Finset.sum_add_distrib]
    _ = (e ⟨1, by omega⟩).val +
          partBEndpointDeficitVectorTailMomentSumNat n e := by
          simp [partBEndpointDeficitVectorTailMomentSumNat, a, j1]

lemma partBEndpointDeficitVectorTailCountSumNat_le_tailMomentSumNat
    (n : ℕ)
    (e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)) :
    partBEndpointDeficitVectorTailCountSumNat n e ≤
      partBEndpointDeficitVectorTailMomentSumNat n e := by
  classical
  dsimp [partBEndpointDeficitVectorTailCountSumNat,
    partBEndpointDeficitVectorTailMomentSumNat]
  refine Finset.sum_le_sum ?_
  intro j _hj
  by_cases hj2 : 2 ≤ j.val
  · simp [hj2]
    exact Nat.le_mul_of_pos_left (e j).val (by omega)
  · simp [hj2]

lemma partBEndpointDeficitVectorOneCoord_eq_deficit_sub_tailMoment
    {n : ℕ} (ht_one : 1 < partBThresholdLevel n)
    {e : Fin (partBThresholdLevel n + 1) → Fin (n + 1)}
    (he : e ∈ partBEndpointDeficitVectorFinset n) :
    (e ⟨1, by omega⟩).val =
      (partBPaperObstructionColorCount n * partBThresholdLevel n - n) -
        partBEndpointDeficitVectorTailMomentSumNat n e := by
  have hmoment := (mem_partBEndpointDeficitVectorFinset_iff.mp he).2
