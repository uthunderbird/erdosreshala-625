/-- Event-level convention bridge: a possibly-empty unordered `k_t - 2` coloring can be compressed
to an exact-colour unordered coloring with at most `k_t - 2` colours.

This is the remaining deterministic bridge needed after the empty-colour red-team audit. -/
def PaperPartBAtMostToExactEventBridgeTarget : Prop :=
  ∀ n : ℕ,
    {G : SimpleGraph (Fin n) |
      UnorderedClassBoundedColoringExists n
        (partBPaperObstructionColorCount n) (partBThresholdLevel n) G} ⊆
    {G : SimpleGraph (Fin n) |
      ∃ m : ℕ, m ≤ partBPaperObstructionColorCount n ∧
        UnorderedSurjectiveClassBoundedColoringExists n m (partBThresholdLevel n) G}

/-- The deterministic convention bridge is true: discard unused colour labels and relabel the
used colours by `Fin m`. -/
theorem paperPartBAtMostToExactEventBridgeTarget :
    PaperPartBAtMostToExactEventBridgeTarget := by
  intro n G hG
  simp only [Set.mem_setOf_eq] at hG ⊢
  have hordered :
      ClassBoundedColoringExists n
        (partBPaperObstructionColorCount n) (partBThresholdLevel n) G :=
    (unorderedClassBoundedColoringExists_iff n
      (partBPaperObstructionColorCount n) (partBThresholdLevel n) G).mp hG
  obtain ⟨m, hm, π, hπ⟩ := classBoundedColoringExists_to_surjective hordered
  exact ⟨m, hm,
    (unorderedSurjectiveClassBoundedColoringExists_iff n m (partBThresholdLevel n) G).mpr
      ⟨π, hπ⟩⟩

/-- The exact-colour event target plus the deterministic convention bridge imply the original
possibly-empty unordered event target. -/
theorem paperPartBUnorderedFailureEventTarget_of_exactEvent
    (hbridge : PaperPartBAtMostToExactEventBridgeTarget)
    {ε δ : ℝ} (hexact : PaperPartBExactUnorderedFailureEventTarget ε δ) :
    PaperPartBUnorderedFailureEventTarget ε δ := by
  obtain ⟨n₀, hexact⟩ := hexact
  refine ⟨n₀, ?_⟩
  intro n hn hnMain
  exact (MeasureTheory.measure_mono (hbridge n)).trans (hexact n hn hnMain)

