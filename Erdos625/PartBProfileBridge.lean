  have hn₂ : n₂ ≤ n := (Nat.le_max_right n₁ n₂).trans hn
  have hfloor_ge9 : 9 ≤ thresholdFloor n := by
    exact Nat.le_floor (hge9 n hn₁ hmain)
  have hfloor_n : thresholdFloor n ≤ n := hfloor_le n hn₂ hmain
  dsimp [partBThresholdLevel]
  omega

theorem paperPartBTerminalContributionEntropyFloorExactForbiddenUpperWorstMFiniteWindowProfileKpowtCardLogBoundTarget
    {ε : ℝ} (hε_pos : 0 < ε) :
    PaperPartBTerminalContributionEntropyFloorExactForbiddenUpperWorstMFiniteWindowProfileKpowtCardLogBoundTarget ε := by
  rcases paperPartBThresholdLevelTerminalShapeTarget_of_thresholdGeNine_floorLe
      hε_pos (paperPartBThresholdFloorLeNTarget ε) with ⟨n₀, hshape⟩
  refine ⟨n₀, fun n hn hmain k _hk => ?_⟩
  classical
  set t := partBThresholdLevel n
  set S := coloringProfileFinset n k t
  have ht_le_n : t ≤ n := (hshape n hn hmain).2
  let trunc : (Fin (n + 1) → Fin (n + 1)) → (Fin (t + 1) → Fin (k + 1)) :=
    fun f i =>
      if hf : f ∈ S then
        ⟨(f ⟨i.val, Nat.lt_succ_of_le ((Nat.le_of_lt_succ i.isLt).trans ht_le_n)⟩).val,
          Nat.lt_succ_of_le (by
            have hle_sum :
                (f ⟨i.val, Nat.lt_succ_of_le ((Nat.le_of_lt_succ i.isLt).trans ht_le_n)⟩).val ≤
                  ∑ u : Fin (n + 1), (f u).val := by
              exact Finset.single_le_sum
                (f := fun u : Fin (n + 1) => (f u).val)
                (fun _ _ => Nat.zero_le _)
                (Finset.mem_univ _)
            have hcount :
                ∑ u : Fin (n + 1), (f u).val = k := by
              simpa [S, t, profileColorCount] using
                profileColorCount_eq_of_mem_coloringProfileFinset hf
            exact hle_sum.trans_eq hcount)⟩
      else 0
  have hinj : Set.InjOn trunc (↑S : Set (Fin (n + 1) → Fin (n + 1))) := by
    intro f hf g hg htrunc
    have hfS : f ∈ S := by simpa using hf
    have hgS : g ∈ S := by simpa using hg
    funext u
    by_cases hu : u.val ≤ t
    · have hidx_lt : u.val < t + 1 := Nat.lt_succ_of_le hu
      have hfg := congrArg Fin.val (congrFun htrunc ⟨u.val, hidx_lt⟩)
      simp [trunc, hfS, hgS] at hfg
      exact Fin.ext hfg
    · have htu : t < u.val := Nat.lt_of_not_ge hu
      have hf_zero : (f u).val = 0 := by
        exact (mem_coloringProfileFinset_iff.mp (by simpa [S, t] using hfS)).2.2 u htu
      have hg_zero : (g u).val = 0 := by
        exact (mem_coloringProfileFinset_iff.mp (by simpa [S, t] using hgS)).2.2 u htu
      exact Fin.ext (hf_zero.trans hg_zero.symm)
  have hcard : S.card ≤ (k + 1) ^ (t + 1) := by
    have hcard_eq : S.card = (S.image trunc).card :=
      (Finset.card_image_of_injOn hinj).symm
    calc
      S.card = (S.image trunc).card := hcard_eq
      _ ≤ Fintype.card (Fin (t + 1) → Fin (k + 1)) := Finset.card_le_univ _
      _ = (k + 1) ^ (t + 1) := by simp [Fintype.card_fin]
  have hcard_succ : S.card + 1 ≤ (k + 1) ^ (t + 1) + 1 :=
    Nat.succ_le_succ hcard
  have hlog :
      Real.log (((S.card + 1 : ℕ) : ℝ)) ≤
        Real.log ((((k + 1) ^ (t + 1) + 1 : ℕ) : ℝ)) :=
    Real.log_le_log (by positivity) (by exact_mod_cast hcard_succ)
  simpa [partBFiniteWindowProfileKpowtCardLogBound, S, t] using hlog

