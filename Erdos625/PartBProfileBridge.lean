/-- A non-uniform logarithmic envelope whose exponential sum satisfies the fixed-`m` budget
implies the exact log-sum inner budget. -/
theorem paperPartBExactNoEmptyProfileContributionLogSumInnerBudgetTarget_of_logEnvelope
    {E : ℝ → ℝ → (n : ℕ) → ℕ → (Fin (n + 1) → Fin (n + 1)) → ℝ}
    {ε δ : ℝ}
    (hpoint :
      PaperPartBExactNoEmptyProfileContributionLogEnvelopePointwiseTarget E ε δ)
    (hsum :
      PaperPartBExactNoEmptyProfileContributionLogEnvelopeSumTarget E ε δ) :
    PaperPartBExactNoEmptyProfileContributionLogSumInnerBudgetTarget ε δ := by
  rcases hpoint with ⟨n₁, hpoint⟩
  rcases hsum with ⟨n₂, hsum⟩
  refine ⟨max n₁ n₂, fun n hn hmain m hm => ?_⟩
  have hn₁ : n₁ ≤ n := (le_max_left n₁ n₂).trans hn
  have hn₂ : n₂ ≤ n := (le_max_right n₁ n₂).trans hn
  set R := Finset.range (partBPaperObstructionColorCount n + 1)
  set S := noEmptyColoringProfileFinset n m (partBThresholdLevel n)
  set X : ℝ := ∑ f ∈ S, profileContribution n f
  set Y : ℝ := ∑ f ∈ S, Real.exp (E ε δ n m f)
  have h_each : ∀ f ∈ S, profileContribution n f ≤ Real.exp (E ε δ n m f) := by
    intro f hf
    have hf_color : f ∈ coloringProfileFinset n m (partBThresholdLevel n) :=
      (mem_noEmptyColoringProfileFinset_iff.mp hf).1
    have hP : 0 < profileP n (fun u => (f u).val) :=
      profileP_pos_of_mem_coloringProfileFinset hf_color
    have hcontrib_pos : 0 < profileContribution n f :=
      profileContribution_pos_of_profileP_pos n f hP
    calc
      profileContribution n f = Real.exp (Real.log (profileContribution n f)) :=
        (Real.exp_log hcontrib_pos).symm
      _ ≤ Real.exp (E ε δ n m f) :=
        Real.exp_le_exp.mpr (hpoint n hn₁ hmain m hm f (by simpa [S] using hf))
  have hXY : X ≤ Y := by
    dsimp [X, Y]
    exact Finset.sum_le_sum h_each
  have hX_nonneg : 0 ≤ X := by
    dsimp [X]
    exact Finset.sum_nonneg (fun f _ => profileContribution_nonneg n f)
  by_cases hX_zero : X = 0
  · left
    simpa [S, X] using hX_zero
  · right
    have hX_pos : 0 < X := lt_of_le_of_ne hX_nonneg (Ne.symm hX_zero)
    rcases hsum n hn₂ hmain m hm with hY_zero | hY_log
    · have hX_le_zero : X ≤ 0 := by
        simpa [Y, S] using hXY.trans (le_of_eq hY_zero)
      exact False.elim ((not_lt_of_ge hX_le_zero) hX_pos)
    · have hlog_XY : Real.log X ≤ Real.log Y :=
        Real.log_le_log hX_pos hXY
      exact hlog_XY.trans (by simpa [R, S, Y] using hY_log)

/-- A log-core no-empty profile target implies the pointwise no-empty profile budget. -/
theorem paperPartBExactNoEmptyProfilePointwiseTarget_of_logCore
    {ε δ : ℝ} (hδ_pos : 0 < δ)
    (hcore : PaperPartBExactNoEmptyProfileLogCorePointwiseTarget ε δ) :
    PaperPartBExactNoEmptyProfilePointwiseTarget ε δ := by
  rcases hcore with ⟨n₀, hcore⟩
  refine ⟨n₀, fun n hn hmain m hm f hf => ?_⟩
  have hf_color : f ∈ coloringProfileFinset n m (partBThresholdLevel n) :=
    (mem_noEmptyColoringProfileFinset_iff.mp hf).1
  have hP : 0 < profileP n (fun u => (f u).val) :=
    profileP_pos_of_mem_coloringProfileFinset hf_color
  have hcontrib_pos : 0 < profileContribution n f :=
    profileContribution_pos_of_profileP_pos n f hP
  have hcore' :
      profileCombinatorialLogCore n f ≤
        Real.log (partBExactNoEmptyRawProfileBudget δ n m) := by
    simpa [partBExactNoEmptyLogCoreBudget] using hcore n hn hmain m hm f hf
  calc
    profileContribution n f ≤ Real.exp (Real.log (partBExactNoEmptyRawProfileBudget δ n m)) :=
      profileContribution_le_exp_of_core_bound hcontrib_pos hP hcore'
    _ = partBExactNoEmptyRawProfileBudget δ n m :=
      Real.exp_log (partBExactNoEmptyRawProfileBudget_pos n m hδ_pos)
    _ = δ /
          ((((Finset.range (partBPaperObstructionColorCount n + 1)).card + 1 : ℕ) : ℝ) *
            (((noEmptyColoringProfileFinset n m (partBThresholdLevel n)).card + 1 : ℕ) : ℝ)) := by
      rfl

/-- Uniform inner budgets imply the summed no-empty profile target. -/
theorem paperPartBExactNoEmptyProfileUnionTarget_of_innerBudget
    {ε δ : ℝ} (hδ_nonneg : 0 ≤ δ)
    (hinner : PaperPartBExactNoEmptyProfileInnerBudgetTarget ε δ) :
    PaperPartBExactNoEmptyProfileUnionTarget ε δ := by
  rcases hinner with ⟨n₀, hinner⟩
  refine ⟨n₀, fun n hn hmain => ?_⟩
  set R := Finset.range (partBPaperObstructionColorCount n + 1)
  set B : ℝ := δ / (((R.card + 1 : ℕ) : ℝ))
  have hsum_le :
      (∑ m ∈ R,
        ENNReal.ofReal
          (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
            profileContribution n f)) ≤
        ∑ m ∈ R, ENNReal.ofReal B := by
    exact Finset.sum_le_sum (fun m hm => by simpa [R, B] using hinner n hn hmain m hm)
  have hsum_const : ∑ _m ∈ R, ENNReal.ofReal B = (R.card : ℝ≥0∞) * ENNReal.ofReal B := by
    simp [nsmul_eq_mul]
  have hB_nonneg : 0 ≤ B := by
    dsimp [B]
    positivity
  have hcard_budget : (R.card : ℝ) * B ≤ δ := by
    dsimp [B]
    have hD_pos : 0 < (((R.card + 1 : ℕ) : ℝ)) := by positivity
    have hR_le_D : (R.card : ℝ) ≤ (((R.card + 1 : ℕ) : ℝ)) := by
      exact_mod_cast Nat.le_succ R.card
    calc
      (R.card : ℝ) * (δ / (((R.card + 1 : ℕ) : ℝ)))
          ≤ (((R.card + 1 : ℕ) : ℝ)) * (δ / (((R.card + 1 : ℕ) : ℝ))) := by
            exact mul_le_mul_of_nonneg_right hR_le_D (div_nonneg hδ_nonneg hD_pos.le)
      _ = δ := by field_simp [ne_of_gt hD_pos]
  calc
    (∑ m ∈ R,
      ENNReal.ofReal
        (∑ f ∈ noEmptyColoringProfileFinset n m (partBThresholdLevel n),
          profileContribution n f)) ≤
        ∑ _m ∈ R, ENNReal.ofReal B := hsum_le
    _ = (R.card : ℝ≥0∞) * ENNReal.ofReal B := hsum_const
    _ = ENNReal.ofReal ((R.card : ℝ) * B) := by
      rw [show (R.card : ℝ≥0∞) = ENNReal.ofReal (R.card : ℝ) by simp]
      rw [show (R.card : ℝ) * B = B * (R.card : ℝ) by ring]
      rw [ENNReal.ofReal_mul hB_nonneg]
      rw [mul_comm]
    _ ≤ ENNReal.ofReal δ := ENNReal.ofReal_le_ofReal hcard_budget

