def PaperPartBTerminalProfileFFormulaTarget : Prop :=
  ∀ n m : ℕ, PartBTerminalProfileFeasible n m →
    profileF n (fun u => (partBTerminalProfile n m u).val) =
      Nat.choose (partBThresholdLevel n) 2 * partBTerminalTopCount n m +
        Nat.choose (partBThresholdLevel n - 1) 2 * partBTerminalLowCount n m

theorem paperPartBTerminalProfileFFormulaTarget :
    PaperPartBTerminalProfileFFormulaTarget := by
  intro n m hfeas
  rcases hfeas with ⟨_hlower, _hupper, hmn, ht_one, htn⟩
  let uTop : Fin (n + 1) := ⟨partBThresholdLevel n, Nat.lt_succ_of_le htn⟩
  let uLow : Fin (n + 1) :=
    ⟨partBThresholdLevel n - 1,
      Nat.lt_succ_of_le ((Nat.sub_le _ _).trans htn)⟩
  have hneq : uTop ≠ uLow := by
    intro h
    have hval := congrArg Fin.val h
    dsimp [uTop, uLow] at hval
    omega
  have hval : ∀ u : Fin (n + 1),
      Nat.choose u.val 2 * (partBTerminalProfile n m u).val =
        if u = uTop then Nat.choose (partBThresholdLevel n) 2 * partBTerminalTopCount n m
        else if u = uLow then
          Nat.choose (partBThresholdLevel n - 1) 2 * partBTerminalLowCount n m
        else 0 := by
    intro u
    by_cases htop : u = uTop
    · rw [htop]
      have htop_val :=
        partBTerminalProfile_top_val (n := n) (m := m) (u := uTop) (by simp [uTop])
      simp [uTop, htop_val]
    · by_cases hlow : u = uLow
      · have hu_ne_top : u.val ≠ partBThresholdLevel n := by
          intro h
          apply htop
          exact Fin.ext (by simpa [uTop] using h)
        rw [hlow]
        have hLowNeTop : uLow ≠ uTop := Ne.symm hneq
        have hlow_val :=
          partBTerminalProfile_low_val (n := n) (m := m) (u := uLow)
            (by simp [uLow]) (by simpa [hlow] using hu_ne_top) hmn
        simp [uLow, hLowNeTop, hlow_val]
      · have hu_ne_top : u.val ≠ partBThresholdLevel n := by
          intro h
          exact htop (Fin.ext (by simpa [uTop] using h))
        have hu_ne_low : u.val ≠ partBThresholdLevel n - 1 := by
          intro h
          exact hlow (Fin.ext (by simpa [uLow] using h))
        have hzero := partBTerminalProfile_apply_of_ne
          (n := n) (m := m) (u := u) hu_ne_top hu_ne_low
        simp [htop, hlow, hzero]
  rw [profileF]
  calc
    (∑ u : Fin (n + 1), Nat.choose u.val 2 * (partBTerminalProfile n m u).val)
        = ∑ u : Fin (n + 1),
            if u = uTop then
              Nat.choose (partBThresholdLevel n) 2 * partBTerminalTopCount n m
            else if u = uLow then
              Nat.choose (partBThresholdLevel n - 1) 2 * partBTerminalLowCount n m
            else 0 := by
          exact Finset.sum_congr rfl (fun u _ => hval u)
    _ = Nat.choose (partBThresholdLevel n) 2 * partBTerminalTopCount n m +
          Nat.choose (partBThresholdLevel n - 1) 2 * partBTerminalLowCount n m := by
          exact finset_univ_sum_two_point uTop uLow
            (Nat.choose (partBThresholdLevel n) 2 * partBTerminalTopCount n m)
            (Nat.choose (partBThresholdLevel n - 1) 2 * partBTerminalLowCount n m) hneq

def PaperPartBTerminalProfileSymmFormulaTarget : Prop :=
  ∀ n m : ℕ, PartBTerminalProfileFeasible n m →
    profileSymm n (fun u => (partBTerminalProfile n m u).val) =
      Nat.factorial (partBTerminalTopCount n m) *
        Nat.factorial (partBTerminalLowCount n m)

theorem paperPartBTerminalProfileSymmFormulaTarget :
    PaperPartBTerminalProfileSymmFormulaTarget := by
  intro n m hfeas
  rcases hfeas with ⟨_hlower, _hupper, hmn, ht_one, htn⟩
  let uTop : Fin (n + 1) := ⟨partBThresholdLevel n, Nat.lt_succ_of_le htn⟩
  let uLow : Fin (n + 1) :=
    ⟨partBThresholdLevel n - 1,
      Nat.lt_succ_of_le ((Nat.sub_le _ _).trans htn)⟩
  have hneq : uTop ≠ uLow := by
    intro h
    have hval := congrArg Fin.val h
    dsimp [uTop, uLow] at hval
    omega
  have hval : ∀ u : Fin (n + 1),
      Nat.factorial ((partBTerminalProfile n m u).val) =
        if u = uTop then Nat.factorial (partBTerminalTopCount n m)
        else if u = uLow then Nat.factorial (partBTerminalLowCount n m)
        else 1 := by
    intro u
    by_cases htop : u = uTop
    · rw [htop]
      have htop_val :=
        partBTerminalProfile_top_val (n := n) (m := m) (u := uTop) (by simp [uTop])
      simp [uTop, htop_val]
    · by_cases hlow : u = uLow
      · have hu_ne_top : u.val ≠ partBThresholdLevel n := by
          intro h
          apply htop
          exact Fin.ext (by simpa [uTop] using h)
        rw [hlow]
        have hLowNeTop : uLow ≠ uTop := Ne.symm hneq
        have hlow_val :=
          partBTerminalProfile_low_val (n := n) (m := m) (u := uLow)
            (by simp [uLow]) (by simpa [hlow] using hu_ne_top) hmn
        simp [uLow, hLowNeTop, hlow_val]
      · have hu_ne_top : u.val ≠ partBThresholdLevel n := by
          intro h
          exact htop (Fin.ext (by simpa [uTop] using h))
        have hu_ne_low : u.val ≠ partBThresholdLevel n - 1 := by
          intro h
          exact hlow (Fin.ext (by simpa [uLow] using h))
        have hzero := partBTerminalProfile_apply_of_ne
          (n := n) (m := m) (u := u) hu_ne_top hu_ne_low
        simp [htop, hlow, hzero]
  rw [profileSymm]
  calc
    (∏ u : Fin (n + 1), Nat.factorial ((partBTerminalProfile n m u).val))
        = ∏ u : Fin (n + 1),
            if u = uTop then Nat.factorial (partBTerminalTopCount n m)
            else if u = uLow then Nat.factorial (partBTerminalLowCount n m)
            else 1 := by
          exact Finset.prod_congr rfl (fun u _ => hval u)
    _ = Nat.factorial (partBTerminalTopCount n m) *
          Nat.factorial (partBTerminalLowCount n m) := by
          exact finset_univ_prod_two_point uTop uLow
            (Nat.factorial (partBTerminalTopCount n m))
            (Nat.factorial (partBTerminalLowCount n m)) hneq

